
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }

    .q5-filters { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .q5-filters__kw { display: inline-block; width: 270px; }
    .q5-filters__state { display: inline-block; width: 210px; }
    .q5-chip {
      display: inline-flex; align-items: center; cursor: pointer; font: inherit;
      font-size: var(--fs-12); font-weight: 500; color: var(--warning-text);
      background: var(--warning-bg); border: 1px solid transparent; border-radius: var(--radius-full); padding: 2px 10px;
    }
    .q5-chip:hover { border-color: var(--warning-base, var(--warning-text)); }
    .q5-chip--on { border-color: var(--warning-base, var(--warning-text)); font-weight: 700; }

    /* peek side cần chỗ đứng khi bảng ít dòng (pattern D2 min-height) */
    .q5-split { flex: 1 1 auto; min-height: 480px; display: flex; gap: 12px; align-items: stretch; }
    .q5-main { flex: 1 1 auto; min-width: 0; overflow: auto; display: flex; flex-direction: column; gap: 14px; }
    .q5-empty { padding: 40px 0; display: flex; justify-content: center; }

    .q5-sec { display: flex; flex-direction: column; gap: 6px; }
    .q5-row {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      border: 1px solid var(--border-sub); border-radius: var(--radius-md);
      background: var(--bg-surface); padding: 7px 12px; font-size: var(--fs-13);
    }
    .q5-row__mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .q5-row__main { color: var(--text-body); font-weight: 500; }
    .q5-row__muted { font-size: var(--fs-12); color: var(--text-sub); }
    .q5-row__gap { flex: 1; }

    .q5-stack { display: flex; flex-direction: column; gap: 2px; align-items: flex-start; min-width: 0; }
    .q5-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .q5-strong { color: var(--text-strong); font-weight: 500; }
    .q5-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .q5-warn { font-size: var(--fs-12); font-weight: 600; color: var(--warning-text); }
    .q5-err { font-size: var(--fs-12); color: var(--error-text); }
    .q5-num { font-weight: 600; color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .q5-tags { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; row-gap: 4px; }
    :host ::ng-deep .q5-tags .ant-tag { margin: 0; }

    .q5-bulk-sel { display: inline-block; width: 210px; }
    .q5-xoa-note { font-size: var(--fs-12); color: var(--text-sub); }
    .q5-form { display: flex; flex-direction: column; gap: 8px; }
    .q5-form b { color: var(--text-strong); }
  