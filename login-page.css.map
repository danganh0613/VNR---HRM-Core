
    .lp-frame {
      width: 100%; aspect-ratio: 16 / 10; border: 1px solid var(--border-sub);
      border-radius: var(--radius-xl); overflow: hidden; background: var(--bg-surface-subtle);
    }
    .lp-frame iframe { width: 100%; height: 100%; border: 0; display: block; }
    .lp-actions { margin-top: 14px; }
    .lp-actions a { text-decoration: none; }
  