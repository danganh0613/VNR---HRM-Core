
    :host { display: block; max-width: 860px; }
    .dd-wrap { display: flex; flex-direction: column; gap: 10px; }
    .dd-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .dd-note { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .dd-note b { color: var(--text-strong); }
    .dd-form { display: flex; flex-direction: column; gap: 10px; }
    .dd-field { display: flex; flex-direction: column; gap: 4px; font-size: var(--fs-12); color: var(--text-sub); }
    .dd-err { font-size: var(--fs-12); color: var(--error-text); font-weight: 500; }
  