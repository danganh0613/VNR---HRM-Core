
    :host { display: flex; flex-direction: column; gap: 10px; }
    .t-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .t-note { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .t-grid2 { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 14px; align-items: start; }
    .t-col { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .t-item { border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); padding: 8px 11px; display: flex; flex-direction: column; gap: 4px; }
    .t-item--mo { opacity: .55; }
    .t-item--het { border-style: dashed; }
    .t-item__head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .t-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 700; color: var(--text-strong); }
    .t-strong { color: var(--text-strong); font-weight: 500; }
    .t-muted { margin: 0; font-size: var(--fs-12); color: var(--text-sub); display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }
    .t-warn { margin: 0; font-size: var(--fs-12); color: var(--warning-text); font-weight: 500; }
    .t-err { margin: 0; font-size: var(--fs-12); color: var(--error-text); font-weight: 500; }
    .t-map { border: 1px dashed var(--border-sub); border-radius: var(--radius-md); padding: 7px 10px; display: flex; flex-direction: column; gap: 3px; align-items: flex-start; }
    .t-map--xm { border-color: var(--error-base); background: var(--error-bg); }
  