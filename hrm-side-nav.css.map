
:host { display: block; }
.sn {
  position: relative;
  display: flex; flex-direction: column; gap: 4px;
  width: 264px; padding: 12px 10px;
  background: var(--bg-surface); border-right: 1px solid var(--border-sub);
  font-family: var(--font-sans); overflow: hidden; min-height: 0;
  transition: width var(--duration-normal, .22s) var(--ease-out, ease);
}
.sn.is-collapsed { width: 72px; padding: 12px 8px; align-items: stretch; }

/* Ghim: brand (top) + foot (bottom) cố định; chỉ .sn-scroll (danh sách nav) cuộn dọc. */
.sn-brand, .sn-brand-mark, .sn-head, .sn-search, .sn-foot { flex: none; }
.sn-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; }

/* Header — logo + actions + toggle */
.sn-brand {
  display: flex; align-items: center; gap: 8px;
  padding: 4px 6px 12px; margin-bottom: 6px; border-bottom: 1px solid var(--border-soft);
}
.sn-brand-logo { height: 30px; width: auto; flex: 1; min-width: 0; object-fit: contain; object-position: left center; }
.sn-brand-act { display: flex; align-items: center; gap: 2px; flex: none; }
.sn-iconbtn {
  display: grid; place-items: center; width: 34px; height: 34px;
  border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub);
}
.sn-iconbtn:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
/* Collapsed header — mark + hover expand */
.sn-brand-mark {
  position: relative; display: flex; justify-content: center; align-items: center;
  height: 44px; margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid var(--border-soft);
}
.sn-mark-logo { height: 30px; width: auto; transition: opacity var(--duration-fast, .15s) var(--ease-out, ease); }
.sn-expand {
  position: absolute; inset: 0 0 8px 0; margin: auto;
  display: grid; place-items: center; width: 34px; height: 34px;
  border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md);
  cursor: pointer; color: var(--text-sub); opacity: 0; transition: opacity var(--duration-fast, .15s) var(--ease-out, ease);
  box-shadow: var(--shadow-regular-xs);
}
.sn-brand-mark:hover .sn-mark-logo { opacity: 0; }
.sn-brand-mark:hover .sn-expand { opacity: 1; }
.sn-expand:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }

.sn-head { padding: 2px 4px 12px; margin-bottom: 4px; border-bottom: 1px solid var(--border-soft); display: flex; }
.sn-head:empty { display: none; }

/* ===== nz-menu override (double-class theo chuẩn specificity — KHÔNG !important) =====
   Nền/màu/active nền tảng do ng-zorro-bridge; khối này đưa hình khối + màu về ĐÚNG UI side nav cũ:
   hàng 37px sát nhau, pill radius-lg, hover trung tính (không primary kiểu ant), caret phải tự xoay. */
.sn ::ng-deep .ant-menu.ant-menu { background: transparent; border-inline-end: none; font-size: var(--fs-14); }
.sn ::ng-deep .ant-menu.ant-menu-inline-collapsed { width: 100%; }
.sn ::ng-deep .ant-menu .ant-menu-item,
.sn ::ng-deep .ant-menu .ant-menu-submenu-title {
  border-radius: var(--radius-lg); margin-inline: 0; margin-block: 0; width: 100%;
  height: 37px; line-height: 37px;
}
.sn ::ng-deep .ant-menu.ant-menu-inline .ant-menu-item:not(:last-child) { margin-bottom: 0; }
/* Bỏ thanh chỉ báo 3px bên phải của ant v4 — UI cũ dùng pill, không có thanh. */
.sn ::ng-deep .ant-menu.ant-menu-inline .ant-menu-item::after { display: none; }
/* Nội dung item = flex icon + nhãn + badge/trailing (nz bọc trong .ant-menu-title-content).
   Thụt lề ở đây (padding 10px) vì nzInlineIndent=0. */
.sn ::ng-deep .ant-menu-title-content { display: flex; align-items: center; gap: 10px; min-width: 0; width: 100%; padding: 0 10px; }
/* Submenu title với nzTitle template KHÔNG có .ant-menu-title-content — flex trực tiếp trên title.
   ant bơm inline padding-inline-start:0 (indent=0) → thụt trái bằng margin phần tử đầu. */
.sn ::ng-deep .ant-menu .ant-menu-submenu-title { display: flex; align-items: center; gap: 10px; padding-right: 10px; }
.sn ::ng-deep .ant-menu .ant-menu-submenu-title > *:first-child { margin-inline-start: 10px; }
/* Nhóm con: thụt 30px như UI cũ (margin — inline-style padding-left:0 của ant không cản). */
.sn ::ng-deep .ant-menu-sub.ant-menu-inline .ant-menu-item { margin-inline-start: 30px; width: calc(100% - 30px); }
/* Hover trung tính (ant mặc định nhuộm primary): nền subtle + chữ đậm — như UI cũ. */
.sn ::ng-deep .ant-menu.ant-menu .ant-menu-item:hover:not(.ant-menu-item-selected):not(.ant-menu-item-disabled),
.sn ::ng-deep .ant-menu.ant-menu .ant-menu-submenu-title:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
/* Hover TRÊN mục đang chọn — đậm hơn 1 nấc để vẫn có phản hồi. */
.sn ::ng-deep .ant-menu.ant-menu .ant-menu-item-selected:hover { background: var(--primary-bg-soft); color: var(--primary-base); }
.sn ::ng-deep .ant-menu.ant-menu .ant-menu-item-selected { font-weight: 500; }
:host-context(.dark) .sn ::ng-deep .ant-menu-item-selected { color: var(--text-strong); }
/* Cha chứa mục đang chọn — nhãn đậm + icon primary để định vị (như UI cũ). */
.sn ::ng-deep .ant-menu-submenu-selected > .ant-menu-submenu-title { color: var(--text-strong); font-weight: 500; }
.sn ::ng-deep .ant-menu-submenu-selected > .ant-menu-submenu-title .sn-ic { color: var(--primary-base); }
/* Caret custom (chevron phải, xoay 90° khi mở) thay mũi tên ant. */
.sn ::ng-deep .ant-menu-submenu-arrow { display: none; }
.sn-caret { flex: none; color: var(--text-soft); transition: transform var(--duration-fast, .15s) var(--ease-out, ease); }
.sn ::ng-deep .sn-open > .ant-menu-submenu-title .sn-caret { transform: rotate(90deg); }
.sn ::ng-deep .ant-menu-item-group { margin-top: 14px; }
.sn ::ng-deep .ant-menu-item-group:first-child { margin-top: 0; }
.sn ::ng-deep .ant-menu-item-group-title {
  font-size: var(--fs-11); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;
  color: var(--text-soft); padding: 10px 10px 4px;
}
.sn-ic { flex: none; }
.sn-label { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* ant v4 ép mọi con của item/title về flex:0 0 auto (specificity 3 class) → nâng specificity để nhãn giãn,
   đẩy caret/badge sát mép phải như UI cũ. */
.sn ::ng-deep .ant-menu .ant-menu-item .sn-label,
.sn ::ng-deep .ant-menu .ant-menu-submenu-title .sn-label { flex: 1 1 0%; min-width: 0; }
.sn-badge {
  flex: none; font-size: var(--fs-11); font-weight: 600; line-height: 1;
  padding: 3px 7px; border-radius: var(--radius-full);
  background: var(--primary-bg-soft); color: var(--primary-base);
}
.sn-trail { flex: none; font-size: var(--fs-12); color: var(--text-soft); }

/* Ô tìm kiếm (nz-input-group) — skin token, double-class thắng min.css. */
.sn-search.ant-input-affix-wrapper.ant-input-affix-wrapper {
  margin: 2px 4px 10px; padding: 7px 10px; width: auto;
  background: var(--bg-surface-subtle); border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
}
.sn-search.ant-input-affix-wrapper-focused { border-color: var(--primary-base); box-shadow: none; }
.sn-search ::ng-deep .ant-input.ant-input { background: transparent; font-size: var(--fs-13); color: var(--text-body); }
.sn-search-ic { color: var(--text-soft); }
.sn-search-clr {
  display: grid; place-items: center; width: 18px; height: 18px; padding: 0;
  border: 0; background: transparent; cursor: pointer; color: var(--text-soft); border-radius: var(--radius-sm);
}
.sn-search-clr:hover { color: var(--text-strong); background: var(--bg-surface); }
.sn-empty { padding: 16px 12px; font-size: var(--fs-13); color: var(--text-soft); text-align: center; }

/* Focus bàn phím — vòng focus rõ trên phần tử bấm được (WCAG 2.4.7); menu item do ng-zorro lo. */
.sn-iconbtn:focus-visible,
.sn-expand:focus-visible,
.sn-user:focus-visible,
.sn-switch:focus-visible,
.sn-search-clr:focus-visible {
  outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: 1px;
}

/* Footer (khối tài khoản người dùng) — ghim đáy side nav */
.sn-foot { display: flex; padding: 10px 4px 2px; border-top: 1px solid var(--border-soft); }
.sn-foot:empty { display: none; }
.sn-user { display: flex; align-items: center; gap: 10px; width: 100%; padding: 6px 8px; border: 0;
  background: transparent; border-radius: var(--radius-lg); cursor: pointer; text-align: left; }
.sn-user:hover { background: var(--bg-surface-subtle); }
.sn-uav ::ng-deep .ant-avatar { background: var(--primary-base); color: var(--text-on-primary, #fff); font-size: var(--fs-13); font-weight: 600; }
.sn-uinfo { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.sn-uname { font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sn-umail { font-size: var(--fs-12); color: var(--text-sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sn-switch { flex: none; display: inline-flex; color: var(--text-soft); padding: 2px; border-radius: var(--radius-sm); }
.sn-switch:hover { color: var(--text-strong); background: var(--bg-surface-subtle); }
.sn.is-collapsed .sn-user { justify-content: center; padding: 6px 0; }

/* Collapsed rail: ẩn nhãn/badge/trail + tiêu đề nhóm; item = ô vuông icon giữa.
   Submenu popup do ng-zorro render NGOÀI component (overlay) — style trong ng-zorro-bridge.css. */
.sn.is-collapsed .sn-label,
.sn.is-collapsed .sn-badge,
.sn.is-collapsed .sn-trail { display: none; }
.sn.is-collapsed ::ng-deep .ant-menu-item-group-title { display: none; }
.sn.is-collapsed ::ng-deep .ant-menu .ant-menu-item,
.sn.is-collapsed ::ng-deep .ant-menu .ant-menu-submenu-title {
  width: 40px; height: 40px; padding: 0; margin: 0 auto 4px;
  display: flex; align-items: center; justify-content: center;
}
.sn.is-collapsed ::ng-deep .ant-menu-title-content { flex: none; gap: 0; padding: 0; }
.sn.is-collapsed ::ng-deep .ant-menu .ant-menu-submenu-title { padding-right: 0; justify-content: center; }
.sn.is-collapsed ::ng-deep .ant-menu .ant-menu-submenu-title > *:first-child { margin-inline-start: 0; }
/* Thu gọn: overlay popup nằm ngoài rail → bỏ clip; .sn-scroll vẫn cuộn dọc. */
.sn.is-collapsed { overflow: visible; }
.sn.is-collapsed .sn-head, .sn.is-collapsed .sn-foot { justify-content: center; padding-left: 0; padding-right: 0; }
  