
    /* Full-bleed: shell (.ins-body) không padding, và list-page tự lo gutter (.lp-split margin 16px +
       .lp-head full-bleed) → :host KHÔNG thêm gutter (nếu không → double-gutter, header mất full-bleed). */
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; padding: 0; }

    .m03b-list { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; padding: 0; }
    .m03b-list hrm-data-workspace { flex: 1 1 auto; min-height: 0; }
    /* Footer đếm (thay thanh phân trang) — canh mép panel (.lp-split margin 16px), border-top nhẹ. */
    .m03b-foot { flex: none; margin: 0 var(--space-4) var(--space-4); padding: var(--space-2) var(--space-1);
      border-top: 1px solid var(--border-soft); font-size: var(--fs-12); color: var(--text-sub); text-align: right; }
    .m03b-foot b { color: var(--text-strong); font-weight: 600; font-variant-numeric: tabular-nums; }
    /* Màn B (lo-detail) KHÔNG dùng list-page → tự cấp gutter ngang (trước đây do :host 0 20px lo). */
    ins-m03-lo-detail { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; padding: var(--space-3) var(--space-5) var(--space-4); overflow: auto; }

    /* Cell lưới LÔ */
    .m03b-stack { display: flex; flex-direction: column; gap: var(--space-0-5); min-width: 0; align-items: flex-start; }
    :host ::ng-deep .m03b-stack .ant-tag { margin: 0; }
    .m03b-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .m03b-strong { color: var(--text-strong); font-weight: 500; }
    .m03b-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .m03b-loi { font-size: var(--fs-12); font-weight: 600; color: var(--error-text); }

    /* Modal form */
    .m03b-form { display: flex; flex-direction: column; gap: var(--space-2); }
    .m03b-err { font-size: var(--fs-12); color: var(--error-text); }
  