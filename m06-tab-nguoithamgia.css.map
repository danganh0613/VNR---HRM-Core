
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; gap: 8px; }
    .t2-toolbar { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .t2-toolbar__lbl { font-size: var(--fs-12); color: var(--text-sub); }
    .t2-gap { flex: 1; }
    .t2-toggle { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-12); color: var(--text-sub); cursor: pointer; }
    .t2-split { flex: 1 1 auto; min-height: 480px; display: flex; gap: 12px; align-items: stretch; }
    .t2-main { flex: 1 1 auto; min-width: 0; overflow: auto; }
    .t2-empty { padding: 40px 0; display: flex; justify-content: center; }
    .t2-stack { display: flex; flex-direction: column; gap: 2px; align-items: flex-start; min-width: 0; }
    .t2-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .t2-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .t2-muted b { color: var(--text-strong); }
    .t2-err { font-size: var(--fs-12); color: var(--error-text); font-weight: 500; }
    .t2-ok { font-size: var(--fs-12); color: var(--success-text); font-weight: 500; }
    .t2-rz { display: flex; flex-direction: column; gap: 8px; font-size: var(--fs-13); }
    .t2-rz__row { display: flex; gap: 8px; align-items: baseline; border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 6px 10px; }
    .t2-rz__row--err { border-color: var(--error-base); background: var(--error-bg); }
    .t2-rz__acts { display: flex; gap: 8px; }
    .t2-xd { display: flex; flex-direction: column; gap: 6px; border: 1px solid var(--warning-base, var(--warning-text)); border-radius: var(--radius-md); padding: 8px 10px; }
    .t2-xd--done { border-color: var(--success-base, var(--success-text)); }
    .t2-xd__head { margin: 0; }
    .t2-xd__head b { color: var(--text-strong); }
    .t2-xd__sides { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    .t2-xd__side {
      display: flex; flex-direction: column; gap: 2px; align-items: flex-start; text-align: left; cursor: pointer;
      font: inherit; font-size: var(--fs-12); color: var(--text-body);
      background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 6px 8px;
    }
    .t2-xd__side:hover { border-color: var(--primary-base); }
    .t2-xd__side--on { border-color: var(--primary-base); background: var(--primary-bg, var(--bg-surface-subtle)); font-weight: 600; }
    .t2-xd__nhan { font-size: var(--fs-11, 11px); font-weight: 700; text-transform: uppercase; color: var(--text-sub); }
    .t2-form { display: flex; flex-direction: column; gap: 8px; }
  