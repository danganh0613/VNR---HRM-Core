
    :host { display: flex; flex-direction: column; gap: 8px; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg); padding: 12px 14px; }
    .d6-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .d6-khoa { font-size: var(--fs-11); font-weight: 700; padding: 1px 9px; border-radius: var(--radius-full); }
    .d6-khoa[data-ok='true'] { background: var(--success-bg); color: var(--success-text); }
    .d6-khoa[data-ok='false'] { background: var(--warning-bg); color: var(--warning-text); }
    .d6-cap { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; cursor: pointer; text-align: left;
      font: inherit; background: none; border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 6px 10px; }
    .d6-cap:hover { border-color: var(--primary-base); }
    .d6-cap__cot { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .d6-cap__nhan { font-size: var(--fs-12); font-weight: 600; color: var(--text-body); }
    .d6-cap__sub { font-size: var(--fs-11); color: var(--text-soft); }
    .d6-cap__na { font-size: var(--fs-12); font-weight: 600; color: var(--text-soft); }
    .d6-unexp { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; font-size: var(--fs-12); color: var(--text-body); }
    .d6-unexp__num { font-size: var(--fs-13); font-weight: 700; color: var(--error-text); font-variant-numeric: tabular-nums; }
    .d6-muted { font-size: var(--fs-11); color: var(--text-soft); }
    .d6-top3 { display: flex; flex-direction: column; gap: 4px; }
    .d6-top3__head { font-size: var(--fs-11); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--text-sub); }
    .d6-top3__row { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; cursor: pointer; text-align: left;
      font: inherit; background: none; border: 0; padding: 2px 0; }
    .d6-top3__row:hover .d6-mota { color: var(--primary-base); }
    .d6-mota { font-size: var(--fs-12); color: var(--text-body); }
    .d6-top3__row b { font-size: var(--fs-12); color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .d6-empty { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
  