
    :host { display: flex; flex-direction: column; gap: 10px; }
    .l-policies { display: flex; flex-direction: column; gap: 5px; }
    .l-policy { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); padding: 6px 10px; }
    .l-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 700; color: var(--text-strong); }
    .l-strong { color: var(--text-strong); font-weight: 500; font-size: var(--fs-13); }
    .l-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .l-muted b { color: var(--text-strong); }
    .l-warn { font-size: var(--fs-12); color: var(--warning-text); font-weight: 600; }
    .l-dot { border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface); padding: 10px 13px; display: flex; flex-direction: column; gap: 7px; }
    .l-dot__head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .l-row { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; border-left: 3px solid var(--border-sub); padding: 4px 10px; }
    .l-row--gh { border-left-color: var(--warning-base, var(--warning-text)); background: var(--warning-bg); border-radius: var(--radius-sm); }
    .l-acts { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .l-sel { width: 230px; }
    .l-note { margin: 0; font-size: var(--fs-11); color: var(--text-soft); }
  