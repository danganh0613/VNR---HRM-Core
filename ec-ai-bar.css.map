
:host { display: block; min-width: 0; }

/* ── Chatbot AI: KẾ THỪA nhận diện AI của Trợ lý no-code/low-code (sg-form-builder .ai-fab):
   viền GRADIENT 4 màu xanh dương → tím → vàng → cam đỏ + VỆT SÁNG chạy quanh chu vi (moving
   border kiểu Aceternity, conic-gradient xoay qua @property). Các hex này = MÀU NHẬN DIỆN AI
   (cố định cả 2 theme, không token — giống hệt cách no-code làm). Ring MỎNG HƠN: 1px (no-code 2px). ── */
@property --ecai-angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
.ai-bar { position: relative; background: var(--bg-surface); border: 0; border-radius: var(--radius-xl);
  padding: var(--space-2-5) var(--space-3); display: flex; flex-direction: column; gap: var(--space-2-5);
  box-shadow: 0 6px 20px rgb(37 99 235 / .16), 0 6px 22px rgb(240 101 58 / .14), 0 2px 8px rgb(139 92 246 / .12); }
.ai-bar > * { position: relative; z-index: 1; }
/* Viền base gradient 4 màu mờ + vệt comet chạy — ring 1px qua mask xor (MỎNG hơn no-code) */
.ai-bar::before, .ai-bar::after { content: ''; position: absolute; inset: 0; z-index: 0;
  border-radius: inherit; padding: 1px; pointer-events: none;
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor; mask-composite: exclude; }
.ai-bar::before { background: linear-gradient(100deg, #2563EB 0%, #8B5CF6 38%, #FBBF24 70%, #F0653A 100%); opacity: .4; }
.ai-bar::after { background: conic-gradient(from var(--ecai-angle),
    transparent 0 64%, rgb(37 99 235 / .35) 72%, #2563EB 79%, #8B5CF6 86%, #FBBF24 93%, #F0653A 98%, #FFD9C4 100%);
  animation: ecai-border-move 3s linear infinite; }
@keyframes ecai-border-move { to { --ecai-angle: 360deg; } }
/* Focus vào input: comet chạy nhanh hơn (đang "lắng nghe") + glow đậm */
.ai-bar:focus-within { box-shadow: 0 8px 26px rgb(37 99 235 / .24), 0 8px 28px rgb(240 101 58 / .2), 0 3px 10px rgb(139 92 246 / .18); }
.ai-bar:focus-within::after { animation-duration: 1.6s; }
@media (prefers-reduced-motion: reduce) { .ai-bar::after { animation: none; opacity: 0; } .ai-bar::before { opacity: .65; } }

.ai-row { display: flex; align-items: center; gap: var(--space-2-5); }
/* Spark tô màu nhận diện AI (tím giữa dải gradient) */
.ai-spark { color: #8B5CF6; flex: none; }

/* Input lớn, không viền (bar là field) — số/chữ theo token */
.ai-input { flex: 1; min-width: 0; border: none; outline: none; background: transparent;
  font-family: inherit; font-size: var(--fs-15); color: var(--text-strong); padding: var(--space-1-5) 0; }
.ai-input::placeholder { color: var(--text-soft); }
.ai-input:disabled { color: var(--text-disabled); }

/* Nút Tạo: icon wand + chữ, gap nhỏ giữa icon và nhãn */
.ai-bar hrm-button tabler-icon { margin-right: 5px; vertical-align: -2px; }

/* Trạng thái Đang tạo — thay chỗ nút Tạo */
.ai-busy { display: inline-flex; align-items: center; gap: var(--space-2); flex: none;
  font-size: var(--fs-13); font-weight: var(--font-medium); color: var(--primary-base); padding: 0 var(--space-1); }
.ai-busy hrm-spin { display: inline-flex; }

/* ── Chip gợi ý: bóng đèn GHIM đầu hàng · dải chip 1 HÀNG cuộn ngang (không rớt hàng) ── */
.ai-chips { display: flex; align-items: center; gap: 6px; flex-wrap: nowrap; min-width: 0; }
.ai-bulb { color: var(--text-soft); flex: none; }
/* Dải cuộn: chip flex:none (không co) · scrollbar mảnh theo token */
.ai-chips-scroll { flex: 1; min-width: 0; display: flex; align-items: center; gap: 6px;
  overflow-x: auto; overflow-y: hidden; scrollbar-width: thin;
  scrollbar-color: var(--border-soft) transparent; }
.ai-chips-scroll::-webkit-scrollbar { height: 4px; }
.ai-chips-scroll::-webkit-scrollbar-track { background: transparent; }
.ai-chips-scroll::-webkit-scrollbar-thumb { background: var(--border-soft); border-radius: var(--radius-full); }
.ai-chip { flex: none; white-space: nowrap; border: 1px solid var(--border-sub); border-radius: var(--radius-full);
  background: var(--bg-surface-subtle); color: var(--text-body); font-family: inherit;
  font-size: var(--fs-12); padding: 4px 11px; text-align: left; }
.ai-chip:hover { border-color: var(--primary-border); color: var(--primary-base); background: var(--primary-bg-subtle); }
.ai-chip:disabled { color: var(--text-disabled); background: var(--bg-surface-subtle); cursor: not-allowed; }
.ai-chip:disabled:hover { border-color: var(--border-sub); }

/* ── Dải kết quả AI ── */
.ai-res { background: var(--primary-bg-subtle); border-radius: var(--radius-md); padding: var(--space-2) var(--space-2-5); }
.ai-res-main { display: flex; align-items: center; gap: var(--space-2); }
.ai-res-main .ai-spark { align-self: flex-start; margin-top: 2px; }
.ai-res-t { flex: 1; min-width: 0; font-size: var(--fs-13); color: var(--text-strong); line-height: 1.5; }
.ai-res-t b { font-weight: var(--font-semibold); }
.ai-undo { flex: none; display: inline-flex; align-items: center; gap: 4px; border: none; background: transparent;
  font-family: inherit; font-size: var(--fs-12); font-weight: var(--font-medium); color: var(--primary-base); padding: 2px 4px; }
.ai-undo:hover { text-decoration: underline; }
.ai-res-sub { font-size: var(--fs-11); color: var(--text-soft); margin-top: 4px; padding-left: 23px; }
  