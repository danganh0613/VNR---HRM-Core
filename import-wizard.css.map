
    .imw-mask { position: fixed; inset: 0; background: var(--overlay); z-index: var(--z-modal); }
    .imw-dialog { position: fixed; z-index: calc(var(--z-modal) + 1); top: 50%; left: 50%; transform: translate(-50%, -50%);
      width: min(1280px, 96vw); height: min(860px, 94vh); display: flex; flex-direction: column;
      background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-xl);
      box-shadow: var(--shadow-regular-lg); overflow: hidden; }

    /* Header */
    .imw-head { flex: none; display: flex; align-items: center; justify-content: space-between;
      gap: var(--space-3); padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border-soft); }
    .imw-head-l { display: flex; align-items: center; gap: var(--space-2); min-width: 0; }
    .imw-head-ic { display: grid; place-items: center; width: 32px; height: 32px; flex: none;
      border-radius: var(--radius-md); background: var(--primary-bg-subtle); color: var(--primary-base); }
    .imw-title { font-size: var(--fs-16, 16px); font-weight: var(--font-semibold, 600); color: var(--text-strong); }
    .imw-head-r { display: flex; align-items: center; gap: var(--space-1); }
    .imw-x { display: grid; place-items: center; width: 30px; height: 30px; border: 0; background: transparent;
      border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub); }
    .imw-x:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }

    /* Stepper */
    .imw-steps { flex: none; padding: var(--space-3) var(--space-6); border-bottom: 1px solid var(--border-soft); }

    /* Body — step tự dựng card trên nền canvas; KHÔNG cho dialog scroll ngang */
    .imw-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden;
      padding: var(--space-5) var(--space-6); background: var(--bg-canvas); }

    /* Footer */
    .imw-foot { flex: none; display: flex; align-items: center; gap: var(--space-2);
      padding: var(--space-3) var(--space-4); border-top: 1px solid var(--border-soft);
      background: var(--bg-surface); }
    .imw-foot-r { display: flex; align-items: center; gap: var(--space-2); margin-inline-start: auto; }
    .imw-foot-r hrm-button { font-variant-numeric: tabular-nums; }
  