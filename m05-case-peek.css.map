
    :host { display: flex; flex-direction: column; gap: 14px; font-size: var(--fs-13); }
    .pk__head { display: flex; flex-direction: column; gap: 5px; }
    .pk__tags { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .pk__desc { margin: 0; font-weight: 600; color: var(--text-strong); }
    .pk__sub { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .pk__sec { display: flex; flex-direction: column; gap: 6px; padding-top: 10px; border-top: 1px solid var(--border-soft); }
    .pk__mocs { display: flex; gap: 12px; flex-wrap: wrap; font-size: var(--fs-12); color: var(--text-sub); }
    .pk__mocs b { color: var(--text-strong); }
    .pk__money { display: flex; align-items: center; gap: 8px; }
    .pk__num { font-size: var(--fs-18); font-weight: 700; color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .pk__muted { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .pk__ck { display: flex; gap: 7px; align-items: baseline; font-size: var(--fs-12); color: var(--text-body); }
    .pk__ck b { color: var(--warning-text); }
    .pk__ck-x { color: var(--error-base); font-weight: 700; }
    .pk__deep {
      margin-top: 2px; display: inline-flex; align-items: center; justify-content: center; gap: 7px;
      border: 0; border-radius: var(--radius-md); background: var(--primary-base); color: var(--static-white, #fff);
      font: inherit; font-size: var(--fs-13); font-weight: 600; padding: 8px 14px; cursor: pointer;
    }
    .pk__deep:hover { opacity: .92; }
    .pk__deep-b {
      background: color-mix(in srgb, var(--static-white, #fff) 22%, transparent);
      border-radius: var(--radius-sm); padding: 0 7px; font-size: var(--fs-12);
    }
  