
.hrm-column-inspector { display: block; background: var(--bg-surface); font-family: var(--font-sans); }

.ci-empty { padding: var(--space-6, 24px) var(--space-4, 16px); text-align: center;
  font-size: var(--fs-13, 13px); color: var(--text-soft); }

.ci { display: flex; flex-direction: column; padding: var(--space-4, 16px); }

.ci-head { display: flex; align-items: flex-start; gap: var(--space-2, 8px); padding-bottom: var(--space-3, 12px);
  border-bottom: 1px solid var(--border-soft); }
.ci-head-main { flex: 1; min-width: 0; }
.ci-name { font-size: var(--fs-15, 15px); font-weight: var(--font-semibold, 600); color: var(--text-strong);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ci-type { margin-top: 2px; font-size: var(--fs-12, 12px); color: var(--text-sub); }
.ci-name-inp { width: 100%; height: 30px; padding: 0 8px; border: 1px solid var(--primary-base);
  border-radius: var(--radius-sm, 6px); background: var(--bg-surface); color: var(--text-strong);
  font: inherit; font-size: var(--fs-15, 15px); font-weight: var(--font-semibold, 600); }
.ci-name-inp:focus-visible { outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: 1px; }
.ci-pen { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border: 0; background: transparent;
  border-radius: var(--radius-md, 8px); color: var(--text-soft); cursor: pointer; }
.ci-pen:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }

.ci-sec { margin: var(--space-4, 16px) 0 var(--space-2, 8px); font-size: var(--fs-11, 11px);
  font-weight: var(--font-semibold, 600); letter-spacing: .04em; text-transform: uppercase; color: var(--text-soft); }

.ci-row { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-3, 12px);
  min-height: 36px; padding: var(--space-1, 4px) 0; }
.ci-lb { flex: none; padding-top: 8px; font-size: var(--fs-13, 13px); color: var(--text-sub); }
.ci-ctl { flex: 0 0 auto; }
.ci-ctl-col { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-1, 4px); }
.ci-hint { font-size: var(--fs-11, 11px); color: var(--text-soft); }

/* Select native + chevron overlay */
.ci-sel { position: relative; width: 176px; }
.ci-sel select { width: 100%; height: 34px; padding: 0 30px 0 10px; border: 1px solid var(--border-sub);
  border-radius: var(--radius-md, 8px); background: var(--bg-surface); color: var(--text-body); font: inherit;
  font-size: var(--fs-13, 13px); cursor: pointer; appearance: none; -webkit-appearance: none; }
.ci-sel select:hover { border-color: var(--primary-border, var(--border-sub)); }
.ci-sel select:focus-visible { outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: 1px; border-color: var(--primary-base); }
.ci-sel-ic { position: absolute; inset-inline-end: 8px; top: 50%; transform: translateY(-50%); color: var(--text-soft); pointer-events: none; }

/* Segmented (nút tự dựng) */
.ci-seg { display: inline-flex; border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px); overflow: hidden; }
.ci-seg button { display: inline-flex; align-items: center; height: 32px; padding: 0 10px; border: 0; background: transparent;
  color: var(--text-sub); font: inherit; font-size: var(--fs-13, 13px); cursor: pointer;
  transition: background var(--duration-fast, .15s) var(--ease-out, ease), color var(--duration-fast, .15s) var(--ease-out, ease); }
.ci-seg button + button { border-inline-start: 1px solid var(--border-sub); }
.ci-seg button:hover { color: var(--text-strong); }
.ci-seg button.on { background: var(--primary-bg-subtle); color: var(--primary-base); font-weight: var(--font-medium, 500); }
.ci-seg button:focus-visible { outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: -2px; }

/* Dropdown Định dạng: trigger giống select nhưng list hiện label + sample mờ */
.ci-dd { position: relative; width: 200px; }
.ci-dd-tg { display: flex; align-items: center; gap: var(--space-2, 8px); width: 100%; height: 34px; padding: 0 8px 0 10px;
  border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px); background: var(--bg-surface);
  color: var(--text-body); font: inherit; font-size: var(--fs-13, 13px); cursor: pointer; text-align: start; }
.ci-dd-tg:hover { border-color: var(--primary-border, var(--border-sub)); }
.ci-dd.open .ci-dd-tg, .ci-dd-tg:focus-visible { outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: 1px; border-color: var(--primary-base); }
.ci-dd-lb { flex: none; color: var(--text-body); }
.ci-dd-sample { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: end; color: var(--text-soft); font-size: var(--fs-12, 12px); }
.ci-dd-ic { flex: none; margin-inline-start: auto; color: var(--text-soft); }
.ci-dd.open .ci-dd-ic { color: var(--primary-base); }

.ci-scrim { position: fixed; inset: 0; z-index: 40; border: 0; background: transparent; cursor: default; }
.ci-pop { position: absolute; z-index: 41; top: calc(100% + 4px); inset-inline-end: 0; min-width: 100%; margin: 0; padding: var(--space-1, 4px);
  list-style: none; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px);
  box-shadow: var(--shadow-regular-md, 0 6px 20px rgba(0,0,0,.12)); max-height: 260px; overflow-y: auto; }
.ci-pop li { display: flex; align-items: center; gap: var(--space-3, 12px); min-height: 32px; padding: 0 10px;
  border-radius: var(--radius-sm, 6px); font-size: var(--fs-13, 13px); color: var(--text-body); cursor: pointer; }
.ci-pop li:hover { background: var(--bg-surface-subtle); }
.ci-pop li.sel { background: var(--primary-bg-subtle); color: var(--primary-base); font-weight: var(--font-medium, 500); }
.ci-opt-lb { flex: none; }
.ci-opt-sample { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  text-align: end; color: var(--text-soft); font-size: var(--fs-12, 12px); }
.ci-pop li.sel .ci-opt-sample { color: var(--primary-base); opacity: .7; }
  