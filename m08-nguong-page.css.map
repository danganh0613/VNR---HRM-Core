
    :host { display: flex; flex-direction: column; gap: 10px; }
    .n-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .n-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .n-muted b, .n-lock b { color: var(--text-strong); }
    .n-item { border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); padding: 9px 12px; display: flex; flex-direction: column; gap: 7px; }
    .n-item--thieu { border-color: var(--warning-base, var(--warning-text)); background: var(--warning-bg); }
    .n-item__head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .n-gap { flex: 1; }
    .n-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .n-strong { color: var(--text-strong); font-weight: 500; }
    .n-item__muc { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .n-lock { font-size: var(--fs-12); color: var(--error-text); }
    .n-oq { font-size: var(--fs-11); }
    .n-his { display: flex; flex-direction: column; gap: 3px; border-left: 3px solid var(--border-sub); padding-left: 10px; }
    .n-his__head { font-size: var(--fs-11); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--text-sub); }
    .n-his__row { font-size: var(--fs-12); color: var(--text-body); }
    .n-his__row b { color: var(--text-strong); }
    .n-note { margin: 0; font-size: var(--fs-11); color: var(--text-soft); }
  