
    /* ─── Dock 300px sticky — cột phải của drawer, tóm tắt luôn trong tầm mắt ─── */
    :host{display:flex;flex-direction:column;gap:var(--space-3);width:300px;flex:none;
      border-left:1px solid var(--border-sub);background:var(--bg-surface);
      padding:var(--space-4);overflow-y:auto;position:sticky;top:0;max-height:100%;min-height:0}
    .num{font-family:var(--font-mono);font-variant-numeric:tabular-nums}

    /* Nguồn cấu hình */
    .dk-src{font-size:var(--fs-12);color:var(--text-sub);line-height:1.5;flex:none}
    .dk-src b{display:block;font-size:var(--fs-13);color:var(--text-strong);font-weight:var(--font-medium)}
    .dk-src .pin{color:var(--warning-base);font-size:var(--fs-11)}

    /* Dirty-chip — amber CHỈ cho cảnh báo (AP-07), link hành động ngay trong chip */
    .dirty{display:flex;align-items:center;gap:var(--space-1);flex-wrap:wrap;flex:none;
      font-size:var(--fs-11);font-weight:var(--font-medium);
      background:var(--warning-bg);color:var(--warning-text);border:1px solid var(--warning-border);
      padding:var(--space-1) var(--space-3);border-radius:var(--radius-full)}
    .dirty .dot{width:6px;height:6px;border-radius:var(--radius-full);background:var(--warning-base)}
    .dirty .sep{color:var(--warning-border)}
    .dirty button{border:none;background:transparent;color:inherit;font-weight:var(--font-semibold);
      font-size:var(--fs-11);text-decoration:underline;cursor:pointer;padding:0}

    /* Chip mời lưu — trung tính (amber CHỈ cho cảnh báo, AP-07) */
    .savehint{display:inline-flex;align-items:center;gap:4px;flex:none;align-self:flex-start;
      font-size:var(--fs-11);color:var(--text-sub);background:var(--bg-surface-subtle);
      border:1px solid var(--border-sub);padding:var(--space-1) var(--space-3);border-radius:var(--radius-full)}
    .savehint button{border:none;background:transparent;color:var(--primary-base);
      font-weight:var(--font-semibold);font-size:var(--fs-11);cursor:pointer;padding:0}
    .savehint button:hover{text-decoration:underline}

    /* Khối tóm tắt — bất biến */
    .dk-sum{border:1px solid var(--border-sub);border-radius:var(--radius-lg);overflow:hidden;flex:none}
    .dk-h{font-size:var(--fs-11);letter-spacing:.8px;text-transform:uppercase;font-weight:var(--font-semibold);
      color:var(--text-sub);background:var(--bg-surface-subtle);
      padding:var(--space-2) var(--space-3);border-bottom:1px solid var(--border-soft)}
    .dk-row{display:flex;justify-content:space-between;align-items:baseline;gap:var(--space-2);
      padding:var(--space-2) var(--space-3);font-size:var(--fs-12);color:var(--text-sub);
      border-bottom:1px solid var(--border-soft)}
    .dk-row:last-child{border-bottom:none}
    .dk-row b{color:var(--text-strong);font-weight:var(--font-medium);text-align:right}
    .dk-row .soft{color:var(--text-soft);font-weight:var(--font-regular)}
    .dk-chips{padding:0 var(--space-3) var(--space-2);display:flex;gap:var(--space-1);flex-wrap:wrap}
    .chip{font-size:var(--fs-11);padding:2px 7px;border-radius:var(--radius-sm);
      background:var(--bg-surface-subtle);border:1px solid var(--border-sub);color:var(--text-body)}

    /* Trạng thái lịch — luôn render cả 2 chiều (AP-01) */
    .sdot{display:inline-flex;align-items:center;gap:5px;font-size:var(--fs-11);font-weight:var(--font-medium)}
    .sdot::before{content:'';width:7px;height:7px;border-radius:var(--radius-full)}
    .sdot.act{color:var(--success-text)}
    .sdot.act::before{background:var(--success-base)}
    .sdot.off{color:var(--text-soft)}
    .sdot.off::before{background:var(--text-soft)}

    /* Dock morph đặt lịch — viền primary để mắt biết đang ở mode lịch, không che tóm tắt.
       P2: morph TỰ scroll ở viewport thấp — tóm tắt + CTA luôn trong khung nhìn (bất biến §2). */
    .sched{border:1px solid var(--primary-border);border-radius:var(--radius-lg);
      background:var(--primary-bg-subtle);padding:var(--space-3);flex:none;
      max-height:45vh;overflow-y:auto}
    .sched-t{font-size:var(--fs-12);font-weight:var(--font-semibold);color:var(--primary-base);
      display:flex;gap:var(--space-1);align-items:center;margin-bottom:var(--space-2)}
    .sched hrm-input{margin-top:var(--space-1)}

    /* Field label dùng chung (morph + modal) */
    .f-l{font-size:var(--fs-11);color:var(--text-sub);font-weight:var(--font-medium);
      margin:var(--space-2) 0 var(--space-1)}
    .f-l .opt{color:var(--text-soft);font-weight:var(--font-regular)}
    .req{color:var(--error-base)}
    /* Nhãn có nút gợi ý AI — label trái, nút phải cùng hàng */
    .f-l-ai{display:flex;align-items:center;justify-content:space-between;gap:var(--space-2)}
    /* Nút "✨ Gợi ý" — accent AI = primary (KHÔNG amber); chỉ điền, không tự Xuất */
    .ai-hint{display:inline-flex;align-items:center;gap:3px;cursor:pointer;
      border:1px solid var(--primary-border);background:var(--primary-bg-subtle);color:var(--primary-base);
      font-size:var(--fs-11);font-weight:var(--font-medium);line-height:1.6;
      padding:1px var(--space-2);border-radius:var(--radius-full)}
    .ai-hint:hover{background:var(--primary-bg-soft)}
    .f-2{display:flex;gap:var(--space-2)}
    .f-2>div{flex:1;min-width:0}
    .f-2>.wide{flex:1.4}
    .rcpt{display:flex;gap:var(--space-1);flex-wrap:wrap;margin-bottom:var(--space-1)}
    .f-ck{margin-top:var(--space-2);font-size:var(--fs-12);color:var(--text-body)}

    .dk-alert{flex:none}

    /* CTA — margin-top:auto neo đáy dock; primary duy nhất (AP-06) */
    .dk-cta{margin-top:auto;display:flex;flex-direction:column;gap:var(--space-2);
      padding-top:var(--space-2);flex:none}
    .dk-note{font-size:var(--fs-11);color:var(--text-soft);text-align:center;line-height:1.5}

    /* Modal overlay tự chứa — nền token --overlay, 1 lớp duy nhất trên drawer (P4) */
    .mback{position:fixed;inset:0;background:var(--overlay);display:flex;align-items:center;
      justify-content:center;z-index:1100}
    .modal{background:var(--bg-surface);border-radius:var(--radius-3xl);box-shadow:var(--shadow-regular-lg);
      width:460px;max-width:92vw;max-height:92vh;overflow-y:auto}
    .modal.w560{width:560px}
    .mo-h{display:flex;align-items:center;gap:var(--space-3);padding:var(--space-5) var(--space-5) 0}
    .mo-h h4{flex:1;font-size:var(--fs-16);font-weight:var(--font-semibold);color:var(--text-strong);margin:0}
    .mo-ic{width:32px;height:32px;border-radius:var(--radius-md);background:var(--primary-bg-subtle);
      color:var(--primary-base);display:flex;align-items:center;justify-content:center;flex:none}
    .mo-x{width:30px;height:30px;border:none;background:transparent;color:var(--text-sub);cursor:pointer;
      border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center}
    .mo-x:hover{background:var(--bg-surface-subtle)}
    .mo-sub{padding:2px var(--space-5) 0;font-size:var(--fs-12);color:var(--text-sub)}
    .mo-b{padding:var(--space-3) var(--space-5) var(--space-1)}
    .mo-f{display:flex;gap:var(--space-3);justify-content:flex-end;padding:var(--space-4) var(--space-5) var(--space-5)}
    .mo-note{margin-top:var(--space-3);border:1px solid var(--border-soft);border-radius:var(--radius-md);
      background:var(--bg-surface-subtle);padding:var(--space-2) var(--space-3);
      font-size:var(--fs-11);color:var(--text-sub);line-height:1.6}
    .mo-note b{color:var(--text-strong)}
  