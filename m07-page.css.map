
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }
    /* ds-demo global zero padding-ngang nz-page-header → set lại chuẩn đối xứng (giống M01/M02). */
    :host ::ng-deep .m07-ph .ant-page-header { padding: 16px 24px; }
    .m07-bar { flex: none; padding: 0 24px 12px; }
    .m07-body { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; padding: 0 24px 16px; overflow: auto; }
  