
    :host { display: flex; flex-direction: column; min-height: 0; overflow: auto; }
    .ex { display: flex; flex-direction: column; gap: 10px; padding-bottom: 8px; }
    .ex-row, .ex-card {
      border: 1px solid var(--border-sub); border-radius: var(--radius-md);
      background: var(--bg-surface); padding: 8px 12px; font-size: var(--fs-13);
    }
    .ex-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .ex-card { display: flex; flex-direction: column; gap: 6px; }
    .ex-card__head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .ex-card__actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .ex-mono { border: 0; background: none; padding: 0; cursor: pointer; font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 600; color: var(--primary-base); }
    span.ex-mono { cursor: default; color: var(--text-strong); }
    .ex-main { color: var(--text-body); font-weight: 500; }
    .ex-main b, .ex-muted b { color: var(--text-strong); }
    .ex-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .ex-gap { flex: 1; }
    .ex-link { border: 0; background: none; padding: 0; cursor: pointer; font: inherit; font-size: var(--fs-12); font-weight: 600; color: var(--primary-base); }
    .ex-vc { display: inline-flex; align-items: baseline; gap: 5px; }
    .ex-cap { font-size: var(--fs-11); font-weight: 700; color: var(--text-sub); }
    .ex-empty { margin: 0; font-size: var(--fs-12); color: var(--text-sub); padding: 12px 2px; }
    .ex-note { margin: 0; font-size: var(--fs-11); color: var(--text-soft); }
    .ex-note b { color: var(--text-sub); }
    .ex-hist { display: flex; flex-direction: column; gap: 2px; }
    .ex-hist__item { font-size: var(--fs-12); color: var(--text-sub); }
    .ex-trust {
      font-size: var(--fs-11); font-weight: 500; color: var(--warning-text); background: var(--warning-bg);
      border-radius: var(--radius-full); padding: 1px 9px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;
    }
    .ex-form { display: flex; flex-direction: column; gap: 8px; }
    .ex-err { font-size: var(--fs-12); color: var(--error-text); }
  