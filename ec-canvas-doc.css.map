
    /* Spacing = token --space-* (bất biến DS #3, đồng bộ ec-dock). Kích thước cấu trúc (min-height/width
       trang giấy, ring focus) giữ px vì không có token tương ứng. */
    :host { display: flex; flex-direction: column; gap: var(--space-2-5); flex: 1; min-height: 0; }

    .tm-row { display: flex; gap: var(--space-2-5); align-items: center; }
    .grow { flex: 1; min-width: 0; }
    .push { margin-left: auto; }

    /* Toggle WORD/PDF — 2 nút liền khối, active = nền primary (mockup .wpseg) */
    .wpseg { display: inline-flex; border: 1px solid var(--border-sub); border-radius: var(--radius-md); overflow: hidden; flex: none; }
    .wpseg .m {
      font-size: var(--fs-11); font-weight: 600; padding: var(--space-2) var(--space-3-5); border: none;
      background: var(--bg-surface); color: var(--text-sub); cursor: pointer;
    }
    .wpseg .m.on { background: var(--primary-base); color: var(--text-on-primary); }

    /* Tabs Soạn thảo/Xem trước — pill trên nền subtle (mockup .edtabs) */
    .edtabs { display: inline-flex; gap: var(--space-0-5); background: var(--bg-surface-subtle); border-radius: var(--radius-md); padding: var(--space-0-5); width: fit-content; }
    .edtabs .m {
      font-size: var(--fs-12); font-weight: 500; color: var(--text-sub); padding: var(--space-1-5) var(--space-3-5);
      border-radius: var(--radius-sm); border: none; background: transparent; cursor: pointer;
      display: inline-flex; gap: var(--space-1-5); align-items: center;
    }
    .edtabs .m.on { background: var(--bg-surface); color: var(--primary-base); box-shadow: var(--shadow-regular-xs); }

    /* Editor mono — popover định vị theo wrapper */
    .ed-wrap { position: relative; flex: 1; min-height: 0; display: flex; }
    .editor {
      flex: 1; width: 100%; min-height: 280px; resize: none; outline: none;
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface);
      padding: var(--space-4); font-family: var(--font-mono); font-size: var(--fs-13); line-height: 2; color: var(--text-strong);
    }
    .editor:focus { border-color: var(--primary-base); box-shadow: 0 0 0 3px var(--primary-focus-ring); }
    .ed-hint { font-size: var(--fs-11); color: var(--text-soft); }

    /* Overlay "AI đang soạn" — frosted veil token-only (color-mix bg-surface + blur nhẹ), editor còn thấy lờ mờ. */
    .ai-overlay {
      position: absolute; inset: 0; z-index: 23;
      display: flex; align-items: center; justify-content: center;
      border-radius: var(--radius-lg);
      background: color-mix(in srgb, var(--bg-surface) 66%, transparent);
      backdrop-filter: blur(2px);
    }
    .ai-badge { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--fs-13); font-weight: 600; color: var(--primary-base); }
    /* Hint sau khi soạn xong — nhắc đây chỉ là NHÁP AI (accent primary, không amber). */
    .ai-hint { display: inline-flex; align-items: center; gap: var(--space-1-5); font-size: var(--fs-11); font-weight: 500; color: var(--primary-base); }

    /* Field picker popover (mockup .fpick) */
    .fp-backdrop { position: fixed; inset: 0; z-index: 24; }
    .fpick {
      position: absolute; top: var(--space-2); right: var(--space-2-5); width: 250px; z-index: 25; overflow: hidden;
      background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: var(--radius-lg); box-shadow: var(--shadow-regular-md);
    }
    .fp-s { margin: var(--space-2) var(--space-2) 0; }
    .fp-list { max-height: 300px; overflow: auto; padding-bottom: var(--space-2); }
    .fg {
      font-size: var(--fs-11); letter-spacing: .8px; text-transform: uppercase; font-weight: 600;
      color: var(--text-soft); padding: var(--space-2) var(--space-3) var(--space-0-5);
    }
    .fi {
      display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); width: 100%;
      font-size: var(--fs-12); color: var(--text-body); padding: var(--space-1-5) var(--space-3);
      border: none; background: transparent; cursor: pointer; text-align: left;
    }
    .fi:hover { background: var(--primary-bg-subtle); color: var(--primary-base); }
    .fi code { font-family: var(--font-mono); font-size: var(--fs-11); color: var(--text-soft); }
    .fi:hover code { color: var(--primary-base); }
    .fp-empty { padding: var(--space-2-5) var(--space-3); font-size: var(--fs-12); color: var(--text-soft); }

    /* Hàng điều hướng preview */
    .pv-lb { font-size: var(--fs-12); color: var(--text-sub); flex: none; }
    .pv-sel { width: 240px; flex: none; }
    .pv-nav { display: flex; gap: var(--space-1); flex: none; }

    /* Trang giấy trắng (mockup .docprev/.page) */
    .docprev {
      flex: 1; min-height: 0; overflow: auto; padding: var(--space-4);
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface-subtle);
    }
    .page {
      max-width: 560px; margin: 0 auto; padding: var(--space-8) var(--space-10); min-height: 420px;
      background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: var(--radius-sm); box-shadow: var(--shadow-regular-sm);
    }
    .page h5 { font-size: var(--fs-15); letter-spacing: .6px; text-align: center; margin: 0 0 var(--space-6); font-weight: 700; color: var(--text-strong); }
    .pr { display: flex; font-size: var(--fs-13); line-height: 2.1; }
    .pr .k { width: 150px; flex: none; color: var(--text-sub); }
    .pr .v { color: var(--text-strong); font-weight: 500; }
    .num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
    .pt { font-size: var(--fs-13); line-height: 2.1; color: var(--text-strong); margin: 0; }
    .pb { height: var(--space-3); }
  