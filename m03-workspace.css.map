
    :host { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
    tabler-icon { display: inline-flex; align-items: center; flex: none; }
    .ws-gap { flex: 1; }
    .ws-sep { color: var(--text-soft); }
    .ws-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .ws-num { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--text-strong); }

    /* A-07 chip (nhỏ, đầu màn) */
    .ws-a07row { display: flex; }
    .ws-a07 { display: inline-flex; align-items: center; gap: 5px; font-size: var(--fs-11); font-weight: 500;
      color: var(--warning-text); background: var(--warning-bg); border: 1px dashed var(--warning-base, var(--warning-text));
      border-radius: var(--radius-full); padding: 1px 9px; cursor: help; }

    /* Header ① — tiêu đề + Kỳ selector | cập nhật lúc + nút */
    .ws-hdr { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .ws-hdr__left { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .ws-hdr__title { font-size: var(--fs-16); font-weight: 700; color: var(--text-strong); }
    .ws-hdr__ky { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-13); color: var(--text-sub); }
    .ws-hdr__kysel { width: 148px; }
    .ws-hdr__right { display: flex; align-items: center; gap: 10px; margin-left: auto; }
    .ws-hdr__at { font-size: var(--fs-12); color: var(--text-sub); }
    .ws-hdr__at b { color: var(--text-body); font-variant-numeric: tabular-nums; }

    /* Header ② — segmented loại kỳ + cảnh báo */
    .ws-subtabs { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .ws-warnpill { display: inline-flex; align-items: center; gap: 4px; font-size: var(--fs-12); font-weight: 600;
      color: var(--warning-text); background: var(--warning-bg); border-radius: var(--radius-full); padding: 1px 10px; }
    .ws-okpill { font-size: var(--fs-12); color: var(--success-text); }

    /* Header ③ — TÓM TẮT 1 dòng */
    .ws-tomtat { display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      border: 1px solid var(--border-soft); border-radius: var(--radius-md); background: var(--bg-surface-subtle); padding: 8px 12px; }
    .ws-tomtat__lb { font-size: var(--fs-11); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--text-soft); }
    .ws-tomtat__body { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-13); color: var(--text-body); }
    .ws-tomtat__body b { color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .ws-pending2 { color: var(--text-sub) !important; font-style: italic; font-weight: 500 !important; }
    .ws-tomtat__note { font-size: var(--fs-11); color: var(--text-soft); margin-left: auto; }

    /* Chọn tất cả */
    .ws-selall { display: flex; align-items: center; gap: 10px; padding: 2px 2px 0; }

    /* Lưới gom nhóm — 1 vùng cuộn ngang chung */
    .ws-scroll { overflow-x: auto; }
    .ws-groups { display: flex; flex-direction: column; gap: 12px; }
    /* Vùng cuộn chung: TẮT cuộn ngang nội bộ mỗi hrm-grid → 6 cột thẳng hàng giữa các nhóm. */
    .ws-scroll ::ng-deep .ant-table-content, .ws-scroll ::ng-deep .ant-table-body { overflow-x: visible !important; }

    .ws-grp { display: flex; flex-direction: column; gap: 6px; }
    .ws-grp__head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; width: 100%; text-align: left;
      border: 0; background: none; font: inherit; cursor: pointer; padding: 3px 2px 6px; border-bottom: 1px solid var(--border-soft); }
    .ws-grp__chev { color: var(--text-soft); }
    .ws-dot { flex: none; width: 10px; height: 10px; border-radius: var(--radius-full); background: var(--text-soft); }
    .ws-dot[data-tone='success'] { background: var(--success-base); }
    .ws-dot[data-tone='error'] { background: var(--error-base); }
    .ws-dot[data-tone='info'] { background: var(--info-text, var(--primary-base)); }
    .ws-dot[data-tone='neutral'] { background: var(--text-soft); }
    .ws-grp__name { font-size: var(--fs-13); font-weight: 700; text-transform: uppercase; letter-spacing: .02em; color: var(--text-strong); }
    .ws-grp__count { font-size: var(--fs-12); color: var(--text-sub); font-variant-numeric: tabular-nums; }
    .ws-grp__ma { font-size: var(--fs-12); font-weight: 700; color: var(--primary-base); background: var(--primary-bg-subtle); border-radius: var(--radius-sm); padding: 0 7px; }
    .ws-grp__ref { font-size: var(--fs-11); color: var(--text-soft); }
    .ws-grp__sum { font-size: var(--fs-12); color: var(--text-body); font-weight: 500; margin-left: auto; }
    .ws-empty { margin: 6px 0; font-size: var(--fs-12); color: var(--text-soft); }

    /* Cell nội dung */
    .ws-nld { display: flex; flex-direction: column; gap: 1px; min-width: 0; align-items: flex-start; }
    .ws-nld--right { align-items: flex-end; }
    .ws-nld__name { color: var(--text-strong); font-weight: 500; }
    .ws-warn { display: inline-flex; align-items: center; gap: 3px; font-size: var(--fs-11); color: var(--warning-text); font-weight: 500; }
    .ws-cd { font-size: var(--fs-11); color: var(--text-soft); background: var(--bg-surface-subtle); border-radius: var(--radius-sm); padding: 0 6px; }
    .ws-quy { font-size: var(--fs-12); color: var(--text-body); }
    .ws-quy__mau { font-size: var(--fs-10); color: var(--info-text); background: var(--info-bg); border-radius: var(--radius-sm); padding: 0 5px; }
    .ws-pending { font-size: var(--fs-12); color: var(--text-sub); font-style: italic; }

    /* Thanh đáy + dry-run */
    .ws-bottom { position: sticky; bottom: 0; z-index: 4; display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface);
      box-shadow: var(--shadow-regular-sm); padding: 10px 14px; }
    .ws-bottom__count { font-size: var(--fs-13); color: var(--text-sub); }
    .ws-bottom__count b { color: var(--text-strong); font-weight: 600; }
    .ws-bottom__dry { font-size: var(--fs-13); color: var(--text-sub); display: inline-flex; align-items: center; gap: 4px; }
    .ws-ok { color: var(--success-base); }
    .ws-bad { color: var(--error-base); }
    .ws-why-btn { display: inline-flex; align-items: center; gap: 3px; border: 0; background: none; padding: 0 0 0 4px; cursor: pointer; font: inherit;
      font-size: var(--fs-12); font-weight: 600; color: var(--primary-base); }
    .ws-lap { display: flex; align-items: center; gap: 10px; }
    .ws-lap__reason { font-size: var(--fs-12); color: var(--warning-text); max-width: 320px; }
    .ws-lap__hint { font-size: var(--fs-12); color: var(--text-sub); }
    .ws-why { display: flex; flex-direction: column; gap: 6px; border: 1px solid var(--border-soft); border-radius: var(--radius-md);
      background: var(--bg-surface-subtle); padding: 10px 12px; }
    .ws-why__row { display: flex; align-items: baseline; gap: 8px; font-size: var(--fs-12); color: var(--text-sub); }
    .ws-why__n { flex: none; min-width: 20px; text-align: center; font-weight: 600; color: var(--error-text);
      background: var(--error-bg); border-radius: var(--radius-full); padding: 0 6px; }

    /* Modal Lập tờ khai — chooser lô + tóm tắt */
    .ws-lapm { display: flex; flex-direction: column; gap: 12px; }
    .ws-lapm__q { margin: 0; font-size: var(--fs-13); color: var(--text-body); }
    .ws-lapm__q b { font-variant-numeric: tabular-nums; }
    .ws-lapm__sum { font-size: var(--fs-13); color: var(--text-sub); display: inline-flex; align-items: center; gap: 6px;
      border: 1px solid var(--border-soft); border-radius: var(--radius-md); background: var(--bg-surface-subtle); padding: 8px 12px; }
    .ws-lapm__note { margin: 0; font-size: var(--fs-11); color: var(--text-soft); }
  