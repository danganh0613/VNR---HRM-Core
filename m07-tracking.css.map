
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }

    .tr-banner {
      flex: none; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      margin: 10px 20px 0; padding: 7px 12px;
      background: var(--warning-bg); border: 1px solid var(--warning-base, var(--warning-text));
      border-radius: var(--radius-md);
    }
    .tr-banner__chip { font-size: var(--fs-12); font-weight: 700; color: var(--warning-text); }
    .tr-banner__sub { font-size: var(--fs-11); color: var(--text-sub); }

    .tr-filters { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .tr-filters__kw { display: inline-block; width: 280px; }
    .tr-mask {
      display: inline-flex; align-items: center; gap: 5px; cursor: pointer; font: inherit;
      font-size: var(--fs-12); font-weight: 500; color: var(--text-sub);
      background: var(--bg-surface-subtle); border: 1px solid var(--border-sub); border-radius: var(--radius-full); padding: 2px 10px;
    }
    .tr-mask:hover { color: var(--text-strong); border-color: var(--border-strong, var(--border-sub)); }
    .tr-legend { font-size: var(--fs-11); color: var(--text-soft); }
    .tr-legend b { color: var(--text-sub); font-weight: 600; }

    .tr-split { flex: 1 1 auto; min-height: 480px; display: flex; gap: 12px; align-items: stretch; }
    .tr-main { flex: 1 1 auto; min-width: 0; overflow: auto; display: flex; flex-direction: column; gap: 14px; }
    .tr-empty { padding: 40px 0; display: flex; justify-content: center; }

    .tr-stack { display: flex; flex-direction: column; gap: 2px; align-items: flex-start; min-width: 0; }
    .tr-stack--end { align-items: flex-end; }
    .tr-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .tr-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .tr-num { font-weight: 600; color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .tr-warn { font-size: var(--fs-11); font-weight: 600; color: var(--warning-text); }
    .tr-danger { font-size: var(--fs-11); font-weight: 600; color: var(--error-text); }
    .tr-diff { font-size: var(--fs-11); font-weight: 700; font-variant-numeric: tabular-nums; }
    .tr-diff[data-tone='up'] { color: var(--error-base); }
    .tr-diff[data-tone='down'] { color: var(--success-base); }
    .tr-diff[data-tone='zero'] { color: var(--text-sub); }

    .tr-bulk-sel { display: inline-block; width: 300px; }
    .tr-form { display: flex; flex-direction: column; gap: 8px; }
    .tr-err { font-size: var(--fs-12); color: var(--error-text); }
  