
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; padding: 0 20px; gap: 12px; }

    /* ── Card token chung ── */
    .p360-card {
      background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: 12px; padding: 16px;
    }

    /* ── 1 · Breadcrumb ── */
    .p360-crumb { flex: none; display: flex; align-items: center; gap: 8px; padding-top: 12px; font-size: var(--fs-12); }
    .p360-crumb__root {
      display: inline-flex; align-items: center; gap: 5px; cursor: pointer; font: inherit;
      font-size: var(--fs-12); font-weight: 500; color: var(--text-sub);
      background: none; border: 0; padding: 0;
    }
    .p360-crumb__root:hover { color: var(--primary-base); }
    .p360-crumb__sep { color: var(--text-sub); }
    .p360-crumb__cur { color: var(--text-strong); font-weight: 600; }

    /* ── 2 · Page header ── */
    .p360-head { flex: none; display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .p360-head__title { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .p360-h1 { margin: 0; font-size: var(--fs-20, 20px); font-weight: 700; color: var(--text-strong); }
    .p360-sub { margin: 0; font-size: var(--fs-13); color: var(--text-sub); }
    .p360-head__actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .p360-sync { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-12); color: var(--text-sub); }
    .p360-sync__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success-base); flex: none; }

    /* ── 3 · Identity ── */
    .p360-id { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .p360-id__left { display: flex; align-items: center; gap: 14px; min-width: 0; }
    .p360-id__meta { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .p360-id__row1 { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .p360-name { font-size: var(--fs-18, 18px); font-weight: 700; color: var(--text-strong); }
    .p360-id__row2 { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: var(--fs-12); color: var(--text-sub); }
    .p360-chip { display: inline-flex; align-items: center; gap: 4px; }
    .p360-dot { color: var(--border-strong, var(--text-sub)); }
    .p360-id__right { display: flex; align-items: center; gap: 12px; flex: none; }
    .p360-so { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; }
    .p360-so__label { font-size: var(--fs-12); color: var(--text-sub); }
    .p360-so__val { font-family: var(--font-mono, monospace); font-size: var(--fs-14); font-weight: 700; color: var(--text-strong); }
    .p360-more {
      display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px;
      cursor: pointer; color: var(--text-sub); background: none;
      border: 1px solid var(--border-sub); border-radius: var(--radius-md);
    }
    .p360-more:hover { color: var(--primary-base); border-color: var(--primary-base); }
    /* ── 3b · Menu tạo thủ công (§19-20) ── */
    .p360-create { position: relative; display: inline-flex; }
    .p360-menu {
      position: absolute; top: calc(100% + 6px); right: 0; z-index: 20; min-width: 190px;
      display: flex; flex-direction: column; padding: 6px;
      background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: 10px;
      box-shadow: var(--shadow-sm, 0 4px 12px rgba(0, 0, 0, .08));
    }
    .p360-menu__head { font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); padding: 4px 8px 6px; }
    .p360-menu__group { font-size: var(--fs-11, 11px); font-weight: 600; text-transform: uppercase; letter-spacing: .03em; color: var(--text-sub); padding: 6px 8px 2px; }
    .p360-menu__item {
      display: flex; align-items: center; cursor: pointer; font: inherit; text-align: left;
      font-size: var(--fs-13); color: var(--text-strong); background: none; border: 0; padding: 7px 8px; border-radius: 6px;
    }
    .p360-menu__item:hover { background: color-mix(in srgb, var(--primary-base) 8%, transparent); color: var(--primary-base); }

    /* ── 4 · Summary ── */
    .p360-summary { flex: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .p360-sum { display: flex; align-items: center; gap: 12px; }
    .p360-sum--btn { cursor: pointer; text-align: left; font: inherit; }
    .p360-sum--btn:hover { border-color: var(--primary-base); }
    .p360-sum__disc {
      flex: none; width: 44px; height: 44px; border-radius: 50%;
      display: inline-flex; align-items: center; justify-content: center;
      color: var(--tone); background: color-mix(in srgb, var(--tone) 14%, transparent);
    }
    .p360-sum__body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .p360-sum__label { font-size: var(--fs-12); color: var(--text-sub); }
    .p360-sum__value { font-size: var(--fs-20, 20px); font-weight: 700; color: var(--text-strong); line-height: 1.2; }
    .p360-sum__value--sm { font-size: var(--fs-16); }
    .p360-sum__sub { font-size: var(--fs-12); color: var(--text-sub); }
    .p360-sum__up { font-size: var(--fs-11, 11px); font-weight: 600; color: var(--success-base); }
    /* §9,14 chip "sắp thay đổi" (mức đề xuất đang chờ) — KHÔNG ghi đè value hiện tại */
    .p360-sum__pending { display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 1px; }
    .p360-sum__pending-txt { font-size: var(--fs-11, 11px); font-weight: 600; color: var(--warning-base); }
    .p360-sum--btn-on { border-color: var(--primary-base); }
    @media (max-width: 900px) { .p360-summary { grid-template-columns: repeat(2, 1fr); } }

    /* ── 4b · Panel việc cần xử lý (§30-31) ── */
    .p360-tasks { flex: none; display: flex; flex-direction: column; gap: 8px; box-shadow: var(--shadow-sm, 0 4px 12px rgba(0, 0, 0, .08)); }
    .p360-tasks__head { font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); }
    .p360-tasks__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
    .p360-tasks__row { display: flex; align-items: center; gap: 10px; padding: 8px 6px; border-radius: 8px; }
    .p360-tasks__row:hover { background: color-mix(in srgb, var(--text-strong) 5%, transparent); }
    .p360-tasks__dot { flex: none; width: 8px; height: 8px; border-radius: 50%; }
    .p360-tasks__title { font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); min-width: 0; }
    .p360-tasks__due { font-size: var(--fs-12); color: var(--text-sub); }
    .p360-tasks__act {
      margin-left: auto; flex: none; cursor: pointer; font: inherit;
      font-size: var(--fs-12); font-weight: 500; color: var(--primary-base);
      background: none; border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px); padding: 3px 10px;
    }
    .p360-tasks__act:hover { border-color: var(--primary-base); background: color-mix(in srgb, var(--primary-base) 8%, transparent); }
    .p360-tasks__all { align-self: flex-start; cursor: pointer; font: inherit; font-size: var(--fs-12); font-weight: 500; color: var(--primary-base); background: none; border: 0; padding: 2px 0; }
    .p360-tasks__empty { font-size: var(--fs-13); color: var(--text-sub); font-weight: 500; }

    /* ── 5 · Tab strip ── */
    .p360-tabs { flex: none; display: flex; gap: 2px; border-bottom: 1px solid var(--border-sub); overflow-x: auto; }
    .p360-tab {
      position: relative; display: inline-flex; align-items: center; gap: 6px; flex: none;
      border: 0; background: none; cursor: pointer; padding: 8px 12px 10px;
      font: inherit; font-size: var(--fs-13); color: var(--text-sub); white-space: nowrap;
    }
    .p360-tab:hover { color: var(--text-strong); }
    .p360-tab--active { color: var(--primary-base); font-weight: 600; }
    .p360-tab--active::after {
      content: ''; position: absolute; left: 10px; right: 10px; bottom: -1px; height: 2px;
      background: var(--primary-base); border-radius: var(--radius-full);
    }

    /* ── 6 · Body ── */
    .p360-body { flex: 1 1 auto; min-height: 0; overflow: auto; display: flex; flex-direction: column; padding: 4px 0 16px; }
  