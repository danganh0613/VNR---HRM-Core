
:host { display: inline-flex; align-items: center; gap: 8px; }
.tr-val { font-size: var(--fs-14); color: var(--text-strong); font-variant-numeric: tabular-nums; }
.tr-delta { display: inline-flex; align-items: center; gap: 2px; font-size: var(--fs-13); font-weight: 500;
  font-variant-numeric: tabular-nums; }
.tr-delta[data-dir='up']   { color: var(--success-base); }
.tr-delta[data-dir='down'] { color: var(--error-base); }
.tr-delta[data-dir='flat'] { color: var(--text-sub); }
  