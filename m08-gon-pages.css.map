
    :host { display: flex; flex-direction: column; gap: 7px; }
    .o-node { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); padding: 6px 10px; }
    .o-strong { color: var(--text-strong); font-weight: 500; font-size: var(--fs-13); }
    .o-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .o-muted b { color: var(--text-strong); }
    .o-note { margin: 0; font-size: var(--fs-11); color: var(--text-soft); }
  