
    :host { display: flex; flex-direction: column; gap: 10px; max-width: 940px; }
    .ta-docs { display: flex; flex-direction: column; gap: 6px; }
    .ta-doc { display: flex; align-items: center; gap: 12px; border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); padding: 7px 10px; }
    .ta-doc__meta { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }
    .ta-doc__tags { display: flex; gap: 4px; }
    .ta-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .ta-audit-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .ta-gap { flex: 1; }
    .ta-toggle { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-12); color: var(--text-sub); cursor: pointer; }
    .ta-chan { margin: 0; font-size: var(--fs-12); font-weight: 600; color: var(--error-text); }
    .ta-log { display: flex; flex-direction: column; }
    .ta-log__row { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; font-size: var(--fs-12); color: var(--text-body); padding: 4px 0; border-bottom: 1px dashed var(--border-soft); }
    .ta-log__row--denied { color: var(--error-text); }
    .ta-log__who { font-weight: 600; color: var(--text-strong); }
    .ta-log__act { min-width: 0; }
    .ta-diff { font-family: var(--font-mono, monospace); font-size: var(--fs-11, 11px); color: var(--text-sub); }
  