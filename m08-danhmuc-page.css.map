
    :host { display: flex; flex-direction: column; gap: 10px; }
    .c-filters, .c-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .c-kw { display: inline-block; width: 250px; }
    .c-khoa { display: inline-block; width: 220px; }
    .c-tt { display: inline-block; width: 170px; }
    .c-gap { flex: 1; }
    .c-note { font-size: var(--fs-11); color: var(--text-soft); }
    .c-err { font-size: var(--fs-12); color: var(--error-text); font-weight: 500; margin: 0; }
    .c-refs { font-size: var(--fs-12); color: var(--warning-text); }
    .c-empty { padding: 36px 0; display: flex; justify-content: center; }
    .c-form { display: flex; flex-direction: column; gap: 10px; }
    .c-field { display: flex; flex-direction: column; gap: 3px; }
    .c-field__label { display: flex; align-items: center; gap: 6px; font-size: var(--fs-12); font-weight: 600; color: var(--text-sub); }
    .c-form__acts { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .c-ungvien summary { font-size: var(--fs-12); color: var(--text-sub); cursor: pointer; font-weight: 600; }
    .c-uv { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; padding: 5px 0 0 14px; }
    .c-uv__ten { font-size: var(--fs-13); font-weight: 500; color: var(--text-strong); }
  