
    :host { display: flex; flex-direction: column; gap: 12px; }
    .rc-card {
      display: flex; flex-direction: column; gap: 12px;
      background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: 12px; padding: 16px;
    }

    /* Bảng custom (grid) — header + rows, border-bottom mảnh. */
    .rc-scroll { overflow-x: auto; }
    .rc-tbl { min-width: 780px; }
    .rc-head, .rc-row {
      display: grid; grid-template-columns: 140px minmax(0, 1fr) 130px 100px 130px 130px;
      gap: 12px; align-items: center;
    }
    .rc-head { padding: 0 10px 8px; border-bottom: 1px solid var(--border-sub); }
    .rc-th { font-size: var(--fs-12); font-weight: 600; color: var(--text-sub); }
    .rc-row {
      padding: 10px; border-bottom: 1px solid var(--border-soft, var(--border-sub));
      font-size: var(--fs-13); color: var(--text-body); cursor: pointer;
    }
    .rc-row:last-child { border-bottom: 0; }
    .rc-row:hover { background: var(--bg-surface-subtle); }
    .rc-cell { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rc-mono { font-family: var(--font-mono, monospace); font-weight: 700; color: var(--text-strong); }
    .rc-strong { color: var(--text-strong); font-weight: 500; }
    .rc-nums { font-variant-numeric: tabular-nums; }
    .rc-empty { padding: 14px 10px; font-size: var(--fs-13); color: var(--text-sub); }
  