
    :host { display: flex; flex-direction: column; gap: var(--space-3); }
    tabler-icon { display: inline-flex; align-items: center; flex: none; }

    .ld__card { display: flex; flex-direction: column; gap: var(--space-2-5); padding: var(--space-3) var(--space-3-5);
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface); }

    /* header */
    .ld__head { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    :host ::ng-deep .ld__head .ant-tag { margin: 0; }
    .ld__ma { font-family: var(--font-mono, monospace); font-size: var(--fs-13); font-weight: 700; color: var(--text-strong); }
    .ld__ky { font-size: var(--fs-13); color: var(--text-sub); }
    .ld__gap { flex: 1; }
    .ld__cnt { font-size: var(--fs-12); color: var(--text-sub); white-space: nowrap; }
    .ld__a07 { font-size: var(--fs-11); font-weight: 500; color: var(--warning-text); background: var(--warning-bg);
      border: 1px dashed var(--warning-base, var(--warning-text)); border-radius: var(--radius-full); padding: var(--space-0-5) var(--space-2-5); cursor: help; white-space: nowrap; }

    /* dải 6 bước inline */
    .ld__strip { display: flex; align-items: center; gap: var(--space-1-5); flex-wrap: wrap; padding: var(--space-1) 0 var(--space-1-5);
      border-bottom: 1px solid var(--border-soft); }
    .ld__pill { display: inline-flex; align-items: center; gap: var(--space-1-5); padding: var(--space-1) var(--space-2-5); border-radius: var(--radius-full);
      border: 1px solid var(--border-soft); background: var(--bg-surface); }
    .ld__pill-idx { display: grid; place-items: center; width: 18px; height: 18px; border-radius: var(--radius-full);
      font-size: var(--fs-11); font-weight: 700; border: 1.5px solid var(--border-input); color: var(--text-sub); }
    .ld__pill-tx { font-size: var(--fs-12); font-weight: 600; color: var(--text-sub); }
    .ld__pill[data-state='current'] { border-color: var(--primary-base); }
    .ld__pill[data-state='current'] .ld__pill-idx { border-color: var(--primary-base); color: var(--primary-base); }
    .ld__pill[data-state='current'] .ld__pill-tx { color: var(--text-strong); }
    .ld__pill[data-state='done'] .ld__pill-idx { border-color: var(--success-base); color: var(--success-text); background: var(--success-bg); }
    .ld__pill[data-state='done'] .ld__pill-tx { color: var(--text-body); }
    .ld__arrow { color: var(--text-soft); font-size: var(--fs-12); }

    /* mỗi bước = 1 dòng tóm tắt + nút inline + expand */
    .ld__step { display: flex; gap: var(--space-2-5); padding-top: var(--space-2); border-top: 1px solid var(--border-soft); }
    .ld__step:first-of-type { border-top: 0; padding-top: var(--space-0-5); }
    .ld__step-idx { flex: none; width: 22px; height: 22px; display: grid; place-items: center; margin-top: var(--space-0-5);
      border-radius: var(--radius-full); font-size: var(--fs-12); font-weight: 700; border: 1.5px solid var(--border-input); color: var(--text-sub); }
    .ld__step-idx[data-state='current'] { border-color: var(--primary-base); color: var(--primary-base); }
    .ld__step-idx[data-state='done'] { border-color: var(--success-base); color: var(--success-text); background: var(--success-bg); }
    .ld__step-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: var(--space-1-5); }
    .ld__row { display: flex; align-items: center; gap: var(--space-2-5); flex-wrap: wrap; justify-content: space-between; }
    .ld__kq { padding-top: var(--space-0-5); }
    .ld__sum { font-size: var(--fs-13); color: var(--text-body); display: inline-flex; align-items: center; gap: var(--space-1-5); flex-wrap: wrap; }
    .ld__acts { display: flex; align-items: center; gap: var(--space-1-5); flex-wrap: wrap; }
    .ld__sel { display: inline-block; width: 150px; }

    .ld__ok { color: var(--success-text); font-weight: 600; }
    .ld__warn { color: var(--warning-text); font-weight: 600; }
    .ld__err { color: var(--error-text); font-weight: 600; }
    .ld__num { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--text-strong); }
    .ld__muted { font-size: var(--fs-12); color: var(--text-sub); }
    .ld__strong { color: var(--text-strong); font-weight: 500; }
    .ld__hint { margin: 0; font-size: var(--fs-11); color: var(--text-soft); }

    /* ② Xem trước tác động lô (chỉ đọc) */
    .ld__tac { display: flex; flex-direction: column; gap: var(--space-2); padding-top: var(--space-1); }
    .ld__tac-head { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .ld__funds { display: flex; flex-direction: column; border: 1px solid var(--border-soft); border-radius: var(--radius-md); overflow: hidden; }
    .ld__funds-head { display: grid; grid-template-columns: 200px 1fr; gap: var(--space-3); padding: var(--space-1-5) var(--space-3);
      background: var(--bg-surface-subtle); font-size: var(--fs-12); font-weight: 600; color: var(--text-sub); }
    .ld__fund { display: grid; grid-template-columns: 200px 1fr; gap: var(--space-3); align-items: center; padding: var(--space-1-5) var(--space-3); border-top: 1px solid var(--border-soft); }
    .ld__fund-name { font-size: var(--fs-13); color: var(--text-body); font-weight: 500; }
    .ld__warn-line { margin: 0; font-size: var(--fs-12); color: var(--warning-text); font-weight: 500; }
    .ld__block { margin: 0; font-size: var(--fs-12); color: var(--error-text); }
    .ld__link { display: inline-flex; align-items: center; gap: var(--space-1); border: 0; background: none; padding: 0; cursor: pointer;
      font: inherit; font-size: var(--fs-12); font-weight: 600; color: var(--primary-base); }
    .ld__link:hover { text-decoration: underline; }
    .ld__link--err { color: var(--error-text); }
    .ld__gridwrap { overflow-x: auto; }
    .ld__vipham { font-size: var(--fs-12); color: var(--text-body); }
    .ld__stack { display: flex; flex-direction: column; gap: var(--space-0-5); min-width: 0; align-items: flex-start; }

    .ld__evi { display: flex; flex-direction: column; gap: var(--space-1-5); padding: var(--space-2) var(--space-2-5); border: 1px solid var(--border-soft); border-radius: var(--radius-md); }
    .ld__evi-head { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }

    /* ⑤ nhập tay — form nhỏ */
    .ld__manual { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-2-5) var(--space-3);
      border: 1px solid var(--border-soft); border-radius: var(--radius-md); background: var(--bg-surface-subtle); }
    .ld__manual-grid { display: flex; flex-wrap: wrap; gap: var(--space-2-5); }
    .ld__f { display: flex; flex-direction: column; gap: var(--space-1); min-width: 150px; flex: 1 1 150px; }
    .ld__f-wide { flex: 1 1 260px; }
    .ld__flabel { font-size: var(--fs-11); font-weight: 600; color: var(--text-sub); }
    .ld__manual-acts { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }

    /* ⑤ F1 — phân loại lỗi */
    .ld__cls-wrap { display: flex; flex-direction: column; gap: var(--space-2); padding-top: var(--space-1-5); }
    .ld__sim { margin: 0; display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--fs-11); font-style: italic;
      color: var(--warning-text); }
    .ld__cls { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-2) var(--space-2-5);
      border: 1px solid var(--border-soft); border-radius: var(--radius-md); background: var(--bg-surface); }
    .ld__cls-head { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .ld__chips { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .ld__chip { display: inline-flex; align-items: center; gap: var(--space-1-5); padding: var(--space-1) var(--space-3); cursor: pointer; font: inherit;
      font-size: var(--fs-12); font-weight: 600; color: var(--text-sub); background: var(--bg-surface);
      border: 1px solid var(--border-input); border-radius: var(--radius-full); }
    .ld__chip:hover { border-color: var(--primary-base); }
    .ld__chip-dot { width: 8px; height: 8px; border-radius: var(--radius-full); background: var(--text-soft); flex: none; }
    .ld__chip[data-tone='warning'] .ld__chip-dot { background: var(--warning-base); }
    .ld__chip[data-tone='info'] .ld__chip-dot { background: var(--info-base); }
    .ld__chip[data-tone='processing'] .ld__chip-dot { background: var(--primary-base); }
    .ld__chip[data-active='true'] { color: var(--text-on-primary); background: var(--primary-base); border-color: var(--primary-base); }
    .ld__chip[data-active='true'] .ld__chip-dot { background: var(--text-on-primary); }
    /* Chip đề xuất (chưa chốt): viền nét đứt primary — phân biệt với chip đã chốt (filled). */
    .ld__chip[data-goiy='true'] { border-style: dashed; border-color: var(--primary-base); color: var(--primary-base); }
    .ld__chip-hint { font-weight: 500; opacity: 0.85; }
    .ld__dcc { font-size: var(--fs-12); color: var(--text-sub); }
    /* Bảng dẫn nguồn "mình khai ↔ cơ quan ghi" (C1) = hrm-grid compact; cell cờ ✓/⚠ dùng token qua .ld__ok/.ld__warn. */
    .ld__dn-flag { white-space: nowrap; }

    /* ⑥ xử lý trả về */
    .ld__rcard { display: flex; flex-direction: column; gap: var(--space-1-5); padding: var(--space-2) var(--space-2-5);
      border: 1px solid var(--border-soft); border-radius: var(--radius-md); background: var(--bg-surface-subtle); }
    .ld__giaitrinh { display: flex; flex-direction: column; gap: var(--space-1-5); }
    .ld__gt-acts { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .ld__gt-start { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .ld__keepmoc { font-size: var(--fs-11); font-weight: 600; color: var(--success-text); background: var(--success-bg);
      border-radius: var(--radius-full); padding: var(--space-0-5) var(--space-2-5); }
    .ld__giaitrinh-sent { margin: 0; display: inline-flex; align-items: center; gap: var(--space-1-5); font-size: var(--fs-12); color: var(--info-text); }

    .ld__m04 { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; padding-top: var(--space-1-5); border-top: 1px solid var(--border-soft); }
    .ld__adv { display: block; }
    :host ::ng-deep .ld__adv ins-m03-run-zone { display: block; margin-top: var(--space-2); }
  