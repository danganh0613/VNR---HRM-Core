
    :host { display: block; padding: var(--space-6); max-width: 960px; margin-inline: auto; }

    .imc-wrap {
      display: flex; flex-direction: column; gap: var(--space-6);
      margin: 0 auto;
    }
    .imc-wrap--run { max-width: 680px; padding-top: var(--space-8); }

    /* — header — */
    .imc-head {
      display: flex; align-items: flex-start; justify-content: space-between;
      gap: var(--space-4);
    }
    .imc-title {
      margin: 0; color: var(--text-strong);
      font-size: var(--fs-18); font-weight: var(--font-semibold);
    }
    .imc-sub { margin-top: var(--space-1); color: var(--text-sub); font-size: var(--fs-13); }
    .imc-quality {
      display: inline-flex; align-items: center; gap: var(--space-2);
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-full);
      background: var(--success-bg);
      color: var(--success-text);
      font-size: var(--fs-13);
    }
    .imc-quality strong { font-weight: var(--font-semibold); font-variant-numeric: tabular-nums; }

    /* — tone map (alias cục bộ từ token, pattern hrm-shift-cell) — */
    .t-success { --tn: var(--success-base); }
    .t-primary { --tn: var(--primary-base); }
    .t-warning { --tn: var(--warning-base); }
    .t-error   { --tn: var(--error-base); }
    .t-neutral { --tn: var(--text-soft); }

    .imc-disc {
      display: inline-flex; align-items: center; justify-content: center;
      width: 28px; height: 28px; flex: none;
      border-radius: var(--radius-full);
      background: color-mix(in srgb, var(--tn) 12%, transparent);
      color: var(--tn);
    }

    /* — 4 dòng tóm tắt — */
    .imc-summary {
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
      background: var(--bg-surface);
    }
    .imc-sum-row {
      display: flex; align-items: center; gap: var(--space-3);
      padding: var(--space-3) var(--space-4);
    }
    .imc-sum-row + .imc-sum-row { border-top: 1px solid var(--border-soft); }
    .imc-num {
      min-width: 96px; text-align: right;
      color: var(--text-strong);
      font-size: var(--fs-18); font-weight: var(--font-semibold);
      font-variant-numeric: tabular-nums;
    }
    .imc-lbl { color: var(--text-sub); font-size: var(--fs-13); }

    /* — card strategy — */
    .imc-card {
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
      background: var(--bg-surface); padding: var(--space-4);
    }
    .imc-card-title {
      display: flex; align-items: center; gap: var(--space-2);
      margin-bottom: var(--space-3);
      color: var(--text-strong);
      font-size: var(--fs-14); font-weight: var(--font-semibold);
    }

    /* — Đối chiếu dữ liệu hiện có (chuyển từ bước Kiểm tra & sửa) — */
    .imc-recon { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--space-3); }
    .imc-recon-item {
      display: flex; flex-direction: column; gap: var(--space-0-5);
      border: 1px solid var(--border-soft); border-radius: var(--radius-md); padding: var(--space-3);
    }
    .imc-recon-v { font-size: var(--fs-20); font-weight: var(--font-semibold); color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .imc-recon-v[data-tone='success'] { color: var(--success-base); }
    .imc-recon-v[data-tone='info'] { color: var(--info-base); }
    .imc-recon-v[data-tone='warn'] { color: var(--warning-base); }
    .imc-recon-l { font-size: var(--fs-12); color: var(--text-sub); }
    .imc-mode { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-3); }
    .imc-mode-lbl { font-size: var(--fs-13); font-weight: var(--font-medium); color: var(--text-body); flex: none; }

    /* — màn đang import — */
    .imc-processed { color: var(--text-body); font-size: var(--fs-13); }
    .imc-processed strong {
      color: var(--text-strong); font-weight: var(--font-semibold);
      font-variant-numeric: tabular-nums;
    }
    .imc-stats {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: var(--space-3);
    }
    .imc-stat {
      display: flex; align-items: center; gap: var(--space-3);
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
      background: var(--bg-surface); padding: var(--space-4);
    }
    .imc-stat-body { min-width: 0; }
    .imc-stat-num {
      color: var(--text-strong);
      font-size: var(--fs-20); font-weight: var(--font-semibold);
      font-variant-numeric: tabular-nums;
    }
    .imc-note { margin: 0; color: var(--text-sub); font-size: var(--fs-13); }

    .imc-spin { animation: imc-spin 1s linear infinite; }
    @keyframes imc-spin { to { transform: rotate(360deg); } }
  