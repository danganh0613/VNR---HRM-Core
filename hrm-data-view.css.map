
    /* height:100% để view dạng board/gantt lấp đầy vùng chứa (parent cao auto → coi như auto, an toàn). */
    :host { display: block; height: 100%; min-height: 0; }
    .dv-bar { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
    .dv-tb { flex: 1 1 320px; min-width: 0; }
    .dv-actions { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .dv-spacer { flex: 1; }

    /* ── [toolbar] BẬT: PANEL viền chung (nhân bản hrm-list-page) → toolbar DÍNH bảng ── */
    .dv-panel {
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface);
      overflow: hidden; display: flex; flex-direction: column; min-height: 0;
    }
    /* Toolbar attached: gạch dưới ngăn với bảng, KHÔNG margin (dính), padding gọn. */
    .dv-bar--attached { margin-bottom: 0; padding: 8px 12px; border-bottom: 1px solid var(--border-sub); }
    /* Body view — bảng phẳng (panel đã có viền + bo góc) nên bỏ viền/bo/nền riêng của bảng. */
    .dv-view { min-width: 0; min-height: 0; overflow: auto; }
    .dv-view ::ng-deep .ant-table { border: 0; border-radius: 0; background: transparent; }
    /* Thẻ trong panel cần padding để không dán mép. */
    .dv-view > .dv-cards { padding: 12px; }
    /* Strip RỔ NHÓM DỮ LIỆU — dính trên bảng (giữa toolbar và bảng khi [toolbar] bật). */
    .dv-grp { display: block; padding: 0; border-bottom: 1px solid var(--border-sub); }

    /* Kanban/gantt: panel PHẲNG — bỏ khung; toolbar tự là 1 hộp viền riêng, cách board 12px
       (không lồng board trong khung). */
    .dv-panel--flat { border: 0; background: transparent; border-radius: 0; overflow: visible; }
    .dv-panel--flat .dv-bar--attached {
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface);
      margin-bottom: 12px;
    }
    .dv-panel--flat .dv-view { overflow: visible; }

    /* Thanh tab đổi chế độ xem (kiểu ClickUp): icon + nhãn, mục chọn nền nổi. */
    .dv-tabs {
      display: inline-flex; gap: 2px; padding: 3px; flex: none;
      background: var(--bg-surface-subtle); border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
    }
    .dv-tab {
      display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 10px;
      border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer; color: var(--icon-secondary);
      font: inherit; font-size: var(--fs-13); font-weight: 500;
      transition: background var(--duration-fast, .15s) var(--ease-out, ease), color var(--duration-fast, .15s) var(--ease-out, ease);
    }
    .dv-tab:hover { color: var(--text-strong); }
    .dv-tab.is-on { background: var(--bg-surface); color: var(--primary-base); box-shadow: var(--shadow-regular-xs); }
    .dv-tab-t { white-space: nowrap; }

    .dv-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--dv-min, 260px), 1fr)); gap: 12px; }
    .dv-card {
      display: block; width: 100%; text-align: left; padding: 14px;
      background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
      cursor: pointer; font: inherit; color: var(--text-body);
      transition: border-color var(--duration-fast, .15s) var(--ease-out, ease), box-shadow var(--duration-fast, .15s) var(--ease-out, ease);
    }
    .dv-card:hover { border-color: var(--primary-border); box-shadow: var(--shadow-regular-sm); }
    .dv-card:focus-visible { outline: 2px solid var(--primary-focus-ring); outline-offset: 1px; }

    /* Checkbox chọn trên thẻ — góc trên trái, hiện khi rê/đã chọn; thẻ chọn viền primary. */
    .dv-card { position: relative; }
    .dv-check {
      position: absolute; top: 8px; left: 8px; z-index: 2;
      display: grid; place-items: center; width: 22px; height: 22px;
      border-radius: var(--radius-sm); background: var(--bg-surface);
      box-shadow: var(--shadow-regular-xs); cursor: pointer;
      opacity: 0; transition: opacity var(--duration-fast, .15s) var(--ease-out, ease);
    }
    .dv-check input { width: 14px; height: 14px; margin: 0; cursor: pointer; accent-color: var(--primary-base); }
    .dv-card:hover .dv-check, .dv-card.is-sel .dv-check { opacity: 1; }
    .dv-card.is-sel { border-color: var(--primary-base); }
  