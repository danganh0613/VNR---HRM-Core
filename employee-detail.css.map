
    :host { display: block; }
    .ed { display: flex; flex-direction: column; gap: 20px; }
    .ed-hero { display: flex; align-items: center; gap: 14px; }
    .ed-hero-info { flex: 1; min-width: 0; }
    .ed-name { font-size: var(--fs-18); font-weight: 700; color: var(--text-strong); }
    .ed-role { font-size: var(--fs-13); color: var(--text-sub); margin-top: 2px; }
    .ed-kpi-top { display: flex; justify-content: space-between; font-size: var(--fs-13); color: var(--text-sub); margin-bottom: 6px; }
    .ed-kpi-v { font-weight: 700; color: var(--text-strong); }
    .ed-bar { height: 8px; border-radius: var(--radius-full); background: var(--skeleton); overflow: hidden; }
    .ed-bar-fill { display: block; height: 100%; border-radius: var(--radius-full); }
    .ed-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 20px; }
    .ed--full .ed-fields { grid-template-columns: repeat(3, 1fr); }
    .ed-flabel { font-size: var(--fs-12); color: var(--text-soft); margin-bottom: 2px; }
    .ed-fvalue { font-size: var(--fs-14); color: var(--text-body); }
    .ed-blabel { font-size: var(--fs-12); color: var(--text-soft); margin-bottom: 8px; }
    .ed-skills { display: flex; flex-wrap: wrap; gap: 6px; }
  