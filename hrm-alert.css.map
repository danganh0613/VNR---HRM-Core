
:host { display: block; }

/* ── Biến thể soft (toast style) ── */
.hrm-alert-soft {
  display: flex; align-items: flex-start; gap: var(--space-3);
  padding: var(--space-3);
  border-radius: var(--radius-xl);
  border: 1px solid var(--border-sub);
  background: var(--bg-surface-subtle);
}
.ha-ic-box {
  flex: none; width: 40px; height: 40px;
  display: inline-flex; align-items: center; justify-content: center;
  border-radius: var(--radius-md);
  background: var(--bg-surface);
  color: var(--text-sub);
}
.ha-content { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.ha-message { font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); line-height: 1.4; }
.ha-desc {
  font-size: var(--fs-13); color: var(--text-sub); line-height: 1.4;
  /* soft/inline = cảnh báo THƯỜNG TRỰC (vd hộp trong dock, ví dụ styleguide, phụ đề toast)
     → mô tả PHẢI xuống dòng đọc đủ câu, KHÔNG cắt còn 1 dòng + '…'. Nếu ngữ cảnh nào cần
     giới hạn số dòng thì clamp riêng ở outlet đó (vd .hto-card), không áp cho mọi hrm-alert soft. */
  white-space: normal; overflow-wrap: anywhere;
}
.ha-close {
  flex: none; display: inline-flex; align-items: center; justify-content: center;
  padding: 2px; margin: -2px -2px 0 0;
  border: none; background: transparent; cursor: pointer;
  color: var(--text-soft); border-radius: var(--radius-sm);
}
.ha-close:hover { color: var(--text-body); }

/* tone → nền + viền */
.hrm-alert-soft[data-tone='neutral'] { background: var(--bg-surface-subtle); border-color: var(--border-sub); }
.hrm-alert-soft[data-tone='info']    { background: var(--info-bg); border-color: var(--info-border); }
.hrm-alert-soft[data-tone='success'] { background: var(--success-bg); border-color: var(--success-border); }
.hrm-alert-soft[data-tone='warning'] { background: var(--warning-bg); border-color: var(--warning-border); }
.hrm-alert-soft[data-tone='error']   { background: var(--error-bg); border-color: var(--error-border); }

/* tone → màu icon */
.hrm-alert-soft[data-tone='neutral'] .ha-ic-box { color: var(--text-sub); }
.hrm-alert-soft[data-tone='info']    .ha-ic-box { color: var(--info-base); }
.hrm-alert-soft[data-tone='success'] .ha-ic-box { color: var(--success-base); }
.hrm-alert-soft[data-tone='warning'] .ha-ic-box { color: var(--warning-base); }
.hrm-alert-soft[data-tone='error']   .ha-ic-box { color: var(--error-base); }
  