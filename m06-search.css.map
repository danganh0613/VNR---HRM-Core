
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }
    .m06-lp { flex: 1 1 auto; min-height: 0; }
    /* Ẩn thanh chuyển chế độ nội bộ (chỉ có mode table). */
    :host ::ng-deep hrm-data-view .dv-bar { display: none; }
    /* Lưới đơn: mỗi ô 1 dòng — hẹp thì cuộn ngang, không rớt hàng. */
    :host ::ng-deep .m06-dv .ant-table-tbody > tr { cursor: pointer; }

    /* Toolbar TRÁI. */
    .m06-filters { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; min-width: 0; }
    .m06-kw { display: inline-block; width: 300px; }
    .m06-filters ::ng-deep .ant-input-affix-wrapper {
      height: 32px; min-height: 32px; padding-top: 0; padding-bottom: 0; border-radius: var(--radius-md); }
    .m06-filters ::ng-deep .ant-input { min-height: 0; }

    /* Quick-filter chips (toggle) — active = viền + nền primary nhạt + text primary (không solid mạnh). */
    .m06-chips { display: inline-flex; align-items: center; gap: 6px; }
    .m06-chip {
      display: inline-flex; align-items: center; gap: 5px; cursor: pointer; font: inherit;
      font-size: var(--fs-13); font-weight: 500; color: var(--text-body);
      background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-full);
      padding: 4px 12px; height: 32px; white-space: nowrap;
    }
    .m06-chip:hover { border-color: var(--primary-base); color: var(--primary-base); }
    .m06-chip--on { color: var(--primary-base); background: var(--primary-bg-subtle); border-color: var(--primary-base); }
    .m06-chip__n {
      display: inline-grid; place-items: center; min-width: 18px; height: 18px; padding: 0 5px;
      border-radius: var(--radius-full); background: var(--primary-base); color: var(--static-white, #fff);
      font-size: var(--fs-11); font-weight: 600; line-height: 1;
    }
    .m06-chip--on .m06-chip__n { background: var(--primary-base); }

    /* Nút Bộ lọc + badge. */
    .m06-fbtn {
      display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px; cursor: pointer;
      font: inherit; font-size: var(--fs-13); font-weight: 500; color: var(--text-body);
      background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-md);
    }
    .m06-fbtn:hover { border-color: var(--primary-base); color: var(--primary-base); }
    .m06-fbtn--on { border-color: var(--primary-base); color: var(--primary-base); }
    .m06-fbtn__badge {
      display: inline-grid; place-items: center; min-width: 18px; height: 18px; padding: 0 5px; margin-left: 2px;
      border-radius: var(--radius-full); background: var(--primary-base); color: var(--static-white, #fff);
      font-size: var(--fs-11); font-weight: 600; line-height: 1;
    }

    /* Toolbar PHẢI + nút ⋮. */
    .m06-actions { display: flex; align-items: center; gap: 8px; }
    .m06-more, .m06-rowmore {
      display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--border-sub);
      background: var(--bg-surface); border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub);
    }
    .m06-more { width: 34px; height: 34px; }
    .m06-rowmore { width: 28px; height: 28px; }
    .m06-more:hover, .m06-rowmore:hover { border-color: var(--primary-base); color: var(--text-strong); }

    /* Dải tóm tắt. */
    .m06-sum { display: flex; align-items: center; gap: 12px; padding: 2px 2px 10px; }
    .m06-sum__n { font-size: var(--fs-13); color: var(--text-body); }
    .m06-sum__n b { color: var(--text-strong); font-weight: 700; }
    .m06-sum__clear {
      font: inherit; font-size: var(--fs-12); color: var(--primary-base); background: none; border: 0; cursor: pointer;
    }
    .m06-sum__clear:hover { text-decoration: underline; }

    /* Empty state. */
    .m06-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 40px 0; }
    .m06-empty__hint { margin: 0; font-size: var(--fs-13); color: var(--text-sub); }

    /* Cell — Mức lương (phải, tabular). */
    .m06-sal { display: block; text-align: right; font-variant-numeric: tabular-nums; color: var(--text-strong); font-weight: 500; }
    .m06-muted { color: var(--text-soft); }

    /* Cell — Nơi KCB (tên + mã). */
    .m06-kcb { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .m06-kcb__name { color: var(--text-body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .m06-kcb__code { font-size: var(--fs-12); color: var(--text-soft); font-variant-numeric: tabular-nums; }

    /* Cell — Việc cần xử lý (số lớn + hint tone). */
    .m06-task { display: flex; align-items: baseline; gap: 6px; }
    .m06-task__n { font-size: var(--fs-15); font-weight: 700; font-variant-numeric: tabular-nums; }
    .m06-task__hint { font-size: var(--fs-12); }
    .m06-task[data-tone='error'] .m06-task__n { color: var(--error-base); }
    .m06-task[data-tone='error'] .m06-task__hint { color: var(--error-text, var(--error-base)); }
    .m06-task[data-tone='warning'] .m06-task__n { color: var(--warning-base); }
    .m06-task[data-tone='warning'] .m06-task__hint { color: var(--warning-text, var(--warning-base)); }
    .m06-task[data-tone='muted'] .m06-task__n { color: var(--text-sub); }
    .m06-task[data-tone='muted'] .m06-task__hint { color: var(--text-soft); }

    /* Cell — Biến động gần nhất. */
    .m06-mov { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .m06-mov__type { color: var(--text-body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .m06-mov__date { font-size: var(--fs-12); color: var(--text-soft); font-variant-numeric: tabular-nums; }

    /* Cell — Cập nhật gần nhất. */
    .m06-sync { display: flex; flex-direction: column; gap: 1px; }
    .m06-sync__time { color: var(--text-body); font-variant-numeric: tabular-nums; }
    .m06-sync__date { font-size: var(--fs-12); color: var(--text-soft); font-variant-numeric: tabular-nums; }
    .m06-sync--err { display: inline-flex; align-items: center; gap: 4px; color: var(--warning-text, var(--warning-base)); font-size: var(--fs-12); }

    /* Popover Bộ lọc. */
    .m06-flt { display: flex; flex-direction: column; gap: 12px; width: 540px; max-width: 88vw; }
    .m06-flt__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .m06-flt__grp { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .m06-flt__h {
      font-size: var(--fs-12); font-weight: 700; text-transform: uppercase; letter-spacing: .04em;
      color: var(--text-sub); padding-bottom: 4px; border-bottom: 1px solid var(--border-soft);
    }
    .m06-flt__sub, .m06-flt__lbl { font-size: var(--fs-12); font-weight: 600; color: var(--text-body); margin-top: 2px; }
    .m06-flt__range { display: flex; align-items: center; gap: 8px; }
    .m06-flt__range ::ng-deep hrm-input-number, .m06-flt__range ::ng-deep nz-input-number { flex: 1 1 0; min-width: 0; width: 100%; }
    .m06-flt__dash { color: var(--text-soft); }
    .m06-flt__foot {
      display: flex; align-items: center; justify-content: space-between; gap: 8px;
      padding-top: 10px; border-top: 1px solid var(--border-soft);
    }

    /* Menu ⋮ — chỉ set màu icon (layout do bridge lo). */
    ::ng-deep .m06-menu tabler-icon { color: var(--icon-secondary); }
  