
:host{display:flex;flex-direction:column;width:268px;flex:none;min-height:0;height:100%;
  background:var(--bg-surface-subtle);border-right:1px solid var(--border-sub)}
.num{font-family:var(--font-mono);font-variant-numeric:tabular-nums}

/* ── Search ── */
.rl-search{position:relative;margin:var(--space-3) var(--space-3) var(--space-2)}
.rl-search .kbd{position:absolute;right:9px;top:50%;transform:translateY(-50%);z-index:1;pointer-events:none;
  font-family:var(--font-mono);font-size:var(--fs-11);border:1px solid var(--border-sub);
  border-radius:var(--radius-xs);padding:1px 5px;color:var(--text-soft);background:var(--bg-surface-subtle)}
/* chừa chỗ cho kbd hint bên phải trong ô input */
.rl-search ::ng-deep .ant-input-affix-wrapper{padding-right:64px;background:var(--bg-surface)}

/* ── Chip lọc loại ── */
.rl-chips{display:flex;gap:6px;padding:2px var(--space-3) var(--space-2);flex-wrap:wrap}
.rl-chip{font-size:var(--fs-11);padding:3px 10px;border-radius:var(--radius-full);cursor:pointer;
  border:1px solid var(--border-sub);background:var(--bg-surface);color:var(--text-sub);font-weight:500}
.rl-chip.on{background:var(--primary-bg-subtle);border-color:var(--primary-border);color:var(--primary-base)}

/* ── List + nhóm ── */
.rl-list{flex:1;overflow-y:auto;padding:0 var(--space-2) var(--space-2);min-height:0}
.rl-h{font-size:var(--fs-11);letter-spacing:.8px;text-transform:uppercase;color:var(--text-soft);
  font-weight:600;padding:10px 6px 6px}

/* ── Item ── */
.ri{display:flex;gap:9px;padding:9px var(--space-2);border-radius:var(--radius-md);
  align-items:flex-start;position:relative;cursor:pointer}
.ri:hover{background:var(--bg-surface)}
.ri.on{background:var(--bg-surface);box-shadow:inset 0 0 0 1px var(--primary-border),var(--shadow-regular-xs)}
/* item vừa tạo (xuất xong/lịch mới) — nổi tông success như mockup màn 12/13 */
.ri.fresh{background:var(--success-bg);box-shadow:inset 0 0 0 1px var(--success-border)}
.ri-ic{width:28px;height:28px;border-radius:var(--radius-sm);flex:none;
  display:flex;align-items:center;justify-content:center}
.ri-ic.t-mau{background:var(--primary-bg-subtle);color:var(--primary-base)}
.ri-ic.t-lich{background:var(--success-bg);color:var(--success-base)}
.ri-ic.t-hist{background:var(--bg-surface-muted);color:var(--text-sub)}
.ri-ic.t-new{background:var(--success-bg);color:var(--success-base)}
.ri-m{flex:1;min-width:0}
.ri-t{font-size:var(--fs-13);font-weight:500;color:var(--text-strong);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ri-t .pin{color:var(--warning-base);font-size:var(--fs-11)}
.ri-s{font-size:var(--fs-11);color:var(--text-sub);margin-top:2px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ri-s b{font-weight:500;font-size:var(--fs-11)}

/* trạng thái lịch — luôn render 2 chiều (AP-01) */
.sdot{display:inline-flex;align-items:center;gap:5px;font-size:var(--fs-11);font-weight:500}
.sdot::before{content:'';width:7px;height:7px;border-radius:var(--radius-full)}
.sdot.act{color:var(--success-text)}
.sdot.act::before{background:var(--success-base)}
.sdot.paused{color:var(--text-soft)}
.sdot.paused::before{background:var(--text-soft)}

/* badge loại nguồn */
.bdg{font-size:var(--fs-10);font-weight:600;letter-spacing:.3px;padding:2px 7px;
  border-radius:var(--radius-full);flex:none;margin-top:1px}
.bdg.b-mau{background:var(--primary-bg-subtle);color:var(--primary-base)}
.bdg.b-lich{background:var(--success-bg);color:var(--success-text)}
.bdg.b-hist{background:var(--bg-surface-muted);color:var(--text-sub)}

/* hành động nhanh — chỉ hiện khi hover hoặc item đang chọn; 2 nút cùng 1 hàng, không ép xuống dòng */
.ri-acts{display:none;gap:6px;margin-top:7px;flex-wrap:nowrap}
.ri:hover .ri-acts,.ri.on .ri-acts{display:flex}
.mini{font-size:var(--fs-11);font-weight:500;padding:3px 9px;border-radius:var(--radius-sm);cursor:pointer;
  border:1px solid var(--border-sub);background:var(--bg-surface);color:var(--text-body);
  display:inline-flex;gap:4px;align-items:center;white-space:nowrap}
.mini.p{background:var(--primary-base);border-color:var(--primary-base);color:var(--text-on-primary)}
.mini.p:hover{background:var(--primary-hover)}

/* kebab — hover mới hiện; badge nhường chỗ khi hover item có kebab */
.ri-keb{position:absolute;top:8px;right:6px;width:22px;height:22px;border:none;background:transparent;
  color:var(--text-soft);border-radius:var(--radius-sm);display:none;align-items:center;
  justify-content:center;cursor:pointer}
.ri:hover .ri-keb,.ri.keb-open .ri-keb{display:flex}
.ri-keb:hover{background:var(--bg-surface-subtle)}
.ri.keb-open .ri-keb{background:var(--bg-surface-muted)}
.ri.has-keb:hover .bdg,.ri.keb-open .bdg{display:none}

/* menu kebab tự dựng theo mockup */
.menu{position:absolute;top:32px;right:6px;background:var(--bg-surface);border:1px solid var(--border-sub);
  border-radius:var(--radius-lg);box-shadow:var(--shadow-regular-md);padding:5px;min-width:172px;z-index:21}
.mi{display:flex;align-items:center;gap:9px;font-size:var(--fs-13);color:var(--text-body);width:100%;
  padding:7px 10px;border-radius:var(--radius-sm);white-space:nowrap;border:none;background:transparent;
  cursor:pointer;text-align:left}
.mi:hover{background:var(--bg-surface-subtle);color:var(--text-strong)}
.mi.danger{color:var(--error-base)}
.mi.danger:hover{background:var(--error-bg)}
.msep{height:1px;background:var(--border-soft);margin:4px 6px}
.keb-back{position:fixed;inset:0;z-index:20;background:transparent}

/* empty state trong rail */
.rl-empty{padding:var(--space-4) var(--space-2)}
.e-ic{display:inline-flex;width:52px;height:52px;border-radius:var(--radius-full);
  background:var(--bg-surface-muted);color:var(--text-soft);align-items:center;justify-content:center}
.e-s{font-size:var(--fs-11);color:var(--text-sub);line-height:1.55;max-width:210px;
  margin:0 auto var(--space-2);text-align:center}

/* footer */
.rl-foot{padding:10px var(--space-3);border-top:1px solid var(--border-sub)}
.lnk{font-size:var(--fs-12);color:var(--primary-base);font-weight:500;border:none;background:transparent;
  cursor:pointer;padding:0}
.lnk:hover{text-decoration:underline}

/* confirm xóa TẠI CHỖ trong kebab (Contract §4) — nền error-bg, 2 bước, không overlay chồng lớp */
.del-strip{display:flex;align-items:center;gap:8px;background:var(--error-bg);border:1px solid var(--error-border);
  border-radius:var(--radius-sm);padding:6px 8px;margin:2px;font-size:var(--fs-12);color:var(--error-text)}
.del-strip span{flex:1;white-space:nowrap;font-weight:500}
.del-yes{border:none;background:var(--error-base);color:var(--text-on-primary);font-size:var(--fs-11);
  font-weight:600;padding:3px 10px;border-radius:var(--radius-sm);cursor:pointer}
.del-no{border:none;background:transparent;color:var(--text-sub);font-size:var(--fs-11);padding:3px 8px;cursor:pointer}
.del-no:hover{color:var(--text-strong)}

/* ≤1280px: rail thu gọn thành icon-strip (Contract §2) — chỉ còn ô icon, click vẫn hydrate */
@media (max-width:1280px){
  :host{width:56px}
  .rl-search,.rl-chips,.rl-foot,.rl-h,.ri-m,.bdg{display:none}
  .ri-keb,.ri:hover .ri-keb,.ri.keb-open .ri-keb{display:none}
  .rl-list{padding:var(--space-2) 6px}
  .ri{justify-content:center;padding:7px 0}
}
  