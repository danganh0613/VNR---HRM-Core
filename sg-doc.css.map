
    /* Full chiều ngang vùng content (từ side nav sang phải). */
    :host { display: block; width: 100%; }
    .doc-head { margin-bottom: 20px; }
    .doc-cat { font-size: var(--fs-12); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--primary-base); }
    .doc-title { font-size: var(--fs-30); font-weight: 600; color: var(--text-strong); margin: 6px 0 8px; }
    .doc-desc { font-size: var(--fs-15); color: var(--text-sub); line-height: 1.6; margin: 0; max-width: 720px; }
    .doc-related { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 14px; }
    .doc-related-l { font-size: var(--fs-12); font-weight: 600; color: var(--text-soft); text-transform: uppercase; letter-spacing: 0.04em; }
    .doc-related-link {
      font-size: var(--fs-13); font-weight: 500; color: var(--primary-base); text-decoration: none;
      padding: 3px 10px; border-radius: var(--radius-full);
      background: var(--primary-bg-subtle); transition: background var(--duration-fast) var(--ease-out);
    }
    .doc-related-link:hover { background: var(--primary-bg-soft); }
    .doc-subnav {
      position: sticky; top: -32px; z-index: 2;
      display: flex; gap: 4px; padding: 12px 0; margin-bottom: 8px;
      background: var(--bg-app); border-bottom: 1px solid var(--border-sub);
    }
    .doc-subnav button {
      border: 0; background: transparent; cursor: pointer;
      padding: 6px 12px; border-radius: var(--radius-md);
      font-family: var(--font-sans); font-size: var(--fs-13); font-weight: 500; color: var(--text-sub);
    }
    .doc-subnav button:hover { color: var(--text-strong); background: var(--bg-surface-subtle); }
    .doc-subnav button.on { color: var(--primary-base); background: var(--primary-bg-subtle); }
    .dark .doc-subnav button.on { color: var(--text-strong); }
    .doc-sec { padding: 24px 0; border-bottom: 1px solid var(--border-soft); scroll-margin-top: 60px; }
    .doc-h2 { font-size: var(--fs-13); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-soft); margin: 0 0 16px; }
  