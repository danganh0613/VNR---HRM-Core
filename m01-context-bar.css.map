
    :host { display: flex; flex-direction: column; gap: 6px; }
    .c1 { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .c1-ky { width: 210px; }
    .c1-dv { width: 300px; }
    .c1-dot { width: 190px; }
    .c1-trangthai { display: inline-flex; align-items: center; gap: 7px; font-size: var(--fs-12); color: var(--text-sub); }
    .c1-gap { flex: 1; }
    .c1-meta { font-size: var(--fs-11); color: var(--text-soft); }
    .c1-quyen { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
    .c1-sw { display: inline-flex; align-items: center; gap: 7px; font-size: var(--fs-12); color: var(--text-sub); }
  