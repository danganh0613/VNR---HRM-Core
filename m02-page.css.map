
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }

    /* hrm-data-workspace = flex-item lấp đầy :host; list-page bên trong nó cũng lấp đầy chiều cao. */
    .m02-ws { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
    :host ::ng-deep .m02-ws > hrm-list-page { flex: 1 1 auto; min-height: 0; }
    /* Radius ĐỒNG BỘ toolbar: filter-panel trigger (slot wsFilterPanel, mặc định 10px) → --radius-md (8px). */
    :host ::ng-deep .m02-ws hrm-filter-panel .ant-dropdown-trigger { border-radius: var(--radius-md); }
    .m02-chip {
      display: inline-flex; align-items: center; gap: 5px; cursor: pointer; font: inherit;
      font-size: var(--fs-12); font-weight: 500; color: var(--primary-base);
      background: var(--primary-bg-subtle); border: 1px solid transparent; border-radius: var(--radius-full);
      padding: 2px 10px;
    }
    .m02-chip:hover { border-color: var(--primary-base); }
    /* chip "Đã chuyển xử lý" khi BẬT — viền + ring primary inset (cùng idiom active như .m02-chip--miss-on). */
    .m02-chip--on { border-color: var(--primary-base); box-shadow: 0 0 0 1px var(--primary-base) inset; }
    /* chip "Nghi bỏ sót" — tông cảnh báo, bật/tắt filter nguồn Đối soát chống sót */
    .m02-chip--miss { color: var(--warning-text); background: var(--warning-bg); }
    .m02-chip--miss b { font-weight: 700; }
    .m02-chip--miss:hover { border-color: var(--warning-base); }
    .m02-chip--miss-on { border-color: var(--warning-base); box-shadow: 0 0 0 1px var(--warning-base) inset; }

    /* Dải AI card ([lpTabs]) — nằm trong khối tiêu đề list-page, ngay dưới tiêu đề, trên panel. */
    /* AI card ở [lpTabs] = TRÊN panel (trên toolbar + bảng), dưới tiêu đề. padding-top chừa chỗ đầu mascot peek. */
    /* S: KHỐI RIÊNG trên nền xám (giữa H và panel) — căn lề ngang 16px trùng panel; padding-top chừa chỗ mascot peek. */
    .m02-summary { min-width: 0; padding: 16px 16px 0; }
    .m02-empty { padding: 48px 0; display: flex; justify-content: center; }

    /* Thẻ (card/kanban) — layout gọn đọc-nhanh, token DS. */
    .m02-card { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .m02-card__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
    .m02-card__visao {
      margin: 0; font-size: var(--fs-13); color: var(--text-body); line-height: 1.45;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .m02-card__foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
    .m02-card__acts { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

    .m02-change { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .m02-change__desc { color: var(--text-strong); font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .m02-change__sub { font-size: var(--fs-12); color: var(--text-sub); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .m02-impact { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; }
    .m02-impact__num { font-weight: 600; color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .m02-sla { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; }
    .m02-sla__date { font-size: var(--fs-12); color: var(--text-sub); font-variant-numeric: tabular-nums; }
    .m02-muted { color: var(--text-soft); font-size: var(--fs-12); }
    .m02-warn { color: var(--warning-text); font-size: var(--fs-12); font-weight: 500; }
    .m02-cd { font-size: var(--fs-11); color: var(--text-soft); background: var(--bg-surface-subtle); border-radius: var(--radius-sm); padding: 0 6px; white-space: nowrap; }

    .m02-visao { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .m02-visao__main { color: var(--text-body); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .m02-visao__src { font-size: var(--fs-11); color: var(--text-soft); font-style: italic; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    /* nguồn "Đối soát chống sót" — tô khác màu để HR không nhầm nghi-ngờ với đã-phát-hiện-chắc */
    .m02-visao__src--miss { display: inline-flex; align-items: center; gap: 3px; color: var(--warning-text); font-style: normal; font-weight: 600; }

    .m02-status { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
    .m02-status__thieu { font-size: var(--fs-11); color: var(--warning-text); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .m02-lolink { border: 0; background: none; padding: 0; cursor: pointer; font: inherit; font-size: var(--fs-12); font-weight: 600; color: var(--primary-base); white-space: nowrap; }
    .m02-lolink:hover { text-decoration: underline; }
    .m02-dot-blocked { display: inline-flex; align-items: center; gap: 4px; font-size: var(--fs-11); font-weight: 500; color: var(--warning-text); background: var(--warning-bg); border-radius: var(--radius-sm); padding: 0 6px; white-space: nowrap; }
    .m02-dot-preview { font-size: var(--fs-12); font-weight: 500; color: var(--primary-base); white-space: nowrap; }
    .m02-dot-confirmed { display: inline-flex; align-items: center; gap: 4px; max-width: 100%; font-size: var(--fs-11); font-weight: 500; color: var(--primary-base); background: var(--primary-bg-subtle); border-radius: var(--radius-sm); padding: 0 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .m02-act { display: flex; align-items: center; justify-content: flex-end; gap: 6px; }
    /* Cột Hành động — CHỈ nút ICON (ảnh 2): vuông 30px, viền, bo góc; hover đổi tông theo hành động. */
    .m02-ib { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; box-sizing: border-box;
      border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md); cursor: pointer;
      color: var(--icon-secondary); padding: 0; flex: none; transition: color .12s, border-color .12s, background .12s; }
    .m02-ib:hover { border-color: var(--primary-base); color: var(--primary-base); }
    /* §6 — ✓ xanh (success) · ✗ đỏ (error) ngay khi nghỉ (không chờ hover). */
    .m02-ib--ok { color: var(--success-base, #1a9d55); }
    .m02-ib--danger { color: var(--error-text, #b42318); }
    .m02-ib--ok:hover { border-color: var(--success-base, #1a9d55); color: var(--success-base, #1a9d55); background: var(--success-bg, #eaf7ef); }
    .m02-ib--primary { color: var(--primary-base); }
    .m02-ib--primary:hover { border-color: var(--primary-base); background: var(--primary-bg-subtle); }
    .m02-ib--danger:hover { border-color: var(--error-base, #d92d20); color: var(--error-text, #b42318); background: var(--error-bg, #fef3f2); }
    .m02-ib:disabled { opacity: .4; cursor: not-allowed; }
    .m02-ib:disabled:hover { border-color: var(--border-sub); color: var(--icon-secondary); background: var(--bg-surface); }

    /* ═════ Cột MỚI (§11) ═════ */
    /* Hiệu lực BHXH — ngày hiệu lực (đậm) + nhãn tháng (nhẹ). */
    .m02-hl { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .m02-hl__ngay { color: var(--text-strong); font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .m02-hl__thang { font-size: var(--fs-11); color: var(--text-soft); white-space: nowrap; }

    /* Biến động (§2 redesign) — 1 DÒNG: chip màu loại (mã PA) + tên loại; cả cell mang title=YC1. */
    .m02-bd { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; min-width: 0; cursor: default; }
    .m02-bd--row { flex-direction: row; align-items: center; gap: 6px; }
    .m02-bd__type { font-size: var(--fs-12); color: var(--text-body); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .m02-bd__pa { display: flex; align-items: baseline; gap: 5px; min-width: 0; }
    .m02-bd__code { flex: none; font-weight: 700; font-size: var(--fs-12); color: var(--text-strong); letter-spacing: .02em; }
    .m02-bd__reason { font-size: var(--fs-12); color: var(--text-body); line-height: 1.35;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    /* Cách nộp (flow badge) trong cột Hướng xử lý — trên dòng riêng, sát trái. */
    .m02-flowtag { align-self: flex-start; margin-top: 2px; }

    /* Hướng xử lý — main (đậm) + sub (nhẹ); clickable = nút mở popover kỳ đề xuất. */
    .m02-huong { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .m02-huong__wrap { display: flex; flex-direction: column; gap: 1px; min-width: 0; text-align: left; }
    .m02-huong__main { color: var(--text-strong); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .m02-huong__sub { font-size: var(--fs-11); color: var(--text-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .m02-huong--btn { display: inline-flex; align-items: center; gap: 6px; width: 100%; cursor: pointer; font: inherit;
      background: none; border: 1px solid transparent; border-radius: var(--radius-md); padding: 2px 6px; margin: -2px -6px; }
    .m02-huong--btn:hover { border-color: var(--border-sub); background: var(--bg-surface-subtle); }
    .m02-huong--btn .m02-huong__main { color: var(--primary-base); }
    .m02-huong__caret { color: var(--text-soft); flex: none; margin-left: auto; }
    /* Popover Hướng xử lý — tiêu đề + options + hint hiệu lực (chân). */
    ::ng-deep .m02-huongmenu { min-width: 240px; max-width: 300px; }
    ::ng-deep .m02-huongmenu__title { padding: 6px 12px 2px; font-size: var(--fs-11); font-weight: 700; color: var(--text-soft); text-transform: uppercase; letter-spacing: .02em; }
    ::ng-deep .m02-huongmenu__opt { display: inline-flex; align-items: center; gap: 8px; }
    ::ng-deep .m02-huongmenu__opt b { font-weight: 600; color: var(--text-strong); }
    ::ng-deep .m02-huongmenu__tag { font-size: var(--fs-11); font-weight: 500; color: var(--primary-base); background: var(--primary-bg-subtle); border-radius: var(--radius-full); padding: 0 7px; }
    ::ng-deep .m02-huongmenu__foot { padding: 6px 12px; margin-top: 2px; border-top: 1px solid var(--border-soft);
      font-size: var(--fs-11); color: var(--text-soft); white-space: normal; line-height: 1.4; }

    /* Nguyên nhân — 1 dòng ngắn (§15). */
    .m02-nguyennhan { display: block; color: var(--text-body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }

    /* Tình trạng & việc cần làm (§4 gộp) — dòng 1: badge + hậu tố; dòng 2: nguyên nhân muted. */
    .m02-tinhtrang { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .m02-tinhtrang__top { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; min-width: 0; }
    .m02-tinhtrang__suffix { font-size: var(--fs-11); font-weight: 500; color: var(--text-sub); white-space: nowrap; }
    .m02-tinhtrang__sub { font-size: var(--fs-12); color: var(--text-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }

    /* Thẻ — hàng hướng xử lý giữa top + foot. */
    .m02-card__huong { display: flex; flex-direction: column; gap: 1px; min-width: 0; }

    /* ✨ Cột Tin cậy — chip % bấm được, màu theo mức (Cao/TB/Thấp) */
    .m02-conf { display: inline-flex; align-items: center; justify-content: center; min-width: 46px; cursor: pointer; font: inherit;
      font-size: var(--fs-12); font-weight: 700; font-variant-numeric: tabular-nums; border-radius: var(--radius-full);
      padding: 1px 8px; border: 1px solid transparent; }
    .m02-conf[data-level="cao"] { color: var(--success-text); background: var(--success-bg); }
    .m02-conf[data-level="trung-binh"] { color: var(--warning-text); background: var(--warning-bg); }
    .m02-conf[data-level="thap"] { color: var(--error-text); background: var(--error-bg); }
    .m02-conf:hover { border-color: currentColor; }

    /* ✨ Card gợi ý AI (kiểu Drift) — NỀN "màu AI" của chatbot (nocode/lowcode .ai-panel) bọc ngoài,
       nội dung nằm trong HỘP NỀN TRẮNG bên trong (nền-AI-ngoài + hộp-trắng-trong). */
    /* Wrapper: nâng CẢ NHÓM (mascot + card) nổi TRÊN mọi phần tử anh em khác của trang; chừa chỗ đầu mascot nhô lên. */
    /* Card nằm trong khối tiêu đề list-page (.lp-head); khoảng trên do padding của .lp-head lo. */
    .m02-aicard-outer { position: relative; z-index: 1; margin: 0; overflow: visible; }
    /* Card TRONG wrapper: z-index cao hơn mascot → nền gradient ĐỤC của card CHE phần thân robot chồng lên card.
       overflow VISIBLE để không cắt đáy hộp trắng. margin cũ chuyển lên wrapper. */
    .m02-aicard { position: relative; z-index: 1; overflow: visible; padding: 10px;
      /* Gradient AI brand — hex sáng cố định (ngoại lệ được phép, dùng NGUYÊN màu chatbot .ai-panel). */
      background: linear-gradient(180deg, #E7F0FE 0%, #EDEAFB 48%, #FCE8DC 100%);
      border: 1px solid #DBD3F5; border-radius: 12px; }
    /* Header nằm TRÊN gradient (trong suốt); chữ/nút dùng màu tối CỐ ĐỊNH cho hợp nền sáng cả 2 theme. */
    /* Header(B) + hộp trắng(C) z-index 3 = NẰM TRÊN mascot (z1) → mascot lộ trên nền gradient nhưng khuất sau B/C. */
    .m02-aicard__head { position: relative; z-index: 3; display: flex; align-items: flex-start; justify-content: space-between; gap: 8px;
      padding: 0 2px 8px 4px; }
    /* Cụm nhận diện trợ lý: avatar mascot + (tiêu đề + subtext), canh giữa theo trục dọc. */
    .m02-aicard__id { display: inline-flex; align-items: center; gap: 10px; min-width: 0; }
    .m02-aicard__idtext { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .m02-aicard__title { display: inline-flex; align-items: center; gap: 6px;
      font-size: var(--fs-13); color: #1E2A5A; }
    .m02-aicard__title b { font-weight: 700; }
    .m02-aicard__spark { color: #6C4FE0; flex: none; }
    /* Subtext trợ lý — muted; màu tối CỐ ĐỊNH (như head) để đọc được trên nền gradient sáng cả 2 theme. */
    .m02-aicard__sub { font-size: var(--fs-12); color: #5B6478; line-height: 1.25; }
    .m02-aicard__tools { display: flex; align-items: flex-start; gap: 4px; flex: none; }
    /* Mascot = avatar tròn nhỏ (~40px) bên trái tiêu đề; object-fit cover lấy phần đầu (như gương mặt trợ lý VNAI).
       Màu viền/nền cố định hợp nền gradient sáng; KHÔNG còn absolute lú góc. */
    .m02-aicard__mascot { flex: none; width: 40px; height: 40px; border-radius: 50%; overflow: hidden;
      object-fit: cover; object-position: center 28%; background: rgba(255, 255, 255, 0.6);
      border: 1px solid #DBD3F5; pointer-events: none; display: block; }
    .m02-aicard__close { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; flex: none;
      border: 0; background: none; border-radius: var(--radius-md); cursor: pointer; color: #5B6478; }
    .m02-aicard__close:hover { background: rgba(255, 255, 255, 0.6); color: #1E2A5A; }
    /* Hộp NỀN TRẮNG bọc nội dung — dùng token surface: light = trắng, dark = surface tối để chữ luôn đọc được. */
    .m02-aicard__body { position: relative; z-index: 3; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
      background: var(--bg-surface); border-radius: 10px; padding: 12px 14px; }
    .m02-aicard__text { flex: 1 1 auto; min-width: 0; margin: 0; font-size: var(--fs-13); color: var(--text-body); line-height: 1.5; }
    .m02-aicard__text b { color: var(--text-strong); font-weight: 700; }
    .m02-aicard__hi { color: var(--warning-text); font-weight: 600; margin-left: 2px; }

    /* Card "Tóm tắt công việc" (compact) — giảm ~40–50% chiều cao: padding nhỏ, head sát, body 1 hàng. */
    .m02-aicard--compact { padding: 8px; }
    .m02-aicard--compact .m02-aicard__head { padding: 0 2px 5px 4px; }
    .m02-aicard__body--compact { align-items: center; flex-wrap: nowrap; gap: 16px; padding: 9px 12px; }
    @media (max-width: 720px) { .m02-aicard__body--compact { flex-wrap: wrap; align-items: flex-start; } }
    .m02-aicard__info { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
    /* Prose AI (kiểu LLM phân tích) — ĐẶT TRÊN các số; trong hộp trắng nên dùng token DS. */
    .m02-aicard__prose { margin: 0; font-size: var(--fs-13); color: var(--text-body); line-height: 1.5; }
    .m02-aicard__prose b { color: var(--text-strong); font-weight: 700; }
    .m02-aicard__lead { margin: 0; font-size: var(--fs-13); color: var(--text-body); line-height: 1.35; }
    .m02-aicard__lead-k { color: var(--text-sub); }
    .m02-aicard__lead b { color: var(--text-strong); font-weight: 700; }
    .m02-aicard__counts { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
    .m02-aicard__chip { display: inline-flex; align-items: center; gap: 4px; font-size: var(--fs-12); color: var(--text-sub);
      background: var(--bg-surface-subtle); border: 1px solid var(--border-soft); border-radius: var(--radius-full); padding: 1px 9px; }
    .m02-aicard__chip b { color: var(--text-strong); font-weight: 700; }
    .m02-aicard__chip--warn { color: var(--warning-text); }
    .m02-aicard__chip--warn b { color: var(--warning-text); }
    .m02-aicard__chip--ok { color: var(--success-text); }
    .m02-aicard__chip--ok b { color: var(--success-text); }
    /* §1 — thanh tiến độ (đã xử lý / tổng) trong card Tóm tắt. */
    .m02-aicard__progress { display: flex; align-items: center; gap: 10px; }
    .m02-aicard__bar { flex: 0 0 auto; width: 160px; max-width: 42vw; height: 6px; background: var(--bg-surface-subtle);
      border: 1px solid var(--border-soft); border-radius: var(--radius-full); overflow: hidden; }
    .m02-aicard__bar-fill { display: block; height: 100%; background: var(--success-base); border-radius: var(--radius-full); transition: width .2s; }
    .m02-aicard__progress-txt { font-size: var(--fs-12); color: var(--text-sub); white-space: nowrap; }
    .m02-aicard__progress-txt b { color: var(--text-strong); font-weight: 700; }
    .m02-aicard__ai { margin: 0; font-size: var(--fs-12); color: var(--text-sub); line-height: 1.4; }
    .m02-aicard__ai b { color: var(--text-body); font-weight: 600; }
    .m02-aicard__cta { display: flex; align-items: center; gap: 8px; flex: none; flex-wrap: nowrap; }

    .m02-tags { display: flex; align-items: center; gap: 4px; }
    .m02-tags--wrap { flex-wrap: wrap; row-gap: 4px; }
    :host ::ng-deep .m02-tags .ant-tag { margin: 0; }
    .m02-pa { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; min-width: 0; }
    .m02-pa__code { color: var(--text-body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }

    .m02-lockednote { font-size: var(--fs-12); color: var(--text-sub); margin-right: auto; }

    .m02-reason { display: flex; flex-direction: column; gap: 8px; }
    .m02-reason__hint { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .m02-reason__err { font-size: var(--fs-12); color: var(--error-text); }

    .m02-sim { display: flex; flex-direction: column; gap: 12px; font-size: var(--fs-13); }
    .m02-sim__grid { display: grid; grid-template-columns: 160px 1fr; gap: 6px 12px; align-items: baseline; }
    .m02-sim__k { font-size: var(--fs-12); color: var(--text-sub); }
    .m02-sim__v { color: var(--text-strong); font-weight: 600; font-variant-numeric: tabular-nums; display: inline-flex; align-items: center; gap: 6px; }
    .m02-sim__v--big { font-size: var(--fs-16); }
    .m02-sim__funds { display: flex; gap: 14px; flex-wrap: wrap; padding: 8px 10px; background: var(--bg-surface-subtle); border-radius: var(--radius-md); font-size: var(--fs-12); color: var(--text-sub); }
    .m02-sim__fund b { color: var(--text-strong); margin-right: 4px; }
    .m02-sim__list { display: flex; flex-direction: column; gap: 3px; }
    .m02-sim__row { font-size: var(--fs-12); color: var(--text-body); }
    .m02-sim__row b { color: var(--text-strong); }

    /* Nút "Cập nhật biến động" — hành động refresh nguồn (nhóm phải), CÙNG 32px với ⋮ và control trái. */
    .m02-refreshbtn {
      display: inline-flex; align-items: center; gap: 6px; height: 32px; box-sizing: border-box; cursor: pointer; font: inherit;
      font-size: var(--fs-13); font-weight: 500; color: var(--text-body); white-space: nowrap;
      background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 0 12px;
    }
    .m02-refreshbtn:hover { border-color: var(--primary-base); color: var(--primary-base); }

    /* ⋮ More — nút icon vuông 32px (khớp template Chế độ xem dữ liệu) */
    .m02-more { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; box-sizing: border-box;
      border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub); }
    .m02-more:hover { border-color: var(--primary-base); color: var(--text-strong); }
    ::ng-deep .m02-menu tabler-icon { color: var(--icon-secondary); margin-right: 6px; vertical-align: -3px; }
    .m02-menu__n { display: inline-flex; align-items: center; justify-content: center; min-width: 18px; margin-left: 6px;
      font-size: var(--fs-11); font-weight: 700; color: var(--primary-base); background: var(--primary-bg-subtle); border-radius: var(--radius-full); padding: 0 5px; }

    /* Lịch sử xử lý (modal TO ~900) — mỗi dòng đã xử lý + nút "Xử lý lại" (cột 4) */
    .m02-hist { display: flex; flex-direction: column; gap: 10px; }
    .m02-hist__kw { display: block; }
    .m02-hist__list { display: flex; flex-direction: column; max-height: 64vh; overflow-y: auto; border: 1px solid var(--border-soft); border-radius: var(--radius-md); }
    .m02-hist__row { display: grid; grid-template-columns: minmax(0, 1.4fr) auto minmax(0, 1.3fr) auto; align-items: center; gap: 14px;
      padding: 10px 14px; border-bottom: 1px solid var(--border-soft); }
    .m02-hist__row:last-child { border-bottom: 0; }
    .m02-hist__row:hover { background: var(--bg-surface-subtle); }
    .m02-hist__outcome { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; min-width: 0; }
    .m02-hist__ketcuc { font-size: var(--fs-12); color: var(--text-sub); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
    .m02-hist__empty { margin: 8px 0; font-size: var(--fs-13); color: var(--text-sub); text-align: center; }
    .m02-hist__redo { display: inline-flex; align-items: center; gap: 5px; height: 30px; box-sizing: border-box; cursor: pointer; font: inherit;
      font-size: var(--fs-12); font-weight: 500; color: var(--text-body); white-space: nowrap;
      background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 0 10px; }
    .m02-hist__redo:hover { border-color: var(--primary-base); color: var(--primary-base); }
    .m02-hist__redo-caret { color: var(--text-soft); }

    /* Popover Loại trừ — khối đề xuất + divider + breakdown bulk */
    .m02-lt { display: flex; flex-direction: column; gap: 10px; }
    .m02-lt__suggest { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; padding: 10px 12px;
      background: var(--primary-bg-subtle); border: 1px solid var(--primary-base); border-radius: var(--radius-md); }
    .m02-lt__suggest-head { display: inline-flex; align-items: center; gap: 5px; font-size: var(--fs-13); color: var(--text-strong); }
    .m02-lt__suggest-head b { color: var(--primary-base); font-weight: 700; }
    .m02-lt__suggest-desc { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .m02-lt__divider { display: flex; align-items: center; gap: 8px; font-size: var(--fs-11); color: var(--text-soft); }
    .m02-lt__divider::before, .m02-lt__divider::after { content: ''; flex: 1; height: 1px; background: var(--border-soft); }
    .m02-lt__warn { display: flex; flex-direction: column; gap: 6px; padding: 8px 10px; background: var(--warning-bg);
      border: 1px solid var(--warning-base); border-radius: var(--radius-md); }
    .m02-lt__warn-head { display: flex; align-items: center; gap: 5px; font-size: var(--fs-12); font-weight: 600; color: var(--warning-text); }
    .m02-lt__breakdown { display: flex; flex-wrap: wrap; gap: 6px; }
    .m02-lt__bd { font-size: var(--fs-11); color: var(--text-body); background: var(--bg-surface); border: 1px solid var(--border-soft);
      border-radius: var(--radius-sm); padding: 1px 8px; }
    .m02-lt__bd b { color: var(--text-strong); font-weight: 700; margin-right: 3px; }
    .m02-lt__addnote { align-self: flex-start; border: 0; background: none; padding: 0; cursor: pointer; font: inherit;
      font-size: var(--fs-12); font-weight: 500; color: var(--primary-base); }
    .m02-lt__addnote:hover { text-decoration: underline; }

    /* AI2 — chip nhóm ngoại lệ (Tab 5) */
    .m02-excbar { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; padding: 0 0 10px; }
    .m02-excchip {
      display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font: inherit;
      font-size: var(--fs-12); color: var(--text-body);
      background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-full); padding: 2px 10px;
    }
    .m02-excchip b { color: var(--warning-text); font-weight: 700; }
    .m02-excchip:hover { border-color: var(--primary-base); }
    .m02-excchip--active { background: var(--primary-bg-subtle); border-color: var(--primary-base); color: var(--primary-base); }
    .m02-excchip--active b { color: var(--primary-base); }

    /* AI5 — drawer rủi ro */
    .m02-risk { display: flex; flex-direction: column; gap: 8px; }
    .m02-risk__row { display: flex; align-items: center; gap: 12px; width: 100%; cursor: pointer; text-align: left; font: inherit;
      background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 10px 12px; }
    .m02-risk__row:hover { border-color: var(--primary-base); background: var(--primary-bg-subtle); }
    .m02-risk__count { flex: none; min-width: 34px; height: 34px; display: grid; place-items: center; border-radius: var(--radius-md);
      font-size: var(--fs-16); font-weight: 700; color: var(--bg-surface); }
    .m02-risk__count[data-tone="danger"] { background: var(--error-base); }
    .m02-risk__count[data-tone="warning"] { background: var(--warning-base); }
    .m02-risk__count[data-tone="info"] { background: var(--primary-base); }
    .m02-risk__body { display: flex; flex-direction: column; gap: 1px; flex: 1; min-width: 0; }
    .m02-risk__title { font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); }
    .m02-risk__desc { font-size: var(--fs-12); color: var(--text-sub); }
    .m02-risk__chev { color: var(--text-soft); flex: none; }
    .m02-risk__ok { margin: 0; font-size: var(--fs-13); color: var(--success-text); font-weight: 500; }
  