
    :host { display: block; }
    a { text-decoration: none; }

    /* ===== Reveal on load (hero) ===== */
    .rise { opacity: 0; transform: translateY(14px); animation: rise .55s var(--ease-out, ease) forwards; animation-delay: calc(var(--d, 0) * 90ms); }
    @keyframes rise { to { opacity: 1; transform: none; } }

    /* ===== Reveal on scroll (mọi section dưới hero) ===== */
    .sr { opacity: 0; transform: translateY(22px); transition: opacity .6s var(--ease-out, ease), transform .6s var(--ease-out, ease); transition-delay: calc(var(--sd, 0) * 90ms); }
    .sr.in { opacity: 1; transform: none; }

    @media (prefers-reduced-motion: reduce) {
      .rise { animation: none; opacity: 1; transform: none; }
      .sr { transition: none; opacity: 1; transform: none; }
      .orb, .ring, .dc { animation: none !important; }
      .dc { display: none; }
      .mq-seg { animation: none !important; }
    }

    /* ===== HERO ===== */
    .hero { position: relative; overflow: hidden; border-radius: var(--radius-2xl, 20px); border: 1px solid var(--border-sub);
      background: var(--bg-surface); padding: 72px 28px 56px; text-align: center; }
    .hero-bg { position: absolute; inset: 0; pointer-events: none; }
    .orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: .55; }
    .orb-a { width: 420px; height: 420px; left: -100px; top: -140px;
      background: color-mix(in srgb, var(--primary-base) 32%, transparent); animation: float-a 14s ease-in-out infinite alternate; }
    .orb-b { width: 360px; height: 360px; right: -80px; bottom: -160px;
      background: color-mix(in srgb, var(--primary-base) 22%, transparent); animation: float-b 18s ease-in-out infinite alternate; }
    @keyframes float-a { to { transform: translate(36px, 28px) scale(1.08); } }
    @keyframes float-b { to { transform: translate(-30px, -24px) scale(1.05); } }
    .ring { position: absolute; left: 50%; top: -260px; width: 680px; height: 680px; transform: translateX(-50%);
      border-radius: 50%; opacity: .35;
      background: conic-gradient(from 0deg, transparent 0 70%, color-mix(in srgb, var(--primary-base) 45%, transparent) 86%, transparent 100%);
      -webkit-mask: radial-gradient(closest-side, transparent 76%, #000 77%, #000 82%, transparent 83%);
      mask: radial-gradient(closest-side, transparent 76%, #000 77%, #000 82%, transparent 83%);
      animation: spin 26s linear infinite; }
    @keyframes spin { to { transform: translateX(-50%) rotate(360deg); } }
    .grid-dots { position: absolute; inset: 0;
      background-image: radial-gradient(color-mix(in srgb, var(--text-strong) 14%, transparent) 1px, transparent 1px);
      background-size: 26px 26px;
      -webkit-mask: radial-gradient(ellipse 75% 65% at 50% 38%, #000 30%, transparent 75%);
      mask: radial-gradient(ellipse 75% 65% at 50% 38%, #000 30%, transparent 75%); opacity: .5; }

    /* Hạt tròn trôi 4 hướng — dưới→lên, trên→xuống, trái→phải, phải→trái */
    .drift { position: absolute; inset: 0; overflow: hidden; }
    .dc { position: absolute; width: var(--s); height: var(--s); border-radius: 50%; opacity: 0;
      background: color-mix(in srgb, var(--primary-base) 65%, transparent);
      box-shadow: 0 0 12px color-mix(in srgb, var(--primary-base) 50%, transparent); }
    .dc.ring2 { background: transparent; box-shadow: none;
      border: 1.5px solid color-mix(in srgb, var(--primary-base) 45%, transparent); }
    .dc.up    { left: var(--x); bottom: -24px; animation: dc-up    var(--dur) linear infinite var(--dl); }
    .dc.down  { left: var(--x); top: -24px;    animation: dc-down  var(--dur) linear infinite var(--dl); }
    .dc.right { top: var(--y);  left: -24px;   animation: dc-right var(--dur) linear infinite var(--dl); }
    .dc.left  { top: var(--y);  right: -24px;  animation: dc-left  var(--dur) linear infinite var(--dl); }
    @keyframes dc-up    { 0%{transform:translateY(0);opacity:0} 12%{opacity:.75} 85%{opacity:.75} 100%{transform:translateY(-540px);opacity:0} }
    @keyframes dc-down  { 0%{transform:translateY(0);opacity:0} 12%{opacity:.6}  85%{opacity:.6}  100%{transform:translateY(540px);opacity:0} }
    @keyframes dc-right { 0%{transform:translateX(0);opacity:0} 12%{opacity:.6}  85%{opacity:.6}  100%{transform:translateX(1100px);opacity:0} }
    @keyframes dc-left  { 0%{transform:translateX(0);opacity:0} 12%{opacity:.6}  85%{opacity:.6}  100%{transform:translateX(-1100px);opacity:0} }

    .hero-in { position: relative; max-width: 720px; margin: 0 auto; }
    .badge { display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px; margin-bottom: 22px;
      font-size: calc(12.5px * var(--font-scale)); font-weight: 500; color: var(--primary-base);
      background: color-mix(in srgb, var(--primary-base) 9%, transparent);
      border: 1px solid color-mix(in srgb, var(--primary-base) 28%, transparent); border-radius: var(--radius-full); }
    .hero-h { margin: 0 0 18px; font-size: clamp(34px, 5vw, 52px); line-height: 1.12; letter-spacing: -0.02em;
      font-weight: 800; color: var(--text-strong); }
    .hero-grad { background: linear-gradient(100deg, var(--primary-base),
        color-mix(in srgb, var(--primary-base) 45%, var(--text-strong)));
      -webkit-background-clip: text; background-clip: text; color: transparent; }
    .hero-sub { margin: 0 auto 28px; max-width: 560px; font-size: calc(15.5px * var(--font-scale)); line-height: 1.65; color: var(--text-sub); font-weight: 300; }
    .hero-sub b { color: var(--text-body); font-weight: 600; }
    .hero-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px; }

    .hero-stats { display: flex; align-items: center; justify-content: center; gap: 26px; flex-wrap: wrap; }
    .hs-v { font-size: var(--fs-22); font-weight: 800; color: var(--text-strong); letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
    .hs-l { font-size: var(--fs-12); color: var(--text-soft); margin-top: 2px; }
    .hs-sep { width: 1px; height: 30px; background: var(--border-soft); }

    /* ===== MARQUEE ===== */
    /* Fade mép bằng MASK (làm chip trong suốt dần) → khớp mọi background light/dark, không phụ thuộc màu. */
    .mq { position: relative; margin-top: 26px; overflow: hidden; display: flex; flex-direction: column; gap: 10px; padding: 4px 0;
      -webkit-mask: linear-gradient(90deg, transparent 0, #000 9%, #000 91%, transparent 100%);
      mask: linear-gradient(90deg, transparent 0, #000 9%, #000 91%, transparent 100%); }
    .mq-track { display: flex; width: max-content; }
    .mq-seg { display: flex; gap: 10px; padding-right: 10px; animation: mq-slide 36s linear infinite; }
    .mq-rev .mq-seg { animation-direction: reverse; animation-duration: 42s; }
    .mq:hover .mq-seg { animation-play-state: paused; }
    @keyframes mq-slide { to { transform: translateX(-100%); } }
    .chip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; white-space: nowrap;
      font-size: var(--fs-13); font-weight: 500; color: var(--text-body);
      border: 1px solid var(--border-sub); border-radius: var(--radius-full); background: var(--bg-surface);
      transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out); }
    .chip:hover { border-color: var(--hue); transform: translateY(-2px); box-shadow: var(--shadow-regular-sm); color: var(--text-strong); }
    .chip-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--hue, var(--primary-base)); }

    /* ===== SECTION HEAD ===== */
    .bento-wrap { margin-top: 44px; }
    .sec-head { text-align: center; margin-bottom: 24px; }
    .sec-kicker { display: inline-block; margin-bottom: 8px; font-size: calc(11.5px * var(--font-scale)); font-weight: 700; letter-spacing: .12em;
      text-transform: uppercase; color: var(--primary-base); }
    .sec-h { margin: 0 0 6px; font-size: var(--fs-26); font-weight: 800; letter-spacing: -0.015em; color: var(--text-strong); }
    .sec-s { margin: 0 auto; max-width: 540px; font-size: calc(13.5px * var(--font-scale)); color: var(--text-sub); line-height: 1.6; }

    /* ===== BENTO + spotlight bám chuột ===== */
    .bento { display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; }
    .cell { position: relative; border: 1px solid var(--border-sub); border-radius: var(--radius-xl); background: var(--bg-surface);
      padding: 16px; overflow: hidden;
      transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out); }
    /* lớp spotlight — sáng theo vị trí con trỏ (JS set --mx/--my) */
    .cell::before { content: ''; position: absolute; inset: -1px; z-index: 0; opacity: 0; pointer-events: none;
      background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 50%),
        color-mix(in srgb, var(--primary-base) 9%, transparent), transparent 65%);
      transition: opacity .3s var(--ease-out, ease); }
    .cell:hover::before { opacity: 1; }
    .cell:hover { border-color: color-mix(in srgb, var(--primary-base) 45%, var(--border-sub)); box-shadow: var(--shadow-regular-sm); transform: translateY(-2px); }
    .cell > * { position: relative; z-index: 1; }
    .cell-t { display: flex; align-items: center; gap: 7px; font-size: var(--fs-11); font-weight: 700; text-transform: uppercase;
      letter-spacing: .06em; color: var(--text-soft); margin-bottom: 12px; }
    .cell-tick { width: 14px; height: 2px; border-radius: 2px; background: var(--primary-base); opacity: .8; }
    .cell-body { display: flex; flex-direction: column; gap: 10px; }

    .cell-form { grid-column: span 4; }
    .form-demo { gap: 10px; }
    .cell-stat { grid-column: span 4; }
    .cell-chart { grid-column: span 4; grid-row: span 2; }
    .chart-demo { gap: 6px; }
    .spark-row { display: flex; align-items: center; justify-content: space-between; gap: 10px;
      padding: 10px 12px; border: 1px dashed var(--border-sub); border-radius: var(--radius-lg); }
    .spark-l { font-size: var(--fs-12); color: var(--text-sub); }
    .spark-v { font-size: var(--fs-18); font-weight: 700; color: var(--text-strong); }
    .cell-ctrl { grid-column: span 4; }
    .ctrl-demo { gap: 12px; align-items: flex-start; }
    .ctrl-row { display: flex; align-items: center; gap: 10px; }
    .ctrl-l { font-size: var(--fs-13); color: var(--text-body); }
    .cell-people { grid-column: span 4; }
    .people-demo { gap: 14px; align-items: flex-start; }
    .tag-row { display: flex; gap: 6px; flex-wrap: wrap; }

    @media (max-width: 1100px) {
      .cell-form, .cell-stat, .cell-chart, .cell-ctrl, .cell-people { grid-column: span 6; }
      .cell-chart { grid-row: span 1; }
    }
    @media (max-width: 680px) {
      .cell-form, .cell-stat, .cell-chart, .cell-ctrl, .cell-people { grid-column: span 12; }
      .hero { padding: 48px 18px 40px; }
    }

    /* ===== LỐI ĐI NHANH — hàng editorial đánh số ===== */
    .paths { margin-top: 48px; }
    .path-list { display: flex; flex-direction: column; border-top: 1px solid var(--border-sub); }
    .path { display: flex; align-items: center; gap: 18px; padding: 20px 10px; border-bottom: 1px solid var(--border-sub);
      position: relative; overflow: hidden; }
    .path::after { content: ''; position: absolute; left: 0; bottom: -1px; height: 1px; width: 100%;
      background: var(--primary-base); transform: scaleX(0); transform-origin: left;
      transition: transform .35s var(--ease-out, ease); }
    .path:hover::after { transform: scaleX(1); }
    .path-no { font-size: var(--fs-13); font-weight: 700; color: var(--text-disabled); font-variant-numeric: tabular-nums; width: 26px; flex: none;
      transition: color var(--duration-fast) var(--ease-out); }
    .path:hover .path-no { color: var(--primary-base); }
    .path-ic { display: grid; place-items: center; width: 42px; height: 42px; flex: none; border-radius: var(--radius-lg);
      color: var(--text-sub); background: var(--bg-surface-subtle); border: 1px solid var(--border-soft);
      transition: color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out); }
    .path:hover .path-ic { color: var(--primary-base); background: color-mix(in srgb, var(--primary-base) 9%, transparent); transform: scale(1.06); }
    .path-tx { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .path-h { font-size: var(--fs-16); font-weight: 700; color: var(--text-strong); letter-spacing: -0.01em; }
    .path-b { font-size: var(--fs-13); color: var(--text-sub); }
    .path-arrow { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
      color: var(--text-soft); border: 1px solid var(--border-sub);
      transition: transform .3s var(--ease-out, ease), color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out); }
    .path:hover .path-arrow { transform: translateX(6px); color: var(--text-on-primary, #fff); background: var(--primary-base); border-color: var(--primary-base); }
  