
:host { display: inline-flex; }
:host(.hrm-button-group--vertical) { flex-direction: column; }
:host(.hrm-button-group--block) { display: flex; width: 100%; }
:host(.hrm-button-group--block) ::ng-deep :is(.hrm-button, .hrm-toggle-button) { flex: 1; }
:host(.hrm-button-group--block) ::ng-deep :is(.hrm-button, .hrm-toggle-button) .ant-btn { width: 100%; }

/* Ngang: bỏ bo góc mặt tiếp giáp + gộp viền chồng (-1px). */
:host(:not(.hrm-button-group--vertical)) ::ng-deep :is(.hrm-button, .hrm-toggle-button) + :is(.hrm-button, .hrm-toggle-button) .ant-btn { margin-left: -1px; }
:host(:not(.hrm-button-group--vertical)) ::ng-deep :is(.hrm-button, .hrm-toggle-button):not(:first-child) .ant-btn { border-top-left-radius: 0; border-bottom-left-radius: 0; }
:host(:not(.hrm-button-group--vertical)) ::ng-deep :is(.hrm-button, .hrm-toggle-button):not(:last-child) .ant-btn { border-top-right-radius: 0; border-bottom-right-radius: 0; }

/* Dọc. */
:host(.hrm-button-group--vertical) ::ng-deep :is(.hrm-button, .hrm-toggle-button) + :is(.hrm-button, .hrm-toggle-button) .ant-btn { margin-top: -1px; }
:host(.hrm-button-group--vertical) ::ng-deep :is(.hrm-button, .hrm-toggle-button):not(:first-child) .ant-btn { border-top-left-radius: 0; border-top-right-radius: 0; }
:host(.hrm-button-group--vertical) ::ng-deep :is(.hrm-button, .hrm-toggle-button):not(:last-child) .ant-btn { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }

/* Nút đang hover/focus/bật nổi lên trên để viền không bị che. */
:host ::ng-deep :is(.hrm-button, .hrm-toggle-button):hover .ant-btn,
:host ::ng-deep :is(.hrm-button, .hrm-toggle-button):focus-within .ant-btn,
:host ::ng-deep :is(.hrm-button, .hrm-toggle-button) .ant-btn-primary { position: relative; z-index: 1; }
  