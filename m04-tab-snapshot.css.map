
    :host { display: flex; flex-direction: column; gap: 18px; min-height: 0; overflow: auto; padding: 12px 2px 24px; }

    .t1-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .t1-head__lb { font-size: var(--fs-12); color: var(--text-sub); }
    .t1-head__ver { display: inline-block; width: 210px; }
    .t1-head__note { font-size: var(--fs-12); color: var(--text-soft); }
    .t1-head__gap { flex: 1; }
    .t1-head__sodu { font-size: var(--fs-12); color: var(--text-sub); }
    .t1-head__sodu b { color: var(--text-strong); }

    .t1-sec { display: flex; flex-direction: column; gap: 8px; }
    .t1-sec__title { margin: 0; font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .t1-sec__hint { font-size: var(--fs-11); font-weight: 400; color: var(--text-soft); display: inline-flex; align-items: center; gap: 4px; }

    .t1-funds { border-collapse: collapse; width: 100%; max-width: 720px; font-size: var(--fs-13); }
    .t1-funds th, .t1-funds td { border: 1px solid var(--border-sub); padding: 7px 12px; text-align: left; }
    .t1-funds th { background: var(--bg-surface-subtle); font-weight: 600; color: var(--text-sub); font-size: var(--fs-12); }
    .t1-funds .num { text-align: right; font-variant-numeric: tabular-nums; }
    .t1-funds__total td { font-weight: 700; background: var(--bg-surface-subtle); color: var(--text-strong); }
    .t1-cell { border: 0; background: none; padding: 0; cursor: pointer; font: inherit; color: var(--primary-base); font-variant-numeric: tabular-nums; }
    .t1-cell:hover { text-decoration: underline; }
    .t1-cell--warn { color: var(--warning-text); font-weight: 600; }
    .t1-funds__note { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .t1-funds__note b { color: var(--text-strong); font-variant-numeric: tabular-nums; }

    .t1-user { display: flex; flex-direction: column; min-width: 0; }
    .t1-user__name { color: var(--text-strong); font-weight: 500; }
    .t1-user__name--dim { color: var(--text-soft); text-decoration: line-through; }
    .t1-user__sub { font-size: var(--fs-12); color: var(--text-sub); }
    .t1-muted { color: var(--text-soft); font-size: var(--fs-12); }
    .t1-actrow { display: inline-flex; gap: 10px; }
    .t1-link { border: 0; background: none; padding: 0; cursor: pointer; font: inherit; font-size: var(--fs-12); font-weight: 600; color: var(--primary-base); }
    .t1-link--danger { color: var(--error-base); }
    .t1-money { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--text-strong); }
    .t1-money--neg { color: var(--success-base); }
    .t1-btst { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

    .t1-dn-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .t1-dn { border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 10px 14px; display: flex; flex-direction: column; gap: 4px; }
    .t1-dn__main { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .t1-dn__id { font-weight: 700; color: var(--text-strong); }
    .t1-dn__quy { font-size: var(--fs-12); color: var(--text-sub); font-variant-numeric: tabular-nums; }
    .t1-dn__tong { margin-left: auto; font-weight: 700; color: var(--text-strong); font-variant-numeric: tabular-nums; display: inline-flex; align-items: center; gap: 6px; }
    .t1-dn__sub { font-size: var(--fs-12); color: var(--text-soft); }
    .t1-dn__act { display: flex; gap: 8px; }

    .t1-empty { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 56px 0; }
    .t1-empty__note { margin: 0; font-size: var(--fs-12); color: var(--text-soft); }

    .t1-peek { display: flex; flex-direction: column; gap: 6px; font-size: var(--fs-13); }
    .t1-peek__note { margin: 0 0 4px; font-size: var(--fs-12); color: var(--text-sub); }
    .t1-peek__row { display: flex; align-items: baseline; gap: 8px; padding: 3px 0; border-bottom: 1px dashed var(--border-sub); }
    .t1-peek__row b { margin-left: auto; font-variant-numeric: tabular-nums; color: var(--text-strong); }
    .t1-peek__sub { font-size: var(--fs-11); color: var(--text-soft); }
    .t1-peek__total { display: flex; align-items: center; gap: 8px; padding-top: 8px; font-weight: 600; }
    .t1-peek__total b { margin-left: auto; font-variant-numeric: tabular-nums; }

    .t1-form { display: flex; flex-direction: column; gap: 8px; }
    .t1-form__hint { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .t1-form__err { font-size: var(--fs-12); color: var(--error-text); }
  