
.hrm-grouped-rows { display: block; font-family: var(--font-sans); }
.gr-root { display: flex; flex-direction: column; }
.gr-group { display: flex; flex-direction: column; }

.gr-head { display: flex; align-items: center; gap: var(--space-2, 8px); width: 100%; min-height: 38px;
  padding: var(--space-2, 8px) var(--space-3, 12px);
  padding-inline-start: calc(var(--space-3, 12px) + var(--gr-depth, 0) * var(--space-5, 20px));
  border: 0; border-top: 1px solid var(--border-soft); background: var(--bg-surface-subtle);
  color: var(--text-strong); font: inherit; text-align: start; cursor: pointer; }
.gr-head:hover { background: var(--bg-surface); }
.gr-head:focus-visible { outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: -2px; }
.gr-caret { flex: none; color: var(--text-soft); }
.gr-label { font-size: var(--fs-13, 13px); font-weight: var(--font-semibold, 600); white-space: nowrap; }
.gr-count { display: inline-grid; place-items: center; min-width: 20px; height: 18px; padding: 0 6px;
  border-radius: var(--radius-full); background: var(--primary-bg-soft); color: var(--primary-base);
  font-size: var(--fs-11, 11px); font-weight: var(--font-semibold, 600); line-height: 1; }

/* Mở/thu mượt: body xuất hiện với hiệu ứng trượt-mờ nhẹ. */
.gr-body { display: flex; flex-direction: column; animation: gr-reveal var(--duration-fast, .16s) var(--ease-out, ease); }
@keyframes gr-reveal { from { opacity: 0; transform: translateY(-3px); } to { opacity: 1; transform: none; } }

/* Hàng dữ liệu KHÔNG thụt theo cấp → THẲNG cột với header (cấu trúc lồng thể hiện qua group-header
   thụt lề + đếm). Nếu thụt hàng lá, lưới div-grid bị đẩy phải, lệch cột header. */
.gr-row { padding-inline-start: 0; }
.gr-row-fallback { min-height: 34px; display: flex; align-items: center;
  padding-block: var(--space-2, 8px); padding-inline-end: var(--space-3, 12px);
  padding-inline-start: calc(var(--space-3, 12px) + var(--gr-depth, 0) * var(--space-5, 20px));
  border-top: 1px solid var(--border-soft); font-size: var(--fs-13, 13px); color: var(--text-body); }

.gr-empty { padding: var(--space-6, 24px) var(--space-4, 16px); text-align: center;
  font-size: var(--fs-13, 13px); color: var(--text-soft); }
  