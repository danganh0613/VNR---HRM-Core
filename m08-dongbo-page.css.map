
    :host { display: flex; flex-direction: column; gap: 10px; }
    .s-lan { border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface); padding: 10px 13px; display: flex; flex-direction: column; gap: 7px; }
    .s-lan__head { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
    .s-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 700; color: var(--text-strong); }
    .s-muted { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .s-eq { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; font-size: var(--fs-13);
      border: 1px dashed var(--border-sub); border-radius: var(--radius-md); padding: 7px 12px; font-variant-numeric: tabular-nums; }
    .s-eq[data-ok='true'] { border-color: var(--success-base, var(--success-text)); background: var(--success-bg); }
    .s-eq[data-ok='false'] { border-color: var(--error-base); background: var(--error-bg); }
    .s-eq__n { color: var(--text-body); }
    .s-eq__n b { font-size: var(--fs-16); color: var(--text-strong); }
    .s-eq__op { color: var(--text-soft); font-weight: 700; }
    .s-eq__check { margin-left: 8px; font-weight: 700; color: var(--success-text); }
    .s-eq[data-ok='false'] .s-eq__check { color: var(--error-text); }
    .s-loi { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; border-left: 3px solid var(--border-sub); padding: 4px 10px; }
    .s-link { font-size: var(--fs-12); color: var(--primary-base); font-weight: 500; }
    .s-vet { font-size: var(--fs-11); color: var(--text-soft); width: 100%; }
    .s-acts { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .s-err { font-size: var(--fs-12); color: var(--error-text); }
  