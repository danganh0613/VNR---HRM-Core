
:host { display: inline-flex; align-items: center; gap: 8px; min-width: 120px; width: 100%;
  --_c: var(--primary-base); }
:host([data-color='blue'])  { --_c: var(--blue-600); }
:host([data-color='green']) { --_c: var(--success-base); }
:host([data-color='amber']) { --_c: var(--warning-base); }
:host([data-color='red'])   { --_c: var(--error-base); }
.pc-label { font-size: var(--fs-12); color: var(--text-sub); flex: none; }
.pc-track { position: relative; flex: 1; height: 6px; border-radius: var(--radius-full);
  background: var(--track); overflow: hidden; }
.pc-fill { position: absolute; inset: 0 auto 0 0; height: 100%; border-radius: var(--radius-full);
  background: var(--_c); transition: width var(--duration-slow) var(--ease-out); }
.pc-val { flex: none; min-width: 34px; text-align: right; font-size: var(--fs-12); font-weight: 500;
  color: var(--text-body); font-variant-numeric: tabular-nums; }
  