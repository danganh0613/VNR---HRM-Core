
    :host { display: flex; flex-direction: column; gap: 14px; font-size: var(--fs-13); }
    tabler-icon { display: inline-flex; align-items: center; flex: none; }

    .lp__head { display: flex; flex-direction: column; gap: 8px; }
    .lp__tags { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    :host ::ng-deep .lp__tags .ant-tag { margin: 0; }
    .lp__note { margin: 0; font-size: var(--fs-11); color: var(--text-soft); }
    .lp__muted { color: var(--text-soft); font-size: var(--fs-12); font-weight: 400; }
    .lp__muted-line { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .lp__warn { margin: 0; display: inline-flex; align-items: center; gap: 5px; font-size: var(--fs-12); color: var(--warning-text); }
    .lp__warned { color: var(--warning-text); }
    .lp__miss { color: var(--warning-text); font-weight: 500; }
    .lp__blockreason { font-size: var(--fs-12); color: var(--error-text); }

    .lp__sec { display: flex; flex-direction: column; gap: 8px; padding-top: 10px; border-top: 1px solid var(--border-soft); }
    .lp__params { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .lp__param { display: inline-block; width: 200px; }

    .lp__rows { display: flex; flex-direction: column; gap: 4px; }
    .lp__row { display: flex; gap: 10px; align-items: baseline; }
    .lp__k { flex: none; width: 168px; font-size: var(--fs-12); color: var(--text-sub); }
    .lp__v { flex: 1; min-width: 0; color: var(--text-body); }
    .lp__v b { color: var(--text-strong); font-weight: 600; }

    /* Item / ứng viên */
    .lp__item { display: flex; align-items: center; gap: 10px; padding: 6px 8px; border: 1px solid var(--border-soft); border-radius: var(--radius-md); }
    :host ::ng-deep .lp__item .ant-tag { margin: 0; }
    .lp__item-main { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; text-align: left; }
    .lp__item-name { color: var(--text-strong); font-weight: 500; font-size: var(--fs-13); }
    .lp__item-sub { font-size: var(--fs-12); color: var(--text-sub); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .lp__item-flag { font-size: var(--fs-11); color: var(--warning-text); font-weight: 500; }

    .lp__cand { display: flex; align-items: center; gap: 10px; padding: 6px 8px; border: 1px solid var(--border-soft);
      border-radius: var(--radius-md); background: none; cursor: pointer; font: inherit; width: 100%; }
    .lp__cand:disabled { opacity: .55; cursor: not-allowed; }
    .lp__cand--on { border-color: var(--primary-base); background: var(--primary-bg-subtle); }
    .lp__cand-check { flex: none; width: 15px; height: 15px; border: 1.5px solid var(--border-input); border-radius: var(--radius-sm); }
    .lp__cand-check--on { background: var(--primary-base); border-color: var(--primary-base); }
    .lp__cand-warn { flex: none; font-size: var(--fs-11); color: var(--warning-text); max-width: 160px; text-align: right; }

    /* Hồi tố */
    .lp__ht { display: flex; flex-direction: column; gap: 8px; padding: 8px 10px; border: 1px solid var(--border-soft); border-radius: var(--radius-md); }
    .lp__ht-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    :host ::ng-deep .lp__ht-head .ant-tag { margin: 0; }
    .lp__ht-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .lp__ht-rows { display: flex; flex-direction: column; gap: 4px; }
    .lp__ht-rowhead { display: flex; gap: 12px; font-size: var(--fs-11); font-weight: 600; text-transform: uppercase; letter-spacing: .02em; color: var(--text-soft); }
    .lp__ht-rowhead span:first-child { flex: none; width: 84px; }
    .lp__ht-row { display: flex; gap: 12px; align-items: baseline; padding: 3px 0; border-top: 1px dashed var(--border-soft); }
    .lp__ht-ky { flex: none; width: 84px; font-size: var(--fs-12); font-weight: 600; color: var(--text-body); font-variant-numeric: tabular-nums; }
    .lp__kychip { display: inline-block; margin-right: 8px; font-size: var(--fs-12); color: var(--text-sub); background: var(--bg-surface-subtle); border-radius: var(--radius-sm); padding: 0 6px; }

    .lp__collapse { display: block; }
    .lp__td { display: flex; flex-direction: column; gap: 8px; }
  