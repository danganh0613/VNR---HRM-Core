
    :host { display: flex; flex-direction: column; gap: 8px; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg); padding: 12px 14px; }
    .q4-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .q4-muted { font-size: var(--fs-11); color: var(--text-soft); }
    .q4-che { margin: 0; font-size: var(--fs-12); color: var(--warning-text); font-weight: 500; }
    .q4-empty { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .q4-chain {
      display: flex; align-items: stretch; gap: 6px; flex-wrap: wrap; cursor: pointer; text-align: left;
      font: inherit; background: none; border: 1px dashed var(--border-sub); border-radius: var(--radius-md); padding: 8px 10px;
    }
    .q4-chain:hover { border-color: var(--primary-base); }
    .q4-cell { display: flex; flex-direction: column; gap: 1px; min-width: 92px; }
    .q4-cell b { font-size: var(--fs-13); font-weight: 700; color: var(--text-strong); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .q4-cell i { font-style: normal; font-size: var(--fs-11); color: var(--text-sub); }
    .q4-cell--kq b { color: var(--primary-base); }
    .q4-op { align-self: center; font-size: var(--fs-14); font-weight: 700; color: var(--text-soft); }
    .q4-note { margin: 0; font-size: var(--fs-11); color: var(--text-sub); }
    .q4-note b { color: var(--text-strong); }
  