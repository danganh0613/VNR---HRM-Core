
    :host { display: block; }
    .kt { display: flex; flex-direction: column; gap: 10px; }
    .kt-head, .kt-meta, .kt-cmp { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .kt-sel { width: 220px; }
    .kt-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .kt-muted b { color: var(--text-strong); }
    .kt-strong { font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); }

    .kt-scroll { overflow-x: auto; border: 1px solid var(--border-sub); border-radius: var(--radius-md); }
    .kt-table { border-collapse: collapse; width: max-content; min-width: 100%; font-size: var(--fs-12); }
    .kt-th {
      position: sticky; top: 0; text-align: right; white-space: nowrap; padding: 6px 10px;
      background: var(--bg-surface-subtle); color: var(--text-sub); font-weight: 600;
      border-bottom: 1px solid var(--border-sub);
    }
    .kt-th--name { text-align: left; min-width: 260px; }
    .kt-td { padding: 5px 10px; border-bottom: 1px solid var(--border-sub); color: var(--text-body); }
    .kt-td--num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .kt-td--name b { color: var(--text-strong); margin-right: 4px; }
    .kt-diff { display: flex; flex-direction: column; gap: 3px; }
    .kt-diff__item { font-size: var(--fs-12); color: var(--warning-text); }
  