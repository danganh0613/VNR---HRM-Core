
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }
    .t1-split { flex: 1 1 auto; min-height: 480px; display: flex; gap: 12px; align-items: stretch; }
    .t1-main { flex: 1 1 auto; min-width: 0; overflow: auto; }
    .t1-empty { padding: 40px 0; display: flex; justify-content: center; }
    .t1-tep { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .t1-tep__tags { display: flex; gap: 4px; }
    .t1-stack { display: flex; flex-direction: column; gap: 2px; }
    .t1-strong { color: var(--text-strong); font-weight: 500; }
    .t1-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .t1-warn { color: var(--error-text); font-weight: 600; }
    .t1-hash { font-family: var(--font-mono, monospace); font-size: var(--fs-12); color: var(--success-text); }
    .t1-hash--bad { color: var(--error-text); font-weight: 700; }
    .t1-pk { display: flex; flex-direction: column; gap: 10px; font-size: var(--fs-13); }
    .t1-pk__name { margin: 0; font-weight: 600; color: var(--text-strong); }
    .t1-pk__row { display: flex; gap: 8px; }
    .t1-pb { display: flex; gap: 10px; border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 7px 10px; }
    .t1-pb--bad { border-color: var(--error-base); background: var(--error-bg); }
    .t1-pb__so { font-family: var(--font-mono, monospace); font-weight: 700; color: var(--primary-base); }
    .t1-pb__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .t1-log { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; font-size: var(--fs-12); color: var(--text-body); padding: 3px 0; border-bottom: 1px dashed var(--border-soft); }
    .t1-log--denied { color: var(--error-text); }
  