
.sc-ov { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: 24px; }
.sc-bd { position: absolute; inset: 0; background: var(--overlay-bg, rgba(0,0,0,.45)); }
.sc-dlg { position: relative; width: 100%; max-width: 560px; background: var(--bg-surface);
  border: 1px solid var(--border-sub); border-radius: var(--radius-xl, 12px); box-shadow: var(--shadow-regular-lg);
  font-family: var(--font-sans); display: flex; flex-direction: column; max-height: 88vh; }
.sc-hd { display: flex; align-items: center; gap: 8px; padding: 14px 16px 0; }
.sc-t { display: flex; align-items: center; gap: 8px; font-size: var(--fs-16, 16px); font-weight: var(--font-semibold, 600); color: var(--text-strong); }
.sc-x { margin-inline-start: auto; display: grid; place-items: center; width: 30px; height: 30px; border: 0; background: transparent;
  border-radius: var(--radius-md, 8px); color: var(--text-soft); cursor: pointer; }
.sc-x:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
.sc-sub { margin: 6px 16px 14px; font-size: var(--fs-13, 13px); color: var(--text-sub); }

.sc-empty { margin: 0 16px; padding: 28px 16px; text-align: center; font-size: var(--fs-13, 13px); color: var(--text-soft);
  border: 1px dashed var(--border-sub); border-radius: var(--radius-lg, 10px); }

.sc-list { display: flex; flex-direction: column; gap: 8px; padding: 0 16px; overflow-y: auto; }
.sc-row { display: flex; align-items: center; gap: 8px; background: var(--bg-surface); }
.sc-grip { flex: none; display: inline-grid; place-items: center; width: 22px; height: 34px; color: var(--text-soft); cursor: grab; border-radius: var(--radius-sm, 6px); }
.sc-grip:hover { background: var(--bg-surface-subtle); color: var(--text-body); }
.sc-grip:active { cursor: grabbing; }
.sc-lead { flex: none; width: 64px; font-size: var(--fs-13, 13px); color: var(--text-soft); }
.sc-sel { position: relative; flex: 1; min-width: 0; }
.sc-sel select { width: 100%; height: 36px; padding: 0 30px 0 10px; border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px);
  background: var(--bg-surface); color: var(--text-body); font: inherit; font-size: var(--fs-14, 14px); cursor: pointer;
  appearance: none; -webkit-appearance: none; }
.sc-sel select:focus-visible { outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: 1px; border-color: var(--primary-base); }
.sc-sel-ic { position: absolute; inset-inline-end: 8px; top: 50%; transform: translateY(-50%); color: var(--text-soft); pointer-events: none; }
.sc-dir { flex: none; display: inline-flex; border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px); overflow: hidden; }
.sc-dir button { display: inline-flex; align-items: center; gap: 4px; height: 34px; padding: 0 10px; border: 0; background: transparent;
  color: var(--text-sub); font: inherit; font-size: var(--fs-13, 13px); cursor: pointer; }
.sc-dir button + button { border-inline-start: 1px solid var(--border-sub); }
.sc-dir button.on { background: var(--primary-bg-subtle); color: var(--primary-base); font-weight: var(--font-medium, 500); }
.sc-del { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border: 0; background: transparent;
  border-radius: var(--radius-md, 8px); color: var(--text-soft); cursor: pointer; }
.sc-del:hover { background: var(--error-bg); color: var(--error-base); }

.sc-add { margin: 12px 16px 4px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 40px;
  border: 1px dashed var(--border-sub); border-radius: var(--radius-md, 8px); background: transparent; color: var(--text-sub);
  font: inherit; font-size: var(--fs-14, 14px); cursor: pointer; }
.sc-add:hover:not(:disabled) { border-color: var(--primary-border); color: var(--text-strong); }
.sc-add:disabled { opacity: .5; cursor: not-allowed; }

.sc-ft { display: flex; align-items: center; gap: 8px; padding: 12px 16px; margin-top: 8px; border-top: 1px solid var(--border-soft); }
.sc-sp { flex: 1; }
.sc-clear { border: 0; background: transparent; color: var(--text-sub); font: inherit; font-size: var(--fs-14, 14px); cursor: pointer; padding: 6px 4px; }
.sc-clear:hover { color: var(--text-strong); }
.sc-btn { height: 36px; padding: 0 14px; border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px);
  background: var(--bg-surface); color: var(--text-body); font: inherit; font-size: var(--fs-14, 14px); cursor: pointer; }
.sc-btn:hover { background: var(--bg-surface-subtle); }
.sc-btn.is-primary { background: var(--primary-base); color: var(--text-on-primary); border-color: var(--primary-base); }
.sc-btn.is-primary:hover { background: var(--primary-strong, var(--primary-base)); }
.sc-btn:focus-visible, .sc-clear:focus-visible { outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: 1px; }

.cdk-drag-preview .sc-row, .sc-row.cdk-drag-preview { box-shadow: var(--shadow-regular-md); border-radius: var(--radius-md, 8px); }
.cdk-drag-placeholder { opacity: .4; }
  