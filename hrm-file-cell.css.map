
:host { display: inline-flex; align-items: center; gap: 10px; min-width: 0; max-width: 100%; }
.fc-ic { flex: none; width: 32px; height: 32px; border-radius: var(--radius-md); display: grid; place-items: center; }
.fc-ic[data-tone='red']    { background: var(--error-bg);   color: var(--error-base); }
.fc-ic[data-tone='blue']   { background: var(--info-bg);    color: var(--info-base); }
.fc-ic[data-tone='green']  { background: var(--success-bg); color: var(--success-base); }
.fc-ic[data-tone='amber']  { background: var(--warning-bg); color: var(--warning-base); }
.fc-ic[data-tone='purple'] { background: var(--feature-bg); color: var(--feature-base); }
.fc-ic[data-tone='neutral']{ background: var(--bg-surface-subtle); color: var(--text-sub); }
.fc-body { display: flex; flex-direction: column; min-width: 0; }
.fc-name { font-size: var(--fs-14); color: var(--text-strong); line-height: 1.35;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fc-size { font-size: var(--fs-12); color: var(--text-sub); line-height: 1.3; }
  