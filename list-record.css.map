
    :host { display: block; }
    /* Bỏ padding của vùng cuộn shell KHI trang này hiện → topnav sticky trải sát mép + neo sát đỉnh.
       Nhịp trên/dưới do topnav + body tự lo. */
    ::ng-deep .shell-content:has(sg-list-record) { padding: 0 !important; }
    .lr { display: block; }

    /* TOPNAV: full bề rộng content shell, sticky đỉnh, nền surface + gạch dưới (như top nav). */
    .lr-nav {
      position: sticky; top: 0; z-index: 10;
      background: var(--bg-surface); border-bottom: 1px solid var(--border-sub);
    }
    /* Padding 2 bên = header design system (.lp-head = 16px = --space-4) để đồng bộ. */
    .lr-nav-in {
      max-width: 1080px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
      padding: var(--space-3) var(--space-4);
    }
    .lr-nav-l { display: flex; align-items: center; gap: var(--space-3); min-width: 0; }
    .lr-nav-r { display: flex; align-items: center; gap: var(--space-2); flex: none; }
    /* Tiêu đề đồng bộ header DS (fs-30) nhưng gọn trong topnav. */
    .lr-t { margin: 0; font-size: var(--fs-20); font-weight: 600; color: var(--text-strong); white-space: nowrap; }

    /* Body: card canh giữa, cách topnav 1 nhịp. */
    /* Body cùng padding 2 bên với topnav (space-4) → nội dung thẳng lề tiêu đề header. */
    .lr-body { max-width: 1080px; margin: 0 auto; padding: var(--space-5) var(--space-4) var(--space-2); }
    .lr-card {
      background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: var(--radius-lg); padding: var(--space-5);
    }
    .lr-empty { color: var(--text-sub); }
  