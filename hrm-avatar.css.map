
:host { position: relative; display: inline-flex; vertical-align: middle; }

/* colorful: nền hue SOLID (-600) + chữ TRẮNG (token) — 8 màu từ ramp. */
:host([data-hue="0"]) ::ng-deep .ant-avatar { background: var(--blue-600); color: var(--static-white); }
:host([data-hue="1"]) ::ng-deep .ant-avatar { background: var(--green-600); color: var(--static-white); }
:host([data-hue="2"]) ::ng-deep .ant-avatar { background: var(--amber-600); color: var(--static-white); }
:host([data-hue="3"]) ::ng-deep .ant-avatar { background: var(--red-600); color: var(--static-white); }
:host([data-hue="4"]) ::ng-deep .ant-avatar { background: var(--purple-600); color: var(--static-white); }
:host([data-hue="5"]) ::ng-deep .ant-avatar { background: var(--teal-600); color: var(--static-white); }
:host([data-hue="6"]) ::ng-deep .ant-avatar { background: var(--cyan-600); color: var(--static-white); }
:host([data-hue="7"]) ::ng-deep .ant-avatar { background: var(--pink-600); color: var(--static-white); }

/* status: chấm hiện diện + vòng viền nền (tách avatar khỏi nền dưới). */
.av-status {
  position: absolute; right: 0; width: 28%; height: 28%;
  min-width: 8px; min-height: 8px; max-width: 14px; max-height: 14px;
  border-radius: var(--radius-full);
  box-shadow: 0 0 0 2px var(--bg-surface);
}
:host([data-status-pos='bottom']) .av-status { bottom: 4%; }
:host([data-status-pos='top']) .av-status { top: 4%; }
.av-status[data-status='online']  { background: var(--success-base); }
.av-status[data-status='offline'] { background: var(--neutral-400); }
.av-status[data-status='busy']    { background: var(--error-base); }
.av-status[data-status='away']    { background: var(--away-base); }
  