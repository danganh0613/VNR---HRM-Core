
    :host {
      display: inline-flex; align-items: center; white-space: nowrap;
      font-size: var(--fs-11); line-height: 1.4; font-weight: 500;
      padding: 0 7px; border-radius: var(--radius-sm);
    }
    :host([data-layer='du-kien']) { background: var(--info-bg); color: var(--info-text); }
    :host([data-layer='da-giao-dich']) { background: var(--tag-purple-bg); color: var(--tag-purple-text); }
    :host([data-layer='chinh-thuc']) { background: var(--success-bg); color: var(--success-text); }
  