
:host { display: inline-flex; align-items: center; gap: 10px; min-width: 0; max-width: 100%; }
.mc-media { flex: none; width: 32px; height: 32px; display: grid; place-items: center;
  background: var(--bg-surface-subtle); color: var(--icon-secondary); overflow: hidden; }
.mc-media[data-shape='square'] { border-radius: var(--radius-md); }
.mc-media[data-shape='circle'] { border-radius: var(--radius-full); }
.mc-media img { width: 100%; height: 100%; object-fit: cover; }
.mc-body { display: flex; flex-direction: column; min-width: 0; }
.mc-label { font-size: var(--fs-14); color: var(--text-strong); line-height: 1.35;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mc-sub { font-size: var(--fs-12); color: var(--text-sub); line-height: 1.3;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  