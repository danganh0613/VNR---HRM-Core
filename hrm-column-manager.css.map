
.cm { position: relative; display: flex; flex-direction: column; min-height: 0; height: 100%; font-family: var(--font-sans, inherit); color: var(--text-body); }
/* Anchor popover Tạo nhóm cột ở đáy panel (trigger từ footer modal) — popover mở LÊN qua .cm-pop. */
.cm-create-anchor { position: absolute; inset-inline-start: 0; bottom: 0; width: 0; height: 0; }

.cm-head { display: flex; align-items: flex-start; gap: var(--space-4, 16px); padding-bottom: var(--space-3, 12px); }
.cm-head-txt { flex: 1; min-width: 0; }
.cm-title { margin: 0; font-size: var(--fs-16, 16px); font-weight: var(--font-semibold, 600); color: var(--text-strong); }
.cm-sub { margin: 2px 0 0; font-size: var(--fs-13, 13px); color: var(--text-sub); }

.cm-tools { display: flex; align-items: center; gap: var(--space-3, 12px); padding: var(--space-2, 8px) 0;
  border-bottom: 1px solid var(--border-soft); }
.cm-search { position: relative; flex: 1; min-width: 0; max-width: 300px; }
.cm-search-ic { position: absolute; inset-inline-start: 9px; top: 50%; transform: translateY(-50%); color: var(--text-soft); pointer-events: none; }
.cm-search-in { width: 100%; height: 32px; padding: 0 10px 0 30px; border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px);
  background: var(--bg-surface); color: var(--text-body); font: inherit; font-size: var(--fs-13, 13px); }
.cm-search-in:focus-visible { outline: none; border-color: var(--primary-base); box-shadow: 0 0 0 2px var(--primary-bg-subtle); }
.cm-count { flex: none; font-size: var(--fs-13, 13px); color: var(--text-sub); font-variant-numeric: tabular-nums; }
.cm-bulk { display: inline-flex; align-items: center; gap: var(--space-1, 4px); margin-inline-start: auto; }
.cm-bulk button { display: inline-flex; align-items: center; gap: 4px; border: 0; background: transparent; padding: 4px 6px;
  border-radius: var(--radius-sm, 6px); color: var(--text-sub); font: inherit; font-size: var(--fs-13, 13px); cursor: pointer; }
.cm-bulk button:hover { color: var(--primary-base); background: var(--primary-bg-subtle); }
.cm-dot { color: var(--text-soft); }

.cm-scroll { flex: 1; min-height: 0; overflow-y: auto; padding: var(--space-2, 8px) 0; display: flex; flex-direction: column; gap: var(--space-2, 8px); }
/* Các khối con GIỮ chiều cao nội dung, KHÔNG co (nếu không list cột co về min-height 4px → rows tràn/chồng lên nhau). */
.cm-scroll > * { flex: 0 0 auto; }
.cm-empty { padding: 32px 16px; text-align: center; font-size: var(--fs-13, 13px); color: var(--text-soft);
  border: 1px dashed var(--border-sub); border-radius: var(--radius-lg, 10px); }

.cm-sections { display: flex; flex-direction: column; gap: var(--space-2, 8px); }
.cm-group { border-radius: var(--radius-md, 8px); transition: background .12s ease, box-shadow .12s ease; }
.cm-group.is-hot { background: var(--primary-bg-subtle); box-shadow: inset 0 0 0 1px var(--primary-border); }

.cm-ghead { display: flex; align-items: center; gap: var(--space-2, 8px); height: 30px; padding: 0 var(--space-1, 4px); }
.cm-gname { font-size: var(--fs-11, 11px); font-weight: var(--font-semibold, 600); letter-spacing: .04em; text-transform: uppercase; color: var(--text-sub); }
.cm-gcnt { display: inline-grid; place-items: center; min-width: 18px; height: 16px; padding: 0 5px; border-radius: var(--radius-full);
  background: var(--bg-surface-subtle); color: var(--text-soft); font-size: var(--fs-10, 10px); font-variant-numeric: tabular-nums; }
.cm-gmenu-wrap { position: relative; margin-inline-start: auto; }
.cm-rename { flex: 1; height: 24px; padding: 0 8px; border: 1px solid var(--primary-base); border-radius: var(--radius-sm, 6px);
  background: var(--bg-surface); color: var(--text-strong); font: inherit; font-size: var(--fs-13, 13px); }
.cm-rename:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--primary-bg-subtle); }

.cm-members { display: flex; flex-direction: column; gap: 2px; margin-inline-start: var(--space-3, 12px); padding-inline-start: var(--space-2, 8px);
  border-inline-start: 1px solid var(--border-soft); min-height: 4px; }
.cm-flat { margin-inline-start: 0; padding-inline-start: 0; border-inline-start: 0; }
.cm-members.is-hot { border-inline-start-color: var(--primary-border); }
.cm-flat-lbl { font-size: var(--fs-11, 11px); font-weight: var(--font-medium, 500); letter-spacing: .03em; text-transform: uppercase;
  color: var(--text-soft); padding: var(--space-2, 8px) var(--space-1, 4px) 2px; }
.cm-slot { padding: 10px 12px; font-size: var(--fs-12, 12px); color: var(--text-soft); border: 1px dashed var(--border-sub);
  border-radius: var(--radius-sm, 6px); text-align: center; }

.cm-row { display: flex; align-items: center; gap: var(--space-2, 8px); height: 34px; padding: 0 var(--space-1, 4px);
  border-radius: var(--radius-sm, 6px); background: var(--bg-surface); }
.cm-row:hover { background: var(--bg-surface-subtle); }
.cm-row.is-comp:hover { background: var(--bg-surface-subtle); }
.cm-row--click { cursor: pointer; }
.cm-row--click:focus-visible { outline: 2px solid var(--primary-500, var(--primary-strong)); outline-offset: -2px; }
.cm-grip { flex: none; display: inline-grid; place-items: center; width: 20px; height: 26px; color: var(--text-soft); cursor: grab;
  border-radius: var(--radius-sm, 6px); }
.cm-grip:hover { color: var(--text-body); }
.cm-grip:active { cursor: grabbing; }
.cm-grip.is-off { opacity: .35; cursor: default; pointer-events: none; }
.cm-grip.is-static { cursor: default; color: var(--text-soft); opacity: .7; }
.cm-ghandle { flex: none; display: inline-grid; place-items: center; width: 20px; height: 24px; color: var(--text-soft); cursor: grab;
  border-radius: var(--radius-sm, 6px); }
.cm-ghandle:hover { color: var(--text-body); }
.cm-ghandle:active { cursor: grabbing; }
.cm-ghandle.is-off { opacity: .35; cursor: default; pointer-events: none; }

.cm-chk { flex: none; display: inline-grid; place-items: center; }
.cm-chk input { width: 15px; height: 15px; accent-color: var(--primary-base); cursor: pointer; margin: 0; }
.cm-chk input:disabled { cursor: not-allowed; opacity: .6; }
.cm-cname { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-size: var(--fs-13, 13px); color: var(--text-body); }
.cm-cname.is-off { color: var(--text-soft); }
.cm-ctype { flex: none; color: var(--text-soft); }
.cm-tag { flex: none; border: 1px solid var(--primary-border); background: var(--primary-bg-subtle); color: var(--primary-base);
  border-radius: var(--radius-full); padding: 1px 9px; font: inherit; font-size: var(--fs-11, 11px); font-weight: var(--font-medium, 500); cursor: pointer; }
.cm-tag:hover { background: var(--primary-bg-soft, var(--primary-bg-subtle)); }

.cm-icobtn { flex: none; display: grid; place-items: center; width: 26px; height: 26px; border: 0; background: transparent;
  border-radius: var(--radius-sm, 6px); color: var(--text-soft); cursor: pointer; }
.cm-icobtn:hover { background: var(--bg-surface); box-shadow: inset 0 0 0 1px var(--border-sub); color: var(--text-strong); }
.cm-row:hover .cm-icobtn { color: var(--text-sub); }

.cm-computed { border-top: 1px solid var(--border-soft); padding-top: var(--space-2, 8px); margin-top: var(--space-1, 4px);
  display: flex; flex-direction: column; gap: var(--space-2, 8px); }
.cm-chead { display: flex; align-items: center; gap: var(--space-2, 8px); height: 28px; padding: 0 var(--space-1, 4px); color: var(--primary-base); }

/* ---- Card cột tính toán: tên + ô công thức inline ---- */
.cm-comp-card { display: flex; flex-direction: column; gap: var(--space-2, 8px); padding: var(--space-2, 8px) var(--space-3, 12px) var(--space-3, 12px);
  border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px); background: var(--bg-surface); }
.cm-comp-top { display: flex; align-items: center; gap: var(--space-2, 8px); }
.cm-comp-sigma { flex: none; display: inline-grid; place-items: center; width: 20px; height: 26px; color: var(--primary-base); }
.cm-comp-name { flex: 1; min-width: 0; height: 30px; padding: 0 10px; border: 1px solid var(--border-sub); border-radius: var(--radius-sm, 6px);
  background: var(--bg-surface); color: var(--text-strong); font: inherit; font-size: var(--fs-13, 13px); font-weight: var(--font-medium, 500); }
.cm-comp-name:focus-visible { outline: none; border-color: var(--primary-base); box-shadow: 0 0 0 2px var(--primary-bg-subtle); }
.cm-icobtn.is-danger { color: var(--text-soft); }
.cm-icobtn.is-danger:hover { background: var(--error-bg); color: var(--error-base); box-shadow: inset 0 0 0 1px var(--error-border, var(--error-base)); }

.cm-fx-wrap { display: flex; align-items: stretch; gap: var(--space-2, 8px); }
.cm-fx { flex: 1; min-width: 0; min-height: 44px; padding: 8px 10px; border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px);
  background: var(--bg-surface-subtle); color: var(--text-body); resize: none; font-size: var(--fs-13, 13px); line-height: 1.5;
  font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace); }
.cm-fx::placeholder { color: var(--text-soft); }
/* Read-only preview: click để mở modal soạn công thức (không sửa inline). */
.cm-fx { resize: vertical; }
.cm-fx:focus-visible { outline: none; border-color: var(--primary-base); box-shadow: 0 0 0 2px var(--primary-bg-subtle); background: var(--bg-surface); }
.cm-fx-expand { flex: none; display: grid; place-items: center; width: 34px; align-self: stretch; border: 1px solid var(--border-sub);
  border-radius: var(--radius-md, 8px); background: var(--bg-surface); color: var(--text-sub); cursor: pointer; }
.cm-fx-expand:hover { border-color: var(--primary-border); color: var(--primary-base); background: var(--primary-bg-subtle); }
.cm-fx-expand:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--primary-bg-subtle); border-color: var(--primary-base); }

.cm-fx-empty { display: flex; align-items: center; gap: 6px; padding: 8px 10px; border: 1px solid var(--warning-border, var(--warning-base));
  border-radius: var(--radius-sm, 6px); background: var(--warning-bg); color: var(--warning-base); font-size: var(--fs-12, 12px); }
.cm-fx-summary { font-size: var(--fs-11, 11px); color: var(--text-soft); }

.cm-menu { position: absolute; inset-inline-end: 0; top: calc(100% + 4px); z-index: 30; min-width: 180px; padding: 4px;
  background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px); box-shadow: var(--shadow-regular-md, 0 6px 20px rgba(0,0,0,.12)); }
.cm-menu button { display: flex; align-items: center; gap: 8px; width: 100%; padding: 7px 8px; border: 0; background: transparent;
  border-radius: var(--radius-sm, 6px); color: var(--text-body); font: inherit; font-size: var(--fs-13, 13px); cursor: pointer; text-align: start; }
.cm-menu button:hover { background: var(--bg-surface-subtle); }
.cm-menu button.is-danger { color: var(--error-base); }
.cm-menu button.is-danger:hover { background: var(--error-bg); }
.cm-hint { color: var(--text-soft); font-size: var(--fs-11, 11px); }

.cm-foot { display: flex; flex-wrap: wrap; gap: var(--space-2, 8px); padding-top: var(--space-3, 12px); border-top: 1px solid var(--border-soft); }
.cm-create-wrap { position: relative; }

.cm-btn { display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 12px; border: 1px solid var(--border-sub);
  border-radius: var(--radius-md, 8px); background: var(--bg-surface); color: var(--text-body); font: inherit; font-size: var(--fs-13, 13px); cursor: pointer; }
.cm-btn:hover { background: var(--bg-surface-subtle); }
.cm-btn:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--primary-bg-subtle); border-color: var(--primary-base); }
.cm-btn.is-ghost { border-color: transparent; background: transparent; color: var(--text-sub); }
.cm-btn.is-ghost:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
.cm-btn.is-dashed { border-style: dashed; color: var(--text-sub); }
.cm-btn.is-dashed:hover { border-color: var(--primary-border); color: var(--text-strong); }
.cm-btn.is-primary { background: var(--primary-base); border-color: var(--primary-base); color: var(--text-on-primary, #fff); }
.cm-btn.is-primary:hover { background: var(--primary-strong, var(--primary-base)); }
.cm-btn.is-primary:disabled { opacity: .5; cursor: not-allowed; }

.cm-pop { position: absolute; bottom: calc(100% + 6px); inset-inline-start: 0; z-index: 40; width: 320px; max-width: 88vw; padding: 12px;
  background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg, 10px); box-shadow: var(--shadow-regular-lg, 0 10px 30px rgba(0,0,0,.16)); }
.cm-field { display: block; }
.cm-field-lbl { display: block; font-size: var(--fs-12, 12px); font-weight: var(--font-medium, 500); color: var(--text-sub); margin-bottom: 4px; }
.cm-field-in { width: 100%; height: 34px; padding: 0 10px; border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px);
  background: var(--bg-surface); color: var(--text-body); font: inherit; font-size: var(--fs-13, 13px); }
.cm-field-in:focus-visible { outline: none; border-color: var(--primary-base); box-shadow: 0 0 0 2px var(--primary-bg-subtle); }
.cm-pick-lbl { margin: 10px 0 6px; font-size: var(--fs-12, 12px); font-weight: var(--font-medium, 500); color: var(--text-sub); }
.cm-pick-list { max-height: 220px; overflow-y: auto; display: flex; flex-direction: column; gap: 1px; border: 1px solid var(--border-soft);
  border-radius: var(--radius-md, 8px); padding: 4px; }
.cm-pick { display: flex; align-items: center; gap: 8px; padding: 6px 6px; border-radius: var(--radius-sm, 6px); cursor: pointer; }
.cm-pick:hover { background: var(--bg-surface-subtle); }
.cm-pick input { width: 15px; height: 15px; accent-color: var(--primary-base); cursor: pointer; margin: 0; }
.cm-pick span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--fs-13, 13px); color: var(--text-body); }
.cm-pop-ft { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }

.cm-backdrop { position: fixed; inset: 0; z-index: 20; }

.cm-row.cdk-drag-preview { box-shadow: var(--shadow-regular-md, 0 6px 20px rgba(0,0,0,.14)); border: 1px solid var(--border-sub); background: var(--bg-surface); }
.cm-group.cdk-drag-preview { box-shadow: var(--shadow-regular-lg, 0 10px 30px rgba(0,0,0,.16)); background: var(--bg-surface); border-radius: var(--radius-md, 8px); }
.cdk-drag-placeholder { opacity: .35; }
.cm-members.cdk-drop-list-dragging .cm-row:not(.cdk-drag-placeholder) { transition: transform .16s cubic-bezier(0,0,.2,1); }
  