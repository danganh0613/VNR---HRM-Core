
    :host { display: flex; flex-direction: column; gap: 14px; min-height: 0; overflow: auto; padding: 12px 2px 24px; }
    .t4-pick { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .t4-pick__lb { font-size: var(--fs-12); color: var(--text-sub); }
    .t4-pick__ky { display: inline-block; width: 140px; }
    .t4-pick__ver { display: inline-block; width: 200px; }
    .t4-pick__vs { font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .t4-pick__gap { flex: 1; }

    .t4-sec { display: flex; flex-direction: column; gap: 8px; }
    .t4-sec__title { margin: 0; font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .t4-sec__hint { font-size: var(--fs-11); font-weight: 400; color: var(--text-soft); }

    .t4-table { border-collapse: collapse; width: 100%; max-width: 860px; font-size: var(--fs-13); }
    .t4-table th, .t4-table td { border: 1px solid var(--border-sub); padding: 7px 12px; text-align: left; }
    .t4-table th { background: var(--bg-surface-subtle); font-weight: 600; color: var(--text-sub); font-size: var(--fs-12); }
    .t4-table .num { text-align: right; font-variant-numeric: tabular-nums; }
    .t4-table__total td { font-weight: 700; background: var(--bg-surface-subtle); color: var(--text-strong); }

    .t4-nhom { display: flex; flex-direction: column; gap: 6px; max-width: 860px; }
    .t4-nhom__row { display: flex; align-items: center; gap: 10px; }
    .t4-nhom__label { flex: none; width: 230px; font-size: var(--fs-12); color: var(--text-body); }
    .t4-nhom__count { flex: none; width: 64px; font-size: var(--fs-11); color: var(--text-sub); }
    .t4-nhom__count--zero { color: var(--text-soft); }
    .t4-nhom__barwrap { flex: 1; height: 8px; background: var(--bg-surface-subtle); border-radius: var(--radius-full); overflow: hidden; }
    .t4-nhom__bar { height: 100%; border-radius: var(--radius-full); }
    .t4-nhom__bar[data-tone='up'] { background: var(--error-base); }
    .t4-nhom__bar[data-tone='down'] { background: var(--success-base); }
    .t4-nhom__bar[data-tone='zero'] { background: var(--border-sub); }
    .t4-nhom__num { flex: none; width: 120px; text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; font-size: var(--fs-12); }
    .t4-nhom__num[data-tone='up'] { color: var(--error-base); }
    .t4-nhom__num[data-tone='down'] { color: var(--success-base); }
    .t4-nhom__num[data-tone='zero'] { color: var(--text-soft); }

    .t4-top { display: flex; align-items: baseline; gap: 10px; max-width: 640px; padding: 4px 0; border-bottom: 1px dashed var(--border-sub); font-size: var(--fs-13); }
    .t4-top__why { font-size: var(--fs-12); color: var(--text-sub); }
    .t4-top b { margin-left: auto; font-variant-numeric: tabular-nums; }
    .t4-top b[data-tone='up'] { color: var(--error-base); }
    .t4-top b[data-tone='down'] { color: var(--success-base); }

    .t4-note { margin: 0; font-size: var(--fs-12); color: var(--text-soft); }
    .t4-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 40px 0; }
  