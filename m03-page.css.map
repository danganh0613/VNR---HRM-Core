
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; padding: 0 20px; }
    .m03-dv { display: inline-block; width: 240px; }
    .m03-a07 { font-size: var(--fs-11); font-weight: 500; color: var(--warning-text); background: var(--warning-bg);
      border: 1px dashed var(--warning-base, var(--warning-text)); border-radius: var(--radius-full); padding: 1px 9px; cursor: help; white-space: nowrap; }
    .m03-locked { display: inline-flex; align-items: center; gap: 5px; font-size: var(--fs-12); font-weight: 600;
      color: var(--warning-text); background: var(--warning-bg); border-radius: var(--radius-full); padding: 2px 10px; }

    .m03-body { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; gap: 16px; padding: 12px 0 16px; overflow: auto; }
  