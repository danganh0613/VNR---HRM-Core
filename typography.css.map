
    .rows { display: flex; flex-direction: column; }
    .row {
      display: flex; align-items: baseline; gap: 24px;
      padding: 12px 0;
      border-bottom: 1px solid var(--border-soft);
    }
    .specimen {
      flex: 1; min-width: 0; color: var(--text-strong);
      font-family: var(--font-sans);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .meta { flex-shrink: 0; width: 260px; display: flex; flex-direction: column; gap: 2px; text-align: right; }
    .name { font-size: var(--fs-13); font-weight: 500; color: var(--text-body); }
    .spec { font-size: var(--fs-12); color: var(--text-sub); font-variant-numeric: tabular-nums; }
  