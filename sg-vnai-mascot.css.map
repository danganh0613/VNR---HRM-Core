
    :host { display: inline-block; line-height: 0; }
    .vm { position: relative; transform: rotate(var(--tilt, 0deg)); will-change: transform;
      transition: transform .18s var(--ease-out, ease-out); }
    .vm-img { width: 100%; height: auto; display: block; user-select: none; -webkit-user-drag: none; }

    /* ── Thở: nhún ≤1px, chỉ khi idle (paused/reduced-motion → tắt) ── */
    .vm:not(.vm--paused):not(.vm--error) .vm-img { animation: vm-breath 3.4s ease-in-out infinite; }
    @keyframes vm-breath { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-1px); } }

    /* ── Mí mắt: ellipse màu MÀN HÌNH MẶT robot đè lên mắt; chớp = mở scaleY ── */
    /* Toạ độ mắt ĐO TỪ PIXEL ảnh (canvas scan): trái x 34.3–44% · phải x 58.8–68.3% · y 34.4–43%. */
    .vm-lid { position: absolute; top: 34%; width: 12.5%; height: 10%;
      background: #0F1B3D; border-radius: 46% 46% 50% 50%;
      transform: scaleY(0); transform-origin: center top; pointer-events: none; }
    .vm-lid--l { left: 33.9%; }
    .vm-lid--r { left: 58.4%; }
    .vm-lid.is-blink { animation: vm-blink .15s ease-in; }
    @keyframes vm-blink { 0% { transform: scaleY(0); } 45% { transform: scaleY(1); } 100% { transform: scaleY(0); } }

    /* ── Glow mắt: hover sáng nhẹ · thinking đảo trái-phải ── */
    .vm-glow { position: absolute; top: 35.5%; width: 10.5%; height: 8%; border-radius: 50%;
      background: radial-gradient(circle, rgb(96 165 250 / .95), rgb(96 165 250 / 0) 68%);
      opacity: 0; pointer-events: none; transition: opacity .2s var(--ease-out, ease-out); }
    .vm-glow--l { left: 34.9%; }
    .vm-glow--r { left: 59.4%; }
    :host(:hover) .vm-glow { opacity: .55; }
    .vm--think .vm-glow { opacity: .8; animation: vm-dart 1.5s ease-in-out infinite; }
    @keyframes vm-dart {
      0%, 100% { transform: translateX(-14%); }
      50% { transform: translateX(14%); }
    }

    /* ── 3 hạt sáng quanh đầu (thinking) ── */
    .vm-dot { position: absolute; width: 7%; height: 7%; border-radius: 50%; opacity: 0; pointer-events: none;
      background: radial-gradient(circle, #93C5FD, rgb(147 197 253 / 0) 72%); }
    .vm--think .vm-dot { animation: vm-orbit 1.8s ease-in-out infinite; }
    .vm-dot--1 { left: 6%; top: 12%; }
    .vm-dot--2 { left: 46%; top: -6%; animation-delay: .3s !important; }
    .vm-dot--3 { left: 84%; top: 12%; animation-delay: .6s !important; }
    @keyframes vm-orbit {
      0%, 100% { opacity: 0; transform: translateY(2px) scale(.6); }
      40% { opacity: .95; transform: translateY(-3px) scale(1); }
      70% { opacity: .4; }
    }

    /* ── Error: lắc NHẸ 2px, không bi luỵ ── */
    .vm--error { animation: vm-shake .4s ease-in-out; }
    @keyframes vm-shake {
      0%, 100% { transform: translateX(0) rotate(var(--tilt, 0deg)); }
      25% { transform: translateX(-2px) rotate(var(--tilt, 0deg)); }
      75% { transform: translateX(2px) rotate(var(--tilt, 0deg)); }
    }

    /* ── Success: nhún vui 1 nhịp ── */
    .vm--success { animation: vm-hop .45s var(--ease-out, ease-out); }
    @keyframes vm-hop {
      0%, 100% { transform: translateY(0) rotate(var(--tilt, 0deg)); }
      40% { transform: translateY(-4px) rotate(var(--tilt, 0deg)); }
    }

    /* ── Badge Check / Retry (800ms do host điều khiển state) ── */
    .vm-badge { position: absolute; top: -6%; right: -10%; display: grid; place-items: center;
      width: 38%; height: 38%; border-radius: 50%; color: #fff;
      box-shadow: 0 2px 8px rgb(0 0 0 / .22); animation: vm-pop .3s var(--ease-out, ease-out); }
    .vm-badge svg { width: 62%; height: 62%; }
    .vm-badge--ok { background: var(--success-base, #16A34A); }
    .vm-badge--err { background: var(--warning-base, #F59E0B); }
    @keyframes vm-pop { from { transform: scale(.4); opacity: 0; } to { transform: scale(1); opacity: 1; } }

    /* ── Paused (ngoài viewport) + reduced-motion: tĩnh hoàn toàn, chỉ còn opacity transition ── */
    .vm--paused * { animation-play-state: paused !important; }
    @media (prefers-reduced-motion: reduce) {
      .vm, .vm * { animation: none !important; transition: opacity .2s ease !important; }
    }
  