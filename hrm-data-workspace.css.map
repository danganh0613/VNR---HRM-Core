
/* ViewEncapsulation.None ⇒ :host KHÔNG áp — style host qua class thật. */
.hrm-data-workspace { display: block; min-width: 0; height: 100%; }
/* Segmented đổi chế độ do WORKSPACE tự render ([headerActions]); ẩn thanh tab nội bộ của hrm-data-view
   để không TRÙNG 2 bộ chuyển chế độ (mọi consumer tự có, không phải thêm ::ng-deep). */
.hrm-data-workspace hrm-data-view .dv-bar { display: none; }

/* Cụm điều khiển cạnh tiêu đề — dồn phải, khoảng cách control chuẩn. */
.hdw-hdr { display: flex; align-items: center; justify-content: flex-end; gap: var(--space-2, 8px); }

/* Toolbar 2 trạng thái. */
.hdw-tbx { display: flex; align-items: center; gap: var(--space-2, 8px); min-width: 0; }
.hdw-search { width: 280px; max-width: 100%; }

/* Cụm chọn hàng loạt: nút bỏ chọn + đếm. */
.hdw-clear { display: grid; place-items: center; width: 28px; height: 28px; border: 0; background: transparent;
  border-radius: var(--radius-md, 8px); cursor: pointer; color: var(--text-sub); }
.hdw-clear:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
.hdw-count { font-size: var(--fs-13, 13px); color: var(--text-body); background: var(--primary-bg-subtle);
  padding: 4px 10px; border-radius: var(--radius-full, 999px); white-space: nowrap; }
.hdw-count b { color: var(--primary-base); }

/* Nút ⋮ More. */
.hdw-more { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px;
  border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md, 8px);
  cursor: pointer; color: var(--text-sub); }
.hdw-more:hover { border-color: var(--primary-base); color: var(--text-strong); }

/* Nút TOGGLE "Nhóm dữ liệu" khi bật — SELECTED nền xanh đầy + chữ/icon trắng.
   ViewEncapsulation.None ⇒ selector .ant-btn (render bởi hrm-button) áp trực tiếp, KHÔNG cần ::ng-deep. */
.hdw-sel .ant-btn {
  box-shadow: inset 0 0 0 999px var(--primary-base) !important;
  border-color: var(--primary-base) !important;
  color: var(--text-on-primary) !important;
}
.hdw-sel .ant-btn:hover {
  box-shadow: inset 0 0 0 999px var(--primary-hover, var(--primary-base)) !important;
  border-color: var(--primary-hover, var(--primary-base)) !important;
  color: var(--text-on-primary) !important;
}
.hdw-sel .ant-btn tabler-icon { color: var(--icon-on-primary, var(--text-on-primary)) !important; }
.hdw-badge { display: inline-grid; place-items: center; min-width: 18px; height: 18px; padding: 0 5px; margin-left: 2px;
  border-radius: var(--radius-full); background: var(--primary-base); color: var(--text-on-primary);
  font-size: var(--fs-11, 11px); font-weight: var(--font-semibold, 600); line-height: 1; }

/* Menu ⋮ — chỉ set màu icon (layout do bridge lo). */
.hdw-menu tabler-icon { color: var(--icon-secondary, var(--text-sub)); }

/* Overlay Cấu hình cột. */
.hdw-cmg-mask { position: fixed; inset: 0; background: var(--overlay); z-index: 1000; }
.hdw-cmg-dialog { position: fixed; z-index: 1001; top: 50%; left: 50%; transform: translate(-50%,-50%);
  width: min(920px, 94vw); height: min(640px, 88vh); display: flex; flex-direction: column;
  background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-xl, 12px);
  box-shadow: var(--shadow-regular-lg, 0 12px 32px rgba(0,0,0,.18)); overflow: hidden; }
.hdw-cmg-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px;
  border-bottom: 1px solid var(--border-soft); }
.hdw-cmg-title { font-size: var(--fs-15, 15px); font-weight: var(--font-semibold, 600); color: var(--text-strong); }
.hdw-cmg-x { display: grid; place-items: center; width: 30px; height: 30px; border: 0; background: transparent;
  border-radius: var(--radius-md, 8px); cursor: pointer; color: var(--text-sub); }
.hdw-cmg-x:hover { background: var(--bg-surface-subtle); }
.hdw-cmg-body { flex: 1 1 auto; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 320px); }
.hdw-cmg-mgr { min-width: 0; min-height: 0; height: 100%; display: flex; flex-direction: column;
  border-right: 1px solid var(--border-soft); padding: var(--space-2, 8px) 16px 16px; }
.hdw-cmg-insp { min-width: 0; min-height: 0; height: 100%; overflow: auto; }
/* Footer FULL modal: Tạo nhóm cột + Thêm cột tính toán bên trái · Huỷ/Lưu góc phải. */
.hdw-cmg-foot { flex: none; display: flex; align-items: center; gap: var(--space-3, 12px);
  padding: 10px 16px; border-top: 1px solid var(--border-soft); background: var(--bg-surface); }
.hdw-cmg-foot-create { display: flex; align-items: center; gap: var(--space-2, 8px); flex-wrap: wrap; }
.hdw-cmg-foot-act { display: flex; align-items: center; gap: var(--space-2, 8px); margin-inline-start: auto; }
@media (max-width: 640px) {
  .hdw-cmg-body { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) auto; }
  .hdw-cmg-mgr { border-right: 0; border-bottom: 1px solid var(--border-soft); padding: 12px; }
  /* Cap inspector bằng px cố định (tránh %-height cyclic với grid auto-track ⇒ inspector nuốt hết chỗ);
     column-list (mgr, 1fr) được ưu tiên, inspector cuộn trong 220px. */
  .hdw-cmg-insp { max-height: 220px; }
  .hdw-cmg-foot { flex-wrap: wrap; }
}
  