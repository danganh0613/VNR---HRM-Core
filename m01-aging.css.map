
    :host { display: flex; flex-direction: column; gap: 8px; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg); padding: 12px 14px; }
    .a3-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .a3-muted { font-size: var(--fs-11); color: var(--text-soft); }
    .a3-grid { display: grid; grid-template-columns: minmax(120px, auto) repeat(4, minmax(58px, 1fr)); gap: 4px; align-items: center; }
    .a3-colh { font-size: var(--fs-11); font-weight: 600; color: var(--text-sub); text-align: center; }
    .a3-rowh { font-size: var(--fs-12); color: var(--text-body); padding-right: 8px; }
    .a3-cell {
      font: inherit; font-size: var(--fs-13); font-weight: 700; font-variant-numeric: tabular-nums; cursor: pointer;
      color: var(--text-strong); background: var(--bg-surface-subtle); border: 1px solid var(--border-sub);
      border-radius: var(--radius-sm); padding: 5px 0; text-align: center;
    }
    .a3-cell:hover:not(:disabled) { border-color: var(--primary-base); color: var(--primary-base); }
    .a3-cell:disabled { color: var(--text-soft); cursor: default; background: transparent; }
    .a3-cell[data-hot='true'] { background: var(--error-bg); color: var(--error-text); border-color: var(--error-base); }
    .a3-foot { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .a3-foot b { color: var(--text-strong); }
  