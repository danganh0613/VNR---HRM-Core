
    /* ═══════════ OVERLAY KHUNG ═══════════ */
    .fb { position: fixed; inset: 0; z-index: 1200; display: flex; flex-direction: column;
      background: var(--bg-body, var(--bg-surface-subtle)); color: var(--text-body); font-family: var(--font-sans); }

    /* ═══════════ TOP BAR ═══════════ */
    .fb-top { flex: none; height: 54px; display: flex; align-items: center; justify-content: space-between;
      gap: 12px; padding: 0 14px; background: var(--bg-surface); border-bottom: 1px solid var(--border-sub); }
    .fb-top-l { display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1; }
    .fb-top-c { display: flex; align-items: center; gap: 10px; flex: none; }
    .fb-top-r { display: flex; align-items: center; gap: 8px; flex: 1; justify-content: flex-end; }
    .fb-brand { display: inline-flex; align-items: center; gap: 7px; font-size: var(--fs-13); font-weight: var(--font-bold, 700); color: var(--text-strong); white-space: nowrap; }
    .fb-brand tabler-icon { color: var(--primary-base); }
    .fb-top-sep { width: 1px; height: 22px; background: var(--border-sub); }
    .fb-name { border: 1px solid transparent; background: transparent; font: inherit; font-size: var(--fs-14); font-weight: var(--font-medium, 500);
      color: var(--text-strong); padding: 5px 8px; border-radius: var(--radius-md); min-width: 0; width: 220px; }
    .fb-name:hover { border-color: var(--border-sub); }
    .fb-name:focus { outline: none; border-color: var(--primary-base); background: var(--bg-surface); }
    .fb-ico { display: grid; place-items: center; width: 32px; height: 32px; border: 0; border-radius: var(--radius-md);
      background: transparent; color: var(--text-sub); cursor: pointer; }
    .fb-ico:hover:not(:disabled) { background: var(--bg-surface-subtle); color: var(--text-strong); }
    .fb-ico:disabled { color: var(--icon-disabled, var(--text-soft)); opacity: .45; cursor: not-allowed; }
    .fb-ico--sm { width: 26px; height: 26px; }
    .fb-hist { display: inline-flex; gap: 2px; }
    .fb-dev { display: inline-flex; gap: 2px; padding: 2px; border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface-subtle); }
    .fb-dev-b { display: grid; place-items: center; width: 30px; height: 26px; border: 0; border-radius: var(--radius-sm);
      background: transparent; color: var(--text-sub); cursor: pointer; }
    .fb-dev-b:hover { color: var(--text-strong); }
    .fb-dev-b.on { background: var(--bg-surface); color: var(--primary-base); box-shadow: var(--shadow-regular-xs); }
    .fb-rules-n { display: inline-grid; place-items: center; min-width: 18px; height: 18px; padding: 0 5px; margin-left: 2px;
      border-radius: var(--radius-full, 999px); background: var(--primary-base); color: var(--static-white, #fff);
      font-size: var(--fs-11, 11px); font-weight: var(--font-bold, 700); line-height: 1; }

    /* ═══════════ 3 PANEL (cột co giãn theo trạng thái thu gọn) ═══════════ */
    .fb-main { flex: 1 1 auto; min-height: 0; display: grid; transition: grid-template-columns .24s var(--ease-out, ease); }

    /* ── PANEL THÀNH PHẦN ── */
    .fb-pal { display: flex; flex-direction: column; min-height: 0; min-width: 0; overflow: hidden;
      background: var(--bg-surface); border-right: 1px solid var(--border-sub); }
    .fb-pal.is-closed { border-right: 0; }
    .fb-pal-search { flex: none; padding: 12px 12px 8px; }
    .fb-pal-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 0 12px 16px; }
    .fb-pal-grp { font-size: var(--fs-11, 11px); font-weight: var(--font-semibold, 600); letter-spacing: .05em;
      text-transform: uppercase; color: var(--text-soft); margin: 14px 2px 6px; }
    .fb-pal-item { display: flex; align-items: center; gap: 9px; width: 100%; padding: 7px 8px; margin-bottom: 4px;
      border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface);
      font: inherit; font-size: var(--fs-13); color: var(--text-body); cursor: grab; text-align: left;
      transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out); }
    .fb-pal-item:hover { border-color: var(--primary-base); box-shadow: var(--shadow-regular-xs); transform: translateY(-1px); }
    .fb-pal-item:hover .fb-pal-add { opacity: 1; }
    .fb-pal-ic { flex: none; display: grid; place-items: center; width: 26px; height: 26px; border-radius: var(--radius-sm);
      background: var(--primary-bg-subtle); color: var(--primary-base); }
    .fb-pal-lb { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .fb-pal-add { flex: none; color: var(--text-soft); opacity: 0; transition: opacity var(--duration-fast) var(--ease-out); }
    .fb-pal-item.is-ghost { opacity: .9; box-shadow: var(--shadow-regular-md); border-color: var(--primary-base); }

    /* ── CANVAS (relative để neo nút thu gọn 2 bên) ── */
    .fb-canvas { position: relative; min-width: 0; min-height: 0; overflow-y: auto; padding: 22px 26px 60px;
      background: var(--bg-body, var(--bg-surface-subtle)); transition: background .2s var(--ease-out, ease); }
    .fb-sheet { margin: 0 auto; background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: var(--radius-xl); box-shadow: var(--shadow-regular-sm); padding: 6px 26px 22px;
      transition: max-width .28s var(--ease-out, ease); }
    .fb-sheet-head { padding: 18px 10px 6px; border-radius: var(--radius-md); cursor: pointer; border: 1.5px dashed transparent; }
    .fb-sheet-head:hover { border-color: var(--border-sub); }
    .fb-sheet-head.is-on { border-color: var(--primary-base); }
    .fb-sheet-title { font-size: var(--fs-18, 18px); font-weight: var(--font-bold, 700); color: var(--text-strong); }
    .fb-sheet-desc { margin-top: 3px; font-size: var(--fs-13); color: var(--text-sub); }
    /* Header SOLID theo theme — dải màu full-bleed đầu sheet, chữ trắng. */
    .fb-sheet-head.is-solid { margin: -6px -26px 10px; padding: 18px 26px 14px; border-radius: var(--radius-xl) var(--radius-xl) 0 0; border-color: transparent; }
    .fb-sheet-head.is-solid .fb-sheet-title { color: var(--static-white, #fff); }
    .fb-sheet-head.is-solid .fb-sheet-desc { color: var(--static-white, #fff); opacity: .85; }

    /* Nút thu gọn panel — ghim mép trái/phải canvas, giữa chiều dọc dưới (kiểu Vueform) */
    .fb-side-tg { position: sticky; bottom: 18px; z-index: 5; display: grid; place-items: center;
      width: 28px; height: 28px; border: 1px solid var(--border-sub); border-radius: var(--radius-full, 999px);
      background: var(--bg-surface); color: var(--text-sub); cursor: pointer; box-shadow: var(--shadow-regular-sm); }
    .fb-side-tg:hover { color: var(--primary-base); border-color: var(--primary-base); }
    .fb-side-tg--l { float: left; margin-left: -14px; }
    .fb-side-tg--r { float: right; margin-right: -14px; }

    .fb-sec { margin-top: 14px; }
    .fb-sec-bar { display: flex; align-items: center; gap: 8px; padding-bottom: 7px; border-bottom: 1px solid var(--border-soft); margin-bottom: 12px; }
    .fb-sec-title { flex: 1; min-width: 0; border: 1px solid transparent; background: transparent; font: inherit;
      font-size: var(--fs-13); font-weight: var(--font-bold, 700); color: var(--text-strong); padding: 4px 6px; border-radius: var(--radius-sm); }
    .fb-sec-title:hover { border-color: var(--border-sub); }
    .fb-sec-title:focus { outline: none; border-color: var(--primary-base); }
    .fb-sec-acts { display: inline-flex; gap: 4px; }
    .fb-mini { display: grid; place-items: center; width: 24px; height: 24px; border: 1px solid var(--border-sub);
      border-radius: var(--radius-sm); background: var(--bg-surface); color: var(--text-sub); cursor: pointer; flex: none; }
    .fb-mini:hover { border-color: var(--primary-base); color: var(--primary-base); }
    .fb-mini--danger:hover { border-color: var(--error-base); color: var(--error-base); }

    .fb-sec-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px 10px; min-height: 44px; }
    .fb-cell { min-width: 0; }
    .fb-cell-ph { border: 1.5px dashed var(--primary-base); border-radius: var(--radius-md);
      background: var(--primary-bg-subtle); min-height: 58px; grid-column: span 3; }
    .fb-cell.cdk-drag-preview { z-index: 1300; }

    .fb-item { position: relative; padding: 8px 10px; border: 1.5px dashed transparent; border-radius: var(--radius-md); cursor: pointer;
      transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out); }
    .fb-item:hover { border-color: color-mix(in srgb, var(--primary-base) 45%, transparent); }
    .fb-item.is-on { border-style: solid; border-color: var(--primary-base); background: color-mix(in srgb, var(--primary-base) 4%, var(--bg-surface)); }
    .fb-tag { position: absolute; top: -10px; left: 8px; z-index: 2; display: none; max-width: 70%;
      padding: 1px 7px; border-radius: var(--radius-sm); background: var(--primary-base); color: var(--static-white, #fff);
      font-size: var(--fs-11, 11px); font-weight: var(--font-medium, 500); line-height: 1.5;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .fb-item:hover .fb-tag, .fb-item.is-on .fb-tag { display: inline-block; }
    .fb-chip { position: absolute; top: -13px; right: 8px; z-index: 3; display: none; align-items: center; gap: 2px;
      padding: 2px; border: 1px solid var(--border-sub); border-radius: var(--radius-md);
      background: var(--bg-surface); box-shadow: var(--shadow-regular-sm); }
    .fb-item.is-on .fb-chip, .fb-item:hover .fb-chip { display: inline-flex; }
    .fb-chip-b { display: grid; place-items: center; width: 22px; height: 22px; border: 0; border-radius: var(--radius-sm);
      background: transparent; color: var(--text-sub); cursor: pointer; }
    .fb-chip-b:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
    .fb-chip-b--danger:hover { color: var(--error-base); background: color-mix(in srgb, var(--error-base) 10%, transparent); }
    .fb-chip-drag { cursor: grab; }

    .fb-empty { display: grid; place-items: center; min-height: 64px; border: 1.5px dashed var(--border-sub);
      border-radius: var(--radius-md); color: var(--text-soft); font-size: var(--fs-13); grid-column: 1 / -1; }
    .fb-addsec { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; margin-top: 16px;
      padding: 9px; border: 1.5px dashed var(--border-sub); border-radius: var(--radius-md); background: transparent;
      font: inherit; font-size: var(--fs-13); font-weight: var(--font-medium, 500); color: var(--text-sub); cursor: pointer; }
    .fb-addsec:hover { border-color: var(--primary-base); color: var(--primary-base); background: var(--primary-bg-subtle); }

    /* Preview TĨNH trong canvas */
    .cv-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .cv-lbl { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: var(--fs-13); font-weight: var(--font-medium, 500); color: var(--text-strong); }
    /* Tag Ẩn — size SMALL, kiểu VIỀN (stroke), không nền status */
    .cv-lbl ::ng-deep .ant-tag { margin: 0; line-height: 1.3; padding-inline: 5px; font-size: 10px; border-radius: var(--radius-sm); }
    /* Chip LOGIC: icon sấm sét nền xám secondary, đối xứng cỡ label */
    .cv-logic { position: relative; display: inline-flex; align-items: center; justify-content: center;
      width: 18px; height: 18px; border-radius: var(--radius-sm);
      background: var(--secondary, var(--bg-surface-subtle)); color: var(--text-sub); cursor: help; }
    .cv-logic:hover { color: var(--primary-base); }
    .cv-logic-tip { position: absolute; top: calc(100% + 7px); left: -6px; z-index: 40;
      display: flex; flex-direction: column; gap: 4px; min-width: 230px; max-width: 320px; width: max-content;
      padding: 9px 11px; border-radius: var(--radius-md); background: var(--text-strong); color: var(--bg-surface);
      font-size: var(--fs-12); font-weight: 400; line-height: 1.5; white-space: normal;
      box-shadow: 0 8px 24px rgb(0 0 0 / .22); pointer-events: none; }
    .cv-logic-tip::before { content: ''; position: absolute; top: -4px; left: 11px; width: 8px; height: 8px;
      transform: rotate(45deg); background: var(--text-strong); }
    .cv-logic-t { font-weight: var(--font-semibold, 600); opacity: .85; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; }
    .cv-logic-line { display: block; }
    .fp-ev-sw { display: inline-flex; align-items: center; min-height: 32px; }
    .fp-opt--right { justify-content: flex-end; }
    /* Full-width segmented: dùng [block] CHÍNH THỨC của hrm-segmented (không tự chế width).
       .fp-seg-param: override CỤC BỘ track cho hộp nền subtle — nợ chuẩn hoá: đề xuất DS thêm
       variant nền-tương-phản cho segmented đặt trên --bg-surface-subtle. Chỉ dùng token. */
    .fp-seg-param { width: 100%; }
    .fp-seg-param ::ng-deep .ant-segmented { background: var(--bg-body, #EDF1F5); border: 1px solid var(--border-sub); }
    .fp-seg-param ::ng-deep .ant-segmented-item-selected { background: var(--bg-surface); box-shadow: var(--shadow-sm, 0 1px 3px rgb(0 0 0 / .12)); }

    /* ── XUẤT BẢN / khoá key / đang-dùng-tại (demo schema-evolution) ── */
    .fb-rules-n--gold { background: var(--warning-base, #F59E0B); }
    /* Nút secondary: nền xám token, không viền — phân cấp dưới primary CTA */
    .fb-btn-sec ::ng-deep button.ant-btn { background: var(--secondary, var(--bg-surface-subtle)); border-color: transparent; color: var(--text-strong); }
    .fb-btn-sec ::ng-deep button.ant-btn:hover { background: var(--bg-surface-subtle); border-color: var(--border-sub); color: var(--text-strong); }
    /* Badge đếm nháp trên nút primary: nền trắng mờ, chữ trắng — nổi trên nền màu */
    .fb-rules-n--onp { background: rgb(255 255 255 / .28); color: #fff; }
    .fp-keylock { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 0 11px;
      border: 1px dashed var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface-subtle);
      font-family: var(--font-mono, ui-monospace, monospace); font-size: var(--fs-12); color: var(--text-sub); }
    .fp-used { display: flex; flex-wrap: wrap; gap: 4px; }
    .fp-used ::ng-deep .ant-tag { margin: 0; line-height: 1.4; padding-inline: 6px; font-size: 11px; border-radius: var(--radius-sm); }
    .fb-pub { width: min(680px, calc(100vw - 48px)); }
    .fb-pub-body { display: flex; flex-direction: column; gap: 14px; padding: 16px 18px; overflow: auto; }
    .fb-pub-body > * { flex-shrink: 0; }
    .fb-pub-desc { margin: 0; font-size: var(--fs-13); color: var(--text-body); line-height: 1.6; }
    .fb-pub-empty { margin: 4px 0 8px; font-size: var(--fs-13); color: var(--text-sub); text-align: center; }
    .fb-pub-tbl { width: 100%; border-collapse: collapse; font-size: var(--fs-13); }
    .fb-pub-tbl th { text-align: left; font-size: var(--fs-12); font-weight: var(--font-semibold, 600); color: var(--text-sub);
      padding: 6px 10px; border-bottom: 1px solid var(--border-sub); white-space: nowrap; }
    .fb-pub-tbl td { padding: 7px 10px; border-bottom: 1px solid var(--border-sub); color: var(--text-body); }
    .fb-pub-mono { font-family: var(--font-mono, ui-monospace, monospace); font-size: var(--fs-12); }
    .fb-pub-sql { border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface-subtle); overflow: hidden; }
    .fb-pub-sql-t { padding: 7px 12px; font-size: var(--fs-12); font-weight: var(--font-semibold, 600); color: var(--text-sub);
      border-bottom: 1px solid var(--border-sub); }
    .fb-pub-sql pre { margin: 0; padding: 10px 12px; white-space: pre-wrap; color: var(--text-strong); }
    .fb-pub-foot { display: flex; justify-content: flex-end; gap: 8px; padding-top: 2px; }
    .fb-arch { width: min(520px, calc(100vw - 48px)); }
    .cv-req { color: var(--error-base); }
    .cv-box { position: relative; display: flex; align-items: center; min-height: 32px; padding: 0 11px;
      border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface);
      font-size: var(--fs-13); color: var(--text-soft); }
    .cv-box--area { min-height: 74px; align-items: flex-start; padding-top: 7px; }
    .cv-chev { position: absolute; right: 9px; color: var(--text-soft); }
    .cv-suffix { position: absolute; right: 9px; color: var(--text-soft); font-size: var(--fs-12); }
    .cv-money { display: flex; gap: 8px; }
    .cv-money-n { flex: 1 1 auto; }
    .cv-money-u { flex: 0 0 84px; padding-right: 24px; }
    .cv-mono { font-family: var(--font-mono, ui-monospace, monospace); }
    .cv-opts { display: flex; flex-direction: column; gap: 6px; padding-top: 2px; }
    .cv-radio, .cv-check { display: inline-flex; align-items: center; gap: 7px; font-size: var(--fs-13); color: var(--text-body); }
    .cv-radio-dot { width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid var(--border-strong, var(--border-sub)); }
    .cv-radio-dot.is-on { border-color: var(--primary-base); box-shadow: inset 0 0 0 3px var(--bg-surface); background: var(--primary-base); }
    .cv-check-box { width: 14px; height: 14px; border-radius: var(--radius-xs, 3px); border: 1.5px solid var(--border-strong, var(--border-sub)); }
    .cv-toggle { position: relative; display: inline-block; width: 36px; height: 20px; border-radius: 999px; background: var(--primary-base); }
    .cv-toggle-knob { position: absolute; top: 2px; right: 2px; width: 16px; height: 16px; border-radius: 50%; background: #fff; }
    /* Sao đánh giá — tabler IconStar (KHÔNG dùng ký tự ★ hệ điều hành) */
    .cv-stars { display: inline-flex; gap: 3px; color: var(--warning-base); }
    .cv-drop { display: grid; place-items: center; min-height: 64px; border: 1.5px dashed var(--border-sub);
      border-radius: var(--radius-lg); background: var(--bg-surface-subtle); color: var(--text-sub); font-size: var(--fs-13); }
    .cv-help { font-size: var(--fs-12); color: var(--text-soft); }
    .cv-heading { font-size: var(--fs-14); font-weight: var(--font-bold, 700); color: var(--text-strong); }
    .cv-divider { border: 0; border-top: 1px solid var(--border-soft); margin: 8px 0 2px; }

    /* ── PANEL THUỘC TÍNH / TRANG TRÍ ── */
    .fb-props { display: flex; flex-direction: column; min-height: 0; min-width: 0; overflow: hidden;
      background: var(--bg-surface); border-left: 1px solid var(--border-sub); }
    .fb-props.is-closed { border-left: 0; }
    .fb-props-h { flex: none; display: flex; align-items: center; gap: 9px; padding: 13px 14px; border-bottom: 1px solid var(--border-sub); }
    .fb-props-ic { display: grid; place-items: center; width: 28px; height: 28px; border-radius: var(--radius-md);
      background: var(--primary-bg-subtle); color: var(--primary-base); }
    .fb-props-t { flex: none; font-size: var(--fs-13); font-weight: var(--font-bold, 700); color: var(--text-strong); }
    .fb-props-key { flex: 1; min-width: 0; font-family: var(--font-mono, ui-monospace, monospace); font-size: var(--fs-11, 11px);
      color: var(--text-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .fb-props-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; }

    .fa-sec { border-bottom: 1px solid var(--border-soft); }
    .fa-h { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 11px 14px;
      border: 0; background: transparent; font: inherit; font-size: var(--fs-12); font-weight: var(--font-semibold, 600);
      letter-spacing: .04em; text-transform: uppercase; color: var(--text-sub); cursor: pointer; }
    .fa-h:hover { color: var(--text-strong); background: var(--bg-surface-subtle); }
    .fa-caret { color: var(--text-soft); transition: transform var(--duration-fast) var(--ease-out); }
    .fa-caret.is-open { transform: rotate(180deg); }
    .fa-body { display: flex; flex-direction: column; gap: 12px; padding: 4px 14px 16px; }
    .fa-body--flat { padding: 14px; }

    .fp-row { display: flex; flex-direction: column; gap: 5px; }
    .fp-row--inline { flex-direction: row; align-items: center; justify-content: space-between; gap: 10px; }
    .fp-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .fp-lbl { font-size: var(--fs-12); font-weight: var(--font-medium, 500); color: var(--text-sub); }
    .fp-lbl--solo { margin-bottom: -4px; }
    .fp-mono ::ng-deep input { font-family: var(--font-mono, ui-monospace, monospace); }
    /* Nhãn đa ngôn ngữ: tag ngôn ngữ chính + nút 🌐 badge + block bản dịch */
    .fp-lang-tag ::ng-deep .ant-tag { margin: 0; line-height: 1.3; padding-inline: 5px; font-size: 10px; border-radius: var(--radius-sm); }
    .fp-lang-tag-old { font-size: 10px; font-weight: var(--font-semibold, 600); color: var(--text-soft);
      border: 1px solid var(--border-sub); border-radius: var(--radius-sm); padding: 0 4px; margin-left: 4px; }
    .fp-globe { width: auto; min-width: 24px; padding: 0 5px; gap: 3px; display: inline-flex; align-items: center; height: 32px; }
    .fp-globe.on { border-color: var(--primary-base); color: var(--primary-base); }
    .fp-globe-n { font-size: 10px; font-weight: var(--font-semibold, 600); }
    .fp-trans { display: flex; flex-direction: column; gap: 10px; padding: 10px;
      border: 1px solid var(--border-soft); border-radius: var(--radius-md); background: var(--bg-surface-subtle); }
    .fp-miss { font-size: 10px; color: var(--warning-base); margin-left: 6px; }
    .fp-opt { display: flex; align-items: center; gap: 6px; }
    .fp-opt hrm-input { flex: 1; min-width: 0; }
    .fp-add { display: inline-flex; align-items: center; gap: 5px; align-self: flex-start; border: 0; background: transparent;
      font: inherit; font-size: var(--fs-13); font-weight: var(--font-medium, 500); color: var(--primary-base); cursor: pointer; padding: 2px 0; }
    .fp-add:hover { text-decoration: underline; }
    .fp-sep { border: 0; border-top: 1px solid var(--border-soft); margin: 2px 0; width: 100%; }
    .fp-cond { display: flex; flex-direction: column; gap: 6px; padding: 10px; border: 1px solid var(--border-soft);
      border-radius: var(--radius-md); background: var(--bg-surface-subtle); }
    .fp-mini-lbl { font-size: var(--fs-11, 11px); color: var(--text-soft); }
    .fp-hint { font-size: var(--fs-12); color: var(--text-soft); line-height: 1.55; }
    .fp-reset { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--border-sub); border-radius: var(--radius-md);
      background: transparent; font: inherit; font-size: var(--fs-12); color: var(--text-sub); cursor: pointer; padding: 7px 10px; }
    .fp-reset:hover { color: var(--error-base); border-color: var(--error-base); }

    /* Trang trí form — lưới swatch màu (token viền/chọn) */
    .th-swatches { display: grid; grid-template-columns: repeat(8, 1fr); gap: 6px; }
    .th-sw { aspect-ratio: 1; border-radius: var(--radius-full, 999px); border: 2px solid transparent;
      cursor: pointer; padding: 0; box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08); }
    .th-sw.on { border-color: var(--text-strong); }
    .th-sw--bg { border-radius: var(--radius-md); }
    .th-sw--custom { position: relative; display: inline-flex; overflow: hidden;
      background: conic-gradient(from 90deg, #f43f5e, #eab308, #22c55e, #06b6d4, #6366f1, #d946ef, #f43f5e); }
    .th-sw--custom input[type='color'] { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; border: 0; padding: 0; cursor: pointer; }

    /* ── MODAL chung (Quy tắc + Xem trước) ── */
    .fb-pv-backdrop { position: fixed; inset: 0; z-index: 1400; background: rgb(0 0 0 / .45); }
    .fb-pv { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1410;
      width: min(780px, calc(100vw - 48px)); max-height: 86vh; display: flex; flex-direction: column;
      background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-xl); box-shadow: var(--shadow-regular-lg, var(--shadow-regular-md)); }
    .fb-rules { width: min(920px, calc(100vw - 48px)); }
    .fb-pv-h { flex: none; display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--border-sub); }
    .fb-pv-t { flex: 1; min-width: 0; display: inline-flex; align-items: center; gap: 7px; font-size: var(--fs-14); font-weight: var(--font-bold, 700); color: var(--text-strong);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .fb-pv-t tabler-icon { color: var(--primary-base); }
    .fb-pv-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
    .fb-rules-body { display: flex; flex-direction: column; gap: 14px; padding: 16px; }
    /* FIX cắt card: con của flex-column trong container height cố định bị NÉN (flex-shrink
       mặc định 1) trước khi overflow scroll kịp chạy → khoá shrink. */
    .fb-rules-body > * { flex-shrink: 0; }

    /* Theme preset picker (Thuộc tính biểu mẫu) */
    .thp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .thp { display: flex; flex-direction: column; gap: 5px; padding: 6px; border: 1.5px solid var(--border-sub);
      border-radius: var(--radius-md); background: var(--bg-surface); cursor: pointer; font: inherit; }
    .thp:hover { border-color: color-mix(in srgb, var(--primary-base) 50%, transparent); }
    .thp.on { border-color: var(--primary-base); background: var(--primary-bg-subtle); }
    .thp-prev { display: flex; flex-direction: column; gap: 3px; height: 44px; padding: 0 0 5px;
      border: 1px solid var(--border-soft); border-radius: var(--radius-sm); overflow: hidden; }
    .thp-head { height: 12px; flex: none; }
    .thp-line { height: 4px; margin: 2px 6px 0; border-radius: 2px; opacity: .8; }
    .thp-line--2 { background: var(--border-sub); width: 60%; }
    .thp-line--dark { background: rgb(255 255 255 / .25); }
    .thp-name { font-size: var(--fs-11, 11px); font-weight: var(--font-medium, 500); color: var(--text-body); text-align: left; }

    /* ── TRỢ LÝ AI — chatbot panel (Form Copilot style) ── */
    /* ── Nút Trợ lý VNAI: pill BONG BÓNG TIN NHẮN (góc dưới-phải vuông), mascot đứng trong,
       viền gradient MỎNG 4 màu xanh dương → tím → vàng → cam đỏ (double-background trick). ── */
    /* MOVING BORDER (kiểu Aceternity): viền base gradient 4 màu MỜ + VỆT SÁNG chạy quanh
       chu vi (conic-gradient xoay qua @property --fab-angle). Viền dày 2px, shadow màu sáng hơn. */
    @property --fab-angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
    .ai-fab { position: fixed; right: 20px; bottom: 20px; z-index: 1340;
      display: flex; align-items: center; gap: 10px; padding: 11px 22px 11px 12px;
      border: 0; border-radius: 18px 18px 4px 18px;
      background: var(--bg-surface);
      box-shadow: 0 6px 22px rgb(37 99 235 / .24), 0 6px 24px rgb(240 101 58 / .22), 0 2px 10px rgb(139 92 246 / .18);
      cursor: pointer; font: inherit;
      transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out); }
    .ai-fab > * { position: relative; z-index: 1; }
    /* Viền base: gradient 4 màu mờ (ring 2px qua mask xor) */
    .ai-fab::before, .ai-fab::after { content: ''; position: absolute; inset: 0; z-index: 0;
      border-radius: inherit; padding: 2px; pointer-events: none;
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude; }
    .ai-fab::before {
      background: linear-gradient(100deg, #2563EB 0%, #8B5CF6 38%, #FBBF24 70%, #F0653A 100%);
      opacity: .35; }
    /* Vệt sáng CHẠY quanh viền — comet trắng-tím-xanh, đuôi mờ dần */
    /* Vệt chạy dùng ĐÚNG dải màu viền (xanh → tím → vàng → cam) — đuôi mờ dần, đầu cam sáng ấm. */
    .ai-fab::after {
      background: conic-gradient(from var(--fab-angle),
        transparent 0 64%,
        rgb(37 99 235 / .35) 72%,
        #2563EB 79%,
        #8B5CF6 86%,
        #FBBF24 93%,
        #F0653A 98%,
        #FFD9C4 100%);
      animation: fab-border-move 3s linear infinite; }
    @keyframes fab-border-move { to { --fab-angle: 360deg; } }
    .ai-fab:hover { transform: translateY(-2px) scale(1.03);
      box-shadow: 0 10px 30px rgb(37 99 235 / .32), 0 10px 32px rgb(240 101 58 / .28), 0 4px 14px rgb(139 92 246 / .24); }
    .ai-fab:hover::after { animation-duration: 1.6s; }
    @media (prefers-reduced-motion: reduce) { .ai-fab::after { animation: none; opacity: 0; } .ai-fab::before { opacity: .6; } }
    .ai-fab:active { transform: scale(.98); }
    /* Mascot ĐỨNG TRONG nút: chân CHẠM SÁT mép đáy (margin-bottom âm = padding-bottom nút,
       không hở gap), đầu VƯỢT mép trên nút. */
    .ai-fab-img { align-self: flex-end; margin: -26px 0 -9.5px; flex: none; }
    .ai-fab-txt { font-size: var(--fs-14, 14px); font-weight: var(--font-semibold, 600); color: #1E2A5A; white-space: nowrap; }

    /* Panel = KHUNG PEACH; vùng chat là CARD TRẮNG inset (viền peach lộ 2 bên + đáy — đúng Form Copilot).
       Float: nổi góc phải, height GIỚI HẠN (không full màn). Right/Left: drawer full-height sát mép. */
    .ai-panel { position: fixed; right: 18px; bottom: 18px; z-index: 1350;
      width: 380px; max-width: calc(100vw - 36px); height: min(600px, calc(100vh - 96px));
      display: flex; flex-direction: column;
      /* Nền GRADIENT pastel sau khung chat (xanh → lavender → cam đào, cố định cả 2 theme —
         màu nhận diện AI; card chat bên trong vẫn theo token nên nội dung tự flip light/dark). */
      background: linear-gradient(180deg, #E7F0FE 0%, #EDEAFB 48%, #FCE8DC 100%);
      border: 1px solid rgb(255 255 255 / .65);
      border-radius: var(--radius-2xl, 16px); box-shadow: var(--shadow-regular-lg, var(--shadow-regular-md)); overflow: visible;
      animation: ai-pop .28s var(--ease-out, ease-out); }
    @keyframes ai-pop { from { opacity: 0; transform: translateY(16px) scale(.97); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { .ai-panel { animation: none; } }
    .ai-panel--right { top: 54px; right: 0; bottom: 0; height: auto; border-radius: 0; border: 0; border-left: 1px solid var(--border-sub); }
    .ai-panel--left { top: 54px; left: 0; right: auto; bottom: 0; height: auto; border-radius: 0; border: 0; border-right: 1px solid var(--border-sub); }
    .ai-body { position: relative; z-index: 1; flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column;
      margin: 0 8px 8px; background: var(--bg-surface); border-radius: 14px; overflow: hidden;
      box-shadow: 0 -2px 8px rgb(0 0 0 / .05); }
    .ai-panel--right .ai-body, .ai-panel--left .ai-body { border-radius: 14px 14px 0 0; margin-bottom: 0; }
    /* Dropdown vị trí khung chat */
    .ai-dock-bd { position: fixed; inset: 0; z-index: 1; }
    .ai-dock-menu { position: absolute; top: 52px; right: 40px; z-index: 2; min-width: 168px;
      display: flex; flex-direction: column; gap: 2px; padding: 6px;
      background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: var(--radius-lg); box-shadow: var(--shadow-regular-md); }
    .ai-dock-it { display: flex; align-items: center; gap: 10px; padding: 8px 11px; border: 0;
      border-radius: var(--radius-md); background: transparent; font: inherit; font-size: var(--fs-13);
      font-weight: var(--font-medium, 500); color: var(--text-strong); cursor: pointer; text-align: left; }
    .ai-dock-it:hover { background: var(--bg-surface-subtle); }
    .ai-dock-it.on { background: #EDEAFB; color: #1E2A5A; }
    /* Header PEACH — màu nhận diện chatbot (cố ý không token, giữ nguyên ở cả dark) */
    .ai-head { position: relative; flex: none; display: flex; align-items: center; gap: 10px;
      min-height: 76px; padding: 10px 12px 10px 98px; }
    /* Mascot KHÔNG bọc khung — ảnh lớn neo góc trái header, phần thân tràn xuống bị card chat
       (z cao hơn) che → cảm giác mascot ĐỨNG SAU khung chat (đúng Form Copilot). */
    .ai-mascot { position: absolute; left: 8px; top: 9px; z-index: 0; }
    .ai-mascot--fb { display: grid; place-items: center; width: 56px; height: 56px; left: 20px; top: 12px;
      border-radius: 50%; background: linear-gradient(135deg, #3B82F6, #1D4ED8); color: #fff; }
    .ai-head-t { flex: 1; min-width: 0; }
    /* Header nằm trên nền pastel SÁNG cố định → chữ navy cố định (không theo token dark). */
    .ai-head-name { display: flex; align-items: center; gap: 6px; font-size: var(--fs-15, 15px); font-weight: var(--font-bold, 700); color: #1E2A5A; }
    .ai-badge { font-size: 10px; font-weight: 700; line-height: 1.4; background: #1E2A5A; color: #fff; border-radius: 6px; padding: 1px 6px; }
    .ai-head-sub { font-size: var(--fs-12); color: #1E2A5A; opacity: .72;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ai-head-ico { color: #1E2A5A; }
    .ai-head-ico:hover { background: rgb(30 42 90 / .08); color: #1E2A5A; }
    .ai-log { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 10px; }
    .ai-input { background: var(--bg-surface); }
    .ai-m { max-width: 88%; font-size: var(--fs-13); line-height: 1.55; white-space: pre-wrap; }
    .ai-m--u { align-self: flex-end; background: var(--secondary, var(--bg-surface-subtle)); color: var(--text-strong); padding: 8px 12px; border-radius: var(--radius-lg); }
    .ai-m--b { align-self: flex-start; color: var(--text-body); }
    .ai-sug { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
    .fb-ai-chip { border: 1px solid var(--border-sub); border-radius: var(--radius-full, 999px);
      background: var(--bg-surface); padding: 4px 11px; font: inherit; font-size: var(--fs-12); color: var(--text-body); cursor: pointer;
      max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: left; }
    .fb-ai-chip:hover { border-color: var(--primary-base); color: var(--primary-base); }
    .ai-input { flex: none; padding: 10px 12px 12px; }
    /* KHUNG input kiểu Copilot: 1 khung bo lớn FULL width chứa cả ô gõ + hàng nút action. */
    .ai-input-box { display: flex; flex-direction: column; gap: 6px; padding: 4px 10px 10px;
      border: 1px solid var(--border-sub); border-radius: 16px; background: var(--bg-surface);
      transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out); }
    .ai-input-box:focus-within { border-color: var(--primary-base); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary-base) 12%, transparent); }
    /* Ô gõ bên trong KHÔNG viền/focus riêng — khung ngoài lo. */
    .ai-input-box ::ng-deep .ant-input { border: 0 !important; box-shadow: none !important; background: transparent; padding-inline: 2px; }
    .ai-input-bar { display: flex; align-items: center; gap: 8px; }
    .ai-rnd { display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid var(--border-sub);
      border-radius: 50%; background: var(--bg-surface); color: var(--text-sub); cursor: pointer; flex: none; }
    .ai-rnd:hover { border-color: var(--primary-base); color: var(--primary-base); }
    .ai-chip-b { display: inline-flex; align-items: center; gap: 5px; border: 1px solid var(--border-sub);
      border-radius: var(--radius-full, 999px); background: var(--bg-surface); padding: 5px 12px;
      font: inherit; font-size: var(--fs-12); font-weight: var(--font-medium, 500); color: var(--text-body); cursor: pointer; }
    .ai-chip-b:hover { border-color: var(--primary-base); color: var(--primary-base); }
    .ai-spacer { flex: 1; }
    /* Nút Nói — pill xanh primary (khớp nút Talk xanh của Form Copilot) */
    .ai-talk { display: inline-flex; align-items: center; gap: 6px; border: 0; border-radius: var(--radius-full, 999px);
      background: var(--primary-base); color: var(--static-white, #fff); padding: 7px 16px;
      font: inherit; font-size: var(--fs-13); font-weight: var(--font-semibold, 600); cursor: pointer; }
    .ai-talk:hover { filter: brightness(.95); }

    /* Card quy tắc */
    .rl { border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface); overflow: hidden; }
    .rl-head { display: flex; align-items: center; gap: 9px; padding: 10px 12px; background: var(--bg-surface-subtle); border-bottom: 1px solid var(--border-soft); }
    .rl-no { flex: none; display: grid; place-items: center; width: 22px; height: 22px; border-radius: var(--radius-full, 999px);
      background: var(--primary-base); color: var(--static-white, #fff); font-size: var(--fs-12); font-weight: var(--font-bold, 700); }
    .rl-name { flex: 1; min-width: 0; border: 1px solid transparent; background: transparent; font: inherit;
      font-size: var(--fs-13); font-weight: var(--font-semibold, 600); color: var(--text-strong); padding: 4px 6px; border-radius: var(--radius-sm); }
    .rl-name:hover { border-color: var(--border-sub); }
    .rl-name:focus { outline: none; border-color: var(--primary-base); background: var(--bg-surface); }
    .rl-sec { display: flex; gap: 12px; padding: 12px; }
    .rl-sec + .rl-sec { border-top: 1px dashed var(--border-soft); }
    .rl-kw { flex: none; width: 84px; padding-top: 5px; font-size: var(--fs-11, 11px); font-weight: var(--font-bold, 700);
      letter-spacing: .05em; color: var(--warning-base); }
    .rl-kw--do { color: var(--success-base, var(--primary-base)); }
    .rl-rows { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
    .rl-row { display: flex; align-items: center; gap: 8px; flex-wrap: nowrap; }
    @media (max-width: 720px) { .rl-row { flex-wrap: wrap; } }
    /* Hàng HÀNH ĐỘNG giữ UI cũ: được rớt dòng (công thức Tính toán cần bề ngang) */
    .rl-row--act { flex-wrap: wrap; }
    .rl-and { font-size: var(--fs-11, 11px); font-weight: var(--font-bold, 700); color: var(--text-strong); }
    /* Giá trị ĐÃ CHỌN = màu đậm (không dùng màu mờ xám) */
    .rl-and-sel ::ng-deep .ant-select-selection-item { font-size: var(--fs-12); font-weight: var(--font-bold, 700); color: var(--text-strong); }
    .rl-w-f { flex: 1 1 190px; min-width: 150px; }
    .rl-w-op { flex: 0 1 170px; min-width: 132px; }
    .rl-w-kind { flex: none; }
    .rl-w-v { flex: 1 1 170px; min-width: 132px; }
    .rl-and-sel { width: 84px; flex: 0 0 84px; }
    .rl-formula { flex: 1 1 100%; }
    .rl-formula ::ng-deep textarea { font-family: var(--font-mono, ui-monospace, monospace); font-size: var(--fs-12); }
    .rl-fx-hint { flex: 1 1 100%; font-size: var(--fs-11, 11px); color: var(--text-soft); }
  