
    :host { display: flex; flex-direction: column; gap: 14px; min-height: 0; overflow: auto; padding: 12px 2px 24px; }

    .t3-head { display: flex; flex-direction: column; gap: 8px; }
    .t3-chain { display: flex; align-items: stretch; gap: 6px; flex-wrap: wrap; }
    .t3-layer {
      display: flex; flex-direction: column; align-items: flex-start; gap: 2px;
      border: 1px solid var(--border-sub); border-radius: var(--radius-md);
      background: var(--bg-surface); padding: 6px 10px; min-width: 0;
    }
    .t3-layer--miss { border-style: dashed; }
    .t3-layer--miss .t3-layer__num { color: var(--text-sub); font-weight: 500; font-size: var(--fs-12); }
    .t3-layer__lb { font-size: var(--fs-11); font-weight: 600; text-transform: uppercase; letter-spacing: .03em; color: var(--text-sub); }
    .t3-layer__num { font-size: var(--fs-14); font-weight: 700; font-variant-numeric: tabular-nums; color: var(--text-strong); }
    .t3-chain__sep { align-self: center; color: var(--text-soft); font-weight: 700; }
    .t3-pairs { display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap; }
    .t3-pair { display: inline-flex; align-items: baseline; gap: 8px; }
    .t3-pair__lb { font-size: var(--fs-12); color: var(--text-sub); }
    .t3-pair__na { font-size: var(--fs-12); font-weight: 600; color: var(--text-soft); }
    .t3-fallback { margin: 0; font-size: var(--fs-12); color: var(--warning-text); }
    .t3-head__unex { margin-left: auto; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
    .t3-head__unex-lb { font-size: var(--fs-12); font-weight: 600; color: var(--text-sub); text-transform: uppercase; letter-spacing: .04em; }
    .t3-head__unex-num { font-size: var(--fs-24, 24px); font-weight: 700; font-variant-numeric: tabular-nums; color: var(--text-strong); }
    .t3-head__unex-num--over { color: var(--error-base); }
    .t3-head__unex-sub { font-size: var(--fs-11); color: var(--text-soft); }

    .t3-axis { display: flex; align-items: center; gap: 10px; }
    .t3-axis__lb { font-size: var(--fs-12); color: var(--text-sub); }
    .t3-axis__note { font-size: var(--fs-11); color: var(--text-soft); }

    .t3-tree { border: 1px solid var(--border-sub); border-radius: var(--radius-md); overflow: hidden; }
    .t3-node { display: flex; align-items: center; gap: 8px; padding: 5px 12px; border-bottom: 1px solid var(--border-sub); min-width: 0; }
    .t3-node:hover { background: var(--bg-surface-subtle); }
    .t3-node--empty { opacity: .55; }
    .t3-node__toggle {
      flex: none; width: 18px; height: 18px; line-height: 1; border: 1px solid var(--border-sub);
      border-radius: var(--radius-sm); background: var(--bg-surface); cursor: pointer;
      font: inherit; font-size: var(--fs-12); color: var(--text-sub); display: inline-flex; align-items: center; justify-content: center;
    }
    .t3-node__dot { flex: none; width: 5px; height: 5px; border-radius: 50%; background: var(--text-soft); margin: 0 6px; }
    .t3-node__label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--fs-13); color: var(--text-body); }
    .t3-node:not(.t3-node--leaf) .t3-node__label { font-weight: 600; color: var(--text-strong); }
    .t3-node__count { flex: none; font-size: var(--fs-11); color: var(--text-sub); background: var(--bg-surface-subtle); border-radius: var(--radius-full); padding: 0 7px; }
    .t3-node__amount { margin-left: auto; flex: none; font-variant-numeric: tabular-nums; font-weight: 600; font-size: var(--fs-13); }
    .t3-node__amount[data-tone='up'] { color: var(--error-base); }
    .t3-node__amount[data-tone='down'] { color: var(--success-base); }
    .t3-node__amount[data-tone='zero'] { color: var(--text-soft); }
    .t3-tree__footer { padding: 8px 12px; font-size: var(--fs-12); color: var(--text-sub); background: var(--bg-surface-subtle); }
    .t3-tree__footer b { color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .t3-tree__ok { color: var(--success-base); font-weight: 700; }

    .t3-sec { display: flex; flex-direction: column; gap: 8px; }
    .t3-sec__title { margin: 0; font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .t3-sec__hint { font-size: var(--fs-11); font-weight: 400; color: var(--text-soft); }

    .t3-mota { display: flex; align-items: center; gap: 6px; min-width: 0; }
    .t3-mota__tx { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-strong); }
    .t3-nhanh, .t3-truc { font-size: var(--fs-12); color: var(--text-sub); }
    .t3-money { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--error-base); }
    .t3-money--neg { color: var(--success-base); }
    .t3-kl { display: flex; align-items: center; gap: 6px; min-width: 0; }
    .t3-kl__tx { font-size: var(--fs-12); color: var(--text-body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .t3-muted { color: var(--text-soft); font-size: var(--fs-12); }

    .t3-empty { padding: 56px 0; display: flex; justify-content: center; }
    .t3-form { display: flex; flex-direction: column; gap: 8px; }
    .t3-form__hint { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .t3-form__hint b { color: var(--text-strong); }
    .t3-form__err { font-size: var(--fs-12); color: var(--error-text); }
  