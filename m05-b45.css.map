
    :host { display: block; }
    .b4 { display: flex; flex-direction: column; gap: 14px; max-width: 980px; }
    .b4__sec { display: flex; flex-direction: column; gap: 8px; border: 1px solid var(--border-sub);
      border-radius: var(--radius-lg); background: var(--bg-surface); padding: 12px 14px; }
    .b4__muted { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .b4__muted b { color: var(--text-strong); }
    .b4__trust { font-size: var(--fs-11); font-weight: 500; color: var(--warning-text); background: var(--warning-bg);
      border: 1px dashed var(--warning-base, var(--warning-text)); border-radius: var(--radius-full); padding: 1px 9px; cursor: help; margin-left: 6px; }
    .b4__lan { display: flex; flex-direction: column; gap: 6px; border: 1px solid var(--border-soft); border-radius: var(--radius-md); padding: 10px 12px; }
    .b4__lanhead { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    :host ::ng-deep .b4__lanhead .ant-tag, :host ::ng-deep .b4__ketqua .ant-tag { margin: 0; }
    .b4__ketqua { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  