
:host { display: flex; flex-direction: column; gap: var(--space-6); padding: var(--space-6); max-width: 960px; margin-inline: auto; width: 100%; }

.ims-head { display: flex; flex-direction: column; gap: var(--space-1); }
.ims-title { margin: 0; font-size: var(--fs-18); font-weight: var(--font-semibold); color: var(--text-strong); }
.ims-sub { margin: 0; font-size: var(--fs-13); color: var(--text-sub); }
.ims-mode { align-self: flex-start; }

.ims-sec { display: flex; flex-direction: column; gap: var(--space-4); }
.ims-hint { margin: 0; font-size: var(--fs-13); color: var(--text-sub); }
.ims-note { margin: 0; font-size: var(--fs-12); color: var(--text-soft); }
.ims-h4 { margin: 0; font-size: var(--fs-15); font-weight: var(--font-semibold); color: var(--text-strong); }

/* — mode template — */
.ims-tpl-row { display: flex; align-items: center; gap: var(--space-3); }
.ims-tpl-select { width: 260px; }
.ims-fileok { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4);
  border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface); }
.ims-fileok-ic { color: var(--icon-secondary); }
.ims-fileok-body { flex: 1; min-width: 0; }
.ims-fileok-name { font-size: var(--fs-14); font-weight: var(--font-semibold); color: var(--text-strong); }
.ims-fileok-meta { font-size: var(--fs-12); color: var(--text-sub); font-variant-numeric: tabular-nums; }

/* — dropzone — */
.ims-drop { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); text-align: center;
  padding: var(--space-12) var(--space-6); border: 1px dashed var(--border-sub); border-radius: var(--radius-lg);
  cursor: pointer; transition: border-color .15s ease, background .15s ease; }
.ims-drop:hover { border-color: var(--primary-border); background: var(--primary-bg-subtle); }
.ims-drop-ic { color: var(--icon-secondary); }
.ims-drop-ic--ai { color: var(--primary-base); }
.ims-drop-title { font-size: var(--fs-15); font-weight: var(--font-semibold); color: var(--text-strong); }
.ims-drop-ext { font-size: var(--fs-12); color: var(--text-soft); }
.ims-drop-ai { font-size: var(--fs-13); color: var(--primary-base); }

/* — chips năng lực AI — */
.ims-caps { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); }
.ims-caps-lbl { font-size: var(--fs-13); color: var(--text-sub); }
.ims-cap-ic { color: var(--success-base); vertical-align: -2px; margin-right: var(--space-1); }

/* — scanning — */
.ims-scan { max-width: 640px; width: 100%; margin: 0 auto; }
.ims-file-line { display: flex; align-items: center; gap: var(--space-2); font-size: var(--fs-13); color: var(--text-sub); }
.ims-file-ic { color: var(--icon-secondary); }
.ims-file-name { font-weight: var(--font-medium); color: var(--text-strong); }
.ims-file-meta { font-variant-numeric: tabular-nums; }
.ims-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
.ims-step { display: flex; align-items: center; gap: var(--space-2); font-size: var(--fs-13); color: var(--text-body); }
.ims-step--todo { color: var(--text-soft); }
.ims-step-done { color: var(--success-base); }
.ims-step-spin { color: var(--primary-base); animation: ims-rot .9s linear infinite; }
.ims-step-dot { flex: none; width: 8px; height: 8px; margin: var(--space-1); border-radius: var(--radius-full); background: var(--border-strong); }
@keyframes ims-rot { to { transform: rotate(360deg); } }

/* — kết quả scan — */
.ims-done-head { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
.ims-done-meta { font-size: var(--fs-13); color: var(--text-sub); font-variant-numeric: tabular-nums; }
.ims-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-3); }

.ims-map-field { font-weight: var(--font-medium); color: var(--text-strong); white-space: nowrap; }
.ims-req { color: var(--error-base); margin-left: var(--space-1); }
.ims-map-col { font-variant-numeric: tabular-nums; }
.ims-map-actions { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
.ims-remap { display: inline-block; width: 220px; }

/* Panel bảng mapping kiểu list-page: viền bo overflow-hidden, head = toolbar band (border-bottom), grid flush */
.ims-tablecard { border: 1px solid var(--border-sub); border-radius: var(--radius-lg); overflow: hidden; }
.ims-map-head { display: flex; align-items: baseline; gap: var(--space-2); padding: var(--space-2-5) var(--space-3);
  border-bottom: 1px solid var(--border-sub); font-size: var(--fs-14); font-weight: var(--font-semibold); color: var(--text-strong); }
.ims-tablewrap { min-width: 0; }
.ims-tablewrap ::ng-deep .ant-table { border: 0; border-radius: 0; background: transparent; }
.ims-map-head span { font-size: var(--fs-12); font-weight: var(--font-regular); color: var(--text-soft); }
.ims-map-field { font-weight: var(--font-medium); color: var(--text-strong); white-space: nowrap; }
.ims-req { color: var(--error-base); margin-left: var(--space-1); }
.ims-map-col { font-variant-numeric: tabular-nums; }
.ims-map-actions { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
.ims-mapsel { display: block; width: 100%; min-width: 150px; }
.ims-explain-in { display: block; max-width: 300px; }
/* — confidence + popover explainability — */
.ims-conf { display: inline-flex; align-items: center; gap: var(--space-2); border: 0; background: transparent;
  font: inherit; font-size: var(--fs-13); color: var(--text-body); font-variant-numeric: tabular-nums;
  padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); cursor: pointer; }
.ims-conf:hover { background: var(--bg-surface-subtle); }
.ims-conf:focus-visible { outline: 2px solid var(--border-focus); outline-offset: 1px; }
.ims-conf-dot { flex: none; width: 8px; height: 8px; border-radius: var(--radius-full); }
.ims-conf-dot[data-tone='success'] { background: var(--success-base); }
.ims-conf-dot[data-tone='warning'] { background: var(--warning-base); }
.ims-conf-dot[data-tone='error'] { background: var(--error-base); }
.ims-explain-title { font-size: var(--fs-13); font-weight: var(--font-semibold); color: var(--text-strong); margin-bottom: var(--space-2); }
.ims-explain-body { font-size: var(--fs-13); color: var(--text-body); white-space: pre-line; }
.ims-explain-foot { display: flex; gap: var(--space-2); margin-top: var(--space-3); }
  