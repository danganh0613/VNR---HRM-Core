
.hrm-grid--striped tbody tr:nth-child(even) > td { background: var(--bg-surface-subtle); }
.hrm-grid--striped tbody tr:hover > td { background: var(--bg-surface-hover, var(--bg-surface-subtle)); }

/* variant 'card' — dòng bo góc + cách nhau, hover nền nhạt (kiểu thẻ dữ liệu). Toàn token.
   Bỏ khung ngoài mặc định (từng dòng đã tự có viền + bo góc riêng). */
:host(.hrm-grid--card) ::ng-deep .ant-table { background: transparent; border: 0; border-radius: 0; overflow: visible; }
:host(.hrm-grid--card) ::ng-deep .ant-table table { border-collapse: separate; border-spacing: 0 8px; }
:host(.hrm-grid--card) ::ng-deep thead th {
  background: transparent; border: 0 !important; color: var(--text-sub);
  font-size: var(--fs-12); font-weight: 600; text-transform: uppercase; letter-spacing: .03em; padding: 4px 14px;
}
:host(.hrm-grid--card) ::ng-deep tbody > tr > td {
  background: var(--bg-surface); border-top: 1px solid var(--border-sub); border-bottom: 1px solid var(--border-sub);
  padding: 12px 14px; transition: background var(--duration-fast, .15s) var(--ease-out, ease);
}
:host(.hrm-grid--card) ::ng-deep tbody > tr > td:first-child {
  border-left: 1px solid var(--border-sub);
  border-top-left-radius: var(--radius-lg); border-bottom-left-radius: var(--radius-lg);
}
:host(.hrm-grid--card) ::ng-deep tbody > tr > td:last-child {
  border-right: 1px solid var(--border-sub);
  border-top-right-radius: var(--radius-lg); border-bottom-right-radius: var(--radius-lg);
}
:host(.hrm-grid--card) ::ng-deep tbody > tr:hover > td { background: var(--bg-surface-subtle); }

/* v1.3 — density (theo Astryx): cell ăn token --table-cell-pad/--table-font-size.
   Mặc định 'auto' = kế thừa global html[data-density] (config app). Input cụ thể = override var cục bộ. */
:host ::ng-deep .ant-table.ant-table-small .ant-table-tbody > tr > td,
:host ::ng-deep .ant-table.ant-table-small .ant-table-thead > tr > th {
  padding: var(--table-cell-pad, 8px 12px); font-size: var(--table-font-size, 13px);
}
:host([data-density='compact']) { --table-cell-pad: 4px 10px; --table-font-size: var(--fs-12); }
:host([data-density='balanced']) { --table-cell-pad: 8px 12px; --table-font-size: var(--fs-13); }
:host([data-density='spacious']) { --table-cell-pad: 14px 16px; --table-font-size: var(--fs-14); }

/* Header: nền secondary (dịu, tách khỏi body), semibold 600, màu phụ, gạch dưới 1px —
   bỏ vạch dọc phân cột mặc định của ant. Sort icon Tabler do bridge lo (toàn hệ thống). */
:host ::ng-deep .ant-table.ant-table-small .ant-table-thead > tr > th {
  background: var(--bg-surface-subtle); font-weight: 600; color: var(--text-sub);
  border-bottom: 1px solid var(--border-sub);
}

/* Responsive: cột co tới min-width thì bảng hiện thanh cuộn ngang (đặt [minWidth] hoặc width cột). */
:host ::ng-deep .ant-table-content,
:host ::ng-deep .ant-table-body { overflow-x: auto; }
/* Cột ghim (fixed): offset left/right do applyPinOffsets() TỰ tính cộng dồn (đè inline) —
   KHÔNG ép left:0/right:0 ở đây nữa (bug cũ: ghim ≥2 cột đều về 0 ⇒ chồng lên nhau).
   Nền đặc để nội dung cuộn không lộ dưới. */
:host ::ng-deep .ant-table-cell-fix-right,
:host ::ng-deep .ant-table-cell-fix-left { background: var(--bg-surface); z-index: 3; }
/* Header cột ghim: đè rule header 'transparent' (specificity cao) để chữ dưới không lộ qua. */
:host ::ng-deep .ant-table.ant-table-small .ant-table-thead .ant-table-cell-fix-right,
:host ::ng-deep .ant-table.ant-table-small .ant-table-thead .ant-table-cell-fix-left { background: var(--bg-surface-subtle); }
/* Hover dòng — MỘT màu cho MỌI ô, kể cả cột ghim (fixed có nền đặc riêng nên phải đè).
   Đè cả rule mặc định của ant (specificity cao) để cột hành động không lệch màu với dòng. */
:host ::ng-deep .ant-table-tbody > tr:hover > td,
:host ::ng-deep .ant-table-tbody > tr.ant-table-row:hover > td {
  background: var(--table-row-hover-bg, var(--bg-surface-subtle)) !important;
}
:host ::ng-deep .ant-table-thead > tr > th::before { display: none !important; }

/* v1.3 — dividers: rows = mặc định nz (line ngang). */
:host([data-dividers='columns']) ::ng-deep .ant-table.ant-table-small .ant-table-tbody > tr > td { border-bottom: 0; }
:host([data-dividers='columns']) ::ng-deep .ant-table.ant-table-small .ant-table-tbody > tr > td:not(:last-child),
:host([data-dividers='columns']) ::ng-deep .ant-table.ant-table-small .ant-table-thead > tr > th:not(:last-child) { border-right: 1px solid var(--border-sub); }
:host([data-dividers='grid']) ::ng-deep .ant-table.ant-table-small .ant-table-tbody > tr > td:not(:last-child),
:host([data-dividers='grid']) ::ng-deep .ant-table.ant-table-small .ant-table-thead > tr > th:not(:last-child) { border-right: 1px solid var(--border-sub); }
:host([data-dividers='none']) ::ng-deep .ant-table.ant-table-small .ant-table-tbody > tr > td { border-bottom: 0; }

/* v1.3 — textOverflow='truncate': cắt chữ ellipsis (header luôn cắt). Cần width cột để cột không co về 0. */
:host(.hrm-grid--truncate) ::ng-deep .ant-table table { table-layout: fixed; }
:host(.hrm-grid--truncate) ::ng-deep .ant-table-tbody > tr > td,
:host(.hrm-grid--truncate) ::ng-deep .ant-table-thead > tr > th { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hg-trunc { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* variant 'record' — bảng bản ghi đơn: cột nhãn nền secondary (như header dọc), cột giá trị bình thường. */
:host(.hrm-grid--record) ::ng-deep .hg-rec-label {
  background: var(--bg-surface-subtle); color: var(--text-sub); font-weight: 500;
  vertical-align: middle; white-space: nowrap;
}
:host(.hrm-grid--record) ::ng-deep .hg-rec-value { color: var(--text-body); vertical-align: middle; }
/* Kẻ dọc mảnh giữa nhãn và giá trị cho dễ dò. */
:host(.hrm-grid--record) ::ng-deep .hg-rec-label { border-right: 1px solid var(--border-sub); }

/* ══ v1.4 — Tùy biến cột: header controls (grip + sort ghim + ⋯), thanh "Cột" ══ */
/* Bố cục 1 header: grip | nhãn(+sort) | ⋯. reserve chỗ ⇒ hover KHÔNG làm chữ nhảy. */
.hg-th { display: flex; align-items: center; gap: 2px; min-width: 0; }
/* Header kéo-được-để-nhóm (không grip): cursor grab gợi ý có thể kéo tiêu đề vào rổ nhóm. */
.hg-th--grab { cursor: grab; }
.hg-th--grab:active { cursor: grabbing; }
.hg-lbl {
  display: inline-flex; align-items: center; gap: 4px; min-width: 0;
  border: 0; background: transparent; padding: 0; margin: 0; color: inherit;
  font: inherit; font-weight: inherit; letter-spacing: inherit; text-transform: inherit;
}
.hg-lbl-t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* ── NHÓM CỘT: hàng tiêu đề nhóm (tầng trên header) ── */
.hg-grouprow > th.hg-gh {
  position: relative; text-align: center; padding: 4px 8px; background: var(--bg-surface-subtle);
  border-bottom: 1px solid var(--border-sub); font-size: var(--fs-12, 12px);
  font-weight: var(--font-semibold, 600); color: var(--text-sub);
}
/* Divider dọc ngăn nhóm: INSET (~60% cao, canh giữa) — đồng bộ header mặc định, KHÔNG full độ cao hàng. */
.hg-grouprow > th.hg-gh:not(.hg-gh--empty):not(:last-child)::after {
  content: ''; position: absolute; inset-inline-end: 0; top: 50%; transform: translateY(-50%);
  height: 60%; width: 1px; background: var(--border-sub);
}
.hg-grouprow > th.hg-gh--empty { background: var(--bg-surface-subtle); }
.hg-gh-t { display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
.hg-lbl--sort { cursor: pointer; }
.hg-lbl--sort:hover { color: var(--text-strong); }
.hg-lbl--sort:focus-visible { outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: 2px; border-radius: var(--radius-sm); }
/* Grip kéo — ĐẶT TUYỆT ĐỐI trong vùng padding TRÁI của ô ⇒ KHÔNG chiếm chỗ inline, nhãn
   header bắt đầu đúng mép content = THẲNG HÀNG với dữ liệu bên dưới (data không có grip).
   Chỉ hiện khi hover. Cursor grab. */
.hg-grip {
  position: absolute; inset-inline-start: 0; top: 50%; transform: translateY(-50%);
  display: inline-grid; place-items: center; width: 12px; height: 18px; color: var(--text-soft);
  cursor: grab; opacity: 0; transition: opacity var(--duration-fast, .15s) var(--ease-out, ease);
}
.hg-grip:active { cursor: grabbing; }
.hg-th--x:hover .hg-grip { opacity: .7; }
/* Mũi tên sort: idle mờ (chỉ hiện khi hover), active GHIM (luôn hiện, màu primary). */
.hg-sort { flex: none; }
/* Icon sort LUÔN hiện mờ ở cột sắp-xếp-được (để user biết bấm được), đậm lên khi hover. */
.hg-sort--idle { opacity: .4; color: var(--text-soft); transition: opacity var(--duration-fast, .15s) var(--ease-out, ease); }
.hg-lbl--sort:hover .hg-sort--idle { opacity: .75; }
.hg-sort--on { opacity: 1; color: var(--primary-base); }
/* Số ưu tiên khi sort ≥2 cấp — badge nhỏ cạnh mũi tên. */
.hg-sort-pri { font-size: var(--fs-10, 10px); font-weight: var(--font-semibold, 600); color: var(--primary-base); line-height: 1; margin-inline-start: 1px; }
/* Nút ⋯ — hiện khi hover header (hoặc khi menu đang mở, ant thêm .ant-dropdown-open). */
.hg-more {
  flex: none; display: inline-grid; place-items: center; width: 20px; height: 20px; margin-inline-start: auto;
  border: 0; background: transparent; border-radius: var(--radius-sm); cursor: pointer; color: var(--text-soft);
  opacity: 0; transition: opacity var(--duration-fast, .15s) var(--ease-out, ease), background var(--duration-fast, .15s) var(--ease-out, ease);
}
.hg-th--x:hover .hg-more, .hg-more.ant-dropdown-open { opacity: 1; }
.hg-more:hover { background: var(--bg-surface); color: var(--text-strong); }
.hg-more:focus-visible { opacity: 1; outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: 1px; }

/* Tay kéo độ rộng cột — dải mảnh cạnh phải header. th không-ghim cần position:relative để neo
   (th ghim đã là position:sticky → tự làm chứa tuyệt đối). z-index cao hơn ⋯ để luôn bắt được. */
:host ::ng-deep .ant-table-thead > tr > th:not(.ant-table-cell-fix-left):not(.ant-table-cell-fix-right) { position: relative; }
/* Vùng bắt kéo RỘNG 12px, nằm HẲN trong cell (không thò ra ngoài → không bị th kế đè do stacking
   context; bug cũ: tay 8px thò -3px, pointerdown trúng th thay vì tay). z-index cao để luôn nhận. */
.hg-resize {
  position: absolute; top: 0; inset-inline-end: 0; width: 12px; height: 100%; z-index: 6;
  cursor: col-resize; touch-action: none; user-select: none;
}
/* Đường phân cột LUÔN hiện (mảnh 1px, dịu) để user biết cột kéo được; đậm dần khi hover/kéo. */
.hg-resize::after {
  content: ''; position: absolute; top: 50%; transform: translateY(-50%); inset-inline-end: 3px; width: 1px; height: 45%;
  background: var(--border-sub); transition: background var(--duration-fast, .15s) var(--ease-out, ease);
}
.ant-table-thead > tr > th:hover .hg-resize::after, .hg-resize:hover::after { background: var(--text-soft); width: 2px; }
.hg-resize:active::after { background: var(--primary-base); width: 2px; }

/* Thanh "Cột" trên bảng — phải, gọn. */
.hg-bar { display: flex; justify-content: flex-end; margin-bottom: 8px; }
.hg-colbtn {
  display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 10px;
  border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md);
  cursor: pointer; color: var(--text-body); font: inherit; font-size: var(--fs-13);
  transition: border-color var(--duration-fast, .15s) var(--ease-out, ease), background var(--duration-fast, .15s) var(--ease-out, ease);
}
.hg-colbtn:hover { border-color: var(--primary-border); color: var(--text-strong); }
.hg-colbtn:focus-visible { outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: 1px; }
.hg-colbtn-n {
  display: inline-grid; place-items: center; min-width: 16px; height: 16px; padding: 0 4px;
  border-radius: var(--radius-full); background: var(--primary-bg-soft); color: var(--primary-base);
  font-size: var(--fs-11); font-weight: 600; line-height: 1;
}

/* Menu ⋯ / "Cột" — icon + chữ, dòng ẩn thì icon mắt-tắt mờ đi. */
:host ::ng-deep .hg-menu li[nz-menu-item] { display: flex; align-items: center; gap: 8px; }
:host ::ng-deep .hg-menu .hg-mi-off { opacity: .5; }

/* ══ NHÓM DỮ LIỆU (row grouping): dòng tiêu đề nhóm = toggle + nhãn (thụt theo cấp) + đếm bản ghi ══ */
.hg-grp { background: var(--bg-surface-subtle); }
.hg-grp > td { padding: 6px 12px; }
.hg-grp-tog { display: inline-grid; place-items: center; width: 20px; height: 20px; border: 0; background: transparent; cursor: pointer; color: var(--text-sub); vertical-align: middle; }
.hg-grp-lbl { font-size: var(--fs-13); font-weight: var(--font-semibold, 600); color: var(--text-strong); }
.hg-grp-n { margin-left: 8px; font-size: var(--fs-12); color: var(--text-sub); background: var(--bg-surface); border: 1px solid var(--border-soft); border-radius: var(--radius-full, 999px); padding: 0 8px; }
  