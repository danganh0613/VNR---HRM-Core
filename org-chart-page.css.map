
    .ocp-desktop { height: 720px; border: 1px solid var(--border-sub); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-regular-sm); }
    .ocp-actions { margin-top: 14px; }
    .ocp-full-link { text-decoration: none; }
    /* Chế độ preview — full viewport thật (tab mới), sơ đồ cao hơn. */
    .ocp-preview { height: 100vh; overflow: hidden; }

    /* Vùng content của App Shell → cột dọc, bỏ padding để màn Sơ đồ tổ chức tự bố cục + lấp đầy. */
    :host ::ng-deep .shell-content { padding: 0; display: flex; flex-direction: column; min-height: 0; }

    .ocp { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; background: var(--bg-surface); }
    .ocp-head { flex: none; padding: 14px 20px; border-bottom: 1px solid var(--border-sub); background: var(--bg-surface); }
    .ocp-titlebar { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .ocp-title { margin: 0; font-size: var(--fs-20); font-weight: 700; color: var(--text-strong); }
    .ocp-export { display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); color: var(--text-body); font-size: var(--fs-13); font-weight: 500; cursor: pointer; }
    .ocp-export:hover { border-color: var(--primary-base); color: var(--text-strong); }
    /* Vùng nội dung: padding ĐỀU 4 phía; org chart lấp đầy chiều cao → khoảng cách dưới = trái/phải. */
    .ocp-body { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 20px; background: var(--bg-canvas); }
    .ocp-body ::ng-deep hrm-org-chart { flex: 1; min-height: 0; min-width: 0; display: flex; flex-direction: column; }
    .ocp-body ::ng-deep hrm-org-chart .oc { flex: 1; min-height: 0; min-width: 0; }
    .ocp-body ::ng-deep hrm-org-chart .oc-viewport { flex: 1; min-height: 0; height: auto; }
  