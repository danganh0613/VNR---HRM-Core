
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; padding: 0 20px; }

    .qp__head { flex: none; }
    .qp__titlerow { display: flex; align-items: baseline; gap: 10px; padding: 10px 0 6px; min-width: 0; }
    .qp__title { margin: 0; font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); white-space: nowrap; }
    .qp__subtitle { font-size: var(--fs-12); color: var(--text-sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .qp__tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--border-sub); overflow-x: auto; }
    .qp__tab {
      position: relative; display: inline-flex; align-items: baseline; gap: 5px; flex: none;
      border: 0; background: none; cursor: pointer; padding: 6px 10px 8px;
      font: inherit; font-size: var(--fs-13); color: var(--text-sub);
    }
    .qp__tab:hover { color: var(--text-strong); }
    .qp__tab--active { color: var(--primary-base); font-weight: 600; }
    .qp__tab--active::after {
      content: ''; position: absolute; left: 8px; right: 8px; bottom: -1px; height: 2px;
      background: var(--primary-base); border-radius: var(--radius-full);
    }
    .qp__tab-count { font-size: var(--fs-12); color: var(--text-soft); }
    .qp__tab--active .qp__tab-count { color: var(--primary-base); }
    .qp__tab-sev { font-size: var(--fs-12); font-weight: 600; color: var(--error-base); }

    .qp__summary { flex: none; display: flex; align-items: center; flex-wrap: wrap; gap: 12px; padding: 8px 2px 0; }
    .qp__sum-item { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-12); color: var(--text-sub); }
    .qp__sum-value { font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); }
    .qp__sum-value[data-tone="success"] { color: var(--success-base); }
    .qp__sum-value[data-tone="warning"] { color: var(--warning-text); }
    .qp__sum-value[data-tone="danger"] { color: var(--error-base); }
    .qp__sum-sep { width: 1px; height: 14px; background: var(--border-sub); }

    .qp__banner {
      flex: none; display: flex; align-items: center; gap: 8px; margin-top: 8px;
      padding: 7px 12px; background: var(--primary-bg-subtle); border: 1px solid var(--border-sub);
      border-radius: var(--radius-md); font-size: var(--fs-12); color: var(--text-body);
    }
    .qp__banner-dot { flex: none; width: 7px; height: 7px; border-radius: var(--radius-full); background: var(--primary-base); }

    .qp__filters { flex: none; padding: 8px 0 10px; }
    .qp__filters:not(:has(*)) { display: none; }
    .qp__body { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
    .qp__bulk { flex: none; padding: 8px 0 10px; }
    .qp__bulk:not(:has(*)) { display: none; }
  