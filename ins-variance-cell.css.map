
    :host { display: inline-flex; align-items: baseline; gap: 8px; font-variant-numeric: tabular-nums; min-width: 0; }
    .vc-pair { display: inline-flex; align-items: baseline; gap: 5px; font-size: var(--fs-12); color: var(--text-sub); }
    .vc-num { white-space: nowrap; }
    .vc-num--actual { color: var(--text-strong); font-weight: 600; }
    .vc-arrow { color: var(--text-soft); }
    .vc-diff { font-size: var(--fs-13); font-weight: 700; white-space: nowrap; }
    .vc-diff[data-tone='up'] { color: var(--error-base); }
    .vc-diff[data-tone='down'] { color: var(--success-base); }
    .vc-diff[data-tone='zero'] { color: var(--text-sub); }
  