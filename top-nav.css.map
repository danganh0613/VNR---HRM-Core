
    .tn-frame { border: 1px solid var(--border-sub); border-radius: var(--radius-lg); overflow: hidden; }
    .tn-ico { display: grid; place-items: center; width: 36px; height: 36px; border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub); }
    .tn-ico:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
    .tn-av { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--primary-base); color: #fff; font-size: var(--fs-13); font-weight: 600; }
    .tn-search { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface-subtle); color: var(--text-sub); }
    .tn-search input { border: 0; background: transparent; outline: none; font: inherit; font-size: var(--fs-13); color: var(--text-body); width: 160px; }
    /* Responsive: chỉ khi RẤT hẹp (.tn--narrow, lib bật <560px) → search thu thành ICON.
       Độc lập ngưỡng hamburger → search vẫn full ở 560–820. ::ng-deep vì .tn--narrow là lib. */
    ::ng-deep .tn--narrow .tn-search { flex: none; box-sizing: border-box; width: 36px; height: 36px; padding: 0; justify-content: center; cursor: pointer; background: transparent; border: 0; color: var(--text-sub); }
    ::ng-deep .tn--narrow .tn-search:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
    /* Bấm icon → mở lại ô nhập đầy đủ (dù đang hẹp). */
    ::ng-deep .tn--narrow .tn-search.is-open { width: auto; height: auto; padding: 6px 10px; justify-content: flex-start; background: var(--bg-surface-subtle); border: 1px solid var(--border-sub); }
    ::ng-deep .tn--narrow .tn-search.is-open input { display: inline; }
    ::ng-deep .tn--narrow .tn-search input { display: none; }
    .tn-ghost { border: 0; background: transparent; cursor: pointer; font: inherit; font-size: var(--fs-14); color: var(--text-body); padding: 7px 12px; border-radius: var(--radius-lg); }
    .tn-ghost:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
    /* Nav button (slot tnNav) — trông như tn-item, mở dropdown */
    .tn-navbtn { display: inline-flex; align-items: center; gap: 4px; border: 0; background: transparent; cursor: pointer; font: inherit; font-size: var(--fs-14); color: var(--text-body); padding: 7px 12px; border-radius: var(--radius-lg); white-space: nowrap; }
    .tn-navbtn:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }

    /* Panel dropdown (render trong overlay — inline/global qua ::ng-deep) */
    ::ng-deep .dd { min-width: 200px; padding: 6px; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-xl); box-shadow: var(--shadow-regular-md); }
    ::ng-deep .dd-row { display: block; padding: 8px 12px; border-radius: var(--radius-md); font-size: var(--fs-14); color: var(--text-body); cursor: pointer; text-decoration: none; }
    ::ng-deep .dd-row:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
    ::ng-deep .dd-rich { min-width: 320px; }
    ::ng-deep .dd-item { display: flex; align-items: flex-start; gap: 12px; padding: 10px 12px; border-radius: var(--radius-lg); cursor: pointer; text-decoration: none; }
    ::ng-deep .dd-item:hover { background: var(--bg-surface-subtle); }
    ::ng-deep .dd-ic { display: grid; place-items: center; width: 36px; height: 36px; border-radius: var(--radius-md); background: var(--primary-bg-subtle); color: var(--primary-base); flex: none; }
    ::ng-deep .dd-name { display: block; font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); }
    ::ng-deep .dd-desc { display: block; font-size: var(--fs-12); color: var(--text-sub); }
    ::ng-deep .mega { display: flex; gap: 12px; padding: 12px; min-width: 560px; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-xl); box-shadow: var(--shadow-regular-lg); }
    ::ng-deep .mega-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; flex: 1; }
    ::ng-deep .mega-promo { display: flex; flex-direction: column; gap: 6px; width: 200px; padding: 16px; border-radius: var(--radius-lg); background: var(--primary-bg-subtle); color: var(--primary-base); }
    ::ng-deep .mega-promo-t { font-size: var(--fs-15); font-weight: 700; color: var(--text-strong); }
    ::ng-deep .mega-promo-d { font-size: var(--fs-12); color: var(--text-sub); }
    ::ng-deep .mega-promo-c { margin-top: auto; font-size: var(--fs-13); font-weight: 600; color: var(--primary-base); }
  