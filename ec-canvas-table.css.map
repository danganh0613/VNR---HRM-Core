
:host { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
.num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.strong { color: var(--text-strong); }

/* ── Panel chung (pattern hrm-list-page — khớp mockup) ── */
.panel { background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg); position: relative; }
.panel-h { display: flex; align-items: center; gap: 10px; padding: 11px 14px; border-bottom: 1px solid var(--border-soft); }
.ph-t { font-size: var(--fs-11); letter-spacing: .8px; text-transform: uppercase; font-weight: var(--font-semibold); color: var(--text-sub); }
.ph-r { margin-left: auto; display: flex; align-items: center; gap: var(--space-2); }
.ph-note { font-size: var(--fs-11); color: var(--text-sub); }
.panel-b { padding: 13px 14px; }

/* ── Highlight "AI đã đặt" (accent = --primary-*, KHÔNG amber) ── */
/* Viền primary nhắc field do AI điền — an toàn: chỉ điền, dock giữ nút Hoàn tác. */
.panel.ai-on { box-shadow: inset 0 0 0 1px var(--primary-border); }
/* Tag ✨ AI tái dùng ở cả 3 panel — nền primary-subtle, chữ primary-base. */
.ai-tag { display: inline-flex; align-items: center; gap: 3px; font-size: var(--fs-11); font-weight: var(--font-medium);
  padding: 2px 8px 2px 6px; border-radius: var(--radius-full); background: var(--primary-bg-subtle); color: var(--primary-base); line-height: 1.4; }
.ai-tag tabler-icon { color: var(--primary-base); flex: none; }

/* ── Feature B — hàng gợi ý cột AI (chip dashed = "thêm vào") ── */
.ai-sugg { border-top: 1px solid var(--border-soft); padding: 11px 14px; display: flex; flex-direction: column; gap: 8px; }
.ai-sugg-lb { display: inline-flex; align-items: center; gap: 5px; font-size: var(--fs-11); font-weight: var(--font-medium); color: var(--primary-base); }
.ai-sugg-lb tabler-icon { color: var(--primary-base); flex: none; }
.ai-sugg-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.ai-chip { display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px; border-radius: var(--radius-full);
  border: 1px dashed var(--primary-border); background: var(--primary-bg-subtle); color: var(--primary-base);
  font-family: inherit; font-size: var(--fs-12); }
.ai-chip:hover { background: var(--primary-bg-soft); }
.ai-chip tabler-icon { color: var(--primary-base); flex: none; }
.ai-chip-t { font-weight: var(--font-medium); }
.ai-chip-r { font-size: var(--fs-11); opacity: .8; }

/* ── Phạm vi: 3 radio-card ── */
.scope { display: flex; gap: 10px; }
.rc { flex: 1; border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 10px 12px;
  display: flex; align-items: center; gap: 9px; font-size: var(--fs-13); color: var(--text-body);
  background: var(--bg-surface); font-family: inherit; text-align: left; }
.rdo { width: 15px; height: 15px; border-radius: var(--radius-full); border: 1.5px solid var(--border-strong);
  flex: none; position: relative; background: var(--bg-surface); }
.rc.on { border-color: var(--primary-base); background: var(--primary-bg-subtle); color: var(--text-strong); font-weight: var(--font-medium); }
.rc.on .rdo { border-color: var(--primary-base); }
.rc.on .rdo::after { content: ''; position: absolute; inset: 3px; border-radius: var(--radius-full); background: var(--primary-base); }
.rc.dis { color: var(--text-disabled); background: var(--bg-surface-subtle); cursor: not-allowed; }
.rc.dis .rdo { border-color: var(--border-sub); background: var(--bg-surface-subtle); }
.rc b { margin-left: auto; font-weight: var(--font-semibold); font-size: var(--fs-13); }
.rc.dis b { color: var(--text-disabled); }
.hint-dis { font-size: var(--fs-11); color: var(--text-soft); margin-top: 7px; padding-left: 2px; }
.chips { display: flex; align-items: center; gap: 6px; margin-top: 11px; flex-wrap: wrap; }
.chips .lb { font-size: var(--fs-11); color: var(--text-sub); }
.tag { font-size: var(--fs-11); padding: 3px 9px; border-radius: var(--radius-sm); background: var(--bg-surface-subtle);
  border: 1px solid var(--border-sub); color: var(--text-body); }
.tag b { font-weight: var(--font-medium); color: var(--text-strong); }

/* ── Cột xuất ── */
.mau-desc { font-size: var(--fs-12); color: var(--text-sub); line-height: 1.6; }
.mau-desc b { font-weight: var(--font-medium); }
/* CM tự có hàng tools + list — chỉ cần đệm quanh, không lồng thêm border */
.cm-wrap { padding: var(--space-1) 14px 10px; }
/* canvas ngoài đã scroll — tránh scroll lồng nhau (CM encapsulation None → cần ng-deep để thắng scope emulated) */
.cm-wrap ::ng-deep .cm-scroll { overflow-y: visible; }

/* ── Định dạng: select + dropdown inline ── */
.fmt-sel { width: 100%; display: flex; align-items: center; gap: 10px; border: 1px solid var(--border-sub);
  border-radius: var(--radius-md); padding: 9px 12px; background: var(--bg-surface); font-family: inherit;
  text-align: left; position: relative; z-index: 2; }
.fmt-sel.open { border-color: var(--primary-border); box-shadow: 0 0 0 2px var(--primary-focus-ring); }
.fmt-ic { width: 30px; height: 30px; border-radius: var(--radius-sm); background: var(--success-bg); color: var(--success-base);
  display: flex; align-items: center; justify-content: center; flex: none; }
.fmt-ic.pdf { background: var(--error-bg); color: var(--error-base); }
.fmt-ic.csv { background: var(--bg-surface-muted); color: var(--text-sub); }
.fmt-m { flex: 1; min-width: 0; display: block; }
.fmt-t { display: block; font-size: var(--fs-13); font-weight: var(--font-medium); color: var(--text-strong); }
.fmt-s { display: block; font-size: var(--fs-11); color: var(--text-sub); }
.fmt-cv { color: var(--text-soft); flex: none; }
.fmt-drop { border: 1px solid var(--border-sub); border-top: none; border-radius: 0 0 var(--radius-md) var(--radius-md);
  margin-top: -2px; background: var(--bg-surface); position: relative; z-index: 2; }
.fmt-opt { width: 100%; display: flex; gap: 10px; padding: 8px 12px; align-items: center; border: none;
  background: transparent; font-family: inherit; text-align: left; }
.fmt-opt + .fmt-opt { border-top: 1px solid var(--border-soft); }
.fmt-opt:hover { background: var(--bg-surface-subtle); }

/* ── PDF config inline ── */
.pdfcfg { margin-top: 10px; border: 1px solid var(--border-soft); border-radius: var(--radius-md);
  background: var(--bg-surface-subtle); padding: 12px; }
.pdf-row { display: flex; align-items: center; gap: var(--space-3); }
.pdf-f { flex: 1; min-width: 0; }
.pdf-l { font-size: var(--fs-11); color: var(--text-sub); margin-bottom: 5px; font-weight: var(--font-medium); }
.kho { position: relative; }
.pdf-sel { width: 100%; height: 32px; border: 1px solid var(--border-sub); border-radius: var(--radius-md);
  background: var(--bg-surface); display: flex; align-items: center; justify-content: space-between;
  padding: 0 10px; font-size: var(--fs-12); color: var(--text-strong); font-family: inherit; }
.pdf-sel tabler-icon { color: var(--text-soft); }
.kho-drop { position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 3;
  background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-md);
  box-shadow: var(--shadow-regular-md); overflow: hidden; }
.kho-opt { width: 100%; border: none; background: transparent; text-align: left; padding: 7px 10px;
  font-size: var(--fs-12); color: var(--text-body); font-family: inherit; }
.kho-opt:hover { background: var(--bg-surface-subtle); }
.kho-opt.on { background: var(--primary-bg-subtle); color: var(--primary-base); font-weight: var(--font-medium); }
.fseg { display: flex; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 2px; gap: 2px; }
.fseg .m { flex: 1; font-size: var(--fs-11); font-weight: var(--font-medium); color: var(--text-sub); padding: 5px 0;
  text-align: center; border-radius: var(--radius-sm); border: none; background: transparent; font-family: inherit; }
.fseg .m.on { background: var(--primary-base); color: var(--text-on-primary); }
.tgl-row { display: flex; align-items: center; justify-content: space-between; padding: 8px 0 0;
  font-size: var(--fs-12); color: var(--text-body); }

/* backdrop trong suốt — đóng dropdown khi bấm ra ngoài, nằm DƯỚI trigger/drop (z-index 1 < 2) */
.ec-backdrop { position: fixed; inset: 0; z-index: 1; }

/* ── Skeleton hydrate (contract §5) ── */
.sk { background: var(--bg-surface-muted); border-radius: var(--radius-sm); animation: ec-sk .9s ease-in-out infinite alternate; }
.sk-t { display: inline-block; width: 140px; height: 12px; }
.sk-l { height: 12px; margin-top: 10px; }
.sk-l:first-child { margin-top: 0; }
.w80 { width: 80%; } .w60 { width: 60%; } .w40 { width: 40%; }
@keyframes ec-sk { from { opacity: 1; } to { opacity: .4; } }
  