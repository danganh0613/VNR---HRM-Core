
    :host { display: block; padding: var(--space-6); max-width: 960px; margin-inline: auto; }
    .imr { display: flex; flex-direction: column; gap: var(--space-6); }

    /* ── Header ── */
    .imr-title { margin: 0; font-size: var(--fs-18); font-weight: var(--font-semibold); color: var(--text-strong); }
    .imr-sub { margin: var(--space-1) 0 0; font-size: var(--fs-13); color: var(--text-sub); }

    /* ── Stat cards ── */
    .imr-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-3); }

    /* ── Card chung ── */
    .imr-card {
      display: flex; flex-direction: column; gap: var(--space-3);
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
      background: var(--bg-surface); padding: var(--space-4);
    }
    .imr-hic { color: var(--icon-secondary); flex: none; }
    .imr-hic--ai { color: var(--primary-base); }
    .imr-hic--warn { color: var(--warning-base); }
    .imr-num { font-weight: var(--font-bold); color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .imr-actions { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }


    /* ── Dải ✨ AI đề xuất (collapsible — accordion anatomy, token DS) ── */
    .imr-ai { border: 1px solid var(--border-sub); border-left: 3px solid var(--primary-base);
      border-radius: var(--radius-lg); background: var(--bg-surface); }
    .imr-ai-trigger { display: flex; align-items: center; gap: var(--space-2); width: 100%;
      border: 0; background: transparent; cursor: pointer; text-align: start; font: inherit;
      padding: var(--space-3) var(--space-4); border-radius: var(--radius-lg); }
    .imr-ai-trigger:hover { background: var(--bg-surface-subtle); }
    .imr-ai-title { font-size: var(--fs-14); font-weight: var(--font-semibold); color: var(--text-strong); flex: none; }
    .imr-ai-sum { flex: 1 1 auto; min-width: 0; font-size: var(--fs-13); color: var(--text-sub);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .imr-ai-chev { color: var(--icon-secondary); flex: none;
      transition: transform var(--duration-fast, .15s) ease; }
    .imr-ai--open .imr-ai-chev { transform: rotate(180deg); }
    .imr-ai-body { display: flex; flex-direction: column; border-top: 1px solid var(--border-soft); }
    .imr-ai-item { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); }
    .imr-ai-item + .imr-ai-item { border-top: 1px solid var(--border-soft); }
    .imr-ai-item--col { flex-direction: column; align-items: stretch; gap: var(--space-2); }
    .imr-ai-row { display: flex; align-items: center; gap: var(--space-3); }
    .imr-ai-txt { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: var(--space-0-5); }
    .imr-ai-h { font-size: var(--fs-13); font-weight: var(--font-semibold); color: var(--text-strong); }
    .imr-ai-d { font-size: var(--fs-13); color: var(--text-sub); }
    .imr-rot { transform: rotate(180deg); }

    /* ── Cặp trùng — hàng ngang gọn trong dải AI ── */
    .imr-dups { display: flex; flex-direction: column; gap: var(--space-2); }
    .imr-dup { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;
      border: 1px solid var(--border-soft); border-radius: var(--radius-md);
      padding: var(--space-2) var(--space-3); }
    .imr-dup-cell { font-size: var(--fs-13); color: var(--text-body); min-width: 0;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .imr-dup-cell b { color: var(--text-strong); }
    .imr-dup-vs { flex: none; color: var(--text-soft); font-size: var(--fs-12); }
    .imr-dup-match { flex: none; font-size: var(--fs-12); font-weight: var(--font-semibold); color: var(--warning-text);
      font-variant-numeric: tabular-nums; }

    /* ── Chip đếm-kiêm-lọc (toggle-group anatomy, token DS) ── */
    .imr-chips { display: flex; align-items: center; gap: var(--space-1-5); flex-wrap: wrap; }
    .imr-chip { display: inline-flex; align-items: center; gap: var(--space-1-5);
      border: 1px solid var(--border-sub); border-radius: var(--radius-full);
      background: var(--bg-surface); padding: var(--space-1) var(--space-2-5);
      font: inherit; font-size: var(--fs-13); color: var(--text-body); cursor: pointer; }
    .imr-chip:hover { background: var(--bg-surface-subtle); }
    .imr-chip:focus-visible { outline: 2px solid var(--border-focus); outline-offset: 1px; }
    .imr-chip.is-on { background: var(--primary-bg-subtle); border-color: var(--primary-border); color: var(--text-strong); }
    .imr-chip-dot { width: 6px; height: 6px; border-radius: var(--radius-full); background: var(--text-soft); flex: none; }
    .imr-chip-dot[data-tone='ok'] { background: var(--success-base); }
    .imr-chip-dot[data-tone='err'] { background: var(--error-base); }
    .imr-chip-dot[data-tone='warn'] { background: var(--warning-base); }
    .imr-chip-n { font-size: var(--fs-12); font-weight: var(--font-semibold); color: var(--text-sub);
      font-variant-numeric: tabular-nums; padding: 0 var(--space-1);
      border-radius: var(--radius-full); background: var(--bg-surface-subtle); }
    .imr-chip.is-on .imr-chip-n { background: var(--bg-surface); color: var(--text-strong); }

    /* ── 6.7 filter bar + 6.8 bảng ── */
    /* ── Panel bảng theo khung list-page chuẩn (.lp-panel/.lp-toolbar/.lp-body) —
       toolbar = component DS hrm-table-toolbar, wrapper chỉ kẻ divider; bảng flush mép. ── */
    .imr-tablecard { padding: 0; gap: 0; overflow: hidden; }
    .imr-toolbar { border-bottom: 1px solid var(--border-sub); }        /* = .lp-toolbar */
    .imr-tablewrap ::ng-deep .ant-table { border: 0; border-radius: 0; background: transparent; }  /* = .lp-body */
    .imr-search { width: 320px; max-width: 100%; }
    /* chips xuống hàng gọn trong slot giữa của toolbar khi hẹp */
    .imr-toolbar hrm-table-toolbar { flex-wrap: wrap; }
    .imr-tablewrap { position: relative; min-width: 0; }
    .imr-errtext { font-size: var(--fs-12); color: var(--text-sub); }
    /* Input sửa inline trong ô (theo contract .imr-edit — input event → fixRow re-validate). */
    .imr-edit {
      width: 100%; min-width: 140px; padding: var(--space-0-5) var(--space-2);
      font: inherit; font-size: var(--fs-13); color: var(--text-body);
      background: var(--bg-surface); border: 1px solid var(--border-input); border-radius: var(--radius-sm);
    }
    .imr-edit:focus { outline: none; border-color: var(--border-focus); }
    .imr-edit--err { border-color: var(--border-error); }
    .imr-editsel { display: block; width: 100%; min-width: 160px; }

    /* ── 6.9 bulk bar nổi trên bảng ── */
    /* Bulk band DÍNH: nằm giữa toolbar và bảng, nền primary tint + border-bottom — không đè header */
    .imr-bulk {
      display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap;
      padding: var(--space-2) var(--space-3);
      background: var(--primary-bg-subtle); border-bottom: 1px solid var(--primary-border);
    }
    .imr-bulk-n { font-size: var(--fs-13); font-weight: var(--font-semibold); color: var(--text-strong); white-space: nowrap; }
    .imr-bulk-sel { width: 220px; }
  