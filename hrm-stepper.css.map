
:host { display: flex; align-items: center; gap: 8px; }
:host([data-variant='vertical']) { flex-direction: column; align-items: stretch; }

.st-step {
  display: inline-flex; align-items: center; gap: 10px; border: 0; background: transparent;
  padding: 2px; cursor: default; text-align: left; font-family: var(--font-sans); min-width: 0;
}
.st-step:not(:disabled) { cursor: pointer; }

.st-marker {
  flex: none; width: 26px; height: 26px; border-radius: var(--radius-full);
  display: grid; place-items: center; font-size: var(--fs-13); font-weight: 600;
  border: 1.5px solid var(--border-input); color: var(--text-sub); background: var(--bg-surface);
  transition: background var(--duration-fast, .15s) var(--ease-out, ease),
              border-color var(--duration-fast, .15s) var(--ease-out, ease);
}
.st-step[data-state='done'] .st-marker { background: var(--primary-base); border-color: var(--primary-base); color: var(--text-on-primary, #fff); }
.st-step[data-state='current'] .st-marker { border-color: var(--primary-base); color: var(--primary-base); box-shadow: 0 0 0 4px var(--primary-bg-subtle); }

.st-body { display: flex; flex-direction: column; min-width: 0; }
.st-label { font-size: var(--fs-14); color: var(--text-sub); white-space: nowrap; }
.st-step[data-state='current'] .st-label { color: var(--text-strong); font-weight: 600; }
.st-step[data-state='done'] .st-label { color: var(--text-body); }
.st-desc { font-size: var(--fs-12); color: var(--text-sub); }

.st-line { flex: 1; min-width: 24px; height: 1.5px; background: var(--border-sub); border-radius: 1px; }
.st-line[data-done='true'] { background: var(--primary-base); }
:host([data-variant='vertical']) .st-line { flex: none; width: 1.5px; min-width: 0; height: 20px; margin-left: 14px; }

/* dot: chỉ chấm tròn nhỏ — cho header gọn / mobile. */
:host([data-variant='dot']) .st-marker { width: 10px; height: 10px; border-width: 0; background: var(--border-sub); }
:host([data-variant='dot']) .st-step[data-state='done'] .st-marker,
:host([data-variant='dot']) .st-step[data-state='current'] .st-marker { background: var(--primary-base); }
:host([data-variant='dot']) .st-step[data-state='current'] .st-marker { box-shadow: 0 0 0 4px var(--primary-bg-subtle); }
:host([data-variant='dot']) .st-line { min-width: 16px; }
  