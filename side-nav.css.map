
    .sn-bell { position: relative; display: grid; place-items: center; width: 34px; height: 34px; border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub); transition: background var(--duration-fast, .15s) var(--ease-out, ease), color var(--duration-fast, .15s) var(--ease-out, ease); }
    .sn-bell:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
    .sn-bell-dot { position: absolute; top: 7px; right: 8px; width: 7px; height: 7px; border-radius: 50%; background: var(--error-base); border: 1.5px solid var(--bg-surface); }

    .sn-acct { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px; border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface); cursor: pointer; text-align: left; transition: border-color var(--duration-fast, .15s) var(--ease-out, ease); }
    .sn-acct:hover { border-color: var(--primary-base); }
    .sn-acct--mini { width: auto; padding: 4px; border-color: transparent; background: transparent; }
    .sn-acct-ic { display: grid; place-items: center; width: 32px; height: 32px; border-radius: var(--radius-md); background: var(--primary-bg-subtle); color: var(--primary-base); flex: none; }

    .sn-user { display: flex; align-items: center; gap: 10px; width: 100%; padding: 6px 8px; border: 0; background: transparent; border-radius: var(--radius-lg); cursor: pointer; text-align: left; transition: background var(--duration-fast, .15s) var(--ease-out, ease); }
    .sn-user:hover { background: var(--bg-surface-subtle); }
    .sn-user--mini { width: auto; padding: 4px; }
    .sn-user-av { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--primary-base); color: #fff; font-size: var(--fs-13); font-weight: 600; flex: none; }
    .sn-user-info { flex: 1; min-width: 0; }
    .sn-user-name { display: block; font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sn-user-mail { display: block; font-size: var(--fs-12); color: var(--text-sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sn-user-gear { color: var(--text-soft); flex: none; }
  