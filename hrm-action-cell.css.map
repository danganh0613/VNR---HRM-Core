
:host { display: inline-flex; align-items: center; gap: 2px; }
.ac-btn { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px;
  padding: 0; border: none; background: transparent; color: var(--icon-secondary);
  border-radius: var(--radius-md); cursor: pointer; transition: background var(--duration-fast) var(--ease-out),
  color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out); }
.ac-btn:hover { background: var(--overlay-hover); color: var(--icon-primary); }
.ac-btn:disabled { color: var(--icon-disabled); cursor: not-allowed; background: transparent; }
.ac-btn.ac-danger:hover { background: var(--error-bg); color: var(--error-base); }

/* bordered: mỗi nút là ô viền bo góc riêng (kiểu icon-button có khung) — khoảng cách control
   ↔ control = --space-2. Dùng cho thẻ/toolbar cần nút nổi khối, không phải hàng bảng. */
:host(.hrm-action-cell--bordered) { gap: var(--space-2); }
:host(.hrm-action-cell--bordered) .ac-btn { width: 34px; height: 34px; border: 1px solid var(--border-sub); background: var(--bg-surface); }
:host(.hrm-action-cell--bordered) .ac-btn:hover { border-color: var(--primary-base); background: var(--bg-surface); color: var(--primary-base); }
:host(.hrm-action-cell--bordered) .ac-btn.ac-danger:hover { border-color: var(--error-base); background: var(--error-bg); color: var(--error-base); }
  