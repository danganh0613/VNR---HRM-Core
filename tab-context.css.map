
    :host { display: flex; flex-direction: column; gap: 12px; max-width: 960px; }

    /* ── Card ── */
    .ctx-card {
      display: flex; flex-direction: column; gap: 12px;
      background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: 12px; padding: 16px;
    }
    .ctx-card__title {
      display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap;
      font-size: var(--fs-14); font-weight: 600; color: var(--text-strong);
    }

    /* ── Description grid 2 cột ── */
    .dg { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 28px; }
    .dg-item { display: grid; grid-template-columns: 118px 1fr; gap: 10px; align-items: baseline; font-size: var(--fs-13); }
    .dg-lb { color: var(--text-sub); }
    .dg-val { color: var(--text-strong); font-weight: 500; min-width: 0; overflow-wrap: anywhere; }
    .dg-val--mono { font-family: var(--font-mono, monospace); }

    /* ── Flag / note / empty ── */
    .ctx-flag {
      align-self: flex-start; display: inline-flex; align-items: center; gap: 6px;
      font-size: var(--fs-12); font-weight: 500; padding: 6px 10px; border-radius: var(--radius-md);
    }
    .ctx-flag--warn { background: var(--warning-bg); color: var(--warning-text); }
    .ctx-note { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .ctx-note b { color: var(--text-strong); }
    .ctx-muted { margin: 0; font-size: var(--fs-13); color: var(--text-sub); }

    /* ── Lương: cấu phần + căn cứ + đối chiếu ── */
    .cmp-list { display: flex; flex-direction: column; gap: 6px; }
    .cmp-row {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: var(--fs-13);
      padding: 7px 11px; border: 1px solid var(--border-sub); border-radius: var(--radius-md);
    }
    .cmp-name { color: var(--text-strong); font-weight: 500; min-width: 150px; }
    .cmp-amt { color: var(--text-strong); font-weight: 700; font-variant-numeric: tabular-nums; }
    .cmp-chip {
      font-size: var(--fs-11); font-weight: 500; line-height: 1.5;
      padding: 1px 9px; border-radius: var(--radius-full);
      background: var(--success-bg); color: var(--success-text);
    }
    .cmp-chip--off { background: var(--bg-surface-subtle); color: var(--text-sub); }
    .cmp-src { margin-left: auto; font-size: var(--fs-12); color: var(--text-sub); }
    .cmp-base { display: flex; align-items: baseline; gap: 8px; padding-top: 2px; }
    .cmp-base__lb { font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); }
    .cmp-base__val { font-size: var(--fs-15, 15px); font-weight: 700; color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .rec-ok { display: flex; gap: 18px; flex-wrap: wrap; }
    .rec-ok__item { display: inline-flex; align-items: center; gap: 5px; font-size: var(--fs-13); font-weight: 500; color: var(--success-text); }

    /* ── Bảng custom (grid header + rows) ── */
    .tbl-scroll { overflow-x: auto; }
    .tbl { display: flex; flex-direction: column; min-width: 700px; }
    .tbl-head, .tbl-row { display: grid; align-items: center; gap: 12px; padding: 8px 10px; }
    .tbl-head {
      font-size: var(--fs-12); font-weight: 600; color: var(--text-sub);
      border-bottom: 1px solid var(--border-sub);
    }
    .tbl-row {
      font-size: var(--fs-13); color: var(--text-strong);
      border-bottom: 1px solid var(--border-soft, var(--border-sub));
    }
    .tbl-row:last-child { border-bottom: 0; }
    .tbl-strong { color: var(--text-strong); font-weight: 500; }
    .tbl--cc .tbl-head, .tbl--cc .tbl-row { grid-template-columns: 1.4fr 1.1fr .7fr 1.5fr 1fr; }
    .tbl--qd .tbl-head, .tbl--qd .tbl-row { grid-template-columns: 1.6fr .9fr 1.4fr 1.3fr 1.4fr; }
    .tbl-impact { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
    .tbl-impact .dot { flex: none; width: 8px; height: 8px; border-radius: 50%; }
    .tbl-row--click { cursor: pointer; }
    .tbl-row--click:hover { background: var(--bg-surface-subtle); }
    .qd-status { display: inline-flex; flex-direction: column; align-items: flex-start; gap: 3px; }
    .qd-status__lb { font-size: var(--fs-12); color: var(--text-sub); }

    @media (max-width: 640px) { .dg { grid-template-columns: 1fr; } }
  