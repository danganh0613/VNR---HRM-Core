
    .c { background:var(--primary-bg-subtle); color:var(--primary-base); border:1px solid var(--primary-border); border-radius:var(--radius-md); padding:16px 12px; text-align:center; font-size: var(--fs-13); font-weight:500; }
    .c-alt { background:var(--bg-muted); color:var(--text-body); border-color:var(--border-sub); }
    .dark .c { color:var(--text-strong); }
  