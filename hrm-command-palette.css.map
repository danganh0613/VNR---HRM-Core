
.cp-mask { position: fixed; inset: 0; background: var(--overlay, rgba(0,0,0,.45)); z-index: var(--z-modal, 1000); }
.cp-box {
  position: fixed; left: 50%; top: 18vh; transform: translateX(-50%);
  width: min(560px, calc(100vw - 32px)); z-index: calc(var(--z-modal, 1000) + 1);
  background: var(--bg-surface); border: 1px solid var(--border-sub);
  border-radius: var(--radius-xl); box-shadow: var(--shadow-regular-lg);
  overflow: hidden; display: flex; flex-direction: column;
}
.cp-input {
  border: 0; outline: none; background: transparent; color: var(--text-strong);
  font-family: var(--font-sans); font-size: var(--fs-15); padding: 14px 16px;
  border-bottom: 1px solid var(--border-soft);
}
.cp-input::placeholder { color: var(--text-disabled); }
.cp-list { max-height: 320px; overflow-y: auto; padding: 6px; }
.cp-group { font-size: var(--fs-11); font-weight: 600; text-transform: uppercase; letter-spacing: .04em;
  color: var(--text-sub); padding: 8px 10px 4px; }
.cp-item {
  display: flex; align-items: center; gap: 10px; width: 100%;
  border: 0; background: transparent; cursor: pointer; text-align: left;
  padding: 8px 10px; border-radius: var(--radius-md);
  font-family: var(--font-sans); font-size: var(--fs-14); color: var(--text-body);
}
.cp-item.is-active { background: var(--primary-bg-subtle); color: var(--text-strong); }
.cp-ic { display: inline-flex; color: var(--icon-secondary); flex: none; }
.cp-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cp-empty { padding: 20px 12px; text-align: center; font-size: var(--fs-13); color: var(--text-sub); }
  