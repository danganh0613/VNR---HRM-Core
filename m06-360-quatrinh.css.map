
    :host { display: block; max-width: 900px; }
    .qt-toolbar { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
    .qt-gap { flex: 1; }
    .qt-tl { display: flex; flex-direction: column; }
    .qt-row { display: flex; gap: 10px; }
    .qt-row__pick { padding-top: 14px; }
    .qt-row__rail { display: flex; flex-direction: column; align-items: center; width: 14px; }
    .qt-row__dot { flex: none; width: 11px; height: 11px; border-radius: 50%; margin-top: 16px; border: 2px solid var(--primary-base); background: var(--bg-surface); }
    .qt-row__dot[data-seg='tu-nguyen'] { border-color: var(--feature-base, var(--primary-base)); }
    .qt-row__dot[data-seg='mo-rong'] { border-color: var(--warning-base, var(--warning-text)); }
    .qt-row__line { flex: 1; width: 2px; background: var(--border-sub); }
    .qt-row:last-child .qt-row__line { background: transparent; }
    .qt-row__card {
      flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px;
      border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface);
      padding: 9px 12px; margin: 6px 0;
    }
    .qt-row--khoa .qt-row__card { background: var(--bg-surface-subtle); }
    .qt-row__head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .qt-row__range { font-weight: 700; color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .qt-row__dv { margin: 0; font-size: var(--fs-13); color: var(--text-body); font-weight: 500; }
    .qt-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .qt-muted b { color: var(--text-strong); }
    .qt-tn { margin: 0; font-size: var(--fs-12); color: var(--feature-text, var(--text-body)); }
    .qt-khoa { margin: 0; display: flex; align-items: center; gap: 5px; font-size: var(--fs-12); color: var(--error-text); }
    .qt-khoa b { color: inherit; }
    .qt-pb { display: flex; flex-direction: column; gap: 2px; border-top: 1px dashed var(--border-soft); padding-top: 5px; }
    .qt-pb__label { display: flex; align-items: center; gap: 5px; font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .qt-pb__item { font-size: var(--fs-12); color: var(--text-sub); }
    .qt-note { margin: 10px 0 0; font-size: var(--fs-12); color: var(--text-sub); }
    .qt-form { display: flex; flex-direction: column; gap: 10px; }
    .qt-err { font-size: var(--fs-12); color: var(--error-text); font-weight: 500; }
  