
:host {
  position: fixed;
  top: var(--space-4);
  right: var(--space-4);
  /* Trên MỌI lớp overlay: modal export-center (1051) + modal tự dựng .mback của ec-dock (1100)
     → toast luôn nằm trên, không phụ thuộc thứ tự DOM. */
  z-index: 1200;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  pointer-events: none;
}
/* mỗi thẻ nhận tương tác + bóng đổ; nền/viền do hrm-alert soft lo */
.hto-card {
  width: 360px;
  max-width: calc(100vw - var(--space-8));
  pointer-events: auto;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-regular-md);
  animation: hto-slide-in 160ms ease-out;
}
@keyframes hto-slide-in {
  from { opacity: 0; transform: translateX(var(--space-4)); }
  to   { opacity: 1; transform: translateX(0); }
}
/* tôn trọng người dùng tắt hiệu ứng */
@media (prefers-reduced-motion: reduce) {
  .hto-card { animation: none; }
}
  