
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }
    .rp { flex: 1 1 auto; min-height: 0; display: flex; gap: 14px; padding: 12px 20px; }

    .rp-cat { flex: none; width: 290px; overflow: auto; display: flex; flex-direction: column; gap: 10px; }
    .rp-group { display: flex; flex-direction: column; gap: 2px; }
    .rp-group__head {
      display: flex; align-items: center; gap: 6px; padding: 4px 2px;
      font-size: var(--fs-11); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--text-sub);
    }
    .rp-group__count { font-weight: 600; color: var(--text-soft); background: var(--bg-surface-subtle); border-radius: var(--radius-full); padding: 0 6px; }
    .rp-item {
      display: flex; flex-direction: column; align-items: flex-start; gap: 2px; text-align: left;
      border: 0; background: none; cursor: pointer; font: inherit; padding: 5px 8px; border-radius: var(--radius-sm);
    }
    .rp-item:hover { background: var(--bg-surface-subtle); }
    .rp-item--on { background: var(--primary-bg, var(--bg-surface-subtle)); }
    .rp-item--on .rp-item__label { color: var(--primary-base); font-weight: 600; }
    .rp-item--off { cursor: not-allowed; opacity: .55; }
    .rp-item__label { font-size: var(--fs-13); color: var(--text-body); }
    .rp-item__why { font-size: var(--fs-11); color: var(--text-soft); }
    .rp-cat__note { margin: 0; font-size: var(--fs-11); color: var(--text-soft); }

    .rp-work { flex: 1 1 auto; min-width: 0; overflow: auto; display: flex; flex-direction: column; gap: 12px; }
    .rp-empty { padding: 60px 0; display: flex; justify-content: center; }
    .rp-work__head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .rp-title { margin: 0; font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); }
    .rp-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .rp-note { margin: 0; font-size: var(--fs-11); color: var(--text-soft); }
    .rp-guard { font-size: var(--fs-12); color: var(--error-text); }

    .rp-params { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .rp-params__sel { width: 170px; }
    .rp-params__sel--dv { width: 280px; }
    .rp-params__sel--pv { width: 240px; }
    .rp-bg { display: flex; flex-direction: column; gap: 4px; max-width: 420px; }

    .rp-kq { display: flex; flex-direction: column; gap: 6px; }
    .rp-kq__meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .rp-tong { font-weight: 700; color: var(--text-strong); }

    .rp-export { display: flex; flex-direction: column; gap: 6px; border: 1px dashed var(--border-sub); border-radius: var(--radius-md); padding: 10px 12px; }
    .rp-export__row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .rp-export__sel { width: 420px; }
    .rp-choke { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .rp-choke__item { font-size: var(--fs-12); font-weight: 500; }
    .rp-choke__item[data-ok='true'] { color: var(--success-text); }
    .rp-choke__item[data-ok='false'] { color: var(--error-text); }

    .rp-files { display: flex; flex-direction: column; gap: 6px; }
    .rp-files__head { font-size: var(--fs-12); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--text-sub); }
    .rp-file { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); padding: 7px 12px; font-size: var(--fs-12); }
    .rp-file__name { font-weight: 600; color: var(--text-strong); }
    .rp-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .rp-gap { flex: 1; }

    .rp-peek { display: flex; flex-direction: column; gap: 8px; }
    .rp-peek__kv { display: flex; flex-direction: column; gap: 1px; font-size: var(--fs-12); }
    .rp-peek__kv span { color: var(--text-sub); }
    .rp-peek__kv b { color: var(--text-strong); font-weight: 600; }
  