
    :host { display: flex; flex-direction: column; gap: 10px; }
    .w-rule { border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); padding: 9px 12px; display: flex; flex-direction: column; gap: 6px; }
    .w-rule__head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .w-4tp { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 16px; font-size: var(--fs-12); color: var(--text-body); }
    .w-4tp b { color: var(--text-strong); }
    .w-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 700; color: var(--text-strong); }
    .w-muted { font-size: var(--fs-12); color: var(--text-sub); margin: 0; }
    .w-lan { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 6px 10px; }
    .w-gap { flex: 1; }
    .w-note { margin: 0; font-size: var(--fs-11); color: var(--text-soft); }
  