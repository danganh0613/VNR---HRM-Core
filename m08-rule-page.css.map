
    :host { display: flex; flex-direction: column; gap: 10px; }
    .r-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .r-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .r-muted b, .r-kv b { color: var(--text-strong); }
    .r-note { margin: 0; font-size: var(--fs-12); color: var(--warning-text); }
    .r-err { font-size: var(--fs-12); color: var(--error-text); font-weight: 500; }
    .r-strong { color: var(--text-strong); font-weight: 500; }
    .r-mono { font-family: var(--font-mono, monospace); font-weight: 600; }
    .r-link { text-decoration: underline; }
    .r-stack { display: flex; flex-direction: column; gap: 2px; align-items: flex-start; }
    .r-pk { display: flex; flex-direction: column; gap: 9px; font-size: var(--fs-13); }
    .r-kv { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; font-size: var(--fs-12); }
    .r-kv span:first-child { color: var(--text-sub); min-width: 120px; }
    .r-tyle { border-collapse: collapse; font-size: var(--fs-12); }
    .r-tyle th, .r-tyle td { border: 1px solid var(--border-sub); padding: 3px 12px; text-align: left; }
    .r-tyle th { background: var(--bg-surface-subtle); color: var(--text-sub); font-weight: 600; }
    .r-acts { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .r-sel { width: 260px; }
  