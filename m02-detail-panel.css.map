
    :host { display: flex; flex-direction: column; gap: 16px; font-size: var(--fs-13); }
    /* Icon design-system (@tabler/icons-angular) — canh giữa, không co giãn; kế thừa màu qua currentColor. */
    tabler-icon { display: inline-flex; align-items: center; flex: none; }
    .pn__alert { display: block; }

    .pn__head { display: flex; flex-direction: column; gap: 6px; }
    .pn__head-id { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
    .pn__head-nv { font-size: var(--fs-14); font-weight: 700; color: var(--text-strong); }
    .pn__head-dept { font-size: var(--fs-12); color: var(--text-sub); }
    .pn__head-tags { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    /* §6 Nhãn chính mã phương án dẫn dắt */
    .pn__head-pa { font-size: var(--fs-15); font-weight: 700; color: var(--text-strong); line-height: 1.35; }
    .pn__head-quy { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .pn__head-quy b { color: var(--text-body); font-weight: 600; }
    .pn__head-desc { margin: 0; font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); }

    /* Dữ liệu nguồn — dải thông tin nguồn chung */
    .pn__meta { display: flex; flex-direction: column; gap: 3px; padding: 7px 10px; border: 1px solid var(--border-soft);
      border-radius: var(--radius-md); background: var(--bg-surface-subtle); }
    .pn__meta-row { display: grid; grid-template-columns: 168px 1fr; gap: 10px; align-items: baseline; }
    .pn__meta-k { font-size: var(--fs-12); color: var(--text-sub); }
    .pn__meta-v { font-size: var(--fs-13); color: var(--text-body); font-weight: 600; }

    /* Chuỗi biến động — 2 mốc giảm T08 → tăng lại T09 */
    .pn__chain { display: flex; align-items: stretch; gap: 8px; flex-wrap: wrap; }
    .pn__chain-step { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 140px; padding: 8px 10px;
      border: 1px solid var(--border-soft); border-radius: var(--radius-md); background: var(--bg-surface-subtle); }
    .pn__chain-step--self { border-color: var(--primary-base); background: var(--primary-bg-subtle); }
    .pn__chain-ky { font-size: var(--fs-11); font-weight: 600; text-transform: uppercase; letter-spacing: .02em; color: var(--text-soft); }
    .pn__chain-dir { display: inline-flex; align-items: center; gap: 4px; font-size: var(--fs-13); font-weight: 700; color: var(--text-strong); }
    .pn__chain-dir[data-dir='giam'] { color: var(--error-text); }
    .pn__chain-dir[data-dir='tang'] { color: var(--success-text); }
    .pn__chain-mo { font-size: var(--fs-12); color: var(--text-sub); }
    .pn__chain-arrow { display: flex; align-items: center; align-self: center; color: var(--text-soft); }
    .pn__chain-act { display: flex; }

    .pn__sec { display: flex; flex-direction: column; gap: 8px; padding-top: 10px; border-top: 1px solid var(--border-soft); }
    .pn__rows { display: flex; flex-direction: column; gap: 5px; }
    .pn__row { display: flex; gap: 10px; align-items: baseline; }
    .pn__k { flex: none; width: 122px; font-size: var(--fs-12); color: var(--text-sub); }
    .pn__v { flex: 1; min-width: 0; color: var(--text-body); }
    .pn__v b { color: var(--text-strong); font-weight: 600; }
    .pn__mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); }
    .pn__mocs { display: flex; gap: 12px; flex-wrap: wrap; font-size: var(--fs-12); color: var(--text-sub); }
    .pn__miss { color: var(--warning-text); }
    .pn__muted { color: var(--text-soft); }
    .pn__cd { margin-left: 6px; font-size: var(--fs-11); color: var(--text-soft); background: var(--bg-surface-subtle); border-radius: var(--radius-sm); padding: 0 6px; }
    .pn__link { display: inline-flex; align-items: center; gap: 3px; border: 0; background: none; padding: 0; margin-left: 6px; cursor: pointer; font: inherit; font-size: var(--fs-12); font-weight: 600; color: var(--primary-base); white-space: nowrap; }
    .pn__link:hover { text-decoration: underline; }

    .pn__rule { display: flex; align-items: flex-start; gap: 8px; }
    .pn__rule-body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .pn__rule-msg { color: var(--text-body); }
    .pn__rule-meta { font-size: var(--fs-12); color: var(--text-soft); }
    .pn__muted-line { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .pn__muted-line b { color: var(--text-strong); }

    .pn__sim { display: flex; align-items: center; gap: 8px; }
    .pn__sim-num { font-size: var(--fs-18); font-weight: 700; color: var(--text-strong); }

    /* ── ✨ AI đề xuất ── */
    .pn__ai { gap: 10px; }
    .pn__ai-head { display: flex; flex-direction: column; gap: 2px; }
    .pn__ai-title { font-size: var(--fs-14); font-weight: 700; color: var(--text-strong); }
    .pn__ai-lead { font-size: var(--fs-12); color: var(--text-sub); }

    .pn__conf { display: inline-flex; align-items: center; gap: 7px; align-self: flex-start; cursor: pointer;
      border: 1px solid var(--border-sub); border-radius: var(--radius-full); background: var(--bg-surface);
      padding: 3px 11px; font: inherit; font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .pn__conf:hover { border-color: var(--primary-base); }
    .pn__conf-dot { width: 8px; height: 8px; border-radius: var(--radius-full); background: var(--text-soft); }
    .pn__conf[data-level='cao'] .pn__conf-dot { background: var(--success-base); }
    .pn__conf[data-level='trung-binh'] .pn__conf-dot { background: var(--warning-base); }
    .pn__conf[data-level='thap'] .pn__conf-dot { background: var(--error-base); }
    .pn__conf[data-level='cao'] .pn__conf-lv { color: var(--success-text); }
    .pn__conf[data-level='trung-binh'] .pn__conf-lv { color: var(--warning-text); }
    .pn__conf[data-level='thap'] .pn__conf-lv { color: var(--error-text); }
    .pn__conf-more { display: inline-flex; align-items: center; gap: 3px; font-weight: 500; color: var(--text-soft); font-size: var(--fs-11); }

    .pn__bd { display: flex; flex-direction: column; gap: 6px; padding: 10px 12px; border: 1px solid var(--border-soft);
      border-radius: var(--radius-md); background: var(--bg-surface-subtle); }
    .pn__bd-row { display: grid; grid-template-columns: 130px 1fr 28px; align-items: center; gap: 8px; }
    .pn__bd-k { font-size: var(--fs-12); color: var(--text-sub); }
    .pn__bd-bar { height: 6px; border-radius: var(--radius-full); background: var(--bg-surface); overflow: hidden; }
    .pn__bd-fill { display: block; height: 100%; border-radius: var(--radius-full); background: var(--text-soft); }
    .pn__bd-fill[data-level='cao'] { background: var(--success-base); }
    .pn__bd-fill[data-level='trung-binh'] { background: var(--warning-base); }
    .pn__bd-fill[data-level='thap'] { background: var(--error-base); }
    .pn__bd-n { font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); text-align: right; font-variant-numeric: tabular-nums; }
    .pn__bd-note { margin: 2px 0 0; font-size: var(--fs-12); color: var(--text-sub); }
    .pn__bd-note b { color: var(--text-strong); }

    .pn__why { display: flex; flex-direction: column; gap: 4px; }
    .pn__why-row { display: flex; gap: 8px; align-items: center; font-size: var(--fs-13); }
    .pn__why-ic { flex: none; width: 14px; font-weight: 700; }
    .pn__why-row[data-kind='ok'] .pn__why-ic { color: var(--success-base); }
    .pn__why-row[data-kind='warn'] .pn__why-ic { color: var(--error-base); }
    .pn__why-tx { color: var(--text-body); }
    .pn__why-concl { display: inline-flex; align-items: center; gap: 4px; margin-top: 4px; font-size: var(--fs-13); font-weight: 600; color: var(--primary-base); }
    .pn__why-concl--block { color: var(--error-text); }

    .pn__ba { display: flex; flex-direction: column; gap: 5px; }
    .pn__ba-lb { font-size: var(--fs-11); font-weight: 600; text-transform: uppercase; letter-spacing: .02em; color: var(--text-soft); }
    .pn__ba-diff { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

    .pn__ai-foot { display: flex; flex-direction: column; gap: 4px; padding-top: 8px; border-top: 1px dashed var(--border-soft); }
    .pn__cancu { margin: 0; font-size: var(--fs-11); color: var(--text-soft); }

    .pn__ms { display: flex; flex-direction: column; border: 1px solid var(--border-sub); border-radius: var(--radius-md); overflow: hidden; }
    .pn__ms-row { display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-bottom: 1px solid var(--border-soft); }
    .pn__ms-row:last-child { border-bottom: 0; }
    .pn__ms-row--sug { background: var(--success-bg); }
    .pn__ms-info { display: flex; flex-direction: column; gap: 1px; flex: 1; min-width: 0; }
    .pn__ms-src { font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); display: inline-flex; align-items: center; gap: 6px; }
    .pn__ms-badge { font-size: var(--fs-11); font-weight: 600; color: var(--success-text); background: var(--bg-surface); border: 1px solid var(--success-base); border-radius: var(--radius-sm); padding: 0 5px; }
    .pn__ms-note { font-size: var(--fs-11); color: var(--text-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pn__ms-val { font-size: var(--fs-13); font-weight: 700; color: var(--text-strong); font-variant-numeric: tabular-nums; white-space: nowrap; }

    /* ── §12 Đối soát nhanh với cơ quan BHXH ── */
    .pn__ds { display: flex; flex-direction: column; gap: 4px; }
    .pn__ds-row { display: flex; gap: 8px; align-items: center; }
    .pn__ds-ic { flex: none; display: inline-flex; align-items: center; color: var(--success-base); }
    .pn__ds-row--bad .pn__ds-ic { color: var(--warning-base); }
    .pn__ds-body { display: flex; flex: 1; flex-direction: column; gap: 1px; min-width: 0; }
    .pn__ds-label { font-size: var(--fs-13); color: var(--text-body); }
    .pn__ds-row--bad .pn__ds-label { color: var(--text-strong); font-weight: 600; }
    .pn__ds-hint { font-size: var(--fs-11); color: var(--text-soft); }
    .pn__ds-warn { margin: 4px 0 0; font-size: var(--fs-12); font-weight: 600; color: var(--warning-text);
      background: var(--warning-bg); border: 1px solid var(--warning-base); border-radius: var(--radius-md); padding: 6px 10px; }
    /* Đối soát — tiêu đề khi còn vướng (⚠ N vướng · M đạt) */
    .pn__ds-head { display: flex; align-items: center; gap: 8px; }
    .pn__ds-head-ic { flex: none; font-weight: 700; color: var(--warning-base); }
    .pn__ds-head-tt { font-size: var(--fs-13); font-weight: 700; color: var(--text-strong); }

    /* ── 【1】 Việc cần làm (todo) — kết luận + gate nút chính ── */
    .pn__todo { gap: 10px; }
    .pn__todo-lb { font-size: var(--fs-11); font-weight: 700; text-transform: uppercase; letter-spacing: .02em; color: var(--text-soft); }
    .pn__todo-act { display: flex; gap: 8px; flex-wrap: wrap; }

    /* ── Collapse header dùng chung (đối soát pass · progressive: Vì sao / Nguồn / Chuỗi / Lịch sử) ── */
    .pn__collapse-head { display: flex; align-items: center; gap: 8px; width: 100%; cursor: pointer; text-align: left;
      border: 1px solid var(--border-soft); border-radius: var(--radius-md); background: var(--bg-surface-subtle);
      padding: 7px 10px; font: inherit; color: var(--text-strong); }
    .pn__collapse-head:hover { border-color: var(--primary-base); }
    .pn__collapse-head--ok { border-color: var(--success-base); background: var(--success-bg); }
    .pn__collapse-head--ok .pn__collapse-ic { color: var(--success-base); }
    .pn__collapse-head--sub { background: none; border-style: dashed; padding: 5px 10px; }
    .pn__collapse-ic { flex: none; display: inline-flex; align-items: center; color: var(--success-base); }
    .pn__collapse-tt { display: inline-flex; align-items: center; gap: 6px; flex: 1; min-width: 0; font-size: var(--fs-13); font-weight: 600; }
    .pn__collapse-sub { flex: none; font-size: var(--fs-12); font-weight: 600; color: var(--text-sub); }
    .pn__collapse-sub[data-level='cao'] { color: var(--success-text); }
    .pn__collapse-sub[data-level='trung-binh'] { color: var(--warning-text); }
    .pn__collapse-sub[data-level='thap'] { color: var(--error-text); }
    .pn__collapse-caret { flex: none; font-size: var(--fs-11); color: var(--text-soft); }

    /* ── §13 Kết luận nghiệp vụ (dải khung chính, 6 kết luận) ── */
    .pn__kl { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; padding: 9px 12px;
      border: 1px solid var(--border-soft); border-left: 3px solid var(--primary-base);
      border-radius: var(--radius-md); background: var(--bg-surface-subtle); }
    .pn__kl-chip { flex: none; font-size: var(--fs-13); font-weight: 700; color: var(--primary-base); }
    .pn__kl-desc { font-size: var(--fs-12); color: var(--text-sub); }
    .pn__kl[data-kl='xu-ly-trong-ky'] { border-left-color: var(--success-base); }
    .pn__kl[data-kl='xu-ly-trong-ky'] .pn__kl-chip { color: var(--success-text); }
    .pn__kl[data-kl='dieu-chinh-ky-truoc'] { border-left-color: var(--info-text); }
    .pn__kl[data-kl='dieu-chinh-ky-truoc'] .pn__kl-chip { color: var(--info-text); }
    .pn__kl[data-kl='cho-bo-sung'] { border-left-color: var(--warning-base); }
    .pn__kl[data-kl='cho-bo-sung'] .pn__kl-chip { color: var(--warning-text); }
    .pn__kl[data-kl='tra-nguon-sua'] { border-left-color: var(--warning-base); }
    .pn__kl[data-kl='tra-nguon-sua'] .pn__kl-chip { color: var(--warning-text); }
    .pn__kl[data-kl='khong-xu-ly'] { border-left-color: var(--text-soft); }
    .pn__kl[data-kl='khong-xu-ly'] .pn__kl-chip { color: var(--text-sub); }
    .pn__kl[data-kl='can-xac-minh'] { border-left-color: var(--error-base); }
    .pn__kl[data-kl='can-xac-minh'] .pn__kl-chip { color: var(--error-text); }
    .pn__cachgo-lb { font-size: var(--fs-11); font-weight: 700; text-transform: uppercase; letter-spacing: .02em; color: var(--text-soft); }

    .pn__exc-head { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .pn__exc-han { font-size: var(--fs-12); color: var(--text-sub); display: inline-flex; align-items: center; gap: 6px; }
    .pn__exc-han b { color: var(--text-strong); }
    .pn__outcomes { display: flex; flex-direction: column; border: 1px solid var(--border-sub); border-radius: var(--radius-md); overflow: hidden; }
    .pn__outcome { display: flex; gap: 10px; padding: 7px 10px; border-bottom: 1px solid var(--border-soft); }
    .pn__outcome:last-child { border-bottom: 0; }
    .pn__outcome--hit { background: var(--bg-surface-subtle); }
    .pn__outcome-stt { flex: none; width: 18px; height: 18px; display: grid; place-items: center; border-radius: var(--radius-full);
      background: var(--bg-surface-subtle); font-size: var(--fs-11); font-weight: 600; color: var(--text-sub); }
    .pn__outcome--hit .pn__outcome-stt { background: var(--primary-bg-subtle); color: var(--primary-base); }
    .pn__outcome-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .pn__outcome-name { font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .pn__outcome--hit .pn__outcome-name { color: var(--primary-base); }
    .pn__outcome-desc { font-size: var(--fs-12); color: var(--text-sub); }
    .pn__outcome-actions { display: flex; gap: 6px; margin-top: 4px; flex-wrap: wrap; }

    /* ── Dữ liệu nguồn (data dictionary) ── */
    .pn__src { gap: 10px; }
    .pn__src-grp { display: flex; flex-direction: column; gap: 3px; }
    .pn__src-grp--full { padding: 8px 10px; border: 1px dashed var(--border-soft); border-radius: var(--radius-md); background: var(--bg-surface-subtle); }
    .pn__src-gh { font-size: var(--fs-11); font-weight: 700; text-transform: uppercase; letter-spacing: .02em; color: var(--text-soft); margin-bottom: 1px; }
    .pn__src-rows { display: flex; flex-direction: column; gap: 3px; }
    .pn__src-row { display: grid; grid-template-columns: 168px 1fr auto; gap: 10px; align-items: baseline; }
    .pn__src-k { font-size: var(--fs-12); color: var(--text-sub); }
    .pn__src-v { min-width: 0; color: var(--text-body); font-size: var(--fs-13); overflow-wrap: anywhere; }
    .pn__src-v b { color: var(--text-strong); font-weight: 600; }
    .pn__src-more { display: inline-flex; align-items: center; gap: 4px; align-self: flex-start; border: 0; background: none; padding: 0; cursor: pointer; font: inherit;
      font-size: var(--fs-12); font-weight: 600; color: var(--primary-base); }
    .pn__src-more:hover { text-decoration: underline; }

    .pn__tag { flex: none; align-self: center; font-size: var(--fs-11); font-weight: 600; line-height: 1.5;
      padding: 0 6px; border-radius: var(--radius-sm); white-space: nowrap;
      background: var(--bg-surface-subtle); color: var(--text-soft); }
    .pn__tag[data-tag='SOURCE'] { background: var(--bg-surface-subtle); color: var(--text-sub); }
    .pn__tag[data-tag='DERIVED'] { background: var(--info-bg); color: var(--info-text); }
    .pn__tag[data-tag='AI'] { background: var(--primary-bg-subtle); color: var(--primary-base); }
    .pn__tag[data-tag='HR_INPUT'] { background: var(--warning-bg); color: var(--warning-text); }
    .pn__tag[data-tag='SYSTEM'] { background: var(--bg-surface-subtle); color: var(--text-soft); }

    /* ── Bàn giao chéo — "Đã chuyển xử lý" + form inline (yêu cầu bổ sung / trả nguồn sửa) ── */
    .pn__handoff { gap: 8px; }
    .pn__handoff-head { display: flex; align-items: center; gap: 8px; }
    .pn__handoff-lb { font-size: var(--fs-11); font-weight: 700; text-transform: uppercase; letter-spacing: .02em; color: var(--text-soft); }
    .pn__handoff-body { display: flex; flex-direction: column; gap: 4px; padding: 8px 10px; border: 1px solid var(--border-soft);
      border-left: 3px solid var(--warning-base); border-radius: var(--radius-md); background: var(--bg-surface-subtle); }
    .pn__handoff-han { color: var(--error-text); font-weight: 600; }
    .pn__handoff-act { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

    .pn__form { display: flex; flex-direction: column; gap: 8px; padding: 10px 12px; border: 1px solid var(--border-sub);
      border-radius: var(--radius-md); background: var(--bg-surface-subtle); }
    .pn__form-hd { font-size: var(--fs-12); font-weight: 700; color: var(--text-strong); }
    .pn__field { display: flex; flex-direction: column; gap: 3px; }
    .pn__field-lb { font-size: var(--fs-11); font-weight: 600; color: var(--text-sub); }
    .pn__form-act { display: flex; gap: 6px; flex-wrap: wrap; }
    .pn__form-err { margin: 0; font-size: var(--fs-12); font-weight: 600; color: var(--error-text);
      background: var(--error-bg); border: 1px solid var(--error-base); border-radius: var(--radius-md); padding: 6px 10px; }
  