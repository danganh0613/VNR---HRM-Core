
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }
    .m8 { flex: 1 1 auto; min-height: 0; display: flex; gap: 0; }

    .m8-tree {
      flex: none; width: 265px; overflow: auto; display: flex; flex-direction: column; gap: 10px;
      padding: 12px 10px 12px 20px; border-right: 1px solid var(--border-sub); background: var(--bg-surface);
    }
    .m8-group { display: flex; flex-direction: column; gap: 1px; }
    .m8-group__head {
      display: flex; align-items: center; gap: 6px; padding: 4px 2px;
      font-size: var(--fs-11); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--text-sub);
    }
    .m8-group__count { font-weight: 600; color: var(--text-soft); background: var(--bg-surface-subtle); border-radius: var(--radius-full); padding: 0 6px; }
    .m8-item {
      display: flex; align-items: center; gap: 6px; flex-wrap: wrap; text-align: left;
      border: 0; background: none; cursor: pointer; font: inherit; padding: 5px 8px; border-radius: var(--radius-sm);
    }
    .m8-item:hover:not(:disabled) { background: var(--bg-surface-subtle); }
    .m8-item--on { background: var(--primary-bg, var(--bg-surface-subtle)); }
    .m8-item--on .m8-item__ten { color: var(--primary-base); font-weight: 600; }
    .m8-item--mo { cursor: not-allowed; opacity: .5; }
    .m8-item__ten { font-size: var(--fs-13); color: var(--text-body); }
    .m8-item__why { font-size: var(--fs-11); color: var(--text-soft); }
    .m8-tree__note { margin: 0; font-size: var(--fs-11); color: var(--text-soft); }

    .m8-work { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; min-height: 0; }
    .m8-ctx {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 8px 20px;
      border-bottom: 1px solid var(--border-sub); background: var(--bg-surface);
    }
    .m8-ctx__label { font-size: var(--fs-12); font-weight: 600; color: var(--text-sub); }
    .m8-ctx__sel { width: 300px; }
    .m8-ctx__note { font-size: var(--fs-11); color: var(--text-soft); }
    .m8-ctx__sec { font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .m8-gap { flex: 1; }
    .m8-body { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; overflow: auto; padding: 12px 20px 20px; gap: 12px; }
  