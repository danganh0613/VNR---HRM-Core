
:host { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-13); line-height: 1.4; }
/* tông màu → 3 biến chung */
:host([data-status='success'])    { --_c: var(--success-base); --_bg: var(--success-bg); --_tx: var(--success-text); }
:host([data-status='warning'])    { --_c: var(--warning-base); --_bg: var(--warning-bg); --_tx: var(--warning-text); }
:host([data-status='error'])      { --_c: var(--error-base);   --_bg: var(--error-bg);   --_tx: var(--error-text); }
:host([data-status='info'])       { --_c: var(--info-base);    --_bg: var(--info-bg);    --_tx: var(--info-text); }
:host([data-status='processing']) { --_c: var(--info-base);    --_bg: var(--info-bg);    --_tx: var(--info-text); }
:host([data-status='neutral'])    { --_c: var(--text-sub);     --_bg: var(--bg-surface-subtle); --_tx: var(--text-body); }
:host([data-status='violet'])     { --_c: var(--purple-500);   --_bg: var(--purple-100);        --_tx: var(--purple-600); }

.st-dot { flex: none; width: 6px; height: 6px; border-radius: var(--radius-full); background: var(--_c); }
:host([data-status='processing']) .st-dot { animation: st-pulse 1.4s var(--ease-in-out) infinite; }

/* dot: chữ thường (body) */
:host([data-variant='dot']) .st-label { color: var(--text-body); font-weight: 400; }
/* plain: chỉ chữ màu tông */
:host([data-variant='plain']) .st-label { color: var(--_c); font-weight: 400; }
/* badge: viên nền tint (15% tông — đậm hơn bg-light) + chữ semibold màu tông + chấm nhỏ dẫn đầu.
   Nổi mà không nhầm button. */
:host([data-variant='badge']) {
  background: color-mix(in srgb, var(--_c) 15%, var(--bg-surface));
  color: var(--_tx); padding: 2px 10px; border-radius: var(--radius-sm);
}
:host([data-variant='badge']) .st-label { color: var(--_tx); font-weight: 500; }
:host([data-variant='badge']) .st-dot { width: 5px; height: 5px; }
/* solid: viên nền ĐẬM + chữ trắng — nổi nhất, cho cột trạng thái quy trình cần focus */
:host([data-variant='solid']) { background: var(--_c); padding: 2px 10px; border-radius: var(--radius-sm); }
:host([data-variant='solid']) .st-label { color: var(--static-white, #fff); font-weight: 400; }
:host([data-variant='solid'][data-status='neutral']) { background: var(--neutral-500, var(--_c)); }

@keyframes st-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }
  