
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; gap: 8px; }
    .t3-toolbar { display: flex; align-items: center; gap: 8px; }
    .t3-gap { flex: 1; }
    .t3-split { flex: 1 1 auto; min-height: 480px; display: flex; gap: 12px; align-items: stretch; }
    .t3-main { flex: 1 1 auto; min-width: 0; overflow: auto; }
    .t3-empty { padding: 40px 0; display: flex; justify-content: center; }
    .t3-stack { display: flex; flex-direction: column; gap: 2px; align-items: flex-start; min-width: 0; }
    .t3-tags { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
    .t3-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .t3-strong { color: var(--text-strong); font-weight: 500; }
    .t3-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .t3-muted b { color: var(--text-strong); }
    .t3-err { font-size: var(--fs-12); color: var(--error-text); font-weight: 500; }
    .t3-warn { font-size: var(--fs-12); color: var(--warning-text); font-weight: 500; margin: 0; }
    .t3-ok { font-size: var(--fs-12); color: var(--success-text); font-weight: 500; }
    .t3-pk, .t3-dm { display: flex; flex-direction: column; gap: 10px; font-size: var(--fs-13); }
    .t3-kk { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 6px 10px; }
    .t3-kk--err { border-color: var(--error-base); background: var(--error-bg); }
    .t3-acts { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .t3-so { border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 7px 10px; display: flex; flex-direction: column; gap: 3px; }
    .t3-so__head { margin: 0; display: flex; align-items: center; gap: 8px; }
    .t3-kt { display: flex; flex-direction: column; gap: 5px; align-items: flex-start; border: 1px dashed var(--warning-base, var(--warning-text)); border-radius: var(--radius-md); padding: 8px 10px; background: var(--warning-bg); }
    .t3-kt--ok { border-color: var(--success-base, var(--success-text)); background: var(--success-bg); }
    .t3-d02 { display: flex; flex-direction: column; gap: 3px; border-left: 3px solid var(--primary-base); padding: 4px 10px; }
    .t3-nhanh { display: flex; gap: 16px; flex-wrap: wrap; font-size: var(--fs-12); color: var(--text-sub); }
    .t3-nhanh b { color: var(--text-strong); }
    .t3-dm__item { border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 8px 10px; display: flex; flex-direction: column; gap: 4px; align-items: flex-start; }
    .t3-dm__item--mo { opacity: .55; }
    .t3-dm__head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .t3-map { margin: 0; font-size: var(--fs-12); color: var(--text-body); }
  