
:host { display: block; padding: var(--space-6); max-width: 960px; margin-inline: auto; }
.imk-wrap { display: flex; flex-direction: column; gap: var(--space-6); }

/* — Header hoàn tất — */
.imk-head { display: flex; align-items: center; gap: var(--space-3); }
.imk-head-ic {
  flex: none; width: 44px; height: 44px; border-radius: var(--radius-full);
  display: grid; place-items: center;
  background: color-mix(in srgb, var(--success-base) 15%, var(--bg-surface));
  color: var(--success-base);
}
.imk-title { margin: 0; font-size: var(--fs-18); font-weight: var(--font-semibold); color: var(--text-strong); }
.imk-sub { margin: var(--space-1) 0 0; font-size: var(--fs-13); color: var(--text-sub); font-variant-numeric: tabular-nums; }

/* — 5 stat card — */
.imk-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-3); }

/* — Card chung — */
.imk-card {
  border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
  background: var(--bg-surface); padding: var(--space-4);
}
/* Panel bảng kết quả kiểu list-page: tab strip = toolbar band (đã có border-bottom của nz-tabs), grid flush */
.imk-tablecard { padding: 0; overflow: hidden; }
.imk-tablecard ::ng-deep .ant-tabs-nav { margin: 0; padding: 0 var(--space-3); }
.imk-tablecard ::ng-deep .ant-table { border: 0; border-radius: 0; background: transparent; }

.imk-name { color: var(--text-strong); font-weight: var(--font-medium); }

/* — Hàng nút download — */
.imk-dl { display: flex; flex-wrap: wrap; gap: var(--space-2); }

/* — Card lưu cấu hình — */
.imk-save { display: flex; flex-direction: column; gap: var(--space-4); }
.imk-save-title { margin: 0; font-size: var(--fs-15); font-weight: var(--font-semibold); color: var(--text-strong); }
.imk-save-desc { margin: var(--space-1) 0 0; font-size: var(--fs-13); color: var(--text-sub); }
.imk-save-name { display: flex; flex-direction: column; gap: var(--space-1); max-width: 420px; }
.imk-save-name > span { font-size: var(--fs-13); color: var(--text-sub); }
.imk-save-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
.imk-save-list li { display: flex; align-items: center; gap: var(--space-2); font-size: var(--fs-13); }
.imk-save-check { flex: none; display: inline-flex; color: var(--success-base); }
.imk-save-k { color: var(--text-strong); font-weight: var(--font-medium); white-space: nowrap; }
.imk-save-d { color: var(--text-sub); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.imk-save-foot { display: flex; align-items: center; }
  