
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }
    .c6-search { display: flex; flex-direction: column; gap: 6px; }
    .c6-search__row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .c6-kw { display: inline-block; width: 300px; }
    .c6-f { display: inline-block; width: 150px; }
    .c6-f--sm { width: 116px; }
    .c6-gap { flex: 1; }
    .c6-help {
      display: inline-flex; align-items: center; gap: 5px; cursor: pointer; font: inherit;
      font-size: var(--fs-12); font-weight: 500; color: var(--primary-base);
      background: var(--primary-bg, var(--bg-surface-subtle)); border: 1px solid transparent;
      border-radius: var(--radius-md); padding: 4px 10px;
    }
    .c6-help:hover { border-color: var(--primary-base); }
    .c6-chips { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
    .c6-chips__label { font-size: var(--fs-12); color: var(--text-sub); }

    .c6-hp { display: flex; flex-direction: column; gap: 10px; font-size: var(--fs-13); }
    .c6-hp__note { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .c6-hp__item { border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 8px 10px; display: flex; flex-direction: column; gap: 3px; }
    .c6-hp__item--mo { opacity: .55; }
    .c6-hp__head { display: flex; align-items: baseline; gap: 8px; }
    .c6-hp__ma { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 700; color: var(--primary-base); }
    .c6-hp__ten { font-weight: 500; color: var(--text-strong); }
    .c6-hp__sub { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .c6-hp__sub b { color: var(--text-strong); }
    .c6-hp__warn { margin: 0; font-size: var(--fs-12); color: var(--warning-text); }
    .c6-hp__link {
      align-self: flex-start; cursor: pointer; font: inherit; font-size: var(--fs-13); font-weight: 500;
      color: var(--primary-base); background: none; border: 0; padding: 0; text-decoration: underline;
    }
  