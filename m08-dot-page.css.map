
    :host { display: flex; flex-direction: column; gap: 12px; }
    .p-dot { border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface); padding: 12px 14px; display: flex; flex-direction: column; gap: 10px; }
    .p-dot--soan { border-style: dashed; }
    .p-dot__head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .p-gap { flex: 1; }
    .p-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 700; color: var(--text-strong); }
    .p-cor { color: var(--text-sub); font-weight: 600; }
    .p-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .p-muted b { color: var(--text-strong); }
    .p-err { font-size: var(--fs-12); color: var(--error-text); font-weight: 500; }
    .p-bans { display: flex; flex-direction: column; gap: 5px; }
    .p-ban { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 6px 10px; }
    .p-ban--xd { border-color: var(--error-base); background: var(--error-bg); }
    .p-acts { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .p-sel { width: 230px; }
    .p-vet summary { font-size: var(--fs-12); color: var(--text-sub); cursor: pointer; }
    .p-vet__row { margin: 3px 0 0 14px; font-size: var(--fs-12); color: var(--text-body); }
  