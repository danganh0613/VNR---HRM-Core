
    :host { display: block; position: sticky; bottom: 12px; z-index: 6; }
    .bb {
      background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: var(--radius-lg); box-shadow: var(--shadow-regular-md, var(--shadow-regular-sm));
      padding: 10px 14px;
    }
    .bb-row { display: flex; align-items: center; gap: 12px; }
    .bb-sum { font-size: var(--fs-13); color: var(--text-sub); }
    .bb-sum b { color: var(--text-strong); font-weight: 600; }
    .bb-sep { color: var(--text-soft); margin: 0 2px; }
    .bb-ok { color: var(--success-base); }
    .bb-bad { color: var(--error-base); }
    .bb-why {
      border: 0; background: none; padding: 0; cursor: pointer;
      color: var(--primary-base); font: inherit; font-size: var(--fs-12); font-weight: 600;
    }
    .bb-gap { flex: 1; }
    .bb-reasons {
      margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border-sub);
      display: flex; flex-direction: column; gap: 6px;
    }
    .bb-reason { display: flex; align-items: baseline; gap: 8px; font-size: var(--fs-12); color: var(--text-sub); }
    .bb-count {
      flex: none; min-width: 20px; text-align: center; font-weight: 600;
      color: var(--error-text); background: var(--error-bg); border-radius: var(--radius-full); padding: 0 6px;
    }
  