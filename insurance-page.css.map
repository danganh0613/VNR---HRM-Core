
    :host { display: block; }
    .lp-desktop { height: 760px; border: 1px solid var(--border-sub); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-regular-sm); }
    .lp-full { margin-top: 14px; }
    .lp-full-link { text-decoration: none; }
    .lp-desktop--full { height: 100vh; border: 0; border-radius: 0; box-shadow: none; }
    .lp-desktop ::ng-deep .shell-content { padding: 0; display: flex; flex-direction: column; min-height: 0; }

    .ins-body { display: flex; flex-direction: column; min-height: 0; flex: 1 1 auto; overflow: auto; background: var(--bg-body); }
    .ins-bell { display: grid; place-items: center; width: 30px; height: 30px; border: 0; border-radius: var(--radius-md);
      background: transparent; color: var(--text-sub); cursor: pointer; }
    .ins-bell:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }

    /* Org switcher — content project vào slot snHead của hrm-side-nav (token-only). */
    .ins-org { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px 10px; cursor: pointer;
      background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
      font: inherit; text-align: left; }
    .ins-org:hover { border-color: var(--border-strong, var(--border-sub)); background: var(--bg-surface-subtle); }
    .ins-org-ic { display: grid; place-items: center; width: 36px; height: 36px; flex: none;
      border-radius: var(--radius-md); background: var(--primary-bg-subtle); color: var(--primary-base); }
    .ins-org-info { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; }
    .ins-org-name { font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ins-org-sub { font-size: var(--fs-12); color: var(--text-sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ins-org-caret { color: var(--text-soft); flex: none; }
    .ins-org--min { justify-content: center; padding: 6px; border: 0; background: transparent; }
  