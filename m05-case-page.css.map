
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; padding: 0 20px; }

    .cs-head {
      position: sticky; top: 0; z-index: 7; flex: none;
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      background: var(--bg-body); border-bottom: 1px solid var(--border-sub); padding: 10px 0 8px;
    }
    .cs-back {
      display: inline-flex; align-items: center; gap: 5px; cursor: pointer; font: inherit;
      font-size: var(--fs-12); font-weight: 600; color: var(--primary-base);
      border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); padding: 4px 10px;
    }
    .cs-back:hover { border-color: var(--primary-base); }
    .cs-id { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .cs-name { font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); white-space: nowrap; }
    .cs-meta { font-size: var(--fs-12); color: var(--text-sub); white-space: nowrap; }
    .cs-mono { font-family: var(--font-mono, monospace); font-weight: 600; color: var(--text-strong); }
    .cs-money { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-14); font-weight: 700; color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .cs-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .cs-nf { padding: 24px 0; }
    .cs-gap { flex: 1; }
    .cs-mocs { display: flex; gap: 12px; font-size: var(--fs-12); color: var(--text-sub); white-space: nowrap; }
    .cs-mocs b { color: var(--text-strong); }
    .cs-closed { display: block; margin-top: 8px; }

    /* step-rail — copy pattern .m03-step (D2) */
    .cs-rail { flex: none; display: flex; align-items: stretch; gap: 8px; padding: 8px 0 10px; border-bottom: 1px solid var(--border-sub); overflow-x: auto; }
    .cs-step { display: flex; align-items: flex-start; gap: 9px; flex: 1 1 0; min-width: 190px; text-align: left;
      border: 1px solid var(--border-soft); border-radius: var(--radius-lg); background: var(--bg-surface);
      padding: 8px 12px; cursor: pointer; font: inherit; }
    .cs-step:hover { border-color: var(--border-input); }
    .cs-step--active { border-color: var(--primary-base); box-shadow: 0 0 0 1px var(--primary-base); }
    .cs-step--locked { opacity: .72; cursor: not-allowed; }
    .cs-step__idx { flex: none; width: 24px; height: 24px; display: grid; place-items: center; margin-top: 1px;
      border-radius: var(--radius-full); font-size: var(--fs-12); font-weight: 600;
      border: 1.5px solid var(--border-input); color: var(--text-sub); background: var(--bg-surface); }
    .cs-step__idx[data-status='dang-xu-ly'] { border-color: var(--primary-base); color: var(--primary-base); }
    .cs-step__idx[data-status='co-loi'] { border-color: var(--error-base); color: var(--error-text); background: var(--error-bg); }
    .cs-step__idx[data-status='hoan-tat'] { border-color: var(--success-base); color: var(--success-text); background: var(--success-bg); }
    .cs-step__body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .cs-step__label { font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); white-space: nowrap; }
    .cs-step__status { font-size: var(--fs-11); font-weight: 600; }
    .cs-step__status[data-status='chua-bat-dau'] { color: var(--text-soft); }
    .cs-step__status[data-status='dang-xu-ly'] { color: var(--primary-base); }
    .cs-step__status[data-status='co-loi'] { color: var(--error-text); }
    .cs-step__status[data-status='hoan-tat'] { color: var(--success-text); }
    .cs-step__count { font-size: var(--fs-12); color: var(--text-sub); }
    .cs-step__blocker { font-size: var(--fs-11); color: var(--error-text); }
    .cs-step__lock { font-size: var(--fs-11); color: var(--text-soft); }
    .cs-rail__sep { flex: none; width: 14px; align-self: center; height: 1.5px; background: var(--border-sub); border-radius: 1px; }

    .cs-body { flex: 1 1 auto; min-height: 0; padding: 12px 0 16px; overflow: auto; }
    /* Case Đóng → CHỈ ĐỌC mọi bước: khóa pointer vùng thân (xem/cuộn vẫn được). */
    .cs-body--readonly :is(button, input, textarea, .ant-select, .ant-segmented) { pointer-events: none; opacity: .82; }
  