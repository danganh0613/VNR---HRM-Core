
    :host { display: block; }
    .b2 { display: flex; flex-direction: column; gap: 16px; max-width: 1080px; }
    .b2__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
    .b2__sec { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .b2__list { display: flex; flex-direction: column; border: 1px solid var(--border-sub); border-radius: var(--radius-md); overflow: hidden; }
    .b2__item { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-bottom: 1px solid var(--border-soft); background: var(--bg-surface); }
    .b2__item:last-child { border-bottom: 0; }
    .b2__item[data-st='thieu'] { background: color-mix(in srgb, var(--error-bg) 40%, var(--bg-surface)); }
    .b2__tick {
      flex: none; width: 22px; height: 22px; display: grid; place-items: center;
      border-radius: var(--radius-full); font-size: var(--fs-12); font-weight: 700;
      background: var(--bg-surface-subtle); color: var(--text-sub);
    }
    .b2__tick[data-st='du'] { background: var(--success-bg); color: var(--success-text); }
    .b2__tick[data-st='thieu'] { background: var(--error-bg); color: var(--error-text); }
    .b2__tick[data-st='cho-xac-minh'] { background: var(--warning-bg); color: var(--warning-text); }
    .b2__item-body { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; }
    .b2__item-name { font-size: var(--fs-13); font-weight: 500; color: var(--text-strong); }
    .b2__req { color: var(--error-base); }
    .b2__item-st { font-size: var(--fs-12); color: var(--text-sub); }
    .b2__item-st b { color: var(--warning-text); }
    .b2__muted { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .b2__muted b, .b2__form b { color: var(--text-strong); }
    .b2__err { font-size: var(--fs-12); color: var(--error-text); }
    .b2__doc { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); padding: 8px 12px; }
    .b2__doc-main { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 240px; }
    .b2__doc-name { font-size: var(--fs-13); font-weight: 500; color: var(--text-strong); }
    .b2__doc-tags { display: flex; gap: 4px; flex-wrap: wrap; }
    :host ::ng-deep .b2__doc-tags .ant-tag { margin: 0; }
    .b2__warnrow { display: flex; align-items: flex-start; gap: 10px; }
    .b2__warnalert { flex: 1; display: block; }
    .b2__form { display: flex; flex-direction: column; gap: 8px; }
  