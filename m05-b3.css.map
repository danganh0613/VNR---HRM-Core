
    :host { display: block; }
    .b3 { display: flex; flex-direction: column; gap: 14px; max-width: 920px; }
    .b3__toolbar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .b3__gap { flex: 1; }
    .b3__trust { font-size: var(--fs-11); font-weight: 500; color: var(--warning-text); background: var(--warning-bg);
      border: 1px dashed var(--warning-base, var(--warning-text)); border-radius: var(--radius-full); padding: 1px 9px; cursor: help; }

    .b3__block { display: flex; flex-direction: column; gap: 8px; border: 1px solid var(--border-sub);
      border-radius: var(--radius-lg); background: var(--bg-surface); padding: 12px 14px; }
    .b3__blockhead { display: flex; align-items: center; gap: 8px; }
    .b3__no { font-size: var(--fs-14); font-weight: 700; color: var(--primary-base); }

    .b3__inputgrid { display: grid; grid-template-columns: minmax(280px, 1.4fr) 1fr; gap: 6px 14px; align-items: baseline; }
    .b3__k { font-size: var(--fs-12); color: var(--text-sub); }
    .b3__v { font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .b3__v b { font-weight: 700; }

    .b3__formula { margin: 0; font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); }
    .b3__formula--sub { font-size: var(--fs-12); font-weight: 500; color: var(--text-sub); }
    .b3__ruletags { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    :host ::ng-deep .b3__ruletags .ant-tag { margin: 0; }

    .b3__table { width: 100%; border-collapse: collapse; font-size: var(--fs-12); }
    .b3__table th { text-align: left; padding: 5px 10px; color: var(--text-sub); font-weight: 600;
      background: var(--bg-surface-subtle); border-bottom: 1px solid var(--border-sub); }
    .b3__table td { padding: 5px 10px; border-bottom: 1px solid var(--border-soft); color: var(--text-body); }
    .b3__row--cut td { background: color-mix(in srgb, var(--error-bg) 42%, var(--bg-surface)); }
    .b3__mono { font-family: var(--font-mono, monospace); font-weight: 600; color: var(--text-strong); }
    .b3__yes { color: var(--success-text); font-weight: 600; }
    .b3__no-cell { color: var(--error-text); font-weight: 700; }
    .b3__td-reason { color: var(--text-sub); }
    .b3__table tfoot td { padding-top: 8px; border-bottom: 0; font-size: var(--fs-13); color: var(--text-sub); }
    .b3__table tfoot b { color: var(--text-strong); font-size: var(--fs-13); }

    .b3__result { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: stretch; }
    .b3__rescol { display: flex; flex-direction: column; align-items: flex-start; gap: 5px;
      border: 1px solid var(--border-soft); border-radius: var(--radius-md); padding: 12px 14px; }
    .b3__rescol--override { border-color: var(--warning-base, var(--warning-text)); background: color-mix(in srgb, var(--warning-bg) 35%, var(--bg-surface)); }
    .b3__reslb { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-12); font-weight: 600; color: var(--text-sub); text-transform: uppercase; letter-spacing: .04em; }
    :host ::ng-deep .b3__reslb .ant-tag { margin: 0; text-transform: none; letter-spacing: 0; }
    .b3__resnum { font-size: var(--fs-24, 24px); font-weight: 700; color: var(--text-strong); font-variant-numeric: tabular-nums; line-height: 1.2; }
    .b3__ovactions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 4px; }

    .b3__muted { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .b3__err { font-size: var(--fs-12); color: var(--error-text); }
    .b3__form { display: flex; flex-direction: column; gap: 8px; }
  