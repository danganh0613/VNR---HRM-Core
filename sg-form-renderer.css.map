
    :host { display: block; }
    /* Header solid theo theme — dải màu chủ đạo, chữ trắng. */
    .fbr-head { padding: 16px 20px 14px; color: var(--static-white, #fff); }
    .fbr-head-t { font-size: var(--fs-16, 16px); font-weight: var(--font-bold, 700); }
    .fbr-head-d { margin-top: 2px; font-size: var(--fs-12, 12px); opacity: .85; }
    /* Mật độ CHUẨN form list-page: body 20/20/12 · section gap 24 · grid 6 cột (Vueform columns). */
    .fbr-body { padding: var(--space-5, 20px) var(--space-5, 20px) var(--space-3, 12px); display: flex; flex-direction: column; gap: var(--space-6, 24px); }
    .fbr-sec { display: flex; flex-direction: column; gap: var(--space-3, 12px); }
    .fbr-sec-h { font-size: var(--fs-13, 13px); font-weight: var(--font-bold, 700); color: var(--text-strong); padding-bottom: 8px; border-bottom: 1px solid var(--border-soft); }
    .fbr-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px 10px; }
    .fbr-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .fbr-span-full { grid-column: 1 / -1; }
    .fbr-lbl { font-size: var(--fs-13, 13px); font-weight: var(--font-medium, 500); color: var(--text-strong); }
    .fbr-req { color: var(--error-base); font-weight: var(--font-bold, 700); }
    .fbr-help { font-size: var(--fs-12, 12px); color: var(--text-soft); }
    /* Lỗi ràng buộc / cảnh báo rule — đỏ semantic, icon + text. */
    .fbr-err { display: inline-flex; align-items: center; gap: 4px; font-size: var(--fs-12, 12px); color: var(--error-base); }

    .fbr-heading { font-size: var(--fs-14, 14px); font-weight: var(--font-bold, 700); color: var(--text-strong); padding-top: 4px; }
    .fbr-divider { border: 0; border-top: 1px solid var(--border-soft); margin: 2px 0; width: 100%; }

    .fbr-checks { display: flex; flex-direction: column; gap: 6px; padding-top: 2px; }
    .fbr-toggle, .fbr-rate { display: inline-flex; align-items: center; min-height: 32px; }

    /* Số tiền = group control: số (co giãn) + đơn vị tiền tệ (cố định). */
    .fbr-money { display: flex; gap: 8px; min-width: 0; }
    .fbr-money-n { flex: 1 1 auto; min-width: 0; }
    .fbr-money-u { flex: 0 0 96px; }
    .fbr-mono { font-family: var(--font-mono, ui-monospace, monospace); }

    /* Vùng upload/hình — dashed drop area theo token, KHÔNG upload thật (demo). */
    .fbr-upload {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      min-height: 74px; border: 1.5px dashed var(--border-sub); border-radius: var(--radius-lg);
      background: var(--bg-surface-subtle); color: var(--text-sub); cursor: pointer;
      transition: border-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
    }
    .fbr-upload:hover { border-color: var(--primary-base); color: var(--primary-base); }
    .fbr-upload-t b { font-weight: var(--font-semibold, 600); color: var(--primary-base); }

    /* Chế độ CHI TIẾT / READONLY — giá trị dạng text; readonly trong form có khung nhạt. */
    .fbr-ro { font-size: var(--fs-14, 14px); color: var(--text-body); min-height: 22px; white-space: pre-wrap; }
    .fbr-err--top { padding: 8px 10px; border: 1px solid color-mix(in srgb, var(--error-base) 35%, transparent); border-radius: var(--radius-md); background: color-mix(in srgb, var(--error-base) 6%, var(--bg-surface)); }
    .fbr-hint { font-size: var(--fs-12); color: var(--text-sub); }
    .fbr-files { display: flex; flex-wrap: wrap; gap: 6px; }
    .fbr-file { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface-subtle); font-size: var(--fs-12); color: var(--text-body); }
    .fbr-file-x { border: 0; background: transparent; color: var(--text-soft); cursor: pointer; font-size: 14px; line-height: 1; padding: 0; }
    .fbr-file-x:hover { color: var(--error-base); }
    .fbr-ro--boxed { display: flex; align-items: center; min-height: 32px; padding: 0 11px;
      border: 1px solid var(--border-soft); border-radius: var(--radius-md);
      background: var(--bg-surface-subtle); color: var(--text-sub); }
  