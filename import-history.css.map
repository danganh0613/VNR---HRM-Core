
:host {
  position: absolute; inset: 0; z-index: var(--z-modal);
  display: flex; flex-direction: column;
  background: var(--bg-surface);
}
.imh-head {
  flex: none; display: flex; align-items: center; justify-content: space-between;
  gap: var(--space-3); padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--border-sub);
}
.imh-title { display: flex; align-items: center; gap: var(--space-2); color: var(--icon-secondary); }
.imh-title h3 { margin: 0; font-size: var(--fs-16); font-weight: var(--font-semibold); color: var(--text-strong); }
.imh-filter {
  flex: none; display: flex; align-items: center; flex-wrap: wrap;
  gap: var(--space-3); padding: var(--space-2-5) var(--space-3);
  border-bottom: 1px solid var(--border-sub);
}
.imh-search { flex: 1 1 260px; max-width: 380px; }
.imh-sel { width: 200px; }
.imh-body { flex: 1 1 auto; min-height: 0; overflow: hidden; padding: var(--space-5); }
/* Panel list-page: viền bo overflow-hidden, filter band trên + grid flush cuộn trong */
.imh-tablecard { display: flex; flex-direction: column; min-height: 0; height: 100%;
  border: 1px solid var(--border-sub); border-radius: var(--radius-lg); overflow: hidden; }
.imh-tablewrap { flex: 1 1 auto; min-height: 0; overflow: auto; }
.imh-tablewrap ::ng-deep .ant-table { border: 0; border-radius: 0; background: transparent; }
.imh-file { font-weight: var(--font-medium); color: var(--text-strong); white-space: nowrap; }
.imh-err { color: var(--error-base); }
  