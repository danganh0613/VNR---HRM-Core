
    /* Nút/hành động mẫu trong header thẻ (bên gọi tự cấp — card chỉ mở khe [cardActions]). */
    .cd-btn { display: inline-flex; align-items: center; gap: var(--space-1-5); height: 32px; padding: 0 var(--space-3); border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); color: var(--text-body); font: inherit; font-size: var(--fs-13); font-weight: 500; cursor: pointer; }
    .cd-btn:hover { border-color: var(--primary-base); color: var(--text-strong); }
    .cd-ico { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); color: var(--text-sub); cursor: pointer; }
    .cd-ico:hover { border-color: var(--primary-base); color: var(--text-strong); }
    .cd-kpi { display: flex; align-items: center; gap: var(--space-2-5); }
    .cd-kpi-v { font-size: var(--fs-28); font-weight: 700; color: var(--text-strong); letter-spacing: -.01em; }
    .cd-kpi-d { font-size: var(--fs-12); font-weight: 600; padding: 3px 8px; border-radius: var(--radius-full); background: var(--success-bg); color: var(--success-text, var(--success-base)); }
  