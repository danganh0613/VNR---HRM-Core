
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; }
    /* Panel container: gutter ngang 24px = trùng padding tự nhiên của page-header (nz 24px) → title thẳng lề panel. */
    .d1 { flex: 1 1 auto; overflow: auto; display: flex; flex-direction: column; gap: 12px;
      padding: 14px 24px 24px; background: var(--bg-subtle, var(--bg-surface-subtle)); }

    /* ── tones: đặt --tc (màu chính) + --tbg (nền nhạt) theo data-tone ── */
    [data-tone='success'] { --tc: var(--success-base); --tbg: var(--success-bg); }
    [data-tone='error']   { --tc: var(--error-base);   --tbg: var(--error-bg); }
    [data-tone='warning'] { --tc: var(--warning-base); --tbg: var(--warning-bg); }
    [data-tone='info']    { --tc: var(--info-base);    --tbg: var(--info-bg); }
    [data-tone='primary'] { --tc: var(--primary-base); --tbg: var(--primary-bg-subtle); }
    [data-tone='violet']  { --tc: var(--purple-600);   --tbg: var(--purple-100); }
    [data-tone='none']    { --tc: var(--text-strong);  --tbg: var(--bg-surface-subtle); }

    /* ── topbar ── */
    /* ds-demo global zero padding-ngang của nz-page-header (mong container pad) → khôi phục padding CHUẨN đối xứng
       16px 24px (= gutter panel) cho page-header STANDALONE này (giống M02); nền trắng full-width, nội dung padded đều. */
    :host ::ng-deep .d1-ph .ant-page-header { padding: 16px 24px; }
    .d1-ph-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .d1-ky { display: inline-block; min-width: 150px; }
    .d1-chip { display: inline-flex; align-items: center; gap: 5px; font-size: var(--fs-12); font-weight: 600;
      color: var(--warning-text); background: var(--tbg); border: 1px solid var(--warning-base);
      border-radius: var(--radius-full, 999px); padding: 3px 10px; }
    .d1-ph-actions tabler-icon { display: inline-flex; }

    /* ── panels & grids ── */
    .d1-r1 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
    /* BENTO (sau khi bỏ bảng Tổng hợp + money Chế độ): hàng 1 = Biến động(bd)·Tóm tắt AI(ai)·Kê khai(ky) đều M;
       Chế độ(cd) span 2 cột trái + 2 hàng (rộng cho bars), Ký&nộp(kn)+Đối soát(ds) stack cột phải → cân, không dư. */
    .d1-bento { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 12px; align-items: stretch;
      grid-template-areas: "bd ai ky" "cd cd kn" "cd cd ds"; }
    .d1-bd { grid-area: bd; } .d1-ai { grid-area: ai; } .d1-ky { grid-area: ky; }
    .d1-kn { grid-area: kn; } .d1-ds { grid-area: ds; } .d1-cd { grid-area: cd; }
    @media (max-width: 1200px) {
      .d1-r1 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .d1-bento { grid-template-columns: 1fr; grid-template-areas: "bd" "ai" "ky" "cd" "kn" "ds"; }
    }
    @media (max-width: 640px) { .d1-r1 { grid-template-columns: 1fr; } }

    .pnl { display: flex; flex-direction: column; gap: 10px; background: var(--bg-surface);
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg); padding: 14px; min-width: 0; }
    .pnl-h { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .pnl-t { font-size: var(--fs-13); font-weight: 700; color: var(--text-strong); display: inline-flex; align-items: center; gap: 6px; }
    .pnl-i { color: var(--text-soft); }
    .pnl-sp { color: var(--purple-500); }

    /* ── Row1 stat card ── */
    .sc { display: flex; flex-direction: column; gap: 8px; background: var(--bg-surface);
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg); padding: 14px; min-width: 0; }
    .sc-top { display: flex; align-items: center; gap: 10px; }
    .sc-ic { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px;
      border-radius: var(--radius-full, 999px); background: var(--tbg); color: var(--tc); flex: none; }
    .sc-ten { font-size: var(--fs-13); font-weight: 600; color: var(--text-sub); }
    .sc-so { font-size: var(--fs-28, 28px); font-weight: 700; color: var(--text-strong); line-height: 1.1;
      font-variant-numeric: tabular-nums; }
    .sc-sub { display: flex; flex-wrap: wrap; align-items: baseline; gap: 5px; font-size: var(--fs-12); color: var(--text-sub); }
    .sc-dot { color: var(--text-soft); }

    /* ── link nhỏ "Xem chi tiết ›" ── */
    .d1-link { align-self: flex-start; display: inline-flex; align-items: center; gap: 2px; font: inherit;
      font-size: var(--fs-12); font-weight: 600; color: var(--primary-base); background: none; border: none;
      padding: 0; cursor: pointer; }
    .d1-link:hover { text-decoration: underline; }
    .d1-link tabler-icon { display: inline-flex; }

    /* ── mini tiles ── */
    .mt-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
    .mt-row--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .mt-row--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    @media (max-width: 1400px) { .mt-row { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .mt { display: flex; flex-direction: column; gap: 2px; padding: 8px 10px; border-radius: var(--radius-md);
      border: 1px solid var(--border-soft); background: var(--bg-surface); }
    .mt--noi { border-color: var(--tc); background: var(--tbg); }
    .mt-so { font-size: var(--fs-20); font-weight: 700; color: var(--tc); font-variant-numeric: tabular-nums; line-height: 1.15; }
    .mt-nhan { font-size: var(--fs-11); color: var(--text-sub); }

    /* ── donut + legend ── */
    .dn-wrap { display: grid; grid-template-columns: minmax(150px, 1fr) 1.1fr; gap: 10px; align-items: center; }
    @media (max-width: 640px) { .dn-wrap { grid-template-columns: 1fr; } }
    .dn-cap, .tbl-cap { font-size: var(--fs-12); font-weight: 600; color: var(--text-sub); }
    .dn-chart { display: flex; flex-direction: column; gap: 2px; }
    .dn-leg { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; }
    .dn-li { display: flex; align-items: center; gap: 7px; font-size: var(--fs-12); }
    .dn-dot { width: 10px; height: 10px; border-radius: 3px; flex: none; }
    .dn-name { color: var(--text-body); }
    .dn-val { color: var(--text-strong); font-variant-numeric: tabular-nums; margin-left: auto; }
    .dn-pct { color: var(--text-sub); font-variant-numeric: tabular-nums; min-width: 52px; text-align: right; }

    /* ── table ── */
    .tbl { width: 100%; border-collapse: collapse; font-size: var(--fs-12); }
    .tbl th, .tbl td { padding: 6px 8px; text-align: right; font-variant-numeric: tabular-nums;
      border-bottom: 1px solid var(--border-soft); }
    .tbl th { color: var(--text-sub); font-weight: 600; white-space: nowrap; }
    .tbl th:first-child, .tbl td.tbl-l { text-align: left; }
    .tbl td { color: var(--text-body); }
    .tbl tr.tbl-sum td { font-weight: 700; color: var(--text-strong); border-top: 1.5px solid var(--border-sub);
      border-bottom: none; background: var(--bg-surface-subtle); }

    /* ── AI banner ── */
    .ai-banner { display: flex; align-items: center; gap: 8px; text-align: left; width: 100%; font: inherit;
      font-size: var(--fs-12); color: var(--text-body); background: var(--primary-bg-subtle);
      border: 1px solid var(--primary-border, var(--border-sub)); border-radius: var(--radius-md);
      padding: 9px 11px; cursor: pointer; }
    .ai-banner tabler-icon:first-child { color: var(--primary-base); flex: none; }
    .ai-banner b { color: var(--text-strong); }
    .ai-more { margin-left: auto; display: inline-flex; align-items: center; gap: 2px; white-space: nowrap;
      font-weight: 600; color: var(--primary-base); }

    /* ── AI bullets ── */
    .bul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
    .bul-li { display: flex; align-items: flex-start; gap: 9px; font-size: var(--fs-12); color: var(--text-body); }
    .bul-ic { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; flex: none;
      border-radius: var(--radius-full, 999px); background: var(--tbg); color: var(--tc); margin-top: 1px; }
    .bul-tx b { color: var(--text-strong); }

    /* ── full-width buttons (block input lo width; margin đẩy xuống đáy panel) ── */
    .d1-wbtn { display: block; margin-top: auto; }

    /* ── pipeline ── */
    .pipe { display: flex; align-items: stretch; justify-content: space-between; gap: 4px; flex-wrap: wrap; }
    .pipe-arr { color: var(--text-soft); align-self: center; flex: none; }
    .pipe-step { display: flex; flex-direction: column; align-items: center; gap: 2px; text-align: center; flex: 1 1 0; min-width: 54px; }
    .pipe-so { display: inline-flex; align-items: center; justify-content: center; min-width: 34px; height: 34px; padding: 0 6px;
      border-radius: var(--radius-full, 999px); background: var(--tbg); color: var(--tc); font-weight: 700;
      font-size: var(--fs-14, 14px); font-variant-numeric: tabular-nums; }
    .pipe-nhan { font-size: var(--fs-11); color: var(--text-sub); line-height: 1.2; }
    .pipe-ky { margin: 4px 0 0; font-size: var(--fs-11); color: var(--text-sub); }

    /* ── bar list ── */
    .bl { display: flex; flex-direction: column; }
    .bl-head, .bl-row { display: grid; grid-template-columns: 1fr auto auto; gap: 10px; align-items: center; }
    .bl-head { font-size: var(--fs-11); color: var(--text-soft); padding: 0 0 4px; border-bottom: 1px solid var(--border-soft); }
    .bl-head span:nth-child(2) { min-width: 42px; text-align: right; }
    .bl-head span:nth-child(3) { min-width: 52px; text-align: right; }
    .bl-row { padding: 7px 0; border-bottom: 1px solid var(--border-soft); }
    .bl-main { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .bl-name { font-size: var(--fs-12); color: var(--text-body); }
    .bl-track { height: 6px; border-radius: 999px; background: var(--bg-surface-subtle); overflow: hidden; }
    .bl-fill { height: 100%; border-radius: 999px; background: var(--tc); }
    .bl-so { font-size: var(--fs-12); font-variant-numeric: tabular-nums; color: var(--text-body); min-width: 42px; text-align: right; }
    .bl-pct { font-size: var(--fs-12); font-variant-numeric: tabular-nums; color: var(--text-sub); min-width: 52px; text-align: right; }
    .bl-row.bl-sum { border-bottom: none; }
    .bl-row.bl-sum .bl-name, .bl-row.bl-sum .bl-so, .bl-row.bl-sum .bl-pct { font-weight: 700; color: var(--text-strong); }

    /* ── money block ── */
    .mny { display: flex; flex-direction: column; gap: 2px; background: var(--bg-surface-subtle);
      border: 1px solid var(--border-soft); border-radius: var(--radius-md); padding: 4px 10px; }
    .mny-row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 7px 0; }
    .mny-row + .mny-row { border-top: 1px solid var(--border-soft); }
    .mny-l { display: flex; flex-direction: column; gap: 1px; }
    .mny-nhan { font-size: var(--fs-12); color: var(--text-sub); }
    .mny-hs { font-size: var(--fs-11); color: var(--text-soft); }
    .mny-tien { font-size: var(--fs-14, 14px); font-weight: 700; color: var(--tc); font-variant-numeric: tabular-nums; white-space: nowrap; }

    /* ── đối soát cảnh báo ── */
    .ds-warn { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-12); font-weight: 600;
      color: var(--error-text); }
    .ds-warn tabler-icon { color: var(--error-base); }

    /* ── ký & nộp ── */
    .kn { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
    .kn-li { display: flex; align-items: center; gap: 9px; font-size: var(--fs-13); color: var(--text-body); }
    .kn-ic { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; flex: none;
      border-radius: var(--radius-full, 999px); background: var(--tbg); color: var(--tc); }
    .kn-tx b { font-size: var(--fs-15, 15px); color: var(--text-strong); font-variant-numeric: tabular-nums; }
  