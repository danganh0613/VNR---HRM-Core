
    :host { display: block; }

    /* §12 lưới 2 cột 7fr/3fr; ≤1000px → 1 cột. Dòng thời gian = stepper dọc trong cột phải. */
    .bh-grid {
      display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 3fr); gap: 16px; align-items: start;
    }
    @media (max-width: 1000px) { .bh-grid { grid-template-columns: 1fr; } }
    .bh-col { display: flex; flex-direction: column; gap: 16px; min-width: 0; }

    /* Card trắng — convention token DS. */
    .bh-card {
      background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: 12px; padding: 16px; min-width: 0;
    }
    .bh-card__title {
      margin: 0 0 12px; font-size: var(--fs-14); font-weight: 600; color: var(--text-strong);
    }
    .bh-card__title--flush { margin: 0; }
    .bh-strong { color: var(--text-strong); font-weight: 600; }

    /* Link phẳng (deep-link demo). */
    .bh-lnk {
      cursor: pointer; font: inherit; font-size: var(--fs-12); font-weight: 600; color: var(--primary-base);
      background: none; border: 0; padding: 0; text-decoration: none; white-space: nowrap;
    }
    .bh-lnk:hover { text-decoration: underline; }
    .bh-lnk--sm { font-size: var(--fs-11); font-weight: 500; }

    /* Chấm tròn tone. */
    .bh-dot { width: 8px; height: 8px; border-radius: 50%; flex: none; display: inline-block; }

    /* ── A · 2 cụm ngang ── */
    .bh-two { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    @media (max-width: 560px) { .bh-two { grid-template-columns: 1fr; } }
    .bh-kvs { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .bh-kv { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .bh-kv__k { font-size: var(--fs-12); color: var(--text-sub); }
    .bh-kv__v { font-size: var(--fs-14); font-weight: 500; color: var(--text-strong); }
    .bh-sts { display: flex; flex-direction: column; gap: 12px; }
    .bh-st { display: flex; align-items: center; gap: 8px; }
    .bh-st__k { font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); min-width: 48px; }
    .bh-st__v { font-size: var(--fs-13); color: var(--text-sub); }

    /* ── B · bảng cơ cấu đóng (grid 6 cột) ── */
    .bh-tblwrap { overflow-x: auto; }
    .bh-tbl {
      display: grid; grid-template-columns: 1.4fr .9fr .9fr .9fr 1.15fr 1.15fr;
      min-width: 480px; align-items: center;
    }
    .bh-tbl__h {
      font-size: var(--fs-12); color: var(--text-sub); font-weight: 500;
      padding: 0 8px 8px; border-bottom: 1px solid var(--border-sub);
    }
    .bh-tbl__c {
      font-size: var(--fs-13); color: var(--text-strong); padding: 9px 8px;
      border-bottom: 1px solid var(--border-soft);
    }
    .bh-tbl > .bh-tbl__c:nth-last-child(-n+6) { border-bottom: 0; }
    .bh-tbl__c--name { display: flex; align-items: center; gap: 8px; font-weight: 600; }
    .bh-bar { width: 3px; height: 14px; border-radius: var(--radius-full); flex: none; display: inline-block; }
    .bh-num { text-align: right; justify-self: end; font-variant-numeric: tabular-nums; }

    /* Footer bar tổng dự kiến — nền tint primary. */
    .bh-total {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      margin-top: 12px; padding: 10px 12px; border-radius: var(--radius-md);
      background: var(--primary-bg-subtle);
    }
    .bh-total__k { font-size: var(--fs-13); color: var(--text-sub); }
    .bh-total__v { font-size: var(--fs-15, 15px); font-weight: 700; color: var(--text-strong); font-variant-numeric: tabular-nums; }

    /* ── C · card muối/gradient AI ── */
    .bh-empty {
      display: flex; align-items: center; gap: 8px; padding: 12px 16px;
      background: var(--bg-surface); border: 1px dashed var(--border-sub); border-radius: 12px;
      font-size: var(--fs-13); color: var(--text-sub);
    }
    .bh-empty__ic { color: var(--success-base); flex: none; }

    /* Wrapper nâng cụm nổi + chừa chỗ đầu mascot; card gradient AI CHE thân mascot chồng lên. */
    .bh-ai-outer { position: relative; z-index: 1; overflow: visible; }
    .bh-ai {
      position: relative; z-index: 1; overflow: visible; padding: 8px;
      /* Gradient AI brand — hex sáng cố định (ngoại lệ được phép, dùng NGUYÊN màu chatbot). */
      background: linear-gradient(180deg, #E7F0FE 0%, #EDEAFB 48%, #FCE8DC 100%);
      border: 1px solid #DBD3F5; border-radius: 12px;
    }
    .bh-ai__mascot { position: absolute; top: -12px; right: 20px; z-index: 1; width: 104px; height: auto; pointer-events: none; }
    .bh-ai__head {
      position: relative; z-index: 3; display: flex; align-items: center; gap: 7px;
      padding: 2px 2px 8px 4px; font-size: var(--fs-13); color: #1E2A5A;
    }
    .bh-ai__head b { font-weight: 700; }
    .bh-ai__spark { color: #6C4FE0; flex: none; }
    /* Hộp nền trắng bọc nội dung — token surface (đọc được cả 2 theme). */
    .bh-ai__body {
      position: relative; z-index: 3; display: flex; flex-direction: column; gap: 8px;
      background: var(--bg-surface); border-radius: 10px; padding: 12px 14px;
    }
    .bh-ai__heading { font-size: var(--fs-14); font-weight: 700; color: var(--text-strong); }
    .bh-ai__desc { margin: 0; font-size: var(--fs-13); color: var(--text-body); line-height: 1.45; }
    .bh-ai__eff { font-size: var(--fs-12); color: var(--text-sub); }
    .bh-ai__chips { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
    .bh-ai__cta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 2px; }
    .bh-ai__more { font-size: var(--fs-12); color: var(--text-sub); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

    /* ── D · nguồn dữ liệu ── */
    .bh-srcs { display: flex; flex-direction: column; gap: 10px; }
    .bh-src { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .bh-src__ic {
      display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; flex: none;
      border-radius: var(--radius-md); background: var(--bg-surface-subtle); color: var(--text-sub);
    }
    .bh-src__main { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1 1 auto; }
    .bh-src__name { font-size: var(--fs-13); font-weight: 500; color: var(--text-strong); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bh-src__meta { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; flex: none; }
    .bh-src__st { display: inline-flex; align-items: center; gap: 5px; font-size: var(--fs-12); color: var(--text-sub); white-space: nowrap; }
    .bh-src__time { font-size: var(--fs-11); color: var(--text-soft); }
    .bh-src__foot {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border-sub);
    }
    .bh-ring { width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; flex: none; }
    .bh-ring__hole {
      width: 34px; height: 34px; border-radius: 50%; background: var(--bg-surface); display: grid; place-items: center;
      font-size: var(--fs-11); font-weight: 700; color: var(--text-strong);
    }
    .bh-src__complete { font-size: var(--fs-13); font-weight: 500; color: var(--text-strong); }
    .bh-src__evidence { margin-left: auto; }

    /* ── E · conflict ── */
    .bh-conflict { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
    .bh-conflict hrm-alert { display: block; width: 100%; }

    /* ── F · người phụ trách ── */
    .bh-owner { display: flex; align-items: center; gap: 10px; }
    .bh-owner__id { display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; min-width: 0; }
    .bh-owner__name { font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); }
    .bh-owner__role { font-size: var(--fs-13); color: var(--text-sub); }
    .bh-owner__sla { display: flex; align-items: center; gap: 6px; margin-top: 12px; color: var(--warning-text); }

    /* ── G · Dòng thời gian bảo hiểm — stepper DỌC (hrm-steps) ── */
    .bh-timeline__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
    .bh-steps { display: block; }
    /* nz-steps dọc: siết cỡ chữ theo token DS — title đậm + description phụ (thay đổi · nguồn). */
    .bh-steps ::ng-deep .ant-steps-item-title { font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); line-height: 1.4; }
    .bh-steps ::ng-deep .ant-steps-item-description { font-size: var(--fs-12); color: var(--text-sub); font-variant-numeric: tabular-nums; padding-bottom: 12px; }
    .bh-steps ::ng-deep .ant-steps-item:last-child .ant-steps-item-description { padding-bottom: 0; }
    .bh-steps ::ng-deep .ant-steps-item-tail::after { background: var(--border-sub); }

    /* ── §6 Verify — chuỗi căn cứ (lineage) dọc, nối mũi tên ↓ ── */
    .bh-lineage {
      display: flex; flex-direction: column; margin-top: 4px; padding: 10px 12px;
      background: var(--bg-canvas); border-radius: var(--radius-md);
    }
    .bh-lineage__node {
      padding: 6px 8px; border-radius: var(--radius-sm, 6px);
      border: 1px solid var(--border-soft); background: var(--bg-surface);
    }
    .bh-lineage__node--warn { border-color: var(--warning-base); }
    .bh-lineage__row { display: flex; align-items: center; gap: 8px; }
    .bh-lineage__name { font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); flex: 1 1 auto; min-width: 0; }
    .bh-lineage__val { font-size: var(--fs-13); color: var(--text-sub); font-variant-numeric: tabular-nums; }
    .bh-lineage__ok { color: var(--success-base); font-size: var(--fs-13); flex: none; }
    .bh-lineage__warn { color: var(--warning-base); font-size: var(--fs-13); flex: none; }
    .bh-lineage__note { margin-top: 3px; font-size: var(--fs-12); color: var(--warning-text, var(--warning-base)); }
    .bh-lineage__arrow { text-align: center; font-size: var(--fs-13); color: var(--text-soft); line-height: 1.1; padding: 1px 0; }

    /* ── §7,22 Nhất quán giá trị (tách khỏi completeness) ── */
    .bh-consistency { margin-top: 10px; }
    .bh-consistency__line { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: var(--fs-12); }
    .bh-consistency__line--warn { color: var(--warning-text, var(--warning-base)); }
    .bh-consistency__line--ok { color: var(--success-base); }
    .bh-cfpanel {
      margin-top: 8px; padding: 10px 12px; background: var(--bg-canvas);
      border-radius: var(--radius-md); display: flex; flex-direction: column; gap: 8px;
    }
    .bh-cftbl { display: grid; grid-template-columns: 1fr auto; gap: 5px 12px; align-items: center; }
    .bh-cftbl__h { font-size: var(--fs-12); color: var(--text-sub); font-weight: 500; padding-bottom: 3px; border-bottom: 1px solid var(--border-sub); }
    .bh-cftbl__c { font-size: var(--fs-13); color: var(--text-strong); }
    .bh-cftbl__c--bad { color: var(--error-base); }
    .bh-cfpanel__ai { font-size: var(--fs-12); color: var(--text-body); line-height: 1.45; }
    .bh-cfpanel__act {
      align-self: flex-start; cursor: pointer; font: inherit; font-size: var(--fs-12); font-weight: 600;
      color: var(--primary-base); background: var(--bg-surface);
      border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 4px 10px;
    }
    .bh-cfpanel__act:hover { border-color: var(--primary-base); }

    /* ── §18 Audit trail (Xem lịch sử xử lý) ── */
    .bh-timeline__links { display: flex; align-items: center; gap: 12px; }
    .bh-audit {
      margin-top: 12px; padding: 12px; background: var(--bg-canvas);
      border-radius: var(--radius-md); display: flex; flex-direction: column; gap: 10px;
    }
    .bh-audit__title { font-size: var(--fs-12); font-weight: 600; color: var(--text-sub); }
    .bh-audit__row { display: flex; gap: 8px; align-items: flex-start; }
    .bh-audit__row .bh-dot { margin-top: 5px; }
    .bh-audit__main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .bh-audit__top { display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
    .bh-audit__time { font-size: var(--fs-12); color: var(--text-sub); font-variant-numeric: tabular-nums; font-family: var(--font-mono, ui-monospace, monospace); }
    .bh-audit__actor { font-size: var(--fs-13); font-weight: 700; color: var(--text-strong); }
    .bh-audit__action { font-size: var(--fs-13); color: var(--text-body); }
    .bh-audit__detail { font-size: var(--fs-12); color: var(--text-sub); line-height: 1.4; }
  