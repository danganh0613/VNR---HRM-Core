
    :host { display: inline-flex; align-items: center; gap: 7px; }
    .sl-tx {
      font-size: var(--fs-11); font-weight: 700; letter-spacing: .05em;
      text-transform: uppercase; line-height: 1.4;
    }
    :host([data-tone='critical']) .sl-tx { color: var(--error-base); }
    :host([data-tone='attention']) .sl-tx { color: var(--warning-base); }
    :host([data-tone='ontrack']) .sl-tx { color: var(--success-base); }
    :host([data-tone='muted']) .sl-tx { color: var(--text-sub); }
    .sl-count {
      font-size: var(--fs-11); font-weight: 600; color: var(--text-sub);
      background: var(--bg-surface-subtle); border-radius: var(--radius-full);
      padding: 0 7px; line-height: 1.6;
    }
  