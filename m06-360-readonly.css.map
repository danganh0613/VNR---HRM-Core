
    :host { display: flex; flex-direction: column; gap: 10px; max-width: 940px; }
    .bd-list { display: flex; flex-direction: column; gap: 6px; }
    .bd-row { display: flex; gap: 10px; align-items: flex-start; border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); padding: 8px 12px; }
    .bd-row--warn { border-color: var(--warning-base, var(--warning-text)); background: var(--warning-bg); }
    .bd-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .bd-strong { color: var(--text-strong); font-weight: 500; }
    .bd-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .bd-muted b { color: var(--text-strong); }
    .bd-mono { font-family: var(--font-mono, monospace); }
    .bd-canbs { color: var(--warning-text); font-weight: 700; }
  