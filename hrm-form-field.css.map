
:host { display: block; margin-bottom: var(--space-4); }
.ff-label { display: block; margin-bottom: var(--space-1-5); font-size: var(--fs-14); font-weight: 500; color: var(--text-strong); }
.ff-req { color: var(--error-base); margin-left: 2px; }
.ff-opt { margin-left: var(--space-1-5); font-size: var(--fs-12); font-weight: 400; color: var(--text-sub); }
.ff-error { margin-top: var(--space-1); font-size: var(--fs-12); color: var(--error-base); }
.ff-help { margin-top: var(--space-1); font-size: var(--fs-12); color: var(--text-sub); }
  