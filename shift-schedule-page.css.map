
    .lp-desktop { position: relative; height: 760px; border: 1px solid var(--border-sub); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-regular-sm); }
    .lp-desktop--full { position: relative; height: 100vh; border: 0; border-radius: 0; box-shadow: none; }
    .lp-full { margin-top: 14px; } .lp-full-link { text-decoration: none; }
    .lp-desktop ::ng-deep .shell-content { padding: 0; }

    .ssh-scroll { height: 100%; overflow-y: auto; background: var(--bg-canvas, var(--bg-surface-subtle)); }
    .sch-page { max-width: 1440px; margin: 0 auto; padding: var(--space-5, 20px) var(--space-6, 24px) var(--space-10, 40px); }

    .sch-head { margin-bottom: var(--space-3, 12px); }
    .sch-eyebrow { margin: 0 0 2px; font-size: var(--fs-12, 12px); font-weight: var(--font-medium, 500); color: var(--text-soft); }
    .sch-h1 { margin: 0; font-size: var(--fs-22, 22px); font-weight: var(--font-bold, 700); color: var(--text-strong); letter-spacing: -.01em; }

    /* Toolbar */
    .sch-panel { background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-xl); overflow: hidden; }
    .sch-toolbar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3, 12px); padding: var(--space-2-5, 10px) var(--space-3-5, 14px); border-bottom: 1px solid var(--border-sub); flex-wrap: wrap; }
    .tb-left, .tb-right { display: flex; align-items: center; gap: var(--space-2, 8px); flex-wrap: wrap; }
    .tb-ico { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub); }
    .tb-ico:hover { color: var(--text-strong); background: var(--bg-surface-subtle); }
    .tb-ico--danger:hover { color: var(--error-base); border-color: var(--error-base); }
    .sch-nav { display: flex; align-items: center; gap: 6px; }
    .sch-today { padding: 6px 12px; border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md); font-size: var(--fs-13, 13px); font-weight: var(--font-medium, 500); color: var(--text-strong); cursor: pointer; }
    .sch-today:hover { background: var(--bg-surface-subtle); border-color: var(--primary-base); color: var(--primary-base); }
    .sch-period { font-size: var(--fs-14, 14px); font-weight: var(--font-semibold, 600); color: var(--text-strong); margin-left: 4px; white-space: nowrap; }

    /* Scheduler grid */
    .sch-wrap { overflow-x: auto; }
    .sch-grid { width: max-content; min-width: 100%; --cols: 220px repeat(7, minmax(158px, 1fr)); }
    .band { display: grid; grid-template-columns: var(--cols); }
    .band > :first-child { position: sticky; left: 0; z-index: 2; border-right: 1px solid var(--border-sub); }
    .band > :nth-child(2) { border-left: 0; }

    /* Coverage header */
    .cov-head { background: var(--bg-surface-subtle); border-bottom: 1px solid var(--border-sub); align-items: center; }
    .cov-head > :first-child { background: var(--bg-surface-subtle); }
    .cov-eyebrow { padding: var(--space-2-5, 10px) var(--space-3, 12px); font-size: var(--fs-11, 11px); font-weight: var(--font-bold, 700); letter-spacing: .05em; color: var(--text-soft); text-transform: uppercase; }
    .cov-stats { grid-column: 2 / -1; justify-self: end; display: flex; align-items: center; gap: var(--space-4, 16px); padding: var(--space-2, 8px) var(--space-3-5, 14px); flex-wrap: wrap; }
    .cov-stat { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-12, 12px); font-weight: var(--font-semibold, 600); color: var(--text-sub); }
    .dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }
    .dot--early { background: var(--data-7); } .dot--late { background: var(--data-1); }

    /* Coverage cells */
    .cov-cells { border-bottom: 1px solid var(--border-sub); }
    .cov-views { padding: var(--space-3, 12px); background: var(--bg-surface); display: flex; align-items: flex-start; }
    .cov-day { padding: var(--space-2, 8px); display: flex; flex-direction: column; gap: var(--space-2, 8px); border-left: 1px solid var(--border-sub); }
    .cov-drag { cursor: grab; border-radius: var(--radius-md); }
    .cov-drag:active { cursor: grabbing; }
    .cov-drag.cdk-drag-preview { box-shadow: var(--shadow-regular-md); }
    .cov-drag.cdk-drag-placeholder { opacity: .4; }

    /* Coverage totals */
    .cov-foot { background: var(--bg-surface-subtle); border-bottom: 1px solid var(--border-sub); }
    .cov-foot > :first-child { background: var(--bg-surface-subtle); }
    .cov-fday { padding: var(--space-2, 7px) var(--space-2-5, 10px); display: flex; align-items: center; gap: 6px; border-left: 1px solid var(--border-sub); font-size: var(--fs-12, 12px); color: var(--text-sub); font-variant-numeric: tabular-nums; }
    .cov-fday .heads { margin-left: auto; display: inline-flex; align-items: center; gap: 4px; }

    /* Day header */
    .day-head { background: var(--bg-surface); border-bottom: 1px solid var(--border-sub); }
    .day-head > :first-child { background: var(--bg-surface); }
    .day-lead { padding: var(--space-2-5, 10px) var(--space-3, 12px); font-size: var(--fs-11, 11px); font-weight: var(--font-bold, 700); letter-spacing: .05em; color: var(--text-soft); text-transform: uppercase; display: flex; align-items: center; }
    .sch-dh { padding: var(--space-2, 8px) var(--space-2-5, 10px); border-left: 1px solid var(--border-sub); display: flex; align-items: baseline; gap: 6px; }
    .sch-dow { font-size: var(--fs-12, 12px); font-weight: var(--font-bold, 700); color: var(--text-strong); }
    .sch-date { font-size: var(--fs-12, 12px); color: var(--text-soft); }

    /* Employee rows */
    .emp-row { border-bottom: 1px solid var(--border-sub); }
    .emp-row:last-child { border-bottom: 0; }
    .emp-info { padding: var(--space-2-5, 10px) var(--space-3, 12px); display: flex; align-items: center; gap: 10px; background: var(--bg-surface); }
    .emp-row:hover .emp-info { background: var(--bg-surface-subtle); }
    .emp-meta { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .emp-name { font-size: var(--fs-13, 13px); font-weight: var(--font-semibold, 600); color: var(--text-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .emp-hrs { font-size: var(--fs-12, 12px); color: var(--text-soft); }
    .emp-x { flex: none; display: grid; place-items: center; width: 26px; height: 26px; border: 0; background: transparent; border-radius: var(--radius-md); color: var(--text-soft); cursor: pointer; opacity: 0; transition: opacity .12s; }
    .emp-row:hover .emp-x { opacity: 1; }
    .emp-x:hover { color: var(--error-base); background: color-mix(in srgb, var(--error-base) 12%, transparent); }

    .sch-cell { padding: var(--space-2, 8px); border-left: 1px solid var(--border-sub); min-height: 66px; display: flex; }
    .sch-card { flex: 1; display: flex; cursor: grab; border-radius: var(--radius-md); }
    .sch-card:active { cursor: grabbing; }
    .sch-card hrm-shift-cell { flex: 1; }
    .sch-empty { flex: 1; border: 1px dashed transparent; border-radius: var(--radius-md); background: transparent; cursor: pointer; display: grid; place-items: center; color: var(--text-soft); opacity: 0; transition: opacity .12s; }
    .sch-cell:hover .sch-empty { opacity: 1; border-color: var(--border-sub); }
    .sch-empty:hover { color: var(--primary-base); border-color: var(--primary-base); background: var(--primary-bg-subtle); }

    /* CDK drag-drop */
    .sch-card.cdk-drag-preview { box-shadow: var(--shadow-regular-md); }
    .sch-card.cdk-drag-placeholder { opacity: 0; }
    .cdk-drop-list-dragging .sch-card:not(.cdk-drag-placeholder) { transition: transform var(--duration-normal, .18s) var(--ease-out, ease); }
    .sch-cell.cdk-drop-list-receiving, .sch-cell.cdk-drop-list-dragging { background: var(--primary-bg-subtle); }
    .cdk-drag-animating { transition: transform var(--duration-normal, .2s) var(--ease-out, ease); }

    .sch-add { margin-top: var(--space-3, 12px); display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1px dashed var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-lg); color: var(--text-sub); font-size: var(--fs-13, 13px); font-weight: var(--font-medium, 500); cursor: pointer; }
    .sch-add:hover { color: var(--primary-base); border-color: var(--primary-base); }

    /* Nút điều hướng tuần ‹ › */
    .dy-nav { display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub); }
    .dy-nav:hover { color: var(--text-strong); background: var(--bg-surface-subtle); }

    /* Picker popover */
    .pk-backdrop { position: fixed; inset: 0; z-index: 40; }
    .pk { position: fixed; z-index: 41; min-width: 214px; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg); box-shadow: var(--shadow-regular-lg); padding: 6px; }
    .pk-h { padding: 6px 8px 4px; font-size: var(--fs-11, 11px); font-weight: var(--font-bold, 700); letter-spacing: .04em; text-transform: uppercase; color: var(--text-soft); }
    .pk-item { display: flex; align-items: center; gap: 9px; width: 100%; padding: 7px 8px; border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer; font-size: var(--fs-13, 13px); color: var(--text-strong); text-align: left; }
    .pk-item:hover { background: var(--bg-surface-subtle); }
    .pk-dot { width: 10px; height: 10px; border-radius: 50%; flex: none; }
    .pk-sep { height: 1px; background: var(--border-sub); margin: 4px 6px; }
    .pk-del { color: var(--error-base); gap: 7px; }
    .pk-del:hover { background: color-mix(in srgb, var(--error-base) 10%, transparent); }
    .pkd-opening { background: var(--data-7); } .pkd-afternoon { background: var(--data-1); }
    .pkd-night { background: var(--data-3); } .pkd-admin { background: var(--data-4); }
    .pkd-rest { background: var(--data-5); } .pkd-holiday { background: var(--data-8); }
    .pkd-absence { background: var(--warning-base); }
  