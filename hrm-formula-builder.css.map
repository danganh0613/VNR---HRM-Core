
.fb-ov { position: fixed; inset: 0; z-index: 1200; display: grid; place-items: center; padding: var(--space-6, 24px); }
.fb-bd { position: absolute; inset: 0; background: var(--overlay); }
.fb-dlg { position: relative; width: 100%; max-width: 1000px; max-height: 88vh; display: flex; flex-direction: column;
  background: var(--bg-surface, #fff); border: 1px solid var(--border-sub); border-radius: var(--radius-lg, 10px);
  box-shadow: var(--shadow-regular-lg, 0 12px 32px rgba(0,0,0,.18)); font-family: var(--font-sans); overflow: hidden; }

.fb-hd { display: flex; align-items: flex-start; gap: var(--space-3, 12px); padding: var(--space-4, 16px) var(--space-5, 20px);
  border-bottom: 1px solid var(--border-soft); }
.fb-hd-tt { display: flex; flex-direction: column; gap: 2px; }
.fb-hd-title { font-size: var(--fs-16, 16px); font-weight: var(--font-semibold, 600); color: var(--text-strong); }
.fb-hd-sub { font-size: var(--fs-12, 12px); color: var(--text-sub); }
.fb-x { margin-inline-start: auto; flex: none; display: grid; place-items: center; width: 32px; height: 32px; border: 0;
  background: transparent; border-radius: var(--radius-md, 8px); color: var(--text-soft); cursor: pointer; }
.fb-x:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }

.fb-body { flex: 1; min-height: 0; display: grid; grid-template-columns: 224px minmax(0, 1fr) 288px; }
.fb-col { display: flex; flex-direction: column; min-height: 0; min-width: 0; }
.fb-col + .fb-col { border-inline-start: 1px solid var(--border-soft); }
.fb-col-hd { padding: var(--space-3, 12px) var(--space-4, 16px) var(--space-2, 8px); font-size: var(--fs-11, 11px);
  font-weight: var(--font-semibold, 600); letter-spacing: .04em; text-transform: uppercase; color: var(--text-soft); }

.fb-search { position: relative; margin: 0 var(--space-3, 12px) var(--space-2, 8px); }
.fb-search-ic { position: absolute; inset-inline-start: 9px; top: 50%; transform: translateY(-50%); color: var(--text-soft); pointer-events: none; }
.fb-search input { width: 100%; height: 34px; padding: 0 10px 0 30px; border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px);
  background: var(--bg-surface); color: var(--text-body); font: inherit; font-size: var(--fs-13, 13px); }
.fb-search input:focus-visible { outline: 2px solid var(--primary-base); outline-offset: 1px; border-color: var(--primary-base); }

.fb-list { flex: 1; overflow-y: auto; padding: 0 var(--space-3, 12px) var(--space-3, 12px); display: flex; flex-direction: column; gap: 2px; }

.fb-field { display: flex; align-items: center; gap: 8px; width: 100%; text-align: start; padding: 7px 10px; border: 0;
  background: transparent; border-radius: var(--radius-sm, 6px); cursor: pointer; color: var(--text-body); }
.fb-field:hover { background: var(--bg-surface-subtle); }
.fb-field-name { flex: 1; min-width: 0; font-size: var(--fs-13, 13px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fb-field-type { flex: none; font-size: var(--fs-10, 10px); color: var(--text-soft); text-transform: uppercase; letter-spacing: .03em; }
.fb-none { padding: var(--space-4, 16px) var(--space-3, 12px); font-size: var(--fs-12, 12px); color: var(--text-soft); text-align: center; }

.fb-mid { min-height: 0; padding-bottom: var(--space-3, 12px); }
.fb-ed { flex: 1; min-height: 180px; margin: 0 var(--space-4, 16px); padding: var(--space-3, 12px); resize: none;
  border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px); background: var(--bg-surface); color: var(--text-strong);
  font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); font-size: var(--fs-14, 14px); line-height: 1.6; }
.fb-ed:focus-visible { outline: 2px solid var(--primary-base); outline-offset: 1px; border-color: var(--primary-base); }
.fb-ed::placeholder { color: var(--text-soft); }

.fb-status { margin: var(--space-3, 12px) var(--space-4, 16px) 0; min-height: 22px; display: flex; align-items: center;
  gap: var(--space-3, 12px); flex-wrap: wrap; font-size: var(--fs-12, 12px); }
.fb-hint { color: var(--text-soft); }
.fb-ok { display: inline-flex; align-items: center; gap: 5px; color: var(--success-base); font-weight: var(--font-medium, 500); }
.fb-sample { color: var(--text-sub); }
.fb-sample b { color: var(--text-strong); font-weight: var(--font-semibold, 600); }
.fb-err { display: inline-flex; align-items: center; gap: 5px; color: var(--error-base); }

.fb-ai { margin: var(--space-3, 12px) var(--space-4, 16px) 0; }
.fb-ai-toggle { display: inline-flex; align-items: center; gap: 6px; padding: 6px 8px; border: 0; background: transparent;
  border-radius: var(--radius-sm, 6px); color: var(--primary-base); font: inherit; font-size: var(--fs-13, 13px);
  font-weight: var(--font-medium, 500); cursor: pointer; }
.fb-ai-toggle:hover { background: var(--primary-bg-subtle); }
.fb-ai-panel { margin-top: var(--space-2, 8px); display: flex; flex-direction: column; gap: var(--space-2, 8px); }
.fb-ai-input { min-height: 60px; padding: var(--space-3, 12px); resize: vertical; border: 1px solid var(--border-sub);
  border-radius: var(--radius-md, 8px); background: var(--bg-surface-subtle); color: var(--text-body); font: inherit; font-size: var(--fs-13, 13px); }
.fb-ai-input:focus-visible { outline: 2px solid var(--primary-base); outline-offset: 1px; border-color: var(--primary-base); background: var(--bg-surface); }
.fb-ai-go { align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 14px;
  border: 1px solid var(--primary-base); border-radius: var(--radius-md, 8px); background: var(--primary-bg-subtle); color: var(--primary-base);
  font: inherit; font-size: var(--fs-13, 13px); font-weight: var(--font-medium, 500); cursor: pointer; }
.fb-ai-go:hover:not(:disabled) { background: var(--primary-base); color: var(--text-on-primary, #fff); }
.fb-ai-go:disabled { opacity: .5; cursor: not-allowed; }

.fb-grp { display: flex; flex-direction: column; }
.fb-grp-hd { display: flex; align-items: center; gap: 6px; width: 100%; text-align: start; padding: 7px 10px; border: 0;
  background: transparent; cursor: pointer; color: var(--text-body); font: inherit; font-size: var(--fs-12, 12px); font-weight: var(--font-semibold, 600); }
.fb-grp-hd:hover { color: var(--text-strong); }
.fb-grp-hd tabler-icon { color: var(--text-soft); }
.fb-ops { display: flex; flex-wrap: wrap; gap: 6px; padding: 2px 10px 10px; }
.fb-op { width: 38px; height: 34px; display: grid; place-items: center; border: 1px solid var(--border-sub); border-radius: var(--radius-sm, 6px);
  background: var(--bg-surface); color: var(--text-body); font-size: var(--fs-15, 15px); cursor: pointer; }
.fb-op:hover { border-color: var(--primary-base); color: var(--primary-base); background: var(--primary-bg-subtle); }
.fb-fn { display: flex; flex-direction: column; gap: 1px; width: 100%; text-align: start; padding: 6px 10px; border: 0;
  background: transparent; border-radius: var(--radius-sm, 6px); cursor: pointer; }
.fb-fn:hover { background: var(--bg-surface-subtle); }
.fb-fn-name { font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); font-size: var(--fs-12, 12px);
  font-weight: var(--font-medium, 500); color: var(--text-strong); }
.fb-fn-desc { font-size: var(--fs-11, 11px); color: var(--text-soft); }

.fb-ft { display: flex; align-items: center; gap: var(--space-2, 8px); padding: var(--space-3, 12px) var(--space-5, 20px);
  border-top: 1px solid var(--border-soft); }
.fb-ft-sp { flex: 1; }
.fb-btn { height: 36px; padding: 0 16px; border: 1px solid var(--border-sub); border-radius: var(--radius-md, 8px);
  background: var(--bg-surface); color: var(--text-body); font: inherit; font-size: var(--fs-14, 14px); cursor: pointer; }
.fb-btn:hover { background: var(--bg-surface-subtle); }
.fb-btn.is-primary { background: var(--primary-base); color: var(--text-on-primary, #fff); border-color: var(--primary-base); }
.fb-btn.is-primary:hover { background: var(--primary-strong, var(--primary-base)); }
.fb-btn:focus-visible, .fb-x:focus-visible, .fb-field:focus-visible, .fb-op:focus-visible, .fb-fn:focus-visible,
.fb-grp-hd:focus-visible, .fb-ai-toggle:focus-visible, .fb-ai-go:focus-visible { outline: 2px solid var(--primary-base); outline-offset: 1px; }
  