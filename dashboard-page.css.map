
    .lp-desktop { position: relative; height: 760px; border: 1px solid var(--border-sub); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-regular-sm); }
    .lp-desktop--full { position: relative; height: 100vh; border: 0; border-radius: 0; box-shadow: none; }
    .lp-full { margin-top: 14px; } .lp-full-link { text-decoration: none; }
    .lp-desktop ::ng-deep .shell-content { padding: 0; }

    .dsh-scroll { height: 100%; overflow-y: auto; background: var(--bg-canvas, var(--bg-surface-subtle)); }
    .dsh-page { max-width: 1240px; margin: 0 auto; padding: var(--space-6, 24px) var(--space-6, 24px) var(--space-10, 40px); display: flex; flex-direction: column; gap: var(--space-4, 16px); }

    .dsh-head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4, 16px); flex-wrap: wrap; }
    .dsh-h1 { margin: 0; font-size: var(--fs-24, 24px); font-weight: var(--font-bold, 700); color: var(--text-strong); letter-spacing: -.01em; }
    .dsh-hsub { margin: var(--space-1, 4px) 0 0; font-size: var(--fs-13, 13px); color: var(--text-sub); }
    .dsh-head-r { display: flex; align-items: center; gap: var(--space-2, 8px); flex-wrap: wrap; }

    .dsh-kpi { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-3, 12px); }
    @media (max-width: 900px) { .dsh-kpi { grid-template-columns: repeat(2, 1fr); } }

    .dsh-grid { display: grid; gap: var(--space-3, 12px); }
    .dsh-grid--2 { grid-template-columns: 1fr 1fr; }
    .dsh-grid--2a { grid-template-columns: 1.6fr 1fr; }
    .dsh-grid--3 { grid-template-columns: 1.1fr 1fr 0.9fr; }
    @media (max-width: 980px) { .dsh-grid--2, .dsh-grid--2a, .dsh-grid--3 { grid-template-columns: 1fr; } }

    .dsh-card { background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-xl); padding: var(--space-4, 16px); min-width: 0; }
    .dsh-card--center { display: flex; flex-direction: column; }
    .dsh-card-h { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2, 8px); margin-bottom: var(--space-2, 8px); }
    .dsh-card-t { font-size: var(--fs-14, 14px); font-weight: var(--font-semibold, 600); color: var(--text-strong); }
    :host ::ng-deep .ant-tag { margin: 0; }
    .dsh-more { display: inline-flex; align-items: center; gap: 2px; font-size: var(--fs-12, 12px); font-weight: var(--font-medium, 500); color: var(--primary-base); cursor: pointer; text-decoration: none; }
    .dsh-more:hover { text-decoration: underline; }
  