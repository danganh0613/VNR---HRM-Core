
:host { display: inline-flex; align-items: center; }
.ag-item + .ag-item { margin-left: -10px; }
:host(.hrm-avatar-group--compact) .ag-item + .ag-item { margin-left: -8px; }
/* Vòng viền màu nền quanh mỗi avatar để tách lớp khi chồng mép. */
.ag-item ::ng-deep .ant-avatar { box-shadow: 0 0 0 2px var(--bg-surface); }
.ag-more ::ng-deep .ant-avatar { background: var(--bg-surface-subtle); color: var(--text-sub); }
  