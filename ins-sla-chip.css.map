
    :host {
      display: inline-flex; align-items: center; white-space: nowrap;
      font-size: var(--fs-11); line-height: 1.4; font-weight: 500;
      padding: 1px 9px; border-radius: var(--radius-full);
    }
    :host([data-tone='ok']) { background: var(--success-bg); color: var(--success-text); }
    :host([data-tone='warn']) { background: var(--warning-bg); color: var(--warning-text); }
    :host([data-tone='danger']) { background: var(--error-bg); color: var(--error-text); }
    :host([data-tone='muted']) { background: var(--bg-surface-subtle); color: var(--text-sub); }
  