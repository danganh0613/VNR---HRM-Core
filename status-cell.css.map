
    .col { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
    /* Bảng trạng thái hệ thống: mỗi hàng = chip trạng thái + cụm nút hành động. */
    .wf { display: flex; flex-direction: column; gap: var(--space-3); }
    .wf-row { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
    .wf-st { flex: none; width: 160px; }
    .wf-end { font-size: var(--fs-12); color: var(--text-sub); font-style: italic; }
    .wf-log { margin-top: var(--space-3); font-size: var(--fs-13); color: var(--text-sub); }
    .wf-log code { color: var(--primary-base); font-weight: 600; }
  