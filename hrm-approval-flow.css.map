
    /* container NÊN có TÊN (hrm-af) → @container đổi bố cục theo BỀ RỘNG của CHÍNH component (không
       phụ thuộc container cha ngoài). Hẹp = timeline dọc · ≥400px = stepper ngang. */
    :host { display: block; container: hrm-af / inline-size; }
    .af { display: flex; flex-direction: column; }

    /* ===== HẸP (mặc định): TIMELINE DỌC — node trái, thân phải, đường nối dọc ===== */
    .af-step { position: relative; display: flex; gap: 12px; padding-bottom: 18px; }
    .af-step:last-child { padding-bottom: 0; }

    .af-node {
      position: relative; z-index: 1; flex: none;
      display: grid; place-items: center; width: 24px; height: 24px;
      border-radius: var(--radius-full); font-size: var(--fs-12); font-weight: 600;
      background: var(--bg-surface-subtle); color: var(--text-sub); border: 1.5px solid transparent;
    }
    /* Đường nối tới bước kế — dọc (canh tâm node). Xanh khi bước này đã duyệt. */
    .af-step:not(:last-child)::after {
      content: ''; position: absolute; z-index: 0; background: var(--border-sub); border-radius: var(--radius-full);
      left: 11px; top: 28px; bottom: 6px; width: 2px;
    }
    .af-step[data-state='approved'] .af-node { background: var(--bg-surface); border-color: var(--primary-base); color: var(--primary-base); }
    .af-step[data-state='approved']:not(:last-child)::after { background: var(--primary-base); }

    /* Bước ĐANG CHỜ: chấm solid brand + vòng nét đứt xoay. */
    .af-step[data-state='current'] .af-node { background: var(--primary-base); border-color: var(--primary-base); color: var(--static-white, #fff); }
    .af-step[data-state='current'] .af-node::before {
      content: ''; position: absolute; inset: -5px; border-radius: var(--radius-full);
      border: 1.5px dashed var(--primary-base); animation: hrm-af-spin 6s linear infinite;
    }
    @keyframes hrm-af-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { .af-step[data-state='current'] .af-node::before { animation: none; } }
    .af-step[data-state='rejected'] .af-node { background: var(--error-base); border-color: var(--error-base); color: var(--static-white, #fff); }

    /* Thân bước — cột: HEAD (title nhỏ + STATUS pill cùng dòng) rồi người duyệt (avatar trái + tên +
       subtext). Timeline: status đẩy PHẢI (margin-left:auto). Stepper: status kế title (override dưới). */
    .af-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
    .af-head { display: flex; align-items: center; gap: var(--space-2, 8px); min-width: 0; }
    .af-title { font-size: var(--fs-11); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--text-soft); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .af-status { margin-left: auto; flex: none; }
    .af-person { display: flex; align-items: flex-start; gap: 10px; min-width: 0; margin-top: 2px; }
    .af-who { flex: 1; min-width: 0; }
    .af-name { font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .af-role { margin-top: 1px; font-size: var(--fs-12); color: var(--text-sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .af-time { margin-top: 1px; font-size: var(--fs-12); color: var(--text-soft); font-variant-numeric: tabular-nums; }
    .af-more {
      align-self: flex-start; margin: 8px 0 0 36px; padding: 0; border: 0; background: transparent;
      cursor: pointer; font: inherit; font-size: var(--fs-13); font-weight: 500; color: var(--primary-base);
    }
    .af-more:hover { text-decoration: underline; }

    /* ===== RỘNG (≥400px): STEPPER NGANG — node trên · title · người duyệt · STATUS pill DƯỚI CÙNG (theo ảnh mẫu) ===== */
    @container hrm-af (min-width: 400px) {
      .af { flex-direction: row; align-items: flex-start; }
      /* Node trên · nội dung CANH TRÁI theo điểm node; STATUS pill KẾ BÊN title (cùng dòng head). */
      .af-step { flex: 1 1 0; min-width: 0; flex-direction: column; align-items: flex-start; text-align: left; gap: 10px; padding-bottom: 0; }
      .af-step:not(:last-child)::after { left: 12px; right: auto; top: 11px; bottom: auto; width: 100%; height: 2px; }
      .af-body { align-items: flex-start; gap: 6px; width: 100%; }
      .af-head { justify-content: flex-start; }
      .af-title { line-height: 1.3; white-space: normal; }
      .af-status { margin-left: 0; }
      .af-person { justify-content: flex-start; max-width: 100%; }
      .af-who { flex: 0 1 auto; min-width: 0; }
      .af-name, .af-role, .af-time { white-space: normal; }
      .af-more { align-self: flex-start; margin: 0; }
    }
  