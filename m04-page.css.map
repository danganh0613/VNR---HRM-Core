
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; padding: 0 20px; }

    .m04-head { flex: none; }
    .m04-head__row { display: flex; align-items: baseline; gap: 10px; padding: 10px 0 8px; }
    .m04-head__title { margin: 0; font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); }
    .m04-head__sub { font-size: var(--fs-12); color: var(--text-sub); }

    .m04-master { display: grid; grid-template-columns: repeat(3, minmax(240px, 1fr)); gap: 10px; }
    .m04-ky {
      display: flex; flex-direction: column; gap: 4px; text-align: left; cursor: pointer; font: inherit;
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface);
      padding: 10px 14px;
    }
    .m04-ky:hover { border-color: var(--primary-base); }
    .m04-ky--active { border-color: var(--primary-base); box-shadow: 0 0 0 1px var(--primary-base); }
    .m04-ky__row { display: flex; align-items: center; gap: 8px; }
    .m04-ky__label { color: var(--text-strong); font-size: var(--fs-13); }
    .m04-ky__meta { font-size: var(--fs-11); color: var(--text-soft); }
    .m04-ky__life { font-size: var(--fs-11); color: var(--text-sub); }
    .m04-ky__acts { display: flex; gap: 8px; margin-top: 4px; }
    .m04-ky__reason { font-size: var(--fs-11); color: var(--warning-text); }
    .m04-ky__link { color: var(--primary-base); font-weight: 600; cursor: pointer; }

    .m04-lockbanner { display: block; margin-top: 8px; }

    .m04-tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--border-sub); margin-top: 10px; align-items: baseline; }
    .m04-tab {
      position: relative; border: 0; background: none; cursor: pointer; padding: 6px 10px 8px;
      font: inherit; font-size: var(--fs-13); color: var(--text-sub);
    }
    .m04-tab:hover { color: var(--text-strong); }
    .m04-tab--active { color: var(--primary-base); font-weight: 600; }
    .m04-tab--active::after {
      content: ''; position: absolute; left: 8px; right: 8px; bottom: -1px; height: 2px;
      background: var(--primary-base); border-radius: var(--radius-full);
    }
    .m04-tabs__ky { margin-left: auto; font-size: var(--fs-12); color: var(--text-sub); }

    .m04-body { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }

    .m04-form { display: flex; flex-direction: column; gap: 12px; }
    .m04-form__hint { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .m04-form__err { font-size: var(--fs-12); color: var(--error-text); }
    .m04-check { display: flex; flex-direction: column; gap: 6px; }
    .m04-check__row { display: flex; align-items: baseline; gap: 8px; font-size: var(--fs-12); }
    .m04-check__ico { flex: none; width: 18px; text-align: center; font-weight: 700; color: var(--success-base); }
    .m04-check__row--fail .m04-check__ico { color: var(--error-base); }
    .m04-check__lb { color: var(--text-strong); font-weight: 500; }
    .m04-check__dt { color: var(--text-sub); }
    .m04-check__row--fail .m04-check__dt { color: var(--error-text); }
  