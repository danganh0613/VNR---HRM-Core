
:host { display: flex; flex-direction: column; gap: 10px; width: 100%; }
.cb-bar { display: flex; height: 12px; border-radius: var(--radius-full); overflow: hidden; gap: 2px; }
.cb-seg { min-width: 4px; }
.cb-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; }
.cb-item { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-13); }
.cb-dot { width: 8px; height: 8px; border-radius: var(--radius-full); flex: none; }
.cb-lbl { color: var(--text-body); }
.cb-pct { color: var(--text-sub); font-variant-numeric: tabular-nums; }
  