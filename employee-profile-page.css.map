
    .lp-desktop { position: relative; height: 760px; border: 1px solid var(--border-sub); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-regular-sm); }
    .lp-desktop--full { position: relative; height: 100vh; border: 0; border-radius: 0; box-shadow: none; }
    .lp-full { margin-top: 14px; }
    .lp-full-link { text-decoration: none; }
    .lp-desktop ::ng-deep .shell-content { padding: 0; }

    /* ===== PROFILE (port HRE employee-detail.scss) ===== */
    .ed-page { display: flex; flex-direction: column; height: 100%; min-height: 0; }
    .ed-scrollwrap { position: relative; flex: 1; min-height: 0; }
    .ed-scroll { height: 100%; overflow: auto; background: var(--bg-canvas, var(--bg-surface-subtle)); }
    .ed-nav { flex: none; background: var(--bg-surface); border-bottom: 1px solid var(--border-sub); }
    .ed-nav__in { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; gap: var(--space-3, 12px); padding: var(--space-3, 12px) 20px; }
    .ed-nav__t { margin: 0; font-size: var(--fs-20, 20px); font-weight: 600; color: var(--text-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ed-wrap { max-width: 1200px; margin: 0 auto; padding: 20px; display: flex; flex-direction: column; gap: 16px; }
    .ed-mono { font-family: var(--font-mono, 'DM Mono', ui-monospace, monospace); }
    .ed-dot { color: var(--text-soft); }

    .ed-hero { display: flex; align-items: center; gap: 16px; padding: 16px 18px; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-xl); }
    .ed-hero__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
    .ed-hero__name { font-size: var(--fs-20, 20px); font-weight: 700; color: var(--text-strong); }
    .ed-hero__sub { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2, 8px); font-size: var(--fs-13, 13px); color: var(--text-sub); }
    .ed-hero__tags { display: flex; flex-wrap: wrap; gap: var(--space-2, 8px); margin-top: var(--space-1, 4px); }
    /* Design rule (như hrm-tags-cell): nz-tag mặc định margin-inline-end 8px → khử để spacing tag CHỈ do flex gap (token) điều khiển, đồng bộ mọi nhóm tag. */
    :host ::ng-deep .ant-tag { margin: 0; }
    .ed-hero__act { flex: none; align-self: flex-start; }

    .ed-comp { display: grid; grid-template-columns: 240px 1fr; gap: 24px; }
    @media (max-width: 720px) { .ed-comp { grid-template-columns: 1fr; } }
    .ed-comp__left { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; justify-content: center; }
    .ed-comp__lbl { font-size: var(--fs-13, 13px); font-weight: 600; color: var(--text-strong); }
    .ed-comp__ring { display: flex; justify-content: center; padding: 4px 0 2px; }
    .ed-comp__ring ::ng-deep .ant-progress-circle { width: 132px !important; height: 132px !important; }
    .ed-comp__ring ::ng-deep .ant-progress-circle-path { stroke: var(--info-base) !important; }
    .ed-comp__ring ::ng-deep .ant-progress-text { font-size: var(--fs-26, 26px) !important; font-weight: 800; color: var(--text-strong) !important; }
    .ed-comp__frac { font-size: var(--fs-12, 12px); color: var(--text-sub); }
    .ed-comp__hint { font-size: var(--fs-12, 12px); color: var(--text-soft); }
    .ed-comp__hint--ok { color: var(--success-base); font-weight: 600; }

    .ed-sticky { position: absolute; top: 0; left: 0; right: 0; z-index: 40; display: flex; align-items: center; gap: var(--space-4, 16px); padding: 10px 24px; background: var(--bg-surface); border: 0; border-bottom: 1px solid var(--border-sub); box-shadow: var(--shadow-regular-md); }
    .ed-sticky__ring { position: relative; flex: none; width: 46px; height: 46px; }
    .ed-ring { width: 46px; height: 46px; transform: rotate(-90deg); }
    .ed-ring__bg { fill: none; stroke: var(--border-sub); stroke-width: 3.4; }
    .ed-ring__fg { fill: none; stroke: var(--info-base); stroke-width: 3.4; stroke-linecap: round; transition: stroke-dasharray .3s ease; }
    .ed-ring__pct { position: absolute; inset: 0; display: grid; place-items: center; font-size: var(--fs-11, 11px); font-weight: 700; color: var(--text-strong); }
    .ed-sticky__prev { transform: rotate(180deg); }
    .ed-sticky__meta { display: flex; flex-direction: column; flex: none; }
    .ed-sticky__lbl { font-size: var(--fs-13, 13px); font-weight: 600; color: var(--text-strong); }
    .ed-sticky__sub { font-size: var(--fs-12, 12px); color: var(--text-soft); }
    .ed-sticky__task { flex: 1; min-width: 0; display: flex; flex-direction: column; padding-left: 16px; border-left: 1px solid var(--border-sub); }
    .ed-sticky__title { font-size: var(--fs-14, 14px); font-weight: 600; color: var(--text-strong); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ed-sticky__next { font-size: var(--fs-12, 12px); color: var(--text-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ed-sticky__acts { flex: none; display: inline-flex; align-items: center; gap: 8px; }
    @media (max-width: 720px) {
      .ed-sticky { flex-wrap: wrap; gap: 8px 12px; }
      .ed-sticky__task { border-left: 0; padding-left: 0; flex-basis: 100%; order: 3; }
      .ed-sticky__acts { order: 4; }
    }

    .ed-comp__right { border-left: 1px solid var(--border-sub); padding-left: 24px; display: flex; flex-direction: column; gap: 8px; }
    @media (max-width: 720px) { .ed-comp__right { border-left: 0; padding-left: 0; border-top: 1px solid var(--border-sub); padding-top: 16px; } }
    .ed-todo__h { font-size: var(--fs-14, 14px); font-weight: 600; color: var(--text-strong); }
    .ed-todo__list { display: flex; flex-direction: column; gap: 6px; max-height: 264px; overflow-y: auto; padding-right: 4px; }
    .ed-todo { display: flex; align-items: center; gap: 12px; width: 100%; text-align: left; padding: 10px 12px; border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: transparent; cursor: pointer; transition: background-color .12s, border-color .12s; }
    .ed-todo:hover { border-color: var(--primary-base); background: var(--bg-surface-subtle); }
    .ed-todo__ic { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: var(--radius-lg, 12px); background: color-mix(in srgb, var(--sc, var(--primary-base)) 16%, transparent); color: var(--sc, var(--primary-base)); }
    .ed-todo__body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .ed-todo__title { font-size: var(--fs-13, 13px); font-weight: 600; color: var(--text-strong); }
    .ed-todo__sub { font-size: var(--fs-12, 12px); color: var(--text-soft); }
    .ed-todo__badges { display: inline-flex; flex-wrap: wrap; gap: 4px; flex: none; }
    .ed-todo__act { flex: none; display: inline-flex; align-items: center; gap: 2px; font-size: var(--fs-12, 12px); font-weight: 600; color: var(--primary-base); white-space: nowrap; }
    .ed-todo__foot { margin-top: 2px; font-size: var(--fs-12, 12px); color: var(--text-soft); }

    .ed-body2 { display: grid; grid-template-columns: 240px 1fr; gap: 16px; align-items: start; }
    @media (max-width: 900px) { .ed-body2 { grid-template-columns: 1fr; } .ed-toc { display: none; } }
    .ed-toc { position: sticky; top: 0; display: flex; flex-direction: column; gap: 2px; padding: 12px; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-xl); max-height: calc(100vh - 40px); overflow: auto; }
    .ed-toc__h { font-size: var(--fs-12, 12px); font-weight: 600; text-transform: uppercase; letter-spacing: .03em; color: var(--text-soft); padding: 4px 8px 8px; }
    .ed-toc__item { display: flex; align-items: flex-start; gap: 10px; text-align: left; width: 100%; padding: 8px 10px; border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer; transition: background-color .12s; }
    .ed-toc__item:hover { background: var(--bg-surface-subtle); }
    .ed-toc__ic { flex: none; color: var(--text-sub); margin-top: 1px; }
    .ed-toc__txt { display: flex; flex-direction: column; min-width: 0; }
    .ed-toc__title { font-size: var(--fs-13, 13px); color: var(--text-body); line-height: 1.3; }

    .ed-secs { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
    .ed-sec__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2, 8px); margin-bottom: var(--space-3, 12px); width: 100%; }
    .ed-sec__t { display: inline-flex; align-items: center; gap: 8px; font-size: var(--fs-15, 15px); font-weight: 500; color: var(--text-strong); }
    .ed-sec__t > tabler-icon { display: inline-flex !important; align-items: center; justify-content: center; flex: none; width: 30px !important; height: 30px !important; border-radius: var(--radius-md, 8px); color: var(--sc, var(--primary-base)); background: color-mix(in srgb, var(--sc, var(--primary-base)) 15%, transparent); }
    .ed-sec__t > tabler-icon svg { width: 17px; height: 17px; flex: none; }
    .ed-sec__r { display: inline-flex; align-items: center; gap: var(--space-2, 8px); flex: none; }

    .ed-fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 4px 24px; }
    .ed-field { display: flex; align-items: center; gap: 8px; padding: 9px 0; border-bottom: 1px solid var(--border-soft, var(--border-sub)); }
    .ed-field__k { flex: none; width: 148px; font-size: var(--fs-13, 13px); color: var(--text-sub); }
    .ed-field__v { flex: 1; min-width: 0; font-size: var(--fs-13, 13px); color: var(--text-strong); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ed-field__v--empty { color: var(--text-soft); }
    .ed-field__ok { flex: none; color: var(--success-base); }

    .ed-editform { margin-top: 4px; }
    .ed-editform__h { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-13, 13px); font-weight: 600; color: var(--text-strong); }
    .ed-editform__hint { margin: 4px 0 12px; font-size: var(--fs-12, 12px); color: var(--text-soft); }
    .ed-editform__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px 12px; }
    .ed-ff { display: flex; flex-direction: column; gap: 4px; }
    .ed-ff__k { font-size: var(--fs-12, 12px); color: var(--text-sub); }
    .ed-editform__act { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }

    .ed-wh { display: flex; flex-direction: column; gap: var(--space-4, 16px); }
    .ed-wh__item { position: relative; display: flex; gap: var(--space-3, 12px); padding-left: 2px; }
    .ed-wh__dot { display: grid; place-items: center; width: 20px; height: 20px; flex-shrink: 0; margin-top: 2px; border-radius: var(--radius-full, 999px); background: var(--bg-surface-subtle); color: var(--text-soft); }
    .ed-wh__dot--first { background: var(--primary-bg-subtle); color: var(--primary-base); }
    .ed-wh__line { position: absolute; left: 11px; top: 26px; width: 1px; height: calc(100% - 10px); background: var(--border-sub); }
    .ed-wh__pos { font-size: var(--fs-13, 13px); color: var(--text-strong); }
    .ed-wh__meta { font-family: var(--font-mono); font-size: var(--fs-12, 12px); color: var(--text-soft); margin-bottom: var(--space-1, 4px); }

  