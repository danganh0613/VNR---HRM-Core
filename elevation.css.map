
    .shadows { display: flex; flex-wrap: wrap; gap: 24px; }
    .sh-card {
      width: 160px; height: 96px; border-radius: var(--radius-2xl);
      background: var(--bg-surface); border: 1px solid var(--border-soft);
      display: flex; align-items: flex-end; padding: 10px;
    }
    .chip-name { font-size: var(--fs-12); font-weight: 500; color: var(--text-body); }

    .zlist { display: flex; flex-direction: column; gap: 4px; max-width: 360px; }
    .zrow { display: flex; justify-content: space-between; padding: 6px 10px; border-radius: var(--radius-md); background: var(--bg-surface-subtle); }
    .zname { font-size: var(--fs-13); color: var(--text-body); }
    .zval { font-size: var(--fs-13); color: var(--text-sub); font-variant-numeric: tabular-nums; }

    .motions { display: flex; flex-direction: column; gap: 10px; max-width: 480px; }
    .mrow { display: flex; align-items: center; gap: 16px; }
    .track { flex: 1; height: 20px; background: var(--bg-surface-subtle); border-radius: var(--radius-full); position: relative; overflow: hidden; }
    .ball {
      position: absolute; top: 2px; left: 2px; width: 16px; height: 16px;
      border-radius: var(--radius-full); background: var(--primary-base);
      transition-property: left; transition-timing-function: var(--ease-out); transition-duration: 300ms;
    }
    .mrow:hover .ball { left: calc(100% - 18px); }
    .durs { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; }
    .dur-chip {
      font-size: var(--fs-12); color: var(--text-sub); font-variant-numeric: tabular-nums;
      padding: 4px 10px; border: 1px solid var(--border-sub); border-radius: var(--radius-full);
    }
  