
.vm-root { position: relative; display: inline-block; }

.vm-trigger { display: inline-flex; align-items: center; gap: var(--space-2, 8px); height: 36px; padding: 0 var(--space-3, 12px);
  border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md, 8px);
  color: var(--text-body); font: inherit; font-size: var(--fs-14, 14px); font-weight: var(--font-medium, 500);
  cursor: pointer; white-space: nowrap; }
.vm-trigger:hover, .vm-trigger.on { border-color: var(--primary-base); color: var(--text-strong); }
.vm-trigger:focus-visible { outline: 2px solid var(--primary-base); outline-offset: 1px; }
.vm-caret { flex: none; color: var(--text-soft); }

.vm-backdrop { position: fixed; inset: 0; z-index: 40; background: transparent; }

.vm-pop { position: absolute; z-index: 41; top: calc(100% + var(--space-1, 4px)); inset-inline-start: 0;
  min-width: 264px; max-width: 320px; background: var(--bg-surface); border: 1px solid var(--border-sub);
  border-radius: var(--radius-lg, 10px); box-shadow: var(--shadow-regular-md, 0 8px 24px rgba(16, 24, 40, .12));
  padding: var(--space-2, 8px); }

.vm-sec { display: flex; flex-direction: column; }
.vm-sec-h { display: flex; align-items: center; gap: var(--space-1, 4px);
  padding: var(--space-2, 8px) var(--space-2, 8px) var(--space-1, 4px);
  font-size: var(--fs-11, 11px); font-weight: var(--font-medium, 500); letter-spacing: .02em;
  text-transform: uppercase; color: var(--text-soft); }

.vm-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px;
  max-height: 240px; overflow-y: auto; }
.vm-item { display: flex; align-items: center; border-radius: var(--radius-md, 8px); }
.vm-item.active { background: var(--primary-bg-subtle); }
.vm-pick { flex: 1; min-width: 0; display: flex; align-items: center; gap: var(--space-2, 8px); height: 34px;
  padding: 0 var(--space-2, 8px); border: 0; background: transparent; color: var(--text-body);
  font: inherit; font-size: var(--fs-14, 14px); cursor: pointer; text-align: start; border-radius: var(--radius-md, 8px); }
.vm-pick:hover { background: var(--bg-surface-subtle); }
.vm-item.active .vm-pick:hover { background: transparent; }
.vm-pick:focus-visible { outline: 2px solid var(--primary-base); outline-offset: -2px; }
.vm-tick { flex: none; color: var(--primary-base); }
.vm-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.vm-item.active .vm-name { color: var(--primary-base); font-weight: var(--font-medium, 500); }

.vm-del { flex: none; display: grid; place-items: center; width: 30px; height: 30px; margin-inline-end: var(--space-1, 4px);
  border: 0; background: transparent; border-radius: var(--radius-sm, 6px); color: var(--text-soft); cursor: pointer; }
.vm-del:hover { color: var(--error-base); background: var(--bg-surface-subtle); }
.vm-del:focus-visible { outline: 2px solid var(--primary-base); outline-offset: 1px; }

.vm-empty { padding: var(--space-4, 16px) var(--space-2, 8px); text-align: center;
  font-size: var(--fs-13, 13px); color: var(--text-soft); }

.vm-save { margin-top: var(--space-2, 8px); padding-top: var(--space-2, 8px); border-top: 1px solid var(--border-soft); }
.vm-save-row { display: flex; align-items: center; gap: var(--space-2, 8px); padding: 0 var(--space-2, 8px); }
.vm-inp { flex: 1; min-width: 0; height: 34px; padding: 0 var(--space-3, 12px); border: 1px solid var(--border-sub);
  border-radius: var(--radius-md, 8px); background: var(--bg-surface); color: var(--text-body);
  font: inherit; font-size: var(--fs-14, 14px); }
.vm-inp::placeholder { color: var(--text-soft); }
.vm-inp:focus-visible { outline: none; border-color: var(--primary-base); }
.vm-save-btn { flex: none; display: inline-flex; align-items: center; gap: var(--space-1, 4px); height: 34px;
  padding: 0 var(--space-3, 12px); border: 1px solid var(--border-sub); background: var(--bg-surface);
  border-radius: var(--radius-md, 8px); color: var(--text-body); font: inherit; font-size: var(--fs-13, 13px);
  font-weight: var(--font-medium, 500); cursor: pointer; white-space: nowrap; }
.vm-save-btn:hover { border-color: var(--primary-base); color: var(--text-strong); }
.vm-save-btn:focus-visible { outline: 2px solid var(--primary-base); outline-offset: 1px; }
.vm-err { padding: var(--space-1, 4px) var(--space-2, 8px) 0; font-size: var(--fs-12, 12px); color: var(--error-base); }
  