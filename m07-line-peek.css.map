
    :host { display: block; }
    .lp { display: flex; flex-direction: column; gap: 14px; }
    .lp-sec { border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); padding: 10px 12px; display: flex; flex-direction: column; gap: 6px; }
    .lp-h { margin: 0 0 2px; font-size: var(--fs-12); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--text-sub); }

    .lp-row3 { display: flex; flex-direction: column; gap: 10px; }
    .lp-num { display: flex; flex-direction: column; gap: 3px; padding: 8px 10px; border: 1px dashed var(--border-sub); border-radius: var(--radius-md); }
    .lp-num__label { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .lp-num__val { font-size: var(--fs-16); font-weight: 700; color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .lp-num__miss { font-size: var(--fs-13); font-weight: 600; color: var(--warning-text); }
    .lp-num__sub { font-size: var(--fs-11); color: var(--text-soft); }
    .lp-src { align-self: flex-start; border: 0; background: none; padding: 0; cursor: pointer; font: inherit; font-size: var(--fs-12); color: var(--primary-base); font-weight: 500; }
    .lp-src--text { cursor: default; color: var(--text-sub); }

    .lp-vc { display: flex; flex-direction: column; gap: 6px; margin-top: 4px; }
    .lp-vc__row { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .lp-vc__cap { flex: none; width: 150px; font-size: var(--fs-12); color: var(--text-sub); }
    .lp-ok { font-size: var(--fs-12); color: var(--success-text); font-weight: 500; }

    .lp-gt { font-size: var(--fs-12); font-weight: 500; border-radius: var(--radius-sm); padding: 4px 8px; }
    .lp-gt[data-tone='can-xu-ly'] { background: var(--error-bg); color: var(--error-text); }
    .lp-gt[data-tone='da-co-ly-do'] { background: var(--warning-bg); color: var(--warning-text); }
    .lp-gt[data-tone='da-duyet'] { background: var(--success-bg); color: var(--success-text); }
    .lp-note { margin: 0; font-size: var(--fs-11); color: var(--text-soft); }

    .lp-kq { display: flex; flex-direction: column; gap: 5px; border-top: 1px dashed var(--border-sub); padding-top: 8px; }
    .lp-kq__head { font-size: var(--fs-12); color: var(--text-sub); }
    .lp-kq__v { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; font-size: var(--fs-12); color: var(--text-body); }

    .lp-kv { display: flex; align-items: baseline; gap: 10px; font-size: var(--fs-12); }
    .lp-kv span { flex: none; width: 150px; color: var(--text-sub); }
    .lp-kv b { color: var(--text-strong); font-weight: 600; }
    .lp-warn { color: var(--error-text); }
    .lp-ghichu { margin: 2px 0 0; font-size: var(--fs-12); color: var(--warning-text); background: var(--warning-bg); border-radius: var(--radius-sm); padding: 4px 8px; }
    .lp-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .lp-actions { display: flex; gap: 8px; margin-top: 4px; }
  