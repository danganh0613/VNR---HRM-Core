
    :host { display: flex; flex-direction: column; gap: 10px; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg); padding: 12px 14px; }
    .h5-head { display: flex; align-items: center; gap: 10px; }
    .h5-boxes { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8px; }
    @media (max-width: 1300px) { .h5-boxes { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .h5-box {
      display: flex; flex-direction: column; align-items: flex-start; gap: 2px; cursor: pointer; text-align: left;
      font: inherit; background: var(--bg-surface-subtle); border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 8px 10px;
    }
    .h5-box:hover { border-color: var(--primary-base); }
    .h5-box b { font-size: var(--fs-16); font-weight: 700; color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .h5-box i { font-style: normal; font-size: var(--fs-11); color: var(--text-sub); }
    .h5-box[data-hot='true'] { background: var(--error-bg); border-color: var(--error-base); }
    .h5-box[data-hot='true'] b { color: var(--error-text); }
    .h5-src { font-size: var(--fs-11); color: var(--text-soft); }
    .h5-top5 { display: flex; flex-direction: column; gap: 4px; }
    .h5-top5__head { font-size: var(--fs-11); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--text-sub); }
    .h5-row { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; cursor: pointer; text-align: left;
      font: inherit; background: none; border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 5px 10px; }
    .h5-row:hover { border-color: var(--primary-base); }
    .h5-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .h5-mota { font-size: var(--fs-12); color: var(--text-body); }
    .h5-han { font-size: var(--fs-12); color: var(--text-sub); }
    .h5-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .h5-che { margin: 0; font-size: var(--fs-12); color: var(--warning-text); font-weight: 500; }
  