
    :host { display: block; }
    .b1 { display: flex; flex-direction: column; gap: 16px; max-width: 980px; }
    .b1__sec { display: flex; flex-direction: column; gap: 8px; }
    .b1__sechead { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .b1__editrow { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .b1__lb { font-size: var(--fs-12); color: var(--text-sub); }
    .b1__in { display: inline-block; width: 130px; }
    .b1__frozen { font-size: var(--fs-12); color: var(--text-sub); background: var(--bg-surface-subtle); border-radius: var(--radius-sm); padding: 3px 9px; }
    .b1__frozen b { color: var(--text-strong); font-weight: 600; }
    .b1__muted { margin: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .b1__strong { margin: 0; font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); }
  