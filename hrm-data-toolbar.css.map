
.dt-bar { display: flex; align-items: center; gap: 8px; min-width: 0; flex-wrap: wrap; }
.dt-sp { flex: 1 1 0; min-width: 0; }
.dt-count { font-size: var(--fs-12, 12px); color: var(--text-sub); background: var(--bg-surface-subtle);
  padding: 2px 10px; border-radius: var(--radius-full); white-space: nowrap; }

.dt-search { display: flex; align-items: center; gap: 8px; flex: 1 1 180px; min-width: 140px; max-width: 420px; height: 38px;
  padding: 0 10px; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg, 10px); }
.dt-search:focus-within { border-color: var(--primary-base); }
.dt-search-ic { flex: none; color: var(--text-soft); }
.dt-search input { flex: 1; min-width: 0; border: 0; background: transparent; outline: none; font: inherit;
  font-size: var(--fs-14, 14px); color: var(--text-body); }
.dt-search input::placeholder { color: var(--text-soft); }
.dt-search input::-webkit-search-cancel-button { display: none; }
.dt-search-clr { flex: none; display: grid; place-items: center; width: 18px; height: 18px; border: 0; background: transparent;
  color: var(--text-soft); cursor: pointer; border-radius: var(--radius-sm, 6px); }
.dt-search-clr:hover { color: var(--text-strong); background: var(--bg-surface-subtle); }

.dt-btn { display: inline-flex; align-items: center; gap: 6px; height: 38px; padding: 0 12px; flex: none;
  border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md, 8px);
  color: var(--text-body); font: inherit; font-size: var(--fs-14, 14px); cursor: pointer; white-space: nowrap;
  transition: border-color var(--duration-fast, .15s) var(--ease-out, ease), background var(--duration-fast, .15s) var(--ease-out, ease); }
.dt-btn:hover { border-color: var(--primary-border); color: var(--text-strong); }
.dt-btn:focus-visible { outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: 1px; }
.dt-n { display: inline-grid; place-items: center; min-width: 18px; height: 18px; padding: 0 5px;
  border-radius: var(--radius-full); background: var(--primary-bg-soft); color: var(--primary-base);
  font-size: var(--fs-11, 11px); font-weight: var(--font-semibold, 600); line-height: 1; }

:host ::ng-deep .dt-menu li[nz-menu-item] { display: flex; align-items: center; gap: 8px; }
:host ::ng-deep .dt-menu .dt-off { opacity: .5; }
  