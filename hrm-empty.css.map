
.he-ic {
  display: inline-grid; place-items: center; width: 72px; height: 72px;
  border-radius: var(--radius-full); background: var(--bg-surface-subtle); color: var(--icon-secondary);
}
.he-ic[data-preset='error'] { background: var(--error-bg); color: var(--error-base); }
.he-ic[data-preset='first-use'] { background: var(--primary-bg-subtle); color: var(--primary-base); }
  