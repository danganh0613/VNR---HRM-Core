
    :host { display: block; }
    .mn { display: flex; flex-direction: column; gap: 14px; }
    .mn-sec { display: flex; flex-direction: column; gap: 8px; }
    .mn-sec__head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .mn-new { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .mn-new hrm-input { width: 200px; }
    .mn-dot { border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); padding: 8px 12px; display: flex; flex-direction: column; gap: 5px; }
    .mn-dot__head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: var(--fs-13); }
    .mn-pb { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: var(--fs-12); color: var(--text-sub); padding-left: 12px; }
    .mn-pb--form { padding-top: 4px; border-top: 1px dashed var(--border-sub); }
    .mn-pb--form hrm-select { width: 260px; }
    .mn-pb--form hrm-input { width: 130px; }
    .mn-dn { border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); padding: 8px 12px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: var(--fs-13); }
    .mn-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .mn-strong { font-weight: 600; color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .mn-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .mn-muted b { color: var(--text-strong); }
    .mn-gap { flex: 1; }
    .mn-du { font-size: var(--fs-12); font-weight: 700; color: var(--warning-text); background: var(--warning-bg); border-radius: var(--radius-full); padding: 1px 10px; }
    .mn-du--ok { color: var(--success-text); background: var(--success-bg); font-weight: 500; }
    .mn-immutable { font-size: var(--fs-11); font-weight: 600; color: var(--text-sub); background: var(--bg-surface-subtle); border-radius: var(--radius-full); padding: 1px 9px; }
    .mn-duyet-sel { width: 180px; }
    .mn-form { display: flex; flex-direction: column; gap: 8px; }
    .mn-err { font-size: var(--fs-12); color: var(--error-text); }
  