
    .tpl-frame { padding: 16px; background: var(--bg-canvas); border: 1px solid var(--border-sub); border-radius: var(--radius-lg); }
    .tpl-search { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); color: var(--text-sub); }
    .tpl-search input { border: 0; background: transparent; outline: none; font: inherit; font-size: var(--fs-13); color: var(--text-body); width: 160px; }
    .tpl-btn-ghost { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md); cursor: pointer; font: inherit; font-size: var(--fs-13); color: var(--text-body); }
    .tpl-btn-ghost:hover { border-color: var(--primary-border); }

    .ec { display: flex; flex-direction: column; gap: 12px; }
    .ec-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
    .ec-kpi { display: flex; align-items: center; gap: 8px; font-size: var(--fs-12); color: var(--text-sub); }
    .ec-kpi-l { flex: none; }
    .ec-bar { flex: 1; height: 6px; border-radius: var(--radius-full); background: var(--skeleton); overflow: hidden; }
    .ec-bar-f { display: block; height: 100%; border-radius: var(--radius-full); }
    .ec-kpi-v { flex: none; font-weight: 600; color: var(--text-strong); }
    .ec-skills { display: flex; flex-wrap: wrap; gap: 4px; }
  