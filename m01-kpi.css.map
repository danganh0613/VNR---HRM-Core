
    :host { display: block; }
    .k2 { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
    @media (max-width: 1400px) { .k2 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    .k2-card {
      display: flex; flex-direction: column; align-items: flex-start; gap: 4px; text-align: left; cursor: pointer;
      font: inherit; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
      padding: 10px 12px; min-height: 118px;
    }
    .k2-card:hover { border-color: var(--primary-base); }
    .k2-ten { font-size: var(--fs-12); font-weight: 600; color: var(--text-sub); }
    .k2-so { font-size: var(--fs-18); font-weight: 700; color: var(--text-strong); font-variant-numeric: tabular-nums; line-height: 1.2; }
    .k2-cons { display: flex; flex-direction: column; gap: 1px; }
    .k2-con { display: flex; align-items: baseline; gap: 6px; font-variant-numeric: tabular-nums; }
    .k2-con b { font-size: var(--fs-13); font-weight: 700; color: var(--text-strong); }
    .k2-con i { font-style: normal; font-size: var(--fs-11); color: var(--text-sub); }
    .k2-meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .k2-delta { font-size: var(--fs-11); font-weight: 600; }
    .k2-delta[data-tone='up'] { color: var(--error-base); }
    .k2-delta[data-tone='down'] { color: var(--success-base); }
    .k2-delta[data-tone='flat'] { color: var(--text-sub); }
    .k2-rule { font-size: var(--fs-11); color: var(--text-soft); }
    .k2-che { font-size: var(--fs-11); color: var(--warning-text); font-weight: 500; }
  