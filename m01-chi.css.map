
    :host { display: flex; flex-direction: column; gap: 8px; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg); padding: 12px 14px; }
    .c7-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .c7-muted { font-size: var(--fs-11); color: var(--text-soft); }
    .c7-3so { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .c7-so { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; cursor: pointer; text-align: left;
      font: inherit; background: var(--bg-surface-subtle); border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 8px 10px; }
    .c7-so:hover { border-color: var(--primary-base); }
    .c7-so b { font-size: var(--fs-15); font-weight: 700; color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .c7-so i { font-style: normal; font-size: var(--fs-11); color: var(--text-sub); }
    .c7-lop { font-size: var(--fs-11); color: var(--text-soft); }
    .c7-note { margin: 0; font-size: var(--fs-11); color: var(--text-soft); }
    .c7-ton { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .c7-gap { flex: 1; }
    .c7-tonso { display: inline-flex; align-items: baseline; gap: 7px; cursor: pointer; font: inherit; text-align: left;
      background: var(--error-bg); border: 1px solid var(--error-base); border-radius: var(--radius-md); padding: 5px 10px; }
    .c7-tonso b { font-size: var(--fs-14); font-weight: 700; color: var(--error-text); }
    .c7-tonso i { font-style: normal; font-size: var(--fs-11); color: var(--error-text); }
    .c7-hong { font: inherit; font-size: var(--fs-12); color: var(--warning-text); background: none; border: 1px dashed var(--warning-base, var(--warning-text));
      border-radius: var(--radius-md); padding: 4px 10px; cursor: pointer; }
    .c7-hong b { font-variant-numeric: tabular-nums; }
    .c7-top5 { display: flex; flex-direction: column; gap: 4px; }
    .c7-top5__head { font-size: var(--fs-11); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--text-sub); }
    .c7-row { display: flex; align-items: baseline; gap: 9px; flex-wrap: wrap; cursor: pointer; text-align: left;
      font: inherit; background: none; border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 5px 10px; }
    .c7-row:hover { border-color: var(--primary-base); }
    .c7-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .c7-mota { font-size: var(--fs-12); color: var(--text-body); }
    .c7-tuoi { font-size: var(--fs-12); color: var(--error-text); font-variant-numeric: tabular-nums; margin-left: auto; }
  