
    .lp-desktop { position: relative; height: 760px; border: 1px solid var(--border-sub); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-regular-sm); }
    .lp-desktop--full { position: relative; height: 100vh; border: 0; border-radius: 0; box-shadow: none; }
    .lp-full { margin-top: 14px; } .lp-full-link { text-decoration: none; }
    /* Caption phân tách 2 MẪU header trong cùng trang doc. */
    .smp-cap { margin: 4px 0 10px; font-size: var(--fs-13, 13px); color: var(--text-sub); }
    .smp-cap--2 { margin-top: 28px; }
    .smp-cap__n { display: inline-block; margin-right: 6px; padding: 1px 8px; border-radius: var(--radius-full, 999px); background: var(--primary-bg-subtle); color: var(--primary-base); font-weight: var(--font-semibold, 600); }
    .lp-desktop ::ng-deep .shell-content { padding: 0; }

    .lp-hdr { display: flex; align-items: center; gap: var(--space-2, 8px); }
    .tbx { display: flex; align-items: center; gap: var(--space-2, 8px); flex-wrap: wrap; }
    /* Chỉ 1 chế độ Bảng → thanh mode-tabs của data-view rỗng nhưng vẫn chừa 12px (margin-bottom).
       Ẩn dv-bar rỗng để bảng sát toolbar, hết khoảng GAP trắng. */
    :host ::ng-deep hrm-data-view .dv-bar { display: none; }

    /* Peek body TỰ có padding 16 (dp-mbody/drawer/modal) — form đã tự padding qua .cf-body ⇒ ZERO
       padding vùng body khi chứa form (GIỐNG list-page :has(.ef)) để KHÔNG double-padding (chỉ còn 20px). */
    ::ng-deep .ant-drawer-body:has(.cf-body),
    ::ng-deep .ant-modal-body:has(.cf-body),
    ::ng-deep .dp-mbody:has(.cf-body) { padding: 0 !important; }

    /* Form trong hrm-detail-peek — CẤU TRÚC + MẬT ĐỘ khớp list-page (.ef-body/.ef-sec/.ef-grid 2 cột) */
    .cf-body { padding: var(--space-5, 20px) var(--space-5, 20px) var(--space-3, 12px); display: flex; flex-direction: column; gap: var(--space-6, 24px); }
    .cf-sec { display: flex; flex-direction: column; gap: var(--space-3, 12px); }
    .cf-sec-h { font-size: var(--fs-13, 13px); font-weight: var(--font-bold, 700); color: var(--text-strong); padding-bottom: 8px; border-bottom: 1px solid var(--border-soft); }
    .cf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
    .cf-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .cf-field--full { grid-column: 1 / -1; }
    .cf-lbl { font-size: var(--fs-13, 13px); font-weight: var(--font-medium, 500); color: var(--text-strong); }
    .cf-req { color: var(--error-base); font-weight: var(--font-bold, 700); }
    .cf-foot { display: flex; justify-content: flex-end; gap: 10px; }

    /* Filter nhanh trạng thái (đồng bộ VNR-HRE .mr-fbtn) */
    .cf-fbtn { display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 12px; border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); cursor: pointer; font: inherit; font-size: var(--fs-13, 13px); color: var(--text-body); white-space: nowrap; }
    .cf-fbtn:hover, .cf-fbtn--on { border-color: var(--primary-base); }
    .cf-fbtn > tabler-icon:first-child { color: var(--text-sub); }
    .cf-fbtn__lbl { font-weight: var(--font-medium, 500); color: var(--text-strong); }
    .cf-fbtn__val { color: var(--info-base); font-weight: var(--font-medium, 500); }
    .cf-fbtn__chev { color: var(--text-soft); }
    :host ::ng-deep .cf-menu .ant-dropdown-menu-item { display: flex; align-items: center; gap: 8px; }
    .cf-mdot { flex: none; width: 8px; height: 8px; border-radius: 50%; }
    .cf-menu__t { flex: 1; }
    .cf-menu__c { font-size: var(--fs-12, 12px); color: var(--text-soft); }
    .cf-menu__ck { color: var(--primary-base); }
  