
    /* Nút Config ghim góc DƯỚI phải: tròn, icon giữa, shadow,
       viền sao chổi bảy màu chạy vòng quanh (conic-gradient xoay). */
    :host { position: fixed; bottom: 18px; right: 18px; z-index: 900; display: inline-flex; }
    .gear {
      position: relative; display: grid; place-items: center;
      width: 48px; height: 48px; border-radius: 50%;
      border: 0; color: var(--text-sub); cursor: pointer;
      /* nền đậm hơn bối cảnh phía dưới một nấc (light: sẫm nhẹ, dark: sáng nhẹ) để tách nút khỏi trang */
      background: color-mix(in srgb, var(--bg-surface) 88%, var(--text-strong));
      box-shadow: var(--shadow-regular-md);
      transition: color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
    }
    /* Viền "rắn săn mồi": cung sao chổi 7 màu dài 75% vòng (đuôi mờ dần → đầu rực),
       25% còn lại trong suốt — KHÔNG viền nền xám. */
    .gear::before {
      content: ''; position: absolute; inset: -3px; z-index: -1; border-radius: 50%;
      background: conic-gradient(from 0deg,
        transparent 0 25%,
        rgba(244, 63, 94, .14) 29%,
        #f43f5e 37%, #f97316 47%, #eab308 57%, #22c55e 67%,
        #06b6d4 77%, #6366f1 88%, #d946ef 99%, transparent 100%);
      animation: gear-spin 2.6s linear infinite;
    }
    /* quầng sáng bám theo thân rắn — rực, lan rộng */
    .gear::after {
      content: ''; position: absolute; inset: -6px; z-index: -2; border-radius: 50%;
      background: conic-gradient(from 0deg,
        transparent 0 28%,
        rgba(244, 63, 94, .35) 40%, rgba(234, 179, 8, .55) 55%,
        rgba(34, 197, 94, .7) 68%, rgba(6, 182, 212, .8) 80%,
        #6366f1 91%, #d946ef 99%, transparent 100%);
      filter: blur(12px) saturate(1.4); opacity: 1;
      animation: gear-spin 2.6s linear infinite;
    }
    @keyframes gear-spin { to { transform: rotate(360deg); } }
    .gear:hover { color: var(--text-strong); transform: scale(1.06); box-shadow: var(--shadow-regular-lg, var(--shadow-regular-md)); }
    .gear.on { color: var(--primary-base); }

    /* Hover: vành 7 màu nở tỏa từ trong ra, vừa phóng to vừa xoay rồi tan — 2 sóng lệch pha nối nhau. */
    .gear-wave {
      position: absolute; inset: -2px; border-radius: 50%; pointer-events: none; opacity: 0;
      background: conic-gradient(from 0deg, #f43f5e, #f97316, #eab308, #22c55e, #06b6d4, #6366f1, #d946ef, #f43f5e);
      -webkit-mask: radial-gradient(closest-side, transparent 74%, #000 78%, #000 90%, transparent 95%);
      mask: radial-gradient(closest-side, transparent 74%, #000 78%, #000 90%, transparent 95%);
    }
    .gear:hover .gear-wave { animation: gear-ripple 1.5s cubic-bezier(.2,.55,.45,1) infinite; }
    .gear:hover .gear-wave.w2 { animation-delay: .75s; }
    @keyframes gear-ripple {
      0%   { transform: scale(.72) rotate(0deg);  opacity: .85; }
      60%  { opacity: .4; }
      100% { transform: scale(2.15) rotate(160deg); opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) { .gear::before, .gear::after, .gear-wave { animation: none !important; } }

    .backdrop { position: fixed; inset: 0; z-index: var(--z-dropdown); }
    .panel {
      position: absolute; bottom: calc(100% + 10px); right: 0; z-index: var(--z-popover);
      max-height: calc(100vh - 90px); overflow-y: auto;
      width: 300px; padding: 14px;
      background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: var(--radius-2xl); box-shadow: var(--shadow-regular-md);
      display: flex; flex-direction: column; gap: 14px;
    }
    .panel-h { font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); }
    .row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .block { display: flex; flex-direction: column; gap: 8px; }
    .lbl { font-size: var(--fs-12); font-weight: 500; color: var(--text-sub); }

    .seg {
      display: inline-flex; padding: 2px; gap: 2px;
      background: var(--bg-surface-subtle); border: 1px solid var(--border-sub);
      border-radius: var(--radius-lg);
    }
    .seg button {
      border: 0; background: transparent; cursor: pointer;
      padding: 4px 9px; border-radius: var(--radius-md);
      font-family: var(--font-sans); font-size: var(--fs-12); font-weight: 500; color: var(--text-sub);
      transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
    }
    .seg button:hover { color: var(--text-strong); }
    .seg button.on { background: var(--bg-surface); color: var(--primary-base); box-shadow: var(--shadow-regular-xs); }
    .dark .seg button.on { color: var(--text-strong); }

    .swatches { display: grid; grid-template-columns: repeat(8, 1fr); gap: 6px; }
    .sw {
      aspect-ratio: 1; border-radius: var(--radius-full);
      border: 2px solid transparent; cursor: pointer; padding: 0;
      box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08);
    }
    .sw.on { border-color: var(--text-strong); }
    .sw-custom {
      position: relative; display: inline-flex; align-items: center; justify-content: center;
      background:
        conic-gradient(from 90deg, #f43f5e, #eab308, #22c55e, #06b6d4, #6366f1, #d946ef, #f43f5e);
      overflow: hidden;
    }
    .sw-custom input[type='color'] {
      position: absolute; inset: 0; width: 100%; height: 100%;
      opacity: 0; border: 0; padding: 0; cursor: pointer;
    }

    .fonts { display: flex; flex-direction: column; gap: 4px; }
    .font-opt {
      text-align: left; padding: 8px 10px; border-radius: var(--radius-md);
      border: 1px solid var(--border-sub); background: var(--bg-surface);
      font-size: var(--fs-14); color: var(--text-body); cursor: pointer;
      transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
    }
    .font-opt:hover { background: var(--bg-surface-subtle); }
    .font-opt.on { border-color: var(--primary-base); background: var(--primary-bg-subtle); color: var(--text-strong); }

    .reset {
      margin-top: 2px; padding: 8px; border-radius: var(--radius-md);
      border: 1px solid var(--border-sub); background: transparent;
      font-family: var(--font-sans); font-size: var(--fs-12); color: var(--text-sub); cursor: pointer;
    }
    .reset:hover { color: var(--text-strong); background: var(--bg-surface-subtle); }
  