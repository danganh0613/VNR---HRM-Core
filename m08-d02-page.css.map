
    :host { display: flex; flex-direction: column; gap: 10px; }
    .d-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .d-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .d-warn { font-size: var(--fs-11); color: var(--warning-text); font-weight: 500; }
    .d-err { font-size: var(--fs-11); color: var(--error-text); font-weight: 500; max-width: 240px; }
    .d-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 700; color: var(--text-strong); }
    .d-strong { color: var(--text-strong); font-weight: 500; }
    .d-stack { display: flex; flex-direction: column; gap: 2px; align-items: flex-start; }
  