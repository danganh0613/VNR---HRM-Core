.bp { display:flex; gap:10px; padding:12px 14px; border-radius:var(--radius-lg); font-size: var(--fs-14); line-height:1.5; margin-bottom:8px; }
    .bp-do { background: var(--success-bg); border: 1px solid var(--success-border); color: var(--success-text); }
    :host-context(.dark) .bp-do { background: var(--success-bg-dark); border-color: var(--success-border-dark); color: var(--success-text-dark); }
    .bp-tag { font-size: var(--fs-11); font-weight:700; padding:2px 6px; border-radius:var(--radius-xs); height:fit-content; background:var(--success-base); color:var(--text-on-primary); }