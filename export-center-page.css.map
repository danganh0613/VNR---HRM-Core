
:host{display:contents}
.num{font-family:var(--font-mono);font-variant-numeric:tabular-nums}

/* ── Modal overlay: backdrop + card centered (thay hrm-drawer) ── */
.ec-backdrop{position:fixed;inset:0;background:var(--overlay-bg, rgb(14 18 27 / 0.46));z-index:1050}
.ec-modal{position:fixed;inset:0;margin:auto;z-index:1051;
  width:min(1200px, 96vw);height:min(864px, 92vh);
  background:var(--bg-surface);border-radius:var(--radius-3xl);
  box-shadow:var(--shadow-regular-lg);overflow:hidden;
  display:flex;flex-direction:column}
.ec-shell{display:flex;flex-direction:column;height:100%;min-height:0}

/* Header modal custom (tpl-dhead mockup) */
.dhead{display:flex;align-items:flex-start;gap:12px;padding:18px 22px 14px;
  border-bottom:1px solid var(--border-sub);flex:none}
.dh-ic{width:36px;height:36px;border-radius:var(--radius-md);background:var(--primary-bg-subtle);
  color:var(--primary-base);display:flex;align-items:center;justify-content:center;flex:none}
.dh-t{flex:1;min-width:0}
.dh-t h3{font-size:var(--fs-18);font-weight:var(--font-semibold);color:var(--text-strong);margin:0}
.dh-t p{font-size:var(--fs-13);color:var(--text-sub);margin:2px 0 0}
.dh-x{width:30px;height:30px;border:none;background:transparent;color:var(--text-sub);cursor:pointer;
  border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;flex:none}
.dh-x:hover{background:var(--bg-surface-subtle)}

/* Thân 3 vùng: rail (268 tự thân) · canvas co giãn · dock (300 tự thân) */
.dbody{flex:1;display:flex;min-height:0}
.canvas{flex:1;min-width:0;display:flex;flex-direction:column;background:var(--bg-app)}
/* Command bar AI ghim ĐÁY canvas (sau cv-scroll): full width, inset 18px khớp cv-top/cv-scroll.
   .canvas flex column + cv-scroll flex:1 cuộn → ai-mount flex:none tự dính đáy; border-top + nền surface tách khối, không đè dock */
/* Bỏ band footer (border-top + nền surface) — chatbot AI nổi thẳng trên canvas; giữ padding chừa shadow. */
.ai-mount{flex:none;padding:var(--space-3) 18px}
.cv-top{display:flex;align-items:center;gap:14px;padding:12px 18px 0;flex:none}
.src-bar{display:flex;align-items:center;gap:var(--space-2);margin-left:auto;font-size:var(--fs-12);
  color:var(--text-sub);white-space:nowrap;min-width:0;overflow:hidden}
.src-bar b{color:var(--text-strong);font-weight:var(--font-medium)}
.src-bar .pin{color:var(--warning-base)}
.cv-scroll{flex:1;overflow-y:auto;padding:14px 18px 18px;display:flex;flex-direction:column;
  gap:12px;min-height:0}

/* Trạng thái lịch trên src-bar — luôn render 2 chiều (AP-01) */
.sdot{display:inline-flex;align-items:center;gap:5px;font-size:var(--fs-11);font-weight:var(--font-medium)}
.sdot::before{content:'';width:7px;height:7px;border-radius:var(--radius-full)}
.sdot.act{color:var(--success-text)}
.sdot.act::before{background:var(--success-base)}
.sdot.off{color:var(--text-soft)}
.sdot.off::before{background:var(--text-soft)}

/* Dirty-chip trong src-bar (mockup màn 04) — amber CHỈ cho cảnh báo (AP-07) */
.dirty{display:inline-flex;align-items:center;gap:5px;font-size:var(--fs-11);font-weight:var(--font-medium);
  background:var(--warning-bg);color:var(--warning-text);border:1px solid var(--warning-border);
  padding:2px 9px;border-radius:var(--radius-full);flex:none}
.dirty .dot{width:6px;height:6px;border-radius:var(--radius-full);background:var(--warning-base)}
.dirty b{font-weight:var(--font-semibold)}
.dirty button{border:none;background:transparent;color:inherit;font-weight:var(--font-semibold);
  font-size:var(--fs-11);text-decoration:underline;cursor:pointer;padding:0}

/* Chip mời lưu — trung tính (amber CHỈ cho cảnh báo, AP-07) */
.savehint{display:inline-flex;align-items:center;gap:4px;font-size:var(--fs-11);font-weight:var(--font-medium);
  color:var(--text-sub);background:var(--bg-surface-subtle);border:1px solid var(--border-sub);
  padding:2px 9px;border-radius:var(--radius-full);flex:none}
.savehint button{border:none;background:transparent;color:var(--primary-base);font-weight:var(--font-semibold);
  font-size:var(--fs-11);cursor:pointer;padding:0}
.savehint button:hover{text-decoration:underline}

/* ── Màn success (12/13): panel chiếm trọn canvas, hrm-result ở giữa ── */
.panel{background:var(--bg-surface);border:1px solid var(--border-sub);border-radius:var(--radius-lg)}
.panel.grow{flex:1;display:flex;align-items:center;justify-content:center;padding:40px 20px}
.rs-body{display:flex;flex-direction:column;align-items:center;gap:var(--space-2)}
.file-chip{display:inline-flex;align-items:center;gap:9px;border:1px solid var(--border-sub);
  border-radius:var(--radius-md);padding:9px 14px;background:var(--bg-surface-subtle);
  font-size:var(--fs-12);color:var(--text-body)}
.file-chip b{font-weight:var(--font-medium);color:var(--text-strong)}
.file-chip .sz{font-family:var(--font-mono);font-size:var(--fs-11);color:var(--text-sub)}
.fc-ic{width:30px;height:30px;border-radius:var(--radius-sm);background:var(--success-bg);
  color:var(--success-base);display:flex;align-items:center;justify-content:center;flex:none}
.res-acts{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap;justify-content:center}
.res-card{border:1px solid var(--border-sub);border-radius:var(--radius-lg);padding:14px 18px;
  margin-top:var(--space-2);text-align:left;min-width:360px;background:var(--bg-surface)}
.res-card .rc-t{font-size:var(--fs-13);font-weight:var(--font-semibold);color:var(--text-strong)}
.res-card .rc-r{display:flex;justify-content:space-between;gap:var(--space-4);font-size:var(--fs-12);
  color:var(--text-sub);margin-top:7px}
.res-card .rc-r b{color:var(--text-strong);font-weight:var(--font-medium);text-align:right}
  