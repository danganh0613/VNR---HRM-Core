
    /* Preview desktop lớn — dễ xem như màn hình thật. */
    .lp-desktop { height: 760px; border: 1px solid var(--border-sub); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-regular-sm); }
    .lp-full { margin-top: 14px; }
    .lp-full-link { text-decoration: none; }
    /* Preview (route /preview/list-page, tab mới) — khung phủ full viewport, bỏ viền/bo. */
    .lp-desktop--full { height: 100vh; border: 0; border-radius: 0; box-shadow: none; }
    /* Vùng nội dung: padding 0 để khối tiêu đề (breadcrumb+title+tab) chạy FULL-BLEED như top nav.
       Gutter 16px + gap đáy do panel bảng tự lo (margin 16px). */
    .lp-desktop ::ng-deep .shell-content { padding: 0; display: flex; flex-direction: column; min-height: 0; }
    /* Workspace là flex-item lấp đầy shell-content; list-page bên trong nó cũng lấp đầy chiều cao. */
    .lp-desktop ::ng-deep .shell-content hrm-data-workspace { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
    .lp-desktop ::ng-deep .shell-content hrm-data-workspace > hrm-list-page { flex: 1 1 auto; min-height: 0; }

    /* ── Thẻ view "Thẻ": nhận diện người + ĐỦ field/action như 1 dòng bảng ── */
    .ec { display: flex; flex-direction: column; gap: var(--space-2-5); }
    .ec-top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2); }
    .ec-meta { display: flex; flex-direction: column; gap: var(--space-1); }
    /* 1 dòng meta: icon xám + giá trị, cắt gọn 1 dòng. */
    .mrow { display: flex; align-items: center; gap: var(--space-1-5); min-width: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .mrow tabler-icon { flex: none; color: var(--text-soft); }
    .mrow span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .kc-meta { display: flex; flex-direction: column; gap: var(--space-0-5); }
    .ec-foot {
      display: flex; align-items: center; justify-content: space-between; gap: var(--space-2);
      padding-top: var(--space-2); border-top: 1px solid var(--border-soft);
    }

    /* ── Thẻ Kanban: GỌN hơn (cột hẹp, quét nhanh) ── */
    .kc { display: flex; flex-direction: column; gap: 8px; }
    .kc-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 6px; }
    .kc-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .kc-date { font-size: var(--fs-12); color: var(--text-sub); font-variant-numeric: tabular-nums; }

    /* ── Ô nhãn trái Gantt ── */
    .gl { display: flex; align-items: center; gap: 8px; min-width: 0; }

    /* Bỏ padding của surface (drawer/modal/master) KHI chứa form → footer ghim SÁT đáy (không hở gap);
       form tự lo padding đều. Gated :has(.ef) → không đụng nội dung chi tiết hay drawer khác. */
    ::ng-deep .ant-drawer-body:has(.ef),
    ::ng-deep .ant-modal-body:has(.ef),
    ::ng-deep .dp-mbody:has(.ef) { padding: 0 !important; }

    /* Chi tiết: BỎ padding-top của surface → action bar sticky ghim FLUSH sát header (không hở
       khe padding). Bù lại bằng padding-top của chính .pk (trong sg-emp-detail) → nhịp trên vẫn đều. */
    ::ng-deep .ant-drawer-body:has(sg-emp-detail),
    ::ng-deep .ant-modal-body:has(sg-emp-detail),
    ::ng-deep .dp-mbody:has(sg-emp-detail) { padding-top: 0 !important; }

    /* Form Thêm/Sửa nhân viên (nội dung peek) — chia section, body cuộn, footer ghim đáy. */
    .ef { display: flex; flex-direction: column; min-height: 100%; }
    .ef-body { flex: 1 1 auto; display: flex; flex-direction: column; gap: 24px; padding: 20px 20px 12px; }
    .ef-sec { display: flex; flex-direction: column; gap: 12px; }
    .ef-sec-h { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: var(--fs-13); font-weight: 700; color: var(--text-strong); padding-bottom: 8px; border-bottom: 1px solid var(--border-soft); }
    .ef-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
    .ef-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .ef-field--full { grid-column: 1 / -1; }
    .ef-lbl { font-size: var(--fs-13); font-weight: 500; color: var(--text-body); }
    .ef-req { color: var(--error-base); }

    /* Avatar upload — canh GIỮA phía trên, các field xếp bên dưới. */
    .ef-id { display: flex; flex-direction: column; align-items: center; gap: 16px; }
    .ef-id-fields { width: 100%; min-width: 0; }
    .ef-ava { position: relative; flex: none; width: 84px; height: 84px; border-radius: 50%; cursor: pointer; }
    .ef-ava-img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; }
    .ef-ava-ph { display: grid; place-items: center; width: 100%; height: 100%; border-radius: 50%; background: var(--bg-surface-subtle); border: 1px dashed var(--border-strong, var(--border-sub)); color: var(--text-soft); }
    .ef-ava-badge { position: absolute; right: -2px; bottom: -2px; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--primary-base); color: var(--text-on-primary); border: 2px solid var(--bg-surface); }
    .ef-ava-in { position: absolute; inset: 0; opacity: 0; cursor: pointer; }

    /* Kinh nghiệm làm việc */
    .ef-add { display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border: 1px solid var(--border-sub); border-radius: var(--radius-md); background: var(--bg-surface); color: var(--primary-base); font: inherit; font-size: var(--fs-12); font-weight: 600; cursor: pointer; }
    .ef-add:hover { border-color: var(--primary-base); background: var(--primary-bg-subtle); }
    .ef-exp { position: relative; padding: 12px; border: 1px solid var(--border-soft); border-radius: var(--radius-lg); background: var(--bg-surface-subtle); }
    .ef-exp + .ef-exp { margin-top: 10px; }
    .ef-exp-del { position: absolute; top: 8px; right: 8px; display: grid; place-items: center; width: 26px; height: 26px; border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer; color: var(--text-soft); }
    .ef-exp-del:hover { background: var(--bg-surface); color: var(--error-base); }

    /* Footer ghim đáy surface (sticky) — SÁT đáy, padding đều phải/dưới (20px). */
    /* Footer đặt trong slot [footer] của peek (.dp-mfoot đã lo padding 10/16 + border-top) → chỉ căn nút. */
    .ef-foot { display: flex; justify-content: flex-end; gap: 10px; }

    /* Footer modal (mode center): cụm hành động ghim chân — quy trình trái, Duyệt/Sửa phải. */
    .pkf { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; flex: 1 1 auto; width: 100%; }
    .pkf-sep { flex: 1 1 auto; }
    /* (CSS chi tiết bản ghi nằm trong component sg-emp-detail — dùng chung mọi surface.) */
    /* Ẩn thanh chuyển chế độ nội bộ của hrm-data-view (bộ chuyển đã đưa lên tầng tab ngoài panel). */
    .lp-desktop ::ng-deep hrm-data-view .dv-bar { display: none; }
    /* Lưới dữ liệu ĐƠN: mỗi ô đúng 1 dòng — hẹp thì cắt/cuộn ngang, KHÔNG rớt 2 dòng. */
    .lp-desktop ::ng-deep .ant-table-tbody > tr > td,
    .lp-desktop ::ng-deep .ant-table-thead > tr > th { white-space: nowrap; }

    /* Nút Bộ lọc (slot wsFilterPanel) khi có điều kiện bật — viền primary + badge đếm.
       ⚠ list-page (host component này) ENCAPSULATION EMULATED → ::ng-deep mới xuyên vào .ant-btn
       (nội dung project vào workspace vẫn giữ style-context của component khai báo = list-page). */
    .tbx-on ::ng-deep .ant-btn { border-color: var(--primary-base) !important; color: var(--primary-base) !important; }
    .tbx-badge { display: inline-grid; place-items: center; min-width: 18px; height: 18px; padding: 0 5px; margin-left: 2px; border-radius: var(--radius-full); background: var(--primary-base); color: var(--text-on-primary); font-size: var(--fs-11); font-weight: 600; line-height: 1; }

    /* Panel Bộ lọc trong popover. */
    .flt { display: flex; flex-direction: column; gap: 14px; min-width: 220px; }
    .flt-grp { display: flex; flex-direction: column; gap: 8px; }
    .flt-h { font-size: var(--fs-12); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--text-sub); }
    .flt-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding-top: 10px; border-top: 1px solid var(--border-soft); }
    .flt-res { font-size: var(--fs-12); color: var(--text-soft); }
  