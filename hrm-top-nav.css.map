
:host { display: block; }
.tn {
  position: relative;
  display: flex; align-items: center; gap: 16px; height: 56px; padding: 0 16px;
  background: var(--bg-surface); border-bottom: 1px solid var(--border-sub); font-family: var(--font-sans);
}
.tn-brand { display: flex; align-items: center; gap: 8px; flex: none; }
.tn-logo { height: 28px; width: auto; }
/* Menu điều hướng — cuộn NGANG khi hẹp (không tràn/đè vùng actions bên phải).
   Ẩn thanh cuộn cho gọn; items giữ nowrap và cuộn thay vì rớt/đè. */
.tn-items {
  display: flex; align-items: center; gap: 2px; flex: 1 1 auto; min-width: 0;
  overflow-x: auto; overflow-y: hidden;
  scrollbar-width: none; -ms-overflow-style: none;
}
.tn-items::-webkit-scrollbar { display: none; }
.tn-item { flex: none; }
.tn--center .tn-items { justify-content: center; }
.tn-item {
  display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px;
  border: 0; background: transparent; border-radius: var(--radius-lg); cursor: pointer;
  font-size: var(--fs-14); font-weight: 400; color: var(--text-body); font-family: inherit; white-space: nowrap;
  transition: background var(--duration-fast, .15s) var(--ease-out, ease), color var(--duration-fast, .15s) var(--ease-out, ease);
}
.tn-item:hover:not(:disabled) { background: var(--bg-surface-subtle); color: var(--text-strong); }
.tn-item:disabled { color: var(--text-disabled); cursor: not-allowed; }
.tn-item.is-active { background: var(--primary-bg-subtle); color: var(--primary-base); font-weight: 500; }
:host-context(.dark) .tn-item.is-active { color: var(--text-strong); }
.tn-badge {
  font-size: var(--fs-11); font-weight: 600; line-height: 1; padding: 3px 7px; border-radius: var(--radius-full);
  background: var(--primary-bg-soft); color: var(--primary-base);
}
.tn-flex { display: flex; align-items: center; gap: 8px; flex: 0 1 auto; min-width: 0; margin-left: auto; }

/* Hamburger — icon 3 gạch bằng CSS (không phụ thuộc icon lib), mở/đóng thành X. */
.tn-burger {
  flex: none; place-items: center; width: 36px; height: 36px; margin-left: 4px;
  border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md);
  cursor: pointer; color: var(--text-body);
}
.tn-burger:hover { border-color: var(--primary-base); color: var(--text-strong); }
.tn-burger:focus-visible { outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: 1px; }
.tn-burger-ic, .tn-burger-ic::before, .tn-burger-ic::after {
  content: ''; display: block; width: 18px; height: 2px; border-radius: var(--radius-full);
  background: currentColor; transition: transform var(--duration-fast, .15s) var(--ease-out, ease), opacity var(--duration-fast, .15s) var(--ease-out, ease);
}
.tn-burger-ic { position: relative; }
.tn-burger-ic::before { position: absolute; top: -6px; left: 0; }
.tn-burger-ic::after  { position: absolute; top: 6px; left: 0; }
.tn-burger.is-open .tn-burger-ic { background: transparent; }
.tn-burger.is-open .tn-burger-ic::before { transform: translateY(6px) rotate(45deg); }
.tn-burger.is-open .tn-burger-ic::after  { transform: translateY(-6px) rotate(-45deg); }

/* Drawer menu dọc — panel dưới header khi compact. */
.tn-drawer {
  position: absolute; top: 100%; left: 8px; right: 8px; z-index: 40; margin-top: 6px;
  flex-direction: column; gap: 2px; padding: 6px;
  background: var(--bg-surface); border: 1px solid var(--border-sub);
  border-radius: var(--radius-xl); box-shadow: var(--shadow-regular-md);
}
.tn-drawer-item {
  display: flex; align-items: center; gap: 10px; width: 100%; padding: 10px 12px;
  border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer;
  font-size: var(--fs-14); color: var(--text-body); font-family: inherit; text-align: left;
}
.tn-drawer-item:hover:not(:disabled) { background: var(--bg-surface-subtle); color: var(--text-strong); }
.tn-drawer-item:disabled { color: var(--text-disabled); cursor: not-allowed; }
.tn-drawer-item.is-active { background: var(--primary-bg-subtle); color: var(--primary-base); font-weight: 500; }
.tn-drawer-item .tn-badge { margin-left: auto; }

/* ── Responsive (class .tn--compact do JS bật khi bề rộng nav < 820px — ResizeObserver
   đo bề rộng THỰC của top-nav, không viewport). Mặc định rộng: menu inline. ── */
.tn-burger, .tn-drawer { display: none; }
.tn--compact .tn-items { display: none; }
.tn--compact .tn-burger { display: grid; }
.tn--compact .tn-drawer { display: flex; }
  