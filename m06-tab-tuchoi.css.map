
    :host { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; gap: 8px; }
    .t4-toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .t4-split { flex: 1 1 auto; min-height: 480px; display: flex; gap: 12px; align-items: stretch; }
    .t4-main { flex: 1 1 auto; min-width: 0; overflow: auto; }
    .t4-empty { padding: 40px 0; display: flex; justify-content: center; }
    .t4-stack { display: flex; flex-direction: column; gap: 3px; align-items: flex-start; min-width: 0; }
    .t4-mono { font-family: var(--font-mono, monospace); font-size: var(--fs-12); font-weight: 600; color: var(--text-strong); }
    .t4-strong { color: var(--text-strong); font-weight: 600; }
    .t4-muted { font-size: var(--fs-12); color: var(--text-sub); }
    .t4-muted b { color: var(--text-strong); }
    .t4-err { font-size: var(--fs-12); color: var(--error-text); font-weight: 500; }
    .t4-ok { font-size: var(--fs-12); color: var(--success-text); font-weight: 500; margin: 0; }
    .t4-pk { display: flex; flex-direction: column; gap: 10px; font-size: var(--fs-13); }
    .t4-pk__mota { margin: 0; font-weight: 600; color: var(--text-strong); }
    .t4-his { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; border-bottom: 1px dashed var(--border-soft); padding: 3px 0; font-size: var(--fs-12); }
    .t4-acts { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .t4-dr { display: flex; align-items: center; gap: 10px; border: 1px solid var(--border-sub); border-radius: var(--radius-md); padding: 8px 10px; }
    .t4-dr--on { border-color: var(--primary-base); background: var(--primary-bg, var(--bg-surface-subtle)); }
    .t4-dr__body { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
    .t4-form { display: flex; flex-direction: column; gap: 8px; }
  