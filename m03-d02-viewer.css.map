
    .d02 { display: flex; flex-direction: column; gap: 14px; font-size: var(--fs-13); }

    .d02__a07 { display: block; }

    .d02__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
    .d02__bieumau, .d02__ban { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .d02__lbl { font-size: var(--fs-11); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--text-soft); }
    .d02__bieumau-v { font-size: var(--fs-14); font-weight: 700; color: var(--text-strong); }

    .d02__thutuc { margin: 0; font-size: var(--fs-12); color: var(--text-sub);
      padding: 7px 10px; border: 1px solid var(--border-soft); border-radius: var(--radius-md); background: var(--bg-surface-subtle); }
    .d02__thutuc b { color: var(--text-strong); font-weight: 600; }

    .d02__sec { display: flex; flex-direction: column; gap: 8px; padding-top: 12px; border-top: 1px solid var(--border-soft); }

    .d02__records { display: flex; flex-direction: column; gap: 10px; }
    .d02__rec { display: flex; flex-direction: column; gap: 7px; padding: 10px 12px;
      border: 1px solid var(--border-soft); border-radius: var(--radius-lg); background: var(--bg-surface); }
    .d02__rec--cd { background: var(--bg-surface-subtle); border-style: dashed; }
    .d02__rec-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
    .d02__rec-id { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .d02__rec-name { font-size: var(--fs-14); font-weight: 700; color: var(--text-strong); }
    .d02__rec-sub { font-size: var(--fs-12); color: var(--text-sub); }
    .d02__rec-tags { display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    :host ::ng-deep .d02__rec-tags .ant-tag { margin: 0; }

    .d02__tk1-note { display: block; }
    .d02__tk1-list { display: flex; flex-direction: column; border: 1px solid var(--border-sub); border-radius: var(--radius-md); overflow: hidden; }
    .d02__tk1-row { display: flex; align-items: center; justify-content: space-between; gap: 10px;
      padding: 8px 12px; border-bottom: 1px solid var(--border-soft); }
    .d02__tk1-row:last-child { border-bottom: 0; }
    .d02__tk1-suk { font-size: var(--fs-12); color: var(--text-sub); text-align: right; min-width: 0; overflow-wrap: anywhere; }

    .d02__foot { margin: 0; font-size: var(--fs-11); color: var(--text-soft); line-height: 1.5; }
  