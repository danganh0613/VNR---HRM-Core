
:host { display: inline-block; }

/* Pill trigger */
.qf {
  display: inline-flex; align-items: center; gap: 6px;
  /* KHÔNG cố định pill: --radius-lg ăn theo --radius-scale của config theme Bo góc
     (Vuông ≈ 5px · Mặc định 10px · Bo tròn 16px = pill với chiều cao nút này). */
  padding: 5px 12px; border-radius: var(--radius-lg); cursor: pointer;
  background: var(--bg-surface); border: 1px solid var(--border-sub);
  font-family: var(--font-sans); font-size: var(--fs-13); color: var(--text-body);
  transition: border-color var(--duration-fast, .15s) var(--ease-out, ease),
              background var(--duration-fast, .15s) var(--ease-out, ease);
}
.qf:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
/* Đã chọn: chỉ đổi viền sang brand (không đảo nền) — theo spec DS. */
.qf--active { border-color: var(--primary-base); }
.qf-ic { flex: none; color: var(--text-sub); }
.qf-x { flex: none; display: grid; place-items: center; width: 16px; height: 16px;
  border-radius: var(--radius-full); color: var(--text-sub); }
.qf-x:hover { color: var(--text-strong); background: var(--bg-surface-subtle); }
.qf-label { white-space: nowrap; }
.qf-sep { width: 1px; align-self: stretch; margin: 1px 2px; background: var(--border-sub); }
/* Số lượng/giá trị chọn — đậm hơn nhãn 1 nấc. */
.qf-count { white-space: nowrap; font-weight: 600; color: var(--text-strong); }
.qf:focus-visible { outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: 1px; }

/* Panel (render trong overlay nz-dropdown — vẫn là template của component nên style scoped ăn) */
.qf-panel {
  min-width: 240px; max-width: 320px; padding: 6px;
  background: var(--bg-surface); border: 1px solid var(--border-sub);
  border-radius: var(--radius-xl); box-shadow: var(--shadow-regular-md);
  font-family: var(--font-sans);
}
.qf-search { display: flex; align-items: center; gap: 8px; padding: 4px 10px 8px; border-bottom: 1px solid var(--border-soft); }
.qf-search-ic { flex: none; color: var(--text-soft); }
.qf-search-in.ant-input.ant-input {
  flex: 1; min-width: 0; padding: 4px 0; border: 0; background: transparent; box-shadow: none;
  font-size: var(--fs-13); color: var(--text-body);
}
.qf-search-in.ant-input::placeholder { color: var(--text-soft); }
/* Hàng "Chọn tất cả" — divider dưới tách khỏi danh mục, cùng tông divider phụ với ô tìm (border-soft).
   Prefix .qf-row để thắng rule .qf-row (border: 0) đứng sau — cùng specificity thì rule sau thắng. */
.qf-row.qf-all { border: 0; border-bottom: 1px solid var(--border-soft); border-radius: 0; margin-bottom: 4px; }
.qf-all-ic { flex: none; color: var(--text-sub); }
/* Đã chọn hết → hành động đảo là XOÁ: chữ + icon đỏ, hover giữ đỏ (chỉ nền đổi).
   Prefix .qf-row để thắng tie specificity với .qf-row:hover đứng sau. */
.qf-row.qf-all--clear,
.qf-row.qf-all--clear:hover:not(:disabled),
.qf-row.qf-all--clear .qf-all-ic { color: var(--error-base); }
.qf-list { max-height: 300px; overflow-y: auto; display: flex; flex-direction: column; }
.qf-row {
  display: flex; align-items: center; gap: 10px; width: 100%;
  padding: 8px 10px; border: 0; background: transparent; cursor: pointer;
  border-radius: var(--radius-md); text-align: left;
  font-family: inherit; font-size: var(--fs-13); color: var(--text-body);
}
.qf-row:hover:not(:disabled) { background: var(--bg-surface-subtle); color: var(--text-strong); }
.qf-row:disabled { color: var(--text-disabled); cursor: not-allowed; }
.qf-row--picked { color: var(--text-strong); }
/* Checkbox hiển-thị-thuần trong row — click/keyboard do row đảm nhận, chặn tương tác trực tiếp. */
.qf-cb { flex: none; pointer-events: none; }
.qf-cb ::ng-deep .ant-checkbox + span { display: none; }
.qf-row-label { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.qf-tick { flex: none; color: var(--text-strong); }
.qf-empty { padding: 14px 10px; font-size: var(--fs-13); color: var(--text-soft); text-align: center; }
  