
:host { display: block; }
.sn {
  position: relative;
  display: flex; flex-direction: column; gap: 4px;
  width: 264px; padding: 12px 10px;
  background: var(--bg-surface); border-right: 1px solid var(--border-sub);
  font-family: var(--font-sans); overflow: hidden; min-height: 0;
  transition: width var(--duration-normal, .22s) var(--ease-out, ease);
}
.sn.is-collapsed { width: 72px; padding: 12px 8px; align-items: stretch; }

/* Ghim: brand (top) + foot (bottom) cố định; chỉ .sn-scroll (danh sách nav) cuộn dọc. */
.sn-brand, .sn-brand-mark, .sn-head, .sn-search, .sn-foot { flex: none; }
.sn-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; }

/* Header — logo + actions + toggle */
.sn-brand {
  display: flex; align-items: center; gap: 8px;
  padding: 4px 6px 12px; margin-bottom: 6px; border-bottom: 1px solid var(--border-soft);
}
.sn-brand-logo { height: 30px; width: auto; flex: 1; min-width: 0; object-fit: contain; object-position: left center; }
.sn-brand-act { display: flex; align-items: center; gap: 2px; flex: none; }
.sn-iconbtn {
  display: grid; place-items: center; width: 34px; height: 34px;
  border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub);
}
.sn-iconbtn:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
/* Collapsed header — mark + hover expand */
.sn-brand-mark {
  position: relative; display: flex; justify-content: center; align-items: center;
  height: 44px; margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid var(--border-soft);
}
.sn-mark-logo { height: 30px; width: auto; transition: opacity var(--duration-fast, .15s) var(--ease-out, ease); }
.sn-expand {
  position: absolute; inset: 0 0 8px 0; margin: auto;
  display: grid; place-items: center; width: 34px; height: 34px;
  border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md);
  cursor: pointer; color: var(--text-sub); opacity: 0; transition: opacity var(--duration-fast, .15s) var(--ease-out, ease);
  box-shadow: var(--shadow-regular-xs);
}
.sn-brand-mark:hover .sn-mark-logo { opacity: 0; }
.sn-brand-mark:hover .sn-expand { opacity: 1; }
.sn-expand:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }

.sn-sec { display: flex; flex-direction: column; gap: 2px; }
.sn-sec + .sn-sec { margin-top: 14px; }
.sn-header {
  font-size: var(--fs-11); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;
  color: var(--text-soft); padding: 10px 10px 4px;
}
.sn-group { position: relative; }
.sn-item {
  display: flex; align-items: center; gap: 10px; width: 100%;
  padding: 8px 10px; border: 0; background: transparent; cursor: pointer;
  border-radius: var(--radius-lg); text-align: left;
  font-size: var(--fs-14); font-weight: 400; color: var(--text-body); font-family: inherit;
  transition: background var(--duration-fast, .15s) var(--ease-out, ease), color var(--duration-fast, .15s) var(--ease-out, ease);
}
.sn-item:hover:not(:disabled) { background: var(--bg-surface-subtle); color: var(--text-strong); }
.sn-item:disabled { color: var(--text-disabled); cursor: not-allowed; }
.sn-item.is-active {
  background: var(--primary-bg-subtle); color: var(--primary-base); font-weight: 500;
}
/* Hover TRÊN mục đang chọn — đậm hơn 1 nấc để vẫn có phản hồi (không "chết" bằng nền active). */
.sn-item.is-active:hover:not(:disabled) { background: var(--primary-bg-soft); color: var(--primary-base); }
:host-context(.dark) .sn-item.is-active { color: var(--text-strong); }

/* Focus bàn phím — vòng focus rõ trên mọi phần tử bấm được (WCAG 2.4.7). */
.sn-item:focus-visible,
.sn-fly-item:focus-visible,
.sn-iconbtn:focus-visible,
.sn-expand:focus-visible,
.sn-user:focus-visible,
.sn-switch:focus-visible,
.sn-search-clr:focus-visible {
  outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: 1px;
}

/* Cha (đóng nhóm) chứa mục đang chọn — nhãn đậm + màu để biết trang hiện tại nằm trong nhóm này. */
.sn-parent.has-active:not(.is-open) { color: var(--text-strong); font-weight: 500; }
.sn-parent.has-active:not(.is-open) .sn-ic { color: var(--primary-base); }
.sn-ic { flex: none; }
.sn-label { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sn-caret { flex: none; color: var(--text-soft); transition: transform var(--duration-fast, .15s) var(--ease-out, ease); }
.sn-parent.is-open .sn-caret { transform: rotate(90deg); }
.sn-children { display: flex; flex-direction: column; gap: 2px; margin: 2px 0 2px 30px; }
.sn-child { padding: 7px 10px; font-weight: 400; }
.sn-badge {
  flex: none; font-size: var(--fs-11); font-weight: 600; line-height: 1;
  padding: 3px 7px; border-radius: var(--radius-full);
  background: var(--primary-bg-soft); color: var(--primary-base);
}
.sn-trail { flex: none; font-size: var(--fs-12); color: var(--text-soft); }
.sn-head { padding: 2px 4px 12px; margin-bottom: 4px; border-bottom: 1px solid var(--border-soft); }
.sn-head:empty { display: none; }

/* Ô tìm kiếm nhóm/component (variant searchable) */
.sn-search {
  display: flex; align-items: center; gap: 8px; margin: 2px 4px 10px; padding: 7px 10px;
  background: var(--bg-surface-subtle); border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
}
.sn-search:focus-within { border-color: var(--primary-base); }
.sn-search-ic { flex: none; color: var(--text-soft); }
.sn-search-in {
  flex: 1; min-width: 0; border: 0; background: transparent; outline: none;
  font-family: inherit; font-size: var(--fs-13); color: var(--text-body);
}
.sn-search-in::placeholder { color: var(--text-soft); }
.sn-search-clr {
  flex: none; display: grid; place-items: center; width: 18px; height: 18px; padding: 0;
  border: 0; background: transparent; cursor: pointer; color: var(--text-soft); border-radius: var(--radius-sm);
}
.sn-search-clr:hover { color: var(--text-strong); background: var(--bg-surface); }
.sn-empty { padding: 16px 12px; font-size: var(--fs-13); color: var(--text-soft); text-align: center; }

/* Flyout nhóm khi collapsed — HOVER icon cha ra popup con (click con để chọn). */
.sn-flyout {
  display: none; position: absolute; left: calc(100% + 8px); top: 0; z-index: 30;
  min-width: 190px; padding: 6px; background: var(--bg-surface);
  border: 1px solid var(--border-sub); border-radius: var(--radius-xl); box-shadow: var(--shadow-regular-md);
}
/* Cầu nối phủ khoảng hở 8px giữa rail và flyout — chuột băng qua không rớt :hover (đóng sớm). */
.sn-flyout::before { content: ''; position: absolute; left: -8px; top: 0; bottom: 0; width: 8px; }
.sn.is-collapsed .sn-group:hover .sn-flyout { display: block; }
.sn-flyout-h { font-size: var(--fs-11); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-soft); padding: 6px 10px 4px; }
.sn-fly-item {
  display: flex; align-items: center; gap: 8px; width: 100%; padding: 7px 10px;
  border: 0; background: transparent; cursor: pointer; border-radius: var(--radius-md);
  font-size: var(--fs-14); color: var(--text-body); font-family: inherit; text-align: left;
}
.sn-fly-item:hover:not(:disabled) { background: var(--bg-surface-subtle); color: var(--text-strong); }
.sn-fly-item.is-active { background: var(--primary-bg-subtle); color: var(--primary-base); }
.sn-fly-item .sn-badge { margin-left: auto; }

/* Footer (khối tài khoản người dùng) — ghim đáy side nav */
.sn-head, .sn-foot { display: flex; }
.sn-foot { padding: 10px 4px 2px; border-top: 1px solid var(--border-soft); }
.sn-foot:empty { display: none; }

/* Khối user mặc định — avatar + tên + email + nút Chuyển tài khoản. */
.sn-user { display: flex; align-items: center; gap: 10px; width: 100%; padding: 6px 8px; border: 0;
  background: transparent; border-radius: var(--radius-lg); cursor: pointer; text-align: left; }
.sn-user:hover { background: var(--bg-surface-subtle); }
.sn-uav { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
  overflow: hidden; background: var(--primary-base); color: var(--text-on-primary, #fff); font-size: var(--fs-13); font-weight: 600; }
.sn-uav img { width: 100%; height: 100%; object-fit: cover; }
.sn-uinfo { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.sn-uname { font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sn-umail { font-size: var(--fs-12); color: var(--text-sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sn-switch { flex: none; display: inline-flex; color: var(--text-soft); padding: 2px; border-radius: var(--radius-sm); }
.sn-switch:hover { color: var(--text-strong); background: var(--bg-surface-subtle); }
.sn.is-collapsed .sn-user { justify-content: center; padding: 6px 0; }

/* Collapsed rail: ẩn nhãn/badge/trail/caret; mục chọn/hover = Ô VUÔNG bao quanh icon (không phải hình chữ nhật) */
.sn.is-collapsed .sn-label,
.sn.is-collapsed .sn-badge,
.sn.is-collapsed .sn-trail,
.sn.is-collapsed .sn-caret { display: none; }
.sn.is-collapsed .sn-item { width: 40px; height: 40px; padding: 0; margin: 0 auto; justify-content: center; gap: 0; }
/* Collapsed: icon CHA chứa mục đang chọn = ô active (định vị "đang ở nhóm này" trên rail). */
.sn.is-collapsed .sn-parent.has-active { background: var(--primary-bg-subtle); }
.sn.is-collapsed .sn-parent.has-active .sn-ic { color: var(--primary-base); }
/* Cha DISABLED: không bung flyout khi hover. */
.sn.is-collapsed .sn-group:has(.sn-parent:disabled):hover .sn-flyout { display: none; }
/* Collapsed: flyout con nằm NGOÀI bề rộng rail → phải bỏ clip overflow để hiện (nhãn đã ẩn nên
   overflow visible không lộ gì; rail icon-only hiếm khi cần cuộn dọc). */
/* Thu gọn: aside cho tràn (không cần), NHƯNG .sn-scroll VẪN cuộn dọc (overflow-y:auto kế thừa
   từ rule gốc) để rail dài hơn màn hình không bị cắt icon dưới. Flyout dùng position:fixed
   (toạ độ set bằng JS khi hover) nên thoát khỏi overflow của .sn-scroll, không bị clip. */
.sn.is-collapsed { overflow: visible; }
.sn.is-collapsed .sn-flyout { position: fixed; }
.sn.is-collapsed .sn-head, .sn.is-collapsed .sn-foot { justify-content: center; padding-left: 0; padding-right: 0; }
  