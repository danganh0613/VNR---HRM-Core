
:host {
  position: relative; display: flex; align-items: center; gap: 14px; isolation: isolate;
  height: 96px; padding: 0 20px; overflow: hidden;
  background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-2xl);
}
/* Chiều tall: dọc, cao cố định 152px — icon trên, số/nhãn canh mép DƯỚI. Tỉ lệ ~3:2 gọn mắt,
   không để khoảng trống chết ở giữa. */
:host([data-orientation='tall']) {
  flex-direction: column; align-items: flex-start; justify-content: space-between;
  height: 152px; padding: 18px 20px; gap: 0;
}
:host([data-orientation='tall']) .sc-body { flex: none; }

/* variant gradient: nền gradient + chữ trắng, không viền. */
:host([data-variant='gradient']) {
  border: 0; color: var(--static-white, #fff);
  background: linear-gradient(150deg, var(--_g1, var(--purple-400)) 0%, var(--_g2, var(--purple-600)) 100%);
}
/* Vòng tròn đồng tâm mờ toả từ góc dưới-phải (hoạ tiết nền, chỉ gradient). */
:host([data-variant='gradient'])::before {
  content: ''; position: absolute; right: -60px; bottom: -72px; width: 300px; height: 300px; z-index: -1;
  border-radius: 50%; pointer-events: none;
  background: repeating-radial-gradient(circle at center, transparent 0 22px, rgba(255,255,255,.07) 22px 24px);
}
:host([data-variant='gradient'][data-gradient='blue'])   { --_g1: var(--blue-400);   --_g2: var(--blue-600);   --_ic: var(--blue-600); }
:host([data-variant='gradient'][data-gradient='cyan'])   { --_g1: var(--cyan-400);   --_g2: var(--blue-500);   --_ic: var(--cyan-600); }
:host([data-variant='gradient'][data-gradient='teal'])   { --_g1: var(--teal-400);   --_g2: var(--teal-600);   --_ic: var(--teal-600); }
:host([data-variant='gradient'][data-gradient='green'])  { --_g1: var(--green-400);  --_g2: var(--teal-600);   --_ic: var(--green-600); }
:host([data-variant='gradient'][data-gradient='purple']) { --_g1: var(--purple-400); --_g2: var(--purple-600); --_ic: var(--purple-600); }
:host([data-variant='gradient'][data-gradient='pink'])   { --_g1: var(--pink-400);   --_g2: var(--purple-600); --_ic: var(--pink-600); }
:host([data-variant='gradient'][data-gradient='amber'])  { --_g1: var(--amber-400);  --_g2: var(--amber-600);  --_ic: var(--amber-600); }
:host([data-variant='gradient'][data-gradient='yellow']) { --_g1: var(--yellow-400); --_g2: var(--amber-500);  --_ic: var(--amber-600); }
:host([data-variant='gradient'][data-gradient='indigo']) { --_g1: var(--blue-500);   --_g2: var(--purple-700); --_ic: var(--blue-700); }

/* Icon phóng to mờ góc phải (hoạ tiết) — 1 màu bán trong suốt, đồng bộ 2 kiểu:
   gradient = TRẮNG mờ; trắng-viền = ĐEN mờ (tương phản nền). */
.sc-bigicon { position: absolute; right: -10px; bottom: -14px; z-index: -1; color: rgba(255,255,255,.2); line-height: 0; }
:host([data-variant='default']) .sc-bigicon { color: color-mix(in srgb, var(--text-strong) 7%, transparent); }

/* Huy hiệu icon — nền GRADIENT theo tone + icon TRẮNG (default). */
.sc-ic {
  flex: none; width: 46px; height: 46px; border-radius: var(--radius-lg); display: grid; place-items: center;
  color: var(--static-white, #fff);
}
.sc-ic[data-tone='primary'] { background: linear-gradient(135deg, color-mix(in srgb, var(--primary-base) 62%, var(--static-white)), var(--primary-base)); }
.sc-ic[data-tone='success'] { background: linear-gradient(135deg, var(--green-400), var(--green-600)); }
.sc-ic[data-tone='warning'] { background: linear-gradient(135deg, var(--amber-400), var(--amber-600)); }
.sc-ic[data-tone='info']    { background: linear-gradient(135deg, var(--cyan-400), var(--blue-500)); }
.sc-ic[data-tone='neutral'] { background: linear-gradient(135deg, color-mix(in srgb, var(--text-sub) 60%, var(--static-white)), var(--text-sub)); }
/* gradient variant: huy hiệu nền trắng, icon tô màu hue (ngược lại). */
:host([data-variant='gradient']) .sc-ic { background: var(--static-white, #fff); color: var(--_ic, var(--primary-base)); box-shadow: 0 4px 12px rgba(0,0,0,.12); }

.sc-body { flex: 1; min-width: 0; }
.sc-top { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
.sc-value { font-size: var(--fs-26); font-weight: 700; line-height: 1.15; color: var(--text-strong); font-variant-numeric: tabular-nums; }
:host([data-variant='gradient']) .sc-value { color: var(--static-white, #fff); }
/* Nhãn (subtext) — to + đậm hơn chút cho dễ đọc. */
.sc-label { margin-top: 2px; font-size: var(--fs-15); font-weight: 500; color: var(--text-sub); line-height: 1.35; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
:host([data-variant='gradient']) .sc-label { color: rgba(255,255,255,.92); }
/* tall: số to hơn chút, icon huy hiệu 48px. */
:host([data-orientation='tall']) .sc-value { font-size: var(--fs-28); }
:host([data-orientation='tall']) .sc-ic { width: 48px; height: 48px; }
:host([data-orientation='tall']) .sc-bigicon { right: -12px; bottom: -16px; }
:host([data-orientation='tall']) .sc-bigicon ::ng-deep svg { width: 124px; height: 124px; }
.sc-delta { font-size: var(--fs-12); font-weight: 500; white-space: nowrap; }
.sc-delta[data-tone='up']      { color: var(--success-base); }
.sc-delta[data-tone='down']    { color: var(--error-base); }
.sc-delta[data-tone='neutral'] { color: var(--text-sub); }
:host([data-variant='gradient']) .sc-delta { color: rgba(255,255,255,.9); }

.sc-chart { flex: none; align-self: center; display: flex; align-items: center; }
.sc-chart:empty { display: none; }
  