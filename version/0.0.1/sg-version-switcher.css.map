
    /* Pill ghim góc TRÊN phải — vị trí switcher kiểu ng.ant.design (không đè nút config ở góc dưới). */
    :host { position: fixed; top: 14px; right: 18px; z-index: 800; display: inline-flex; }

    .vs-btn {
      display: inline-flex; align-items: center; gap: 6px;
      height: 34px; padding: 0 10px 0 12px;
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
      background: var(--bg-surface); box-shadow: var(--shadow-regular-xs);
      cursor: pointer; font-family: var(--font-sans);
      color: var(--text-strong);
      transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
    }
    .vs-btn:hover, .vs-btn.on { border-color: var(--primary-base); box-shadow: var(--shadow-regular-sm); }
    .vs-cur { font-size: var(--fs-13); font-weight: 600; font-variant-numeric: tabular-nums; }
    .vs-tag {
      font-size: var(--fs-11, 11px); font-weight: 500; line-height: 1;
      padding: 2px 6px; border-radius: var(--radius-full, 999px);
      background: var(--primary-bg-subtle); color: var(--primary-base);
    }
    .vs-chev { color: var(--text-soft); }

    .vs-backdrop { position: fixed; inset: 0; z-index: var(--z-dropdown, 1000); }
    .vs-menu {
      position: absolute; top: calc(100% + 8px); right: 0; z-index: var(--z-popover, 1010);
      min-width: 190px; max-height: min(60vh, 420px); overflow-y: auto;
      padding: 6px; display: flex; flex-direction: column; gap: 2px;
      background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: var(--radius-xl); box-shadow: var(--shadow-regular-md);
    }
    .vs-item {
      display: flex; align-items: center; gap: 8px;
      padding: 8px 10px; border: 0; border-radius: var(--radius-md);
      background: transparent; cursor: pointer; text-align: left;
      font-family: var(--font-sans); font-size: var(--fs-14); color: var(--text-body);
      transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
    }
    .vs-item:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
    .vs-item.on { background: var(--primary-bg-subtle); color: var(--primary-base); font-weight: 600; }
    .vs-item-v { flex: 1; font-variant-numeric: tabular-nums; }
    .vs-item-tag { font-size: var(--fs-11, 11px); color: var(--text-soft); }
    .vs-item.on .vs-item-tag { color: var(--primary-base); }
    .vs-item-ck { color: var(--primary-base); }
  