
    :host {
      /* Branding xanh lá VnResource — nền gradient FULL trang. primary = xanh → hrm component tự bám. */
      --vnr-dark: #145300; --vnr-green: #1c7a0a; --vnr-lime: #8ec517;
      --primary-base: #1c7a0a;
      position: relative; display: block; height: 100vh; overflow: hidden; isolation: isolate;
      font-family: var(--font-sans); color: var(--text-body);
      background: linear-gradient(158deg, #0f4d00 0%, #256b0e 46%, #7fbf1f 100%);
    }
    /* Vòng tròn đồng tâm mờ trên nền xanh. */
    :host::before {
      content: ''; position: absolute; left: -160px; top: -160px; width: 720px; height: 720px; z-index: -1;
      border-radius: 50%; pointer-events: none;
      background: repeating-radial-gradient(circle at center, transparent 0 46px, rgba(255,255,255,.06) 46px 48px);
    }
    /* Thẻ đăng nhập (phải) : nền (trái) = 1.5 : 1 (form rộng hơn, gọn hơn tỉ lệ vàng). */
    .lg { display: grid; grid-template-columns: 1fr 1.5fr; height: 100vh; padding: 24px; gap: 24px; box-sizing: border-box; }

    /* ---- Trái: thương hiệu trên nền xanh ---- */
    .lg-brand { flex: 1; min-width: 0; color: #fff; display: flex; flex-direction: column; justify-content: flex-end; padding: 30px 26px; }
    .lg-logo { display: inline-flex; align-items: center; gap: 10px; }
    .lg-logo b { font-size: var(--fs-19); font-weight: 700; color: #fff; letter-spacing: -.01em; }
    .lg-quote { max-width: 540px; }
    .lg-q-text { font-size: var(--fs-26); line-height: 1.44; font-weight: 500; margin: 0 0 24px; }
    .lg-q-name { font-size: var(--fs-16); font-weight: 700; }
    .lg-q-role { font-size: var(--fs-14); color: rgba(255,255,255,.82); margin-top: 3px; }
    .lg-dots { display: flex; gap: 7px; margin-top: 24px; }
    .lg-dots i { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.4); }
    .lg-dots i.on { width: 22px; border-radius: 5px; background: #fff; }

    /* ---- Phải: thẻ đăng nhập ---- */
    .lg-form {
      min-width: 0; background: var(--bg-surface); border-radius: 26px;
      padding: 30px 46px; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,.18);
    }
    .lg-top { display: flex; align-items: center; justify-content: space-between; min-height: 40px; gap: 16px; }
    .lg-logo-img { height: 32px; width: auto; display: block; }
    .lg-reg { font-size: var(--fs-14); color: var(--text-sub); display: inline-flex; align-items: center; gap: 10px; white-space: nowrap; }
    /* Nút Đăng ký — chip nền tint (như cũ) nhưng màu tươi hơn (lime + chữ xanh sáng). */
    .lg-reg-btn { border: 0; cursor: pointer; font-weight: 600; color: #2f9e0e;
      background: color-mix(in srgb, var(--vnr-lime) 22%, transparent); padding: 6px 14px; border-radius: 10px; font-size: var(--fs-14);
      transition: background .15s; }
    .lg-reg-btn:hover { background: color-mix(in srgb, var(--vnr-lime) 34%, transparent); }

    .lg-card { flex: 1; display: flex; flex-direction: column; align-items: stretch; width: 100%; max-width: 372px; margin: 0 auto; justify-content: center; }
    .lg-avatar {
      width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; margin: 0 auto 16px;
      color: var(--vnr-green); background: var(--bg-surface);
      box-shadow: 0 0 0 1px var(--border-sub), 0 0 0 8px color-mix(in srgb, var(--vnr-lime) 16%, transparent);
    }
    .lg-title { font-size: var(--fs-26); font-weight: 700; color: var(--text-strong); text-align: center; margin: 0; }
    .lg-sub { font-size: var(--fs-14); color: var(--text-sub); text-align: center; margin: 6px 0 22px; }

    .lg-social { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .lg-social hrm-button ::ng-deep .ant-btn { height: 46px; }

    /* Divider "Hoặc" — dùng hrm-divider; chữ nhỏ + màu phụ. */
    .lg-card hrm-divider { display: block; margin: 18px 0; }
    .lg-card hrm-divider ::ng-deep .ant-divider-inner-text { font-size: var(--fs-12); color: var(--text-sub); font-weight: 500; }

    .lg-flag { font-size: var(--fs-15); line-height: 1; }

    .lg-field { display: block; margin-bottom: 16px; }
    .lg-label { display: block; font-size: var(--fs-14); font-weight: 500; color: var(--text-strong); margin-bottom: 7px; }
    .lg-label i { color: var(--vnr-lime); font-style: normal; }
    .lg-field hrm-input { display: block; width: 100%; }

    .lg-pass { position: relative; display: block; }
    .lg-eye { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); z-index: 2;
      border: 0; background: transparent; cursor: pointer; color: var(--text-sub); display: inline-flex; }
    .lg-eye:hover { color: var(--text-strong); }

    .lg-row { display: flex; align-items: center; justify-content: space-between; margin: 6px 0 22px; }
    .lg-forgot { border: 0; background: transparent; cursor: pointer; font-size: var(--fs-14); font-weight: 600; color: var(--vnr-green); }
    .lg-forgot:hover { text-decoration: underline; }

    .lg-foot { display: flex; align-items: center; justify-content: space-between; font-size: var(--fs-13); color: var(--text-sub); }
    .lg-lang { border: 0; background: transparent; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; color: var(--text-sub); font-size: var(--fs-13); }

    @media (max-width: 900px) { .lg-brand { display: none; } .lg-form { width: 100%; } }
  