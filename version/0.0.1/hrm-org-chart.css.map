
:host { display: block; }
.oc { display: flex; flex-direction: column; gap: 10px; font-family: var(--font-sans); }

/* Toolbar hợp nhất — 1 thanh nền trắng, bo góc theo token. Các nhóm nút + ô tìm cùng nằm trong.
   Ngăn cách nhóm bằng đường mảnh thay vì pill riêng. */
.oc-toolbar {
  display: flex; align-items: center; gap: 4px; flex-wrap: nowrap; min-width: 0;
  padding: 4px; box-sizing: border-box;
  background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
}
.oc-tb-grp {
  display: inline-flex; padding: 0; gap: 2px;
  background: transparent; border: 0; border-radius: 0;
}
/* Đường ngăn cách giữa các nhóm nút trong cùng thanh. */
.oc-tb-grp + .oc-tb-grp { margin-left: 4px; padding-left: 6px; border-left: 1px solid var(--border-soft, var(--border-sub)); }
.oc-tb-btn {
  display: grid; place-items: center; width: 32px; height: 32px; padding: 0; box-sizing: border-box;
  border: 0; background: transparent; cursor: pointer; color: var(--text-sub);
  border-radius: var(--radius-md); transition: background var(--duration-fast, .15s) var(--ease-out, ease);
}
.oc-tb-btn:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
.oc-tb-btn.is-on { background: var(--primary-bg-subtle); color: var(--primary-base); box-shadow: none; }
.oc-tb-wide { display: inline-flex; align-items: center; justify-content: center; width: auto; gap: 6px; padding: 0 12px; height: 32px; }
.oc-tb-lbl { font-size: var(--fs-13); font-weight: 500; white-space: nowrap; }
/* Rất hẹp → nút chế độ xem chỉ còn icon (bỏ nhãn) để nhường chỗ cho ô tìm bên phải. */
.oc-toolbar--tight .oc-tb-wide { width: 32px; padding: 0; gap: 0; }
.oc-toolbar--tight .oc-tb-lbl { display: none; }

/* Nút "⋮" + menu chứa nhóm nút bị thu gọn khi thanh công cụ hẹp. */
.oc-more { position: relative; display: inline-flex; flex: none; }
.oc-tb-grp + .oc-more { margin-left: 4px; padding-left: 6px; border-left: 1px solid var(--border-soft, var(--border-sub)); }
.oc-more-btn.is-on { background: var(--primary-bg-subtle); color: var(--primary-base); }
.oc-more-menu {
  position: absolute; top: calc(100% + 6px); right: 0; z-index: 30;
  display: flex; flex-direction: column; gap: 4px; padding: 6px;
  background: var(--bg-surface); border: 1px solid var(--border-sub);
  border-radius: var(--radius-lg); box-shadow: var(--shadow-regular-md);
}
.oc-more-grp { display: inline-flex; gap: 2px; }
.oc-more-grp + .oc-more-grp { margin-top: 4px; padding-top: 4px; border-top: 1px solid var(--border-soft, var(--border-sub)); }

.oc-viewport {
  position: relative; overflow: hidden; touch-action: none; cursor: grab;
  height: var(--org-height, 480px);
  /* Nền canvas ĐẬM hơn 1 chút để tách khỏi nền page content. */
  background: color-mix(in srgb, var(--bg-surface-subtle) 78%, var(--border-strong, var(--border-sub)));
  border: 1px solid var(--border-sub); border-radius: var(--radius-xl);
  background-image: radial-gradient(var(--border-strong, var(--border-sub)) 1px, transparent 1px); background-size: 22px 22px;
}
.oc-viewport:active { cursor: grabbing; }
.oc-canvas { position: absolute; top: 0; left: 0; transform-origin: 0 0; }
.oc-lines { position: absolute; top: 0; left: 0; overflow: visible; pointer-events: none; }
.oc-edge { fill: none; stroke: var(--border-strong, var(--border-sub)); stroke-width: 1.5; }
.oc-edge--dotted { stroke: var(--primary-base); stroke-dasharray: 4 4; opacity: .7; }

.oc-node {
  position: absolute; display: flex; align-items: center; gap: 10px; box-sizing: border-box;
  padding: 10px 12px; background: var(--bg-surface);
  border: 1px solid var(--border-sub); border-radius: var(--radius-lg); box-shadow: var(--shadow-regular-xs);
  cursor: pointer; transition: border-color var(--duration-fast, .15s) var(--ease-out, ease), box-shadow var(--duration-fast, .15s) var(--ease-out, ease);
}
.oc-node:hover { border-color: var(--primary-border, var(--primary-base)); box-shadow: var(--shadow-regular-sm); }
.oc-node.is-active { border-color: var(--primary-base); box-shadow: 0 0 0 3px var(--primary-bg-subtle); }
.oc-av {
  flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
  overflow: hidden; background: var(--primary-base); color: var(--text-on-primary, #fff); font-size: var(--fs-14); font-weight: 600;
}
.oc-av img { width: 100%; height: 100%; object-fit: cover; }
/* Avatar chữ: 8 màu hue theo tên (đồng bộ hrm-avatar) */
.oc-av[data-hue="0"] { background: var(--blue-600); }
.oc-av[data-hue="1"] { background: var(--green-600); }
.oc-av[data-hue="2"] { background: var(--amber-600); }
.oc-av[data-hue="3"] { background: var(--red-600); }
.oc-av[data-hue="4"] { background: var(--purple-600); }
.oc-av[data-hue="5"] { background: var(--teal-600); }
.oc-av[data-hue="6"] { background: var(--cyan-600); }
.oc-av[data-hue="7"] { background: var(--pink-600); }
.oc-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
.oc-name { font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.oc-title { font-size: var(--fs-12); color: var(--text-sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.oc-meta { font-size: var(--fs-11); color: var(--text-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.oc-badge {
  flex: none; align-self: flex-start; font-size: var(--fs-11); font-weight: 600; line-height: 1;
  padding: 3px 7px; border-radius: var(--radius-full); background: var(--primary-bg-soft); color: var(--primary-base);
}
.oc-toggle {
  position: absolute; left: 50%; bottom: -11px; transform: translateX(-50%);
  display: grid; place-items: center; width: 22px; height: 22px; padding: 0; z-index: 2;
  border: 1px solid var(--border-sub); background: var(--bg-surface); color: var(--text-sub);
  border-radius: 50%; cursor: pointer; box-shadow: var(--shadow-regular-xs);
}
.oc-toggle:hover { color: var(--primary-base); border-color: var(--primary-base); }
.oc-toggle--h { left: auto; bottom: auto; right: -11px; top: 50%; transform: translateY(-50%); }

/* Nút lẻ (Home) — nằm trong thanh trắng, cao 32px như các nút khác. */
.oc-tb-solo {
  width: 32px; height: 32px; border: 0; border-radius: var(--radius-md);
  background: transparent; color: var(--text-sub);
}
.oc-tb-solo:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }

/* Ô tìm nhân sự — cao 32px BẰNG các nút; LUÔN ghim bên phải (margin-left:auto) trong thanh
   toolbar. Khi hẹp → CO LẠI (flex-shrink) thay vì tràn ra ngoài mép phải. */
.oc-search {
  display: inline-flex; align-items: center; gap: 6px; margin-left: auto; box-sizing: border-box;
  flex: 0 1 auto; min-width: 84px;
  height: 32px; padding: 0 10px;
  background: var(--bg-surface-subtle); border: 1px solid var(--border-sub); border-radius: var(--radius-md);
}
.oc-search:focus-within { border-color: var(--primary-base); }
.oc-search-ic { flex: none; color: var(--text-soft); }
.oc-search-in { flex: 1; min-width: 0; border: 0; background: transparent; outline: none; font-family: inherit; font-size: var(--fs-13); color: var(--text-body); }
.oc-search-in::placeholder { color: var(--text-soft); }
.oc-search-n { flex: none; font-size: var(--fs-12); color: var(--text-soft); font-variant-numeric: tabular-nums; }
.oc-search-b { flex: none; display: grid; place-items: center; width: 20px; height: 20px; padding: 0; border: 0; background: transparent; cursor: pointer; color: var(--text-sub); border-radius: var(--radius-sm); }
.oc-search-b:hover:not(:disabled) { color: var(--text-strong); background: var(--bg-surface); }
.oc-search-b:disabled { color: var(--text-disabled); cursor: not-allowed; }

/* Legend — nổi góc TRÊN-PHẢI trong canvas (không bị pan/zoom). */
.oc-legend {
  position: absolute; top: 10px; right: 10px; z-index: 4;
  display: flex; gap: 14px; padding: 6px 10px;
  background: color-mix(in srgb, var(--bg-surface) 88%, transparent);
  border: 1px solid var(--border-sub); border-radius: var(--radius-md);
  box-shadow: var(--shadow-regular-xs); backdrop-filter: blur(4px);
}
.oc-lg { display: inline-flex; align-items: center; gap: 7px; font-size: var(--fs-12); color: var(--text-sub); }
.oc-lg-ln { width: 22px; height: 0; border-top: 1.5px solid var(--border-strong, var(--border-sub)); }
.oc-lg-ln--dot { border-top-style: dashed; border-top-color: var(--primary-base); }

/* Tô sáng tuyến báo cáo + kết quả tìm */
.oc-node.is-dim { opacity: .32; }
.oc-node.is-match { border-color: var(--warning-base, var(--primary-base)); box-shadow: 0 0 0 2px var(--warning-bg, var(--primary-bg-subtle)); }
.oc-node.is-current { border-color: var(--primary-base); box-shadow: 0 0 0 3px var(--primary-bg-subtle); }
.oc-edge.is-dim { opacity: .12; }
.oc-edge.is-lit { stroke: var(--primary-base); stroke-width: 2; }
.oc-edge--dotted.is-lit { opacity: 1; stroke-width: 2; }

/* Card Phòng ban (department) — tên đơn vị + quân số + người đứng đầu */
.oc-node--department { flex-direction: column; align-items: stretch; padding: 0; gap: 0; }
.oc-dept { display: flex; flex-direction: column; height: 100%; min-height: 0; }
.oc-dept-unit { display: flex; flex-direction: column; gap: 2px; padding: 12px 14px 10px; }
.oc-dept-head { display: flex; align-items: center; gap: 10px; flex: 1; min-height: 0; padding: 10px 14px; border-top: 1px solid var(--border-soft); }
.oc-unit-name { font-size: var(--fs-15); font-weight: 700; color: var(--text-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.oc-unit-sub { font-size: var(--fs-12); color: var(--text-sub); }

/* Card Vị trí (position) — tên vị trí + biên chế + list nhân viên. overflow VISIBLE để nút ±  không bị cắt. */
.oc-node--position { flex-direction: column; align-items: stretch; padding: 12px; gap: 8px; }
.oc-pos { display: flex; flex-direction: column; gap: 8px; height: 100%; min-height: 0; }
.oc-pos-h { display: flex; flex-direction: column; gap: 3px; padding-bottom: 8px; border-bottom: 1px solid var(--border-soft); }
.oc-pos-title { font-size: var(--fs-15); font-weight: 700; color: var(--text-strong); }
.oc-pos-count { font-size: var(--fs-12); color: var(--text-sub); font-variant-numeric: tabular-nums; }
.oc-pos-bd { color: var(--text-soft); }
.oc-pos-hire { align-self: flex-start; margin-top: 3px; font-size: var(--fs-11); font-weight: 600; line-height: 1;
  padding: 4px 8px; border-radius: var(--radius-sm); background: var(--text-strong); color: var(--bg-surface); }
.oc-pos-list { display: flex; flex-direction: column; gap: 7px; flex-shrink: 0; }
.oc-av--sm { width: 28px; height: 28px; font-size: var(--fs-11); }
.oc-pos-row { display: flex; align-items: center; gap: 8px; }
.oc-pos-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
.oc-pos-hn { display: flex; align-items: center; gap: 6px; font-size: var(--fs-13); font-weight: 500; color: var(--text-strong); }
.oc-pos-nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.oc-pos-tag { flex: none; font-size: var(--fs-10); font-weight: 600; line-height: 1; padding: 2px 5px; border-radius: var(--radius-xs);
  background: var(--bg-surface-subtle); color: var(--text-sub); border: 1px solid var(--border-soft); }
.oc-pos-hd { font-size: var(--fs-11); color: var(--text-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.oc-pos-more { align-self: flex-start; margin-top: 2px; padding: 3px 6px; border: 0; background: transparent; cursor: pointer;
  font-family: inherit; font-size: var(--fs-12); font-weight: 500; color: var(--primary-base); border-radius: var(--radius-sm); }
.oc-pos-more:hover { background: var(--primary-bg-subtle); }
  