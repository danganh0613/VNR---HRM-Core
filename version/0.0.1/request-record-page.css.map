
    :host { display: block; }
    ::ng-deep .shell-content:has(sg-request-record) { padding: 0 !important; }
    .lr { display: block; }
    .lr-nav { position: sticky; top: 0; z-index: 10; background: var(--bg-surface); border-bottom: 1px solid var(--border-sub); }
    .lr-nav-in { max-width: 1080px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-12) var(--space-4); }
    .lr-nav-l { display: flex; align-items: center; gap: var(--space-12); min-width: 0; }
    .lr-nav-r { display: flex; align-items: center; gap: var(--space-8); flex: none; min-width: 0; }
    .lr-t { margin: 0; font-size: var(--fs-20); font-weight: 600; color: var(--text-strong); white-space: nowrap; font-family: var(--font-mono, ui-monospace, monospace); }
    .lr-body { max-width: 1080px; margin: 0 auto; padding: var(--space-20) var(--space-4) var(--space-8); }
    .lr-card { background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg); }
    .lr-empty { color: var(--text-sub); }
  