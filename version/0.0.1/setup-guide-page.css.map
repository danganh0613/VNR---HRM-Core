
    .lp-desktop { position: relative; height: 760px; border: 1px solid var(--border-sub); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-regular-sm); }
    .lp-desktop--full { position: relative; height: 100vh; border: 0; border-radius: 0; box-shadow: none; }
    .lp-full { margin-top: 14px; }
    .lp-full-link { text-decoration: none; }
    .lp-desktop ::ng-deep .shell-content { padding: 0; }

    .as-ico { display: grid; place-items: center; width: 34px; height: 34px; border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub); }
    .sn-acct { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px; border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface); cursor: pointer; text-align: left; }
    .sn-acct--mini { width: auto; padding: 4px; border-color: transparent; background: transparent; }
    .sn-acct-ic { display: grid; place-items: center; width: 32px; height: 32px; border-radius: var(--radius-md); background: var(--primary-bg-subtle); color: var(--primary-base); flex: none; }
    .sn-acct-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .sn-acct-name { font-size: var(--fs-13); font-weight: var(--font-semibold, 600); color: var(--text-strong); }
    .sn-acct-sub { font-size: var(--fs-12); color: var(--text-soft); }

    .sgp-scroll { height: 100%; overflow-y: auto; background: var(--bg-canvas, var(--bg-surface-subtle)); }
    .sgp-page { max-width: 920px; margin: 0 auto; padding: var(--space-6, 24px) var(--space-6, 24px) var(--space-10, 40px); display: flex; flex-direction: column; gap: var(--space-5, 20px); }
    .sgp-anchor { scroll-margin-top: var(--space-4, 16px); }

    .sgp-head { padding: 0 var(--space-1-5, 6px); }
    .sgp-h1 { margin: 0; font-size: var(--fs-24, 24px); font-weight: var(--font-bold, 700); color: var(--text-strong); letter-spacing: -.01em; }
    .sgp-hsub { margin: var(--space-1-5, 6px) 0 0; font-size: var(--fs-14, 14px); color: var(--text-sub); line-height: 1.5; }
  