
    /* Lấp đầy vùng chứa; 1 vùng cuộn duy nhất (ngang + dọc) — cột trái ghim trái, header ghim trên. */
    :host { display: block; height: 100%; min-height: 0; }
    .gt {
      height: 100%; overflow: auto;
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface);
    }
    .gt-in { display: flex; width: max-content; min-width: 100%; }

    /* ── Cột nhãn trái ─────────────────────────────────────────── */
    .gt-labels {
      flex: none; position: sticky; left: 0; z-index: 3;
      background: var(--bg-surface); border-right: 1px solid var(--border-sub);
    }
    .gt-lh {
      position: sticky; top: 0; z-index: 4; height: 56px;
      display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 0 12px;
      background: var(--bg-surface-subtle); border-bottom: 1px solid var(--border-sub);
      font-size: var(--fs-12); font-weight: 600; color: var(--text-sub);
    }
    .gt-lrow {
      height: 40px; display: flex; align-items: center; justify-content: space-between; gap: 8px;
      padding: 0 12px; border-bottom: 1px solid var(--border-soft); cursor: pointer;
      transition: background var(--duration-fast, .15s) var(--ease-out, ease);
    }
    .gt-lrow:hover { background: var(--bg-surface-subtle); }
    .gt-lrow.is-sel { background: var(--primary-bg-subtle); }
    /* Checkbox chọn — đầu hàng nhãn. */
    .gt-check { display: grid; place-items: center; flex: none; margin-right: 8px; cursor: pointer; }
    .gt-check input { width: 14px; height: 14px; margin: 0; cursor: pointer; accent-color: var(--primary-base); }
    .gt-lrow-main { flex: 1; min-width: 0; display: flex; align-items: center; overflow: hidden; }
    .gt-lrow-t { font-size: var(--fs-14); color: var(--text-body); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .gt-lrow-d { flex: none; font-size: var(--fs-12); color: var(--text-sub); font-variant-numeric: tabular-nums; }
    .gt-lrow-d.is-late { color: var(--error-base); font-weight: 600; }

    /* ── Timeline ──────────────────────────────────────────────── */
    .gt-track { position: relative; flex: none; }

    .gt-head { position: sticky; top: 0; z-index: 2; background: var(--bg-surface-subtle); border-bottom: 1px solid var(--border-sub); }
    .gt-months { display: flex; height: 28px; }
    .gt-month {
      flex: none; display: flex; align-items: center; padding: 0 10px;
      font-size: var(--fs-12); font-weight: 600; color: var(--text-strong);
      border-right: 1px solid var(--border-sub); white-space: nowrap; overflow: hidden;
    }
    .gt-days { display: flex; height: 28px; }
    .gt-day {
      flex: none; display: flex; align-items: center; justify-content: center;
      font-size: var(--fs-11); color: var(--text-sub); border-right: 1px solid var(--border-soft);
      font-variant-numeric: tabular-nums;
    }
    .gt-day.is-weekend { color: var(--text-soft); background: var(--bg-surface-muted, var(--bg-surface-subtle)); }
    .gt-day.is-today { color: var(--primary-base); font-weight: 700; }

    /* Gridline ngày chạy dọc thân (nhẹ) — giúp dò mốc thời gian. */
    .gt-body {
      position: relative;
      background-image: repeating-linear-gradient(to right,
        var(--border-soft) 0 1px, transparent 1px var(--gt-dw, 36px));
    }
    .gt-row {
      height: 40px; border-bottom: 1px solid var(--border-soft); position: relative;
      transition: background var(--duration-fast, .15s) var(--ease-out, ease);
    }
    .gt-row:hover { background: color-mix(in srgb, var(--bg-surface-subtle) 70%, transparent); }

    .gt-bar {
      position: absolute; top: 8px; height: 24px; border-radius: var(--radius-md);
      background: var(--primary-bg-subtle); border: 1px solid var(--primary-border);
      overflow: hidden; cursor: pointer; display: flex; align-items: center;
      transition: box-shadow var(--duration-fast, .15s) var(--ease-out, ease);
    }
    .gt-bar:hover { box-shadow: var(--shadow-regular-sm); border-color: var(--primary-base); }
    .gt-fill { position: absolute; inset: 0 auto 0 0; background: var(--primary-base); opacity: .9; }
    .gt-bar-p { position: relative; z-index: 1; font-size: var(--fs-11); font-weight: 600; color: var(--static-white, #fff); padding-left: 8px; }
    /* Nhãn task đặt cạnh thanh — không chắn chuột. */
    .gt-bar-l {
      position: absolute; top: 8px; height: 24px; display: flex; align-items: center;
      font-size: var(--fs-13); color: var(--text-body); white-space: nowrap; pointer-events: none;
    }

    /* Tông màu thanh theo giai đoạn (barTone) — mặc định primary. */
    .gt-bar[data-tone='success'] { border-color: var(--success-base); }
    .gt-bar[data-tone='success'] .gt-fill { background: var(--success-base); }
    .gt-bar[data-tone='info'] { border-color: var(--info-base); }
    .gt-bar[data-tone='info'] .gt-fill { background: var(--info-base); }
    .gt-bar[data-tone='warning'] { border-color: var(--warning-base); }
    .gt-bar[data-tone='warning'] .gt-fill { background: var(--warning-base); }
    .gt-bar[data-tone='error'] { border-color: var(--error-base); }
    .gt-bar[data-tone='error'] .gt-fill { background: var(--error-base); }
    .gt-bar[data-tone='neutral'] { border-color: var(--border-sub); }
    .gt-bar[data-tone='neutral'] .gt-fill { background: var(--neutral-400); }

    .gt-today { position: absolute; top: 0; bottom: 0; width: 2px; background: var(--error-base); z-index: 2; }
  