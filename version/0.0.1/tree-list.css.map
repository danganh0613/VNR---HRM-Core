
    .tl-toggle { display:grid; place-items:center; width:20px; height:20px; border:0; background:transparent; cursor:pointer; color:var(--text-sub); border-radius:var(--radius-sm); }
    .tl-toggle:hover { background:var(--bg-surface-subtle); color:var(--text-strong); }
    .tl-toggle tabler-icon { transition: transform var(--duration-fast,.15s) var(--ease-out,ease); }
    .tl-toggle.open tabler-icon { transform: rotate(90deg); }
    .tl-dot { width:20px; display:inline-block; }
  