
/* display:flex (block-level) — không tham gia baseline của td, tránh lệch dòng với ô hai dòng (Text Cell). */
:host { display: flex; align-items: center; gap: 10px; min-width: 0; max-width: 100%; }
.uc-body { display: flex; flex-direction: column; min-width: 0; }
.uc-name { font-size: var(--fs-14); color: var(--text-strong); line-height: 1.35;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.uc-sub { font-size: var(--fs-12); color: var(--text-sub); line-height: 1.3;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  