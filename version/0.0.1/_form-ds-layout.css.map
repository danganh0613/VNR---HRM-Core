
    /* Host là grid item khi đặt trong .vnr-fg — khai trên host, không phải trên nav con */
    vnr-form-section-nav { display: block; min-inline-size: 0; align-self: start; }

    /* Dính trên khi cuộn form dài (position: sticky, top: 0) */
    .vnr-fsn { position: sticky; top: 0; inset-block-start: 0; z-index: 1;
      display: flex; flex-direction: column; gap: var(--space-1, 4px);
      background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: var(--radius-sm, 6px); padding: var(--space-2, 8px); }
    .vnr-fsn__hd { font-size: var(--fs-11, 11px); font-weight: var(--font-semibold, 600); text-transform: uppercase;
      letter-spacing: .3px; color: var(--text-soft); padding: var(--space-1, 4px) var(--space-2, 8px); }
    .vnr-fsn__ls { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
    .vnr-fsn__li { display: flex; flex-direction: column; }

    .vnr-fsn__it { display: flex; align-items: center; gap: var(--space-2, 8px); inline-size: 100%;
      border: none; background: none; text-align: start; cursor: pointer;
      border-radius: var(--radius-xs, 4px); padding: 6px var(--space-2, 8px);
      font: inherit; font-size: var(--fs-12, 12px); color: var(--text-body); }
    .vnr-fsn__it:hover:not(:disabled) { background: var(--bg-surface-subtle); color: var(--text-strong); }
    .vnr-fsn__it.is-active { background: var(--primary-bg-subtle); color: var(--primary-base);
      font-weight: var(--font-semibold, 600); }
    .vnr-fsn__it:disabled { cursor: not-allowed; color: var(--text-soft); }
    .vnr-fsn__it .lb { flex: 1 1 auto; min-inline-size: 0; overflow: hidden; text-overflow: ellipsis;
      white-space: nowrap; }
    .vnr-fsn__it .mt { flex: none; font-size: var(--fs-11, 11px); color: var(--text-soft);
      font-variant-numeric: tabular-nums; }
    .vnr-fsn__it.is-active .mt { color: var(--primary-base); }

    .vnr-fsn__it .dot { flex: none; inline-size: 8px; block-size: 8px; border-radius: var(--radius-full);
      border: 1px solid var(--border-strong); background: var(--bg-surface); }
    .vnr-fsn__it .dot[data-st='partial']  { background: var(--warning-base); border-color: var(--warning-base); }
    .vnr-fsn__it .dot[data-st='complete'] { background: var(--success-base); border-color: var(--success-base); }
    .vnr-fsn__it .dot[data-st='error']    { background: var(--error-base); border-color: var(--error-base); }
    .vnr-fsn__it .dot[data-st='locked']   { background: var(--faded-base); border-color: var(--faded-base); }

    .vnr-fsn__nt { font-size: var(--fs-11, 11px); font-weight: var(--font-medium, 500);
      padding: 0 var(--space-2, 8px) var(--space-1, 4px) 24px; }
    .vnr-fsn__nt.is-lock { color: var(--text-soft); }
    .vnr-fsn__nt.is-err { color: var(--error-base); font-weight: var(--font-semibold, 600); }
    .vnr-fsn__empty { font-size: var(--fs-12, 12px); color: var(--text-soft);
      padding: var(--space-2, 8px); text-align: center; }

    /* Container hẹp ⇒ chuyển thành dải ngang cuộn được, vẫn dính trên */
    @container vnrform (max-width: 559px) {
      .vnr-fsn__ls { flex-direction: row; overflow-x: auto; gap: var(--space-1, 4px); }
      .vnr-fsn__li { flex: none; }
      .vnr-fsn__it .lb { white-space: nowrap; }
      .vnr-fsn__nt { display: none; }
    }
  