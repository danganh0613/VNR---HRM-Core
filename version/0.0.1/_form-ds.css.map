
    .vnr-ap { display: flex; flex-direction: column; gap: var(--space-2-5, 10px); }
    .vnr-ap__warns { display: flex; flex-direction: column; gap: var(--space-1-5, 6px); }
    .vnr-ap__im { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2, 8px); }
    .vnr-ap__im .t { font-size: var(--fs-11, 11px); font-weight: var(--font-semibold, 600); text-transform: uppercase;
      letter-spacing: .3px; color: var(--text-soft); }
    .vnr-ap__im .chip { font-size: var(--fs-11, 11px); font-weight: var(--font-medium, 500); color: var(--info-base);
      background: var(--info-bg); border-radius: var(--radius-full); padding: 3px 10px; }
  