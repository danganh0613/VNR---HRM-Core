
    .tb { padding:12px 4px; color:var(--text-body); font-size: var(--fs-14); }
    .tabbar { display:flex; gap:4px; border-bottom:1px solid var(--border-sub); }
    .tabbtn {
      display:inline-flex; align-items:center; gap:8px; cursor:pointer;
      border:0; background:transparent; padding:8px 14px; margin-bottom:-1px;
      border-bottom:2px solid transparent; border-radius:var(--radius-md) var(--radius-md) 0 0;
      font-family:var(--font-sans); font-size: var(--fs-14); font-weight:500; color:var(--text-sub);
    }
    .tabbtn:hover { color:var(--text-strong); background:var(--bg-surface-subtle); }
    .tabbtn.on { color:var(--primary-base); border-bottom-color:var(--primary-base); }
  