
:host { display: block; min-width: 0; height: 100%; }

.lp { display: flex; flex-direction: column; min-width: 0; height: 100%; }

.lp-crumb { display: block; margin-bottom: 2px; }

/* Page-header: bỏ padding dọc 16px mặc định của nz — nhịp dọc do .lp quản
   (breadcrumb 8 phía trên · panel 16 phía dưới), tránh khoảng trắng thừa quanh tiêu đề. */
.lp ::ng-deep .ant-page-header { padding-top: 0; padding-bottom: 0; }

/* Panel viền chung — mọi tầng (tabs/toolbar/table/pager) trong 1 khung bo góc,
   nền surface (trắng ở light / dark surface ở dark). */
/* Hàng flex: khối danh sách trái (co giãn) · khối chi tiết phải (lpDetail, bề rộng riêng).
   Gutter 16px quanh cả cụm — mép phải chi tiết không bị dán sát/cắt. */
.lp-split {
  display: flex; align-items: stretch; gap: 16px;
  margin: 16px; flex: 1 1 auto; min-height: 0; min-width: 0;
}

.lp-panel {
  margin: 0;
  flex: 1 1 auto;
  /* Min-width: panel danh sách không sập còn vài px khi kéo chi tiết rộng → pager gọn (~159px)
     luôn đủ chỗ 1 hàng (content = min-width − padding-inline 16 = 164 > 159). */
  min-width: 180px;
  border: 1px solid var(--border-sub);
  border-radius: var(--radius-lg);
  background: var(--bg-surface);
  overflow: hidden;
  /* Panel co giãn lấp đầy chiều cao còn lại; bảng bên trong tự cuộn. */
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  /* Container query: panel co (VD kéo rộng master/drawer) → toolbar/pager tự thu gọn. */
  container-type: inline-size;
}
/* Mặc định (panel rộng): pager đầy đủ; ẩn pager gọn. */
.lp-pg-simple { display: none; }
/* (Toggle full↔simple + thu gọn pager ở container query CUỐI file — phải đặt SAU rule .lp-pager
   nền để padding-inline thắng shorthand padding, tránh pager gọn bị rớt hàng.) */

/* PHẲNG (view board/kanban/gantt) — bỏ khung panel + nền: nội dung board nằm thẳng
   trên nền trang, mỗi cột board tự là thẻ (không lồng thẻ trong thẻ). */
.lp-panel--flat { border: 0; background: transparent; border-radius: 0; overflow: visible; }
/* Toolbar phẳng: BỌC thành container riêng — viền + bo góc (radius-md = button/card,
   bám config bo góc) + nền surface → đồng bộ khung với mode Bảng; cách board bên dưới 12px. */
.lp-panel--flat .lp-toolbar {
  border: 1px solid var(--border-sub);
  border-radius: var(--radius-lg);
  background: var(--bg-surface);
  margin-bottom: var(--space-3);
}

/* Khối tiêu đề trang — nền surface (trắng ở light, tối dịu ở dark), gom tiêu đề + nút chính + tab.
   Tách hẳn khỏi panel bảng bên dưới. */
.lp-head {
  background: var(--bg-surface);
  border-bottom: 1px solid var(--border-sub);
  /* Padding trên/dưới cân đối — cụm điều khiển (segmented + nút) cùng hàng tiêu đề
     nên chân header không được dán sát viền. */
  padding: 10px 16px;
  flex: none;
}

/* Tab nằm TRONG khối tiêu đề, sát ngay dưới tiêu đề (spacing nhỏ). */
.lp-tabs { margin-top: 0; }
.lp-tabs ::ng-deep .ant-tabs-nav { margin-bottom: 0; }

/* Tầng toolbar — padding do hrm-table-toolbar tự lo (8px); gạch dưới ngăn với bảng */
.lp-toolbar { border-bottom: 1px solid var(--border-sub); }

/* Tầng bảng — grid phẳng: panel đã có viền + bo góc nên bỏ viền/bo/nền riêng của bảng.
   Co giãn lấp đầy panel; nội dung dài thì tự cuộn dọc trong vùng bảng. */
.lp-body { min-width: 0; flex: 1 1 auto; min-height: 0; overflow: auto; }
.lp-body ::ng-deep .ant-table { border: 0; border-radius: 0; background: transparent; }

/* Tầng phân trang — thông tin bên trái · điều khiển trang bên phải */
.lp-pager {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 10px 16px; border-top: 1px solid var(--border-sub);
  flex-wrap: nowrap;            /* KHÔNG cho rớt hàng khi panel hẹp */
}
/* Thông tin trang co lại/cắt trước — nhường chỗ cho bộ điều khiển trang. */
.lp-pager-info {
  font-size: var(--fs-13); color: var(--text-sub); min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
/* Bộ điều khiển trang: luôn 1 hàng, ô nhỏ gọn (nzSize small) → vừa panel hẹp. */
.lp-pager ::ng-deep .ant-pagination { display: flex; flex-wrap: nowrap; align-items: center; flex: none; }
.lp-pager ::ng-deep .ant-pagination li { margin-inline-end: 2px; }
/* Host pager (hrm-pagination) flex:none — KHÔNG cho co dưới bề rộng tự nhiên. Nếu co, ul.ant-pagination
   bên trong bị ép hẹp → size changer "10/trang" RỚT HÀNG. Giữ nguyên bề rộng → info tự cắt (…) thay vì pager rớt. */
.lp-pg-full, .lp-pg-simple { flex: none; }

/* Panel HẸP (kéo chi tiết rộng): ẩn info + pager đầy đủ → hiện pager GỌN (‹ [ô] / N ›) LUÔN 1 hàng.
   ĐẶT CUỐI: rule .lp-pager ở đây đứng SAU shorthand padding nền → padding-inline thắng, pager đủ chỗ. */
@container (max-width: 560px) {
  .lp-pager-info { display: none; }
  .lp-pg-full { display: none; }
  .lp-pg-simple { display: block; }
  .lp-pager { justify-content: center; padding-inline: var(--space-2); }
}
  