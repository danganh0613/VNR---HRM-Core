.bp { display:flex; gap:10px; padding:12px 14px; border-radius:var(--radius-lg); font-size: var(--fs-14); line-height:1.5; margin-bottom:8px; }
    .bp-dont { background: var(--error-bg); border: 1px solid var(--error-border); color: var(--error-text); }
    :host-context(.dark) .bp-dont { background: var(--error-bg-dark); border-color: var(--error-border-dark); color: var(--error-text-dark); }
    .bp-tag { font-size: var(--fs-11); font-weight:700; padding:2px 6px; border-radius:var(--radius-xs); height:fit-content; background:var(--error-base); color:var(--text-on-primary); }