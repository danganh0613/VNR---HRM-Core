
    :host { display: block; min-width: 0; width: 100%; }
    /* Hàng nút — KHÔNG rớt hàng (nowrap); nút dư ẩn vào ⋮ đẩy về góc phải. */
    .ab { display: flex; align-items: center; gap: var(--space-2); flex-wrap: nowrap; min-width: 0; width: 100%; }
    hrm-button[hidden] { display: none; }
    hrm-button tabler-icon { margin-right: var(--space-0-5); }
    hrm-button ::ng-deep .ant-btn { padding-inline: var(--space-2); gap: var(--space-0-5); white-space: nowrap; }

    /* Nút ⋮ more — GÓC PHẢI (margin-left auto đẩy về cuối hàng). */
    .ab-more {
      margin-left: auto; flex: none; display: inline-flex; align-items: center; justify-content: center;
      width: 34px; height: 34px; border: 1px solid var(--border-sub); background: var(--bg-surface);
      border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub);
      transition: border-color var(--duration-fast, .15s) var(--ease-out, ease), color var(--duration-fast, .15s) var(--ease-out, ease);
    }
    .ab-more:hover { border-color: var(--primary-base); color: var(--text-strong); }

    /* Tông màu nút (nền đặc) theo ngữ nghĩa — đồng bộ hrm-workflow-actions. */
    hrm-button[data-tone='error'] ::ng-deep .ant-btn { background: var(--error-base); border-color: var(--error-base); color: var(--static-white, #fff); }
    hrm-button[data-tone='error'] ::ng-deep .ant-btn:hover { filter: brightness(0.95); }
    hrm-button[data-tone='warning'] ::ng-deep .ant-btn { background: var(--warning-base); border-color: var(--warning-base); color: var(--static-white, #fff); }
    hrm-button[data-tone='warning'] ::ng-deep .ant-btn:hover { filter: brightness(0.95); }
    hrm-button[data-tone='violet'] ::ng-deep .ant-btn { background: var(--purple-500); border-color: var(--purple-500); color: var(--static-white, #fff); }
    hrm-button[data-tone='violet'] ::ng-deep .ant-btn:hover { filter: brightness(0.95); }
    :host ::ng-deep .ab-menu .ant-dropdown-menu-item { display: flex; align-items: center; gap: 8px; }
    .ab-mi-danger { color: var(--error-base); }
  