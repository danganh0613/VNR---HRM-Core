
:host { display: flex; align-items: center; gap: 12px; padding: 8px 12px; min-width: 0; }
:host(.hrm-table-toolbar--divided) { border-bottom: 1px solid var(--border-soft); margin-bottom: 12px; }

.tb-left { display: flex; align-items: center; gap: 8px; flex: none; min-width: 0; }
/* Không title/count/[tbTitle] → ẩn hẳn để KHÔNG chiếm gap 12px của host (tránh đẩy search sang phải). */
.tb-left:empty { display: none; }
.tb-title { font-size: var(--fs-15); font-weight: 600; color: var(--text-strong); white-space: nowrap; }
.tb-count {
  font-size: var(--fs-12); color: var(--text-sub); background: var(--bg-surface-subtle);
  padding: 1px 8px; border-radius: var(--radius-full); white-space: nowrap;
}

.tb-mid { flex: 1; display: flex; align-items: center; gap: 8px; min-width: 0; }
.tb-right { flex: none; display: flex; align-items: center; gap: 8px; }
  