
    .pv { border-collapse: collapse; font-size: var(--fs-13); min-width: 480px; }
    .pv th, .pv td { border: 1px solid var(--border-sub); padding: 8px 14px; text-align: right; color: var(--text-body); }
    .pv thead th { background: var(--bg-surface-subtle); color: var(--text-strong); font-weight: 600; text-align: right; }
    .pv .pv-corner, .pv .pv-row { text-align: left; background: var(--bg-surface-subtle); color: var(--text-strong); font-weight: 600; }
    .pv .pv-tot { background: var(--primary-bg-subtle); color: var(--primary-base); font-weight: 600; }
    .pv .pv-total th, .pv .pv-total td { background: var(--bg-surface-muted); color: var(--text-strong); font-weight: 600; }
  