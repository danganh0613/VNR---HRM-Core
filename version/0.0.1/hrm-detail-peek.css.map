
    /* Host trong suốt với layout: master aside trở thành con trực tiếp của hàng flex bên ngoài. */
    :host { display: contents; }
    /* Anchor drawer/modal không tham gia layout (overlay render trên body). */
    .dp-anchors { display: none; }

    /* MASTER — panel cố định bên phải: thẻ viền bo, header ghim, thân tự cuộn. */
    .dp-master {
      position: relative;
      flex: none; height: 100%; min-height: 0; display: flex; flex-direction: column;
      background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: var(--radius-lg); overflow: hidden;
    }
    .dp-master.dp-resizing { user-select: none; }

    /* Tay kéo đổi độ rộng (mép trái panel/drawer) — dải mảnh + grip dọc; hover/kéo → highlight primary
       để user NHẬN BIẾT kéo được. Kéo sang trái = rộng ra (panel/drawer neo bên phải). */
    .dp-resize {
      position: absolute; left: 0; top: 0; bottom: 0; width: 12px; z-index: 4;
      display: flex; align-items: center; justify-content: center;
      cursor: col-resize; touch-action: none;
    }
    .dp-grip {
      width: 4px; height: 44px; border-radius: var(--radius-full);
      background: var(--border-strong, var(--border-sub));
      transition: background var(--duration-fast, .15s) var(--ease-out, ease),
                  height var(--duration-fast, .15s) var(--ease-out, ease);
    }
    .dp-resize:hover .dp-grip, .dp-resizing .dp-grip { background: var(--primary-base); height: 60px; }
    /* Handle trong drawer: neo theo body drawer (đặt position relative để absolute bám đúng). */
    :host ::ng-deep .dp-side-wrap .ant-drawer-body { position: relative; }
    /* Vùng tiêu đề drawer chiếm TRỌN bề rộng → pk-head (width:100%) lấp đầy → nút đóng luôn mép PHẢI
       (một số bản ng-zorro không tự cho .ant-drawer-title flex:1). */
    :host ::ng-deep .dp-side-wrap .ant-drawer-header-title { flex: 1 1 auto; min-width: 0; }
    :host ::ng-deep .dp-side-wrap .ant-drawer-title { flex: 1 1 auto; min-width: 0; width: 100%; }
    .dp-resize--drawer { z-index: 20; }
    .dp-mhead { flex: none; padding: 8px 10px; border-bottom: 1px solid var(--border-soft); }
    .dp-mbody { flex: 1 1 auto; min-height: 0; overflow: auto; padding: 16px; }
    /* FOOTER master — ghim đáy (fix cố định), viền trên, action dồn phải. Đồng bộ drawer/modal. */
    .dp-mfoot {
      flex: none; padding: 10px 16px; border-top: 1px solid var(--border-soft);
      background: var(--bg-surface); display: flex; align-items: center; justify-content: flex-end;
      gap: var(--space-2); flex-wrap: wrap;
    }

    /* Header full-width → nút đóng (pk-close) luôn nằm mép PHẢI (master · drawer · modal). */
    .pk-head { display: flex; align-items: center; gap: 2px; width: 100%; }
    .pk-ic {
      display: grid; place-items: center; width: 30px; height: 30px; flex: none;
      border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer;
      color: var(--icon-secondary);
    }
    .pk-ic:hover { background: var(--bg-surface-subtle); color: var(--icon-primary); }
    .pk-sep { width: 1px; height: 18px; background: var(--border-soft); margin: 0 4px; flex: none; }
    .pk-title {
      flex: 1; min-width: 0; margin-left: 6px; font-size: var(--fs-15); font-weight: 600;
      color: var(--text-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .pk-close { margin-left: 4px; }
    .pk-mi { display: flex; align-items: center; gap: 10px; min-width: 168px; }
    .pk-mi-ic { color: var(--icon-secondary); flex: none; }
    .pk-mi-l { flex: 1; }
    .pk-mi-ck { color: var(--primary-base); flex: none; }
  