
    :host { display: inline-flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    /* Nút gọn: gap icon↔text nhỏ + padding ngang thu lại (token). */
    hrm-button tabler-icon { margin-right: var(--space-0-5); }
    hrm-button ::ng-deep .ant-btn { padding-inline: var(--space-2); gap: var(--space-0-5); }

    /* Tông màu nút (nền đặc) theo ngữ nghĩa — primary giữ brand xanh; còn lại ép màu tông.
       Ghi đè cả .ant-btn-primary (đặc) để chữ trắng nổi trên nền màu. */
    hrm-button[data-tone='error'] ::ng-deep .ant-btn {
      background: var(--error-base); border-color: var(--error-base); color: var(--static-white, #fff);
    }
    hrm-button[data-tone='error'] ::ng-deep .ant-btn:hover {
      background: var(--error-hover, var(--error-base)); border-color: var(--error-hover, var(--error-base)); filter: brightness(0.95);
    }
    hrm-button[data-tone='warning'] ::ng-deep .ant-btn {
      background: var(--warning-base); border-color: var(--warning-base); color: var(--static-white, #fff);
    }
    hrm-button[data-tone='warning'] ::ng-deep .ant-btn:hover { filter: brightness(0.95); }
    hrm-button[data-tone='violet'] ::ng-deep .ant-btn {
      background: var(--purple-500); border-color: var(--purple-500); color: var(--static-white, #fff);
    }
    hrm-button[data-tone='violet'] ::ng-deep .ant-btn:hover { filter: brightness(0.95); }
  