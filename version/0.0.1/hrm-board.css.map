
    /* Board lấp đầy chiều cao vùng chứa; cột cao bằng nhau, cuộn NGANG giữa các cột. */
    :host { display: block; height: 100%; min-height: 0; }
    .bd { display: flex; gap: 12px; align-items: stretch; overflow-x: auto; overflow-y: hidden; height: 100%; padding-bottom: 4px; }
    .bd-col {
      flex: 0 0 288px; width: 288px; display: flex; flex-direction: column; min-height: 0; max-height: 100%;
      background: var(--bg-surface-subtle); border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
    }
    .bd-col-h { display: flex; align-items: center; gap: 8px; padding: 10px 12px; }
    .bd-dot { width: 8px; height: 8px; border-radius: var(--radius-full); flex: none; background: var(--neutral-400); }
    .bd-col-h[data-tone='success'] .bd-dot { background: var(--success-base); }
    .bd-col-h[data-tone='warning'] .bd-dot { background: var(--warning-base); }
    .bd-col-h[data-tone='error']   .bd-dot { background: var(--error-base); }
    .bd-col-h[data-tone='info']    .bd-dot { background: var(--info-base); }
    .bd-col-title { font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); }
    .bd-col-count { font-size: var(--fs-12); color: var(--text-sub); background: var(--bg-surface); padding: 0 7px; border-radius: var(--radius-full); }

    /* Danh sách thẻ — cuộn DỌC trong cột khi nhiều thẻ (header cột luôn thấy). */
    .bd-list { display: flex; flex-direction: column; gap: 8px; padding: 0 8px 10px; min-height: 40px; flex: 1 1 auto; overflow-y: auto; }
    .bd-col-h { flex: none; }
    .bd-card {
      background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-md);
      padding: 10px 12px; cursor: pointer; color: var(--text-body); box-shadow: var(--shadow-regular-xs);
      transition: border-color var(--duration-fast, .15s) var(--ease-out, ease), box-shadow var(--duration-fast, .15s) var(--ease-out, ease);
    }
    .bd-card:hover { border-color: var(--primary-border); }
    /* Checkbox chọn — góc trên trái thẻ, hiện khi rê/đã chọn; thẻ chọn viền primary. */
    .bd-card { position: relative; }
    .bd-check {
      position: absolute; top: 6px; left: 6px; z-index: 2;
      display: grid; place-items: center; width: 20px; height: 20px;
      border-radius: var(--radius-sm); background: var(--bg-surface);
      box-shadow: var(--shadow-regular-xs); cursor: pointer;
      opacity: 0; transition: opacity var(--duration-fast, .15s) var(--ease-out, ease);
    }
    .bd-check input { width: 13px; height: 13px; margin: 0; cursor: pointer; accent-color: var(--primary-base); }
    .bd-card:hover .bd-check, .bd-card.is-sel .bd-check { opacity: 1; }
    .bd-card.is-sel { border-color: var(--primary-base); }
    .bd-card-t { font-size: var(--fs-14); font-weight: 500; color: var(--text-strong); }

    /* Nút thêm ở chân cột — mờ, hiện rõ khi rê (không cạnh tranh với thẻ). */
    .bd-add {
      flex: none; margin: 0 8px 8px; padding: 7px 10px; text-align: left;
      border: 0; border-radius: var(--radius-md); background: transparent; cursor: pointer;
      font: inherit; font-size: var(--fs-13); font-weight: 500; color: var(--text-sub);
      transition: background var(--duration-fast, .15s) var(--ease-out, ease), color var(--duration-fast, .15s) var(--ease-out, ease);
    }
    .bd-add:hover { background: var(--bg-surface); color: var(--text-strong); }

    /* Kéo-thả: thẻ đang kéo nổi + bóng; chỗ trống = khung nét đứt. */
    .bd-card.cdk-drag-preview { box-shadow: var(--shadow-regular-md); border-color: var(--primary-base); }
    .bd-card.cdk-drag-placeholder { opacity: 0; }
    .bd-card-ph { height: 44px; border: 1px dashed var(--primary-border); border-radius: var(--radius-md); background: var(--primary-bg-subtle); }
    .cdk-drop-list-dragging .bd-card:not(.cdk-drag-placeholder) { transition: transform var(--duration-normal, .2s) var(--ease-out, ease); }
    .bd-list.cdk-drop-list-receiving, .bd-list.cdk-drop-list-dragging { border-radius: var(--radius-md); }
  