
    /* Grid item THẬT là phần tử host, không phải div bên trong — nên span cột khai ở đây.
       (Nhắc lại lỗi đã gặp: đặt grid-column lên div con thì hoàn toàn vô tác dụng.) */
    vnr-effective-date-bar { display: block; min-inline-size: 0; }
    .vnr-fg > vnr-effective-date-bar { grid-column: 1 / -1; }

    .vnr-eb { border: 1px solid var(--border-sub); border-radius: var(--radius-sm, 6px);
      background: var(--bg-surface); overflow: hidden; }
    .vnr-eb__row { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-3, 12px);
      padding: var(--space-2-5, 10px) var(--space-3, 12px); background: var(--bg-surface-subtle);
      border-block-end: 1px solid var(--border-soft); }
    .vnr-eb__lb { font-size: var(--fs-12, 12px); font-weight: var(--font-semibold, 600); color: var(--text-strong); }
    .vnr-eb__ro { font-size: var(--fs-13, 13px); font-weight: var(--font-semibold, 600); color: var(--text-strong);
      font-variant-numeric: tabular-nums; }

    /* Segmented tự dựng bằng button — không kéo thêm component ngoài vào shell của form */
    .vnr-eb__seg { display: inline-flex; gap: 2px; padding: 2px; border: 1px solid var(--border-sub);
      border-radius: var(--radius-sm, 6px); background: var(--faded-bg); }
    .vnr-eb__opt { border: 1px solid transparent; background: none; color: var(--text-sub); font: inherit;
      font-size: var(--fs-12, 12px); padding: 4px 12px; border-radius: var(--radius-xs, 4px);
      cursor: pointer; white-space: nowrap; }
    .vnr-eb__opt:hover { color: var(--text-strong); }
    /* Trạng thái chọn không chỉ dựa vào màu: có nền nổi, viền và chữ đậm hơn */
    .vnr-eb__opt.is-on { background: var(--bg-surface); border-color: var(--primary-base);
      color: var(--primary-base); font-weight: var(--font-semibold, 600); }
    .vnr-eb__opt:focus-visible { outline: 2px solid var(--primary-base); outline-offset: 1px; }
    .vnr-eb__note { font-size: var(--fs-11, 11px); color: var(--text-soft); }

    .vnr-eb__bd { display: flex; align-items: center; flex-wrap: wrap;
      gap: var(--space-2, 8px) var(--space-3, 12px); padding: var(--space-2-5, 10px) var(--space-3, 12px); }
    .vnr-eb__dl { font-size: var(--fs-12, 12px); color: var(--text-sub); }
    .vnr-eb__in { inline-size: 136px; block-size: 30px; box-sizing: border-box;
      border: 1px solid var(--border-sub); border-radius: var(--radius-xs, 4px); background: var(--bg-surface);
      padding: 0 var(--space-2, 8px); font: inherit; font-size: var(--fs-13, 13px);
      color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .vnr-eb__in:focus-visible { outline: 2px solid var(--primary-base); outline-offset: 1px; }
    .vnr-eb__in:focus { outline: none; border-color: var(--primary-base); }
    .vnr-eb__dv { font-size: var(--fs-13, 13px); font-weight: var(--font-semibold, 600); color: var(--text-strong);
      font-variant-numeric: tabular-nums; }
    .vnr-eb__hint { font-size: var(--fs-11, 11px); color: var(--text-soft); }

    /* Vùng chứa hẹp: xếp dọc, segmented và ô ngày trải hết bề ngang cho dễ bấm */
    @container vnrform (max-width: 559px) {
      .vnr-eb__row { flex-direction: column; align-items: stretch; gap: var(--space-2, 8px); }
      .vnr-eb__seg { display: flex; }
      .vnr-eb__opt { flex: 1; text-align: center; }
      .vnr-eb__bd { flex-direction: column; align-items: stretch; }
      .vnr-eb__in { inline-size: 100%; }
    }
  