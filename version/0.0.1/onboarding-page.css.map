
    .lp-desktop { position: relative; height: 760px; border: 1px solid var(--border-sub); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-regular-sm); }
    .lp-desktop--full { position: relative; height: 100vh; border: 0; border-radius: 0; box-shadow: none; }
    .lp-desktop ::ng-deep .shell-content { padding: 0; }
    .lp-full { display: flex; justify-content: center; margin-top: 12px; }
    .lp-full-link { text-decoration: none; }

    .ob-wrap { height: 100%; overflow: auto; padding: 20px 24px 32px; }

    /* ── Header ─────────────────────────────────────────────────────────────── */
    .ob-head { display: flex; align-items: center; gap: var(--space-4, 16px); flex-wrap: wrap;
      background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: var(--radius-lg, 10px); padding: 14px 16px; margin-bottom: var(--space-4, 16px); }
    .ob-head__ava { flex: none; inline-size: 40px; block-size: 40px; border-radius: var(--radius-full);
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--primary-bg-subtle); color: var(--primary-base); }
    .ob-head__id { flex: 1 1 260px; min-inline-size: 0; }
    .ob-head__name { font-size: var(--fs-18, 18px); font-weight: var(--font-bold, 700); letter-spacing: -.01em; color: var(--text-strong); }
    .ob-head__meta { margin-top: 3px; font-size: var(--fs-12, 12px); color: var(--text-sub); }
    .ob-head__meta b { color: var(--text-body); font-variant-numeric: tabular-nums; }
    .ob-head__meta .dot { margin: 0 6px; color: var(--text-soft); }

    .ob-head__pg { flex: 0 1 220px; min-inline-size: 180px; }
    .ob-head__pgt { display: flex; align-items: baseline; gap: 5px; font-size: var(--fs-12, 12px); color: var(--text-sub); }
    .ob-head__pgt .n { font-size: var(--fs-14, 14px); font-weight: var(--font-bold, 700); color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .ob-head__pgt .p { margin-inline-start: auto; font-weight: var(--font-semibold, 600); color: var(--primary-base);
      font-variant-numeric: tabular-nums; }
    .ob-head__bar { margin-top: 5px; block-size: 5px; border-radius: var(--radius-sm, 6px);
      background: var(--faded-bg); overflow: hidden; }
    .ob-head__bar i { display: block; block-size: 100%; background: var(--success-base); }

    /* ── Thân trang: 2 cột khi đủ rộng, xếp dọc khi container hẹp ───────────── */
    .ob-body { display: grid; grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4, 16px); align-items: start; }
    /* Cột điều hướng tối thiểu 240px — bug thật: cột hẹp làm nhãn vỡ dọc từng từ */
    @container vnrform (min-width: 720px) {
      .ob-body { grid-template-columns: minmax(240px, 268px) minmax(0, 1fr); gap: var(--space-5, 20px); }
    }
    .ob-side { display: flex; flex-direction: column; gap: var(--space-3, 12px); min-inline-size: 0; }
    .ob-main { min-inline-size: 0; background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: var(--radius-lg, 10px); padding: 4px 16px 16px; }

    /* ── Thẻ tóm tắt tiến độ ────────────────────────────────────────────────── */
    .ob-sum { background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-radius: var(--radius-sm, 6px); padding: var(--space-2-5, 10px) var(--space-3, 12px); }
    .ob-sum__hd { font-size: var(--fs-11, 11px); font-weight: var(--font-semibold, 600); text-transform: uppercase; letter-spacing: .3px;
      color: var(--text-soft); margin-bottom: 6px; }
    .ob-sum__row { display: flex; align-items: baseline; gap: 8px; padding: 3px 0; font-size: var(--fs-12, 12px); }
    .ob-sum__row .lb { color: var(--text-sub); }
    .ob-sum__row .vl { margin-inline-start: auto; font-weight: var(--font-semibold, 600); color: var(--text-strong);
      font-variant-numeric: tabular-nums; }
    .ob-sum__row[data-k='done'] .vl { color: var(--success-base); }
    .ob-sum__row[data-k='doing'] .vl { color: var(--primary-base); }
    .ob-sum__row[data-k='blocked'] .vl { color: var(--warning-base); }
    /* Chỉ giữ khoảng cách — màu/nền/icon do hrm-alert lo. */
    .ob-sum__alert { margin-top: var(--space-2, 8px); }

    /* ── Phần nội dung ──────────────────────────────────────────────────────── */
    .ob-hint { font-size: var(--fs-12, 12px); color: var(--text-sub); margin-bottom: var(--space-2-5, 10px); max-width: 720px; }
    .ob-notice { margin-top: var(--space-3, 12px); padding: 7px var(--space-3, 12px); font-size: var(--fs-12, 12px);
      color: var(--primary-base); background: var(--primary-bg-subtle);
      border-radius: var(--radius-sm, 6px); }
  