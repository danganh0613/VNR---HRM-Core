
:host { display: block; height: 100%; min-height: 0; }
.shell { display: flex; height: 100%; min-height: 0; background: var(--bg-app); }

.shell-side { flex: none; display: flex; }
.shell-side:empty { display: none; }
/* Side nav lồng trong shell → kéo cao full (footer ghim đáy hoạt động). */
.shell-side ::ng-deep .hrm-side-nav { display: flex; height: 100%; }
.shell-side ::ng-deep .sn { height: 100%; }

.shell-main { flex: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
.shell-top { flex: none; }
.shell-top:empty { display: none; }
.shell-banner { flex: none; }
.shell-banner:empty { display: none; }

.shell-content { flex: 1; overflow: auto; min-height: 0; }
.shell-content.pad-sm { padding: 12px; }
.shell-content.pad-md { padding: 20px; }
.shell-content.pad-lg { padding: 32px; }
  