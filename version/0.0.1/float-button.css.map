
    /* Khung "màn hình" thu nhỏ để neo nút nổi vào góc thẻ thay vì góc trình duyệt. */
    .fb-screen {
      position: relative; width: 240px; height: 180px; flex: 0 0 auto;
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
      background: var(--bg-surface-subtle); overflow: hidden;
    }
    .fb-screen-tall { height: 260px; }
    .fb-hint {
      position: absolute; top: 12px; left: 12px;
      font-size: var(--fs-12); color: var(--text-sub);
    }
    /* Nút nổi mặc định position:fixed (góc trình duyệt) → ép nút/cụm cấp cao nhất
       về absolute trong khung. Chỉ nhắm phần tử con trực tiếp của wrapper để không
       phá vị trí các nút con bên trong 1 nhóm (ng-zorro tự xếp tương đối). */
    .fb-screen ::ng-deep hrm-float-button > .ant-float-btn,
    .fb-screen ::ng-deep hrm-float-button-group > .ant-float-btn-group {
      position: absolute; bottom: 16px; right: 16px; inset-inline-end: 16px;
    }
  