
    /* Panel là GRID ITEM khi đặt trong .vnr-fg ⇒ quy tắc phải nhắm PHẦN TỬ HOST,
       không phải div bên trong. Đặt grid-column lên .vnr-cp sẽ không có tác dụng. */
    vnr-conflict-panel { display: block; min-inline-size: 0; }
    .vnr-fg > vnr-conflict-panel { grid-column: 1 / -1; }

    .vnr-cp { border: 1px solid var(--border-sub); border-radius: var(--radius-sm, 6px);
      background: var(--bg-surface); overflow: hidden; }
    .vnr-cp[data-top='error'] { border-color: var(--error-base); }
    .vnr-cp[data-top='warn']  { border-color: var(--warning-border); }

    .vnr-cp__hd { border-block-end: 1px solid var(--border-soft); }
    .vnr-cp.is-collapsed .vnr-cp__hd { border-block-end: none; }
    .vnr-cp__tg { inline-size: 100%; display: flex; align-items: center; gap: var(--space-2, 8px);
      padding: var(--space-2-5, 10px) var(--space-3, 12px); border: none; background: var(--bg-surface-subtle);
      font: inherit; color: var(--text-strong); text-align: start; cursor: pointer; }
    .vnr-cp[data-top='error'] .vnr-cp__tg { background: var(--error-bg); }
    .vnr-cp[data-top='warn']  .vnr-cp__tg { background: var(--warning-bg); }
    .vnr-cp[data-top='info']  .vnr-cp__tg { background: var(--info-bg); }
    .vnr-cp__tg:focus-visible { outline: 2px solid var(--primary-base); outline-offset: -2px; }
    .vnr-cp__tg .cv { inline-size: 12px; color: var(--text-soft); flex: none; }
    .vnr-cp__tg .t { font-size: var(--fs-13, 13px); font-weight: var(--font-semibold, 600); }
    .vnr-cp__tg .c { font-size: var(--fs-12, 12px); font-weight: var(--font-semibold, 600); font-variant-numeric: tabular-nums; }
    .vnr-cp[data-top='error'] .vnr-cp__tg .c { color: var(--error-base); }
    .vnr-cp[data-top='warn']  .vnr-cp__tg .c { color: var(--warning-base); }
    .vnr-cp[data-top='info']  .vnr-cp__tg .c { color: var(--info-base); }
    .vnr-cp__tg .c.is-ok { color: var(--success-base); }
    .vnr-cp__tg .sp { margin-inline-start: auto; }
    .vnr-cp__tg .ac { font-size: var(--fs-11, 11px); font-weight: var(--font-medium, 500); color: var(--text-soft); flex: none; }

    .vnr-cp__bd { display: flex; flex-direction: column; gap: var(--space-3, 12px);
      padding: var(--space-3, 12px); }
    .vnr-cp__gr { display: flex; flex-direction: column; gap: var(--space-2, 8px); }
    .vnr-cp__gh { display: flex; align-items: baseline; gap: var(--space-2, 8px); }
    .vnr-cp__gh .lv { font-size: var(--fs-11, 11px); font-weight: var(--font-bold, 700); text-transform: uppercase;
      letter-spacing: .3px; color: var(--text-soft); }
    .vnr-cp__gr[data-lv='error'] .vnr-cp__gh .lv { color: var(--error-base); }
    .vnr-cp__gr[data-lv='warn']  .vnr-cp__gh .lv { color: var(--warning-base); }
    .vnr-cp__gh .n { font-size: var(--fs-11, 11px); color: var(--text-soft);
      font-variant-numeric: tabular-nums; }

    /* Mức error nổi bật nhất: viền trái dày + nền lỗi + tiêu đề đậm hơn.
       (Lưu ý: KHÔNG đặt dấu backtick trong comment CSS — nó đóng template literal sớm,
        biến styles thành mảng nhiều phần tử ⇒ lỗi "Failed to resolve styles at position 1".) */
    .vnr-cp__it { border: 1px solid var(--border-soft);
      border-inline-start: 3px solid var(--border-sub); border-radius: var(--radius-xs, 4px);
      background: var(--bg-surface); padding: var(--space-2, 8px) var(--space-2-5, 10px); }
    .vnr-cp__it[data-lv='error'] { border-color: var(--error-base); border-inline-start-color: var(--error-base);
      background: var(--error-bg); }
    .vnr-cp__it[data-lv='warn'] { border-color: var(--warning-border);
      border-inline-start-color: var(--warning-base); background: var(--warning-bg); }
    .vnr-cp__it[data-lv='info'] { border-inline-start-color: var(--info-base);
      background: var(--info-bg); }

    .vnr-cp__it .hd { display: flex; align-items: baseline; gap: var(--space-2, 8px); flex-wrap: wrap; }
    .vnr-cp__it .tag { flex: none; font-size: var(--fs-11, 11px); font-weight: var(--font-bold, 700); text-transform: uppercase;
      letter-spacing: .3px; border-radius: var(--radius-full); padding: 1px 8px; background: var(--bg-surface);
      border: 1px solid var(--border-sub); color: var(--text-sub); }
    .vnr-cp__it[data-lv='error'] .tag { color: var(--error-base); border-color: var(--error-base); }
    .vnr-cp__it[data-lv='warn']  .tag { color: var(--warning-base); border-color: var(--warning-border); }
    .vnr-cp__it[data-lv='info']  .tag { color: var(--info-base);
      border-color: var(--info-base); }
    .vnr-cp__it .ti { font-size: var(--fs-13, 13px); font-weight: var(--font-medium, 500); color: var(--text-strong);
      word-break: break-word; }
    .vnr-cp__it[data-lv='error'] .ti { font-weight: var(--font-semibold, 600); }
    .vnr-cp__it .de { margin: var(--space-1, 4px) 0 0; font-size: var(--fs-12, 12px);
      color: var(--text-body); line-height: 1.5; }
    .vnr-cp__it .ft { display: flex; align-items: center; gap: var(--space-2, 8px);
      margin-block-start: var(--space-2, 8px); flex-wrap: wrap; }
    .vnr-cp__it .sr { font-size: var(--fs-11, 11px); color: var(--text-soft); }
    .vnr-cp__it .sp { margin-inline-start: auto; }

    .vnr-cp__b { border: 1px solid var(--border-sub); background: var(--bg-surface); color: var(--text-body);
      font: inherit; font-size: var(--fs-11, 11px); font-weight: var(--font-medium, 500); cursor: pointer;
      border-radius: var(--radius-xs, 4px); padding: 3px 9px; }
    .vnr-cp__b:hover { border-color: var(--primary-base); color: var(--primary-base); }
    .vnr-cp__b:focus-visible { outline: 2px solid var(--primary-base); outline-offset: 1px; }
    .vnr-cp__b.is-primary { border-color: var(--primary-base); color: var(--primary-base);
      background: var(--primary-bg-subtle); font-weight: var(--font-semibold, 600); }
    .vnr-cp__b.is-primary:hover { background: var(--bg-surface); }

    /* Container hẹp: nút xuống dòng thay vì ép chữ ⇒ không cuộn ngang.
       Biến số cột KHÔNG khai ở đây — phần tử mang container-type không tự query được chính nó. */
    @container vnrform (max-width: 559px) {
      .vnr-cp__it .ft { align-items: stretch; flex-direction: column; }
      .vnr-cp__it .sp { margin-inline-start: 0; }
      .vnr-cp__b { inline-size: 100%; padding-block: 6px; }
      .vnr-cp__tg .ac { display: none; }
    }
  