
    .frame { height: 460px; border: 1px solid var(--border-sub); border-radius: var(--radius-lg); overflow: hidden; }
    .as-ico { display: grid; place-items: center; width: 34px; height: 34px; border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub); }
    .as-ico:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
    .as-av { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--primary-base); color: #fff; font-size: var(--fs-13); font-weight: 600; }
    .as-search { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface-subtle); color: var(--text-sub); }
    .as-search input { border: 0; background: transparent; outline: none; font: inherit; font-size: var(--fs-13); color: var(--text-body); width: 140px; }
    /* Responsive: chỉ khi RẤT hẹp (.tn--narrow, lib bật ở <560px) → search thu thành ICON.
       Độc lập ngưỡng hamburger (820) → search vẫn full ở khoảng 560–820. ::ng-deep vì
       .tn--narrow là element của LIB. */
    ::ng-deep .tn--narrow .as-search { flex: none; box-sizing: border-box; width: 34px; height: 34px; padding: 0; justify-content: center; cursor: pointer; background: transparent; border: 0; color: var(--text-sub); }
    ::ng-deep .tn--narrow .as-search:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
    /* Bấm icon → mở lại ô nhập đầy đủ (dù đang hẹp). */
    ::ng-deep .tn--narrow .as-search.is-open { width: auto; height: auto; padding: 6px 10px; justify-content: flex-start; background: var(--bg-surface-subtle); border: 1px solid var(--border-sub); }
    ::ng-deep .tn--narrow .as-search.is-open input { display: inline; }
    ::ng-deep .tn--narrow .as-search input { display: none; }

    /* Nút chuyển tài khoản (snHead) — giống mẫu Side Nav. */
    .sn-acct { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px; border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface); cursor: pointer; text-align: left; transition: border-color var(--duration-fast, .15s) var(--ease-out, ease); }
    .sn-acct:hover { border-color: var(--primary-base); }
    .sn-acct--mini { width: auto; padding: 4px; border-color: transparent; background: transparent; }
    .sn-acct-ic { display: grid; place-items: center; width: 32px; height: 32px; border-radius: var(--radius-md); background: var(--primary-bg-subtle); color: var(--primary-base); flex: none; }
    /* Khối user footer (snFooter) — đồng bộ Side Nav doc: avatar + tên + email + bánh răng, mở userMenu. */
    .sn-user { display: flex; align-items: center; gap: 10px; width: 100%; padding: 6px 8px; border: 0; background: transparent; border-radius: var(--radius-lg); cursor: pointer; text-align: left; transition: background var(--duration-fast, .15s) var(--ease-out, ease); }
    .sn-user:hover { background: var(--bg-surface-subtle); }
    .sn-user--mini { width: auto; padding: 4px; }
    .sn-user-av { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--primary-base); color: #fff; font-size: var(--fs-13); font-weight: 600; flex: none; }
    .sn-user-info { flex: 1; min-width: 0; }
    .sn-user-name { display: block; font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sn-user-mail { display: block; font-size: var(--fs-12); color: var(--text-sub); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sn-user-gear { color: var(--text-soft); flex: none; }

    /* Vùng content: KHUNG MẶC ĐỊNH — placeholder giữa trang (đồng đội/AI thay bằng feature). */
    .pg-empty { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; padding: 24px; background: var(--bg-canvas); }
    .pg-empty-title { font-size: var(--fs-20); font-weight: 700; color: var(--text-strong); }
    .pg-empty-sub { font-size: var(--fs-13); color: var(--text-sub); max-width: 42ch; line-height: 1.5; }
  