
    :host { display: block; }
    :host ::ng-deep .ant-tag { margin: 0; }
    .pk { display: flex; flex-direction: column; gap: var(--space-3-5, 14px); padding: var(--space-4, 16px) var(--space-5, 20px) var(--space-5, 20px); }
    .pk-head2 { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2, 8px); }
    .pk-sec { border-top: 1px solid var(--border-soft, var(--border-sub)); padding-top: var(--space-3, 12px); }
    .pk-sec:first-child { border-top: 0; padding-top: 0; }
    .pk-h { margin: 0 0 8px; font-size: var(--fs-12, 12px); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--text-sub); }
    .pk-list { display: grid; grid-template-columns: 118px 1fr; gap: 8px 12px; margin: 0; align-items: center; }
    .pk-list dt { font-size: var(--fs-13, 13px); color: var(--text-sub); }
    .pk-list dd { margin: 0; font-size: var(--fs-13, 13px); color: var(--text-body); min-width: 0; }
    .pk-reason { margin: 0; font-size: var(--fs-13, 13px); color: var(--text-body); line-height: 1.55; }
  