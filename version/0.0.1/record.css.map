
    :host { display: block; }
    .rec { max-width: 920px; margin: 0 auto; padding: 8px 4px; }
    .rec-bar { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
    .rec-crumb { font-size: var(--fs-13); color: var(--text-soft); }
    .rec-card { padding: 24px; background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-xl); }
    .rec-empty { padding: 40px; text-align: center; color: var(--text-sub); }
    .rec-empty a { color: var(--primary-base); cursor: pointer; }
  