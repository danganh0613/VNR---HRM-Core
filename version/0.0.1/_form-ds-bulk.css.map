
    .vnr-bt { display: flex; flex-direction: column; gap: var(--space-2-5, 10px); }

    .vnr-bt__sum { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2, 8px);
      padding: 8px 12px; border: 1px solid var(--border-sub); border-radius: var(--radius-sm, 6px);
      background: var(--bg-surface-subtle); font-size: var(--fs-12, 12px); color: var(--text-sub); }
    .vnr-bt__sum b { color: var(--text-strong); font-variant-numeric: tabular-nums; }
    .vnr-bt__sum .dot { color: var(--text-soft); }
    .vnr-bt__sum .ne { color: var(--warning-base); font-weight: var(--font-semibold, 600); font-variant-numeric: tabular-nums; }
    .vnr-bt__sum .sp { margin-inline-start: auto; }

    /* Số cột khai trên phần tử CON của container (shell mới mang container-type) */
    .vnr-bt__list { display: grid; grid-template-columns: 1fr; gap: 6px; }
    @container vnrform (min-width: 760px)  { .vnr-bt__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @container vnrform (min-width: 1080px) { .vnr-bt__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    /* Rỗng cấp panel: chiếm trọn bề ngang lưới, không bị bóp vào 1 cột */
    .vnr-bt__list hrm-empty { grid-column: 1 / -1; }

    .vnr-bt__it { display: flex; align-items: flex-start; gap: var(--space-2, 8px); min-inline-size: 0;
      padding: 8px 10px; border: 1px solid var(--border-sub); border-radius: var(--radius-sm, 6px);
      background: var(--bg-surface); cursor: pointer; }
    .vnr-bt__it:hover { border-color: var(--primary-base); }
    .vnr-bt__it.is-sel { border-color: var(--primary-base); background: var(--primary-bg-subtle); }
    /* Không đủ điều kiện: nền mờ + viền đứt + con trỏ chặn — kèm chữ lý do ở .rs */
    .vnr-bt__it.is-off { background: var(--faded-bg); border-style: dashed;
      border-color: var(--border-soft); cursor: not-allowed; }
    .vnr-bt__it.is-off:hover { border-color: var(--border-soft); }
    .vnr-bt__it > input { flex: none; margin: 2px 0 0; accent-color: var(--primary-base); }
    .vnr-bt__it .tx { display: flex; flex-direction: column; gap: 2px; min-inline-size: 0; }
    .vnr-bt__it .nm { font-size: var(--fs-13, 13px); font-weight: var(--font-semibold, 600); color: var(--text-strong); word-break: break-word; }
    .vnr-bt__it.is-off .nm { color: var(--text-sub); }
    .vnr-bt__it .sb { font-size: var(--fs-11, 11px); color: var(--text-soft); }
    .vnr-bt__it .rs { font-size: var(--fs-11, 11px); font-weight: var(--font-semibold, 600); color: var(--warning-base); }

    .vnr-bt__ft { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2, 8px); }
    .vnr-bt__ft .sp { margin-inline-start: auto; }
    .vnr-bt__b { border: 1px solid var(--border-strong); background: var(--bg-surface);
      color: var(--text-body); border-radius: var(--radius-sm, 6px); padding: 6px 12px; font: inherit;
      font-size: var(--fs-12, 12px); font-weight: var(--font-medium, 500); cursor: pointer; }
    .vnr-bt__b:hover:not(:disabled) { border-color: var(--primary-base); color: var(--primary-base); }
    .vnr-bt__b:disabled { opacity: .5; cursor: not-allowed; }
    .vnr-bt__b.is-primary { background: var(--primary-base); border-color: var(--primary-base);
      color: var(--text-on-primary); font-weight: var(--font-semibold, 600); }
    .vnr-bt__b.is-primary:hover:not(:disabled) { color: var(--text-on-primary); opacity: .92; }

    .vnr-bt__pv { border: 1px solid var(--border-sub); border-radius: var(--radius-sm, 6px);
      background: var(--bg-surface); overflow: hidden; }
    .vnr-bt__pvhd { display: flex; align-items: baseline; gap: var(--space-2, 8px); padding: 8px 12px;
      background: var(--bg-surface-subtle); border-block-end: 1px solid var(--border-soft); }
    .vnr-bt__pvhd .t { font-size: var(--fs-12, 12px); font-weight: var(--font-semibold, 600); color: var(--text-strong); }
    .vnr-bt__pvhd .m { margin-inline-start: auto; font-size: var(--fs-11, 11px); color: var(--text-soft);
      font-variant-numeric: tabular-nums; }

    .vnr-bt__tb { inline-size: 100%; border-collapse: collapse; }
    .vnr-bt__tb th { background: var(--bg-surface); font-size: var(--fs-11, 11px); text-transform: uppercase;
      letter-spacing: .3px; color: var(--text-soft); font-weight: var(--font-semibold, 600); text-align: start; padding: 7px 10px;
      border-block-end: 1px solid var(--border-soft); }
    .vnr-bt__tb td { padding: 7px 10px; font-size: var(--fs-12, 12px);
      border-block-end: 1px solid var(--border-soft); }
    .vnr-bt__tb tbody tr:last-child td { border-block-end: none; }
    .vnr-bt__tb .lb { color: var(--text-sub); }
    .vnr-bt__tb .vl { color: var(--text-body); font-variant-numeric: tabular-nums; word-break: break-word; }
    .vnr-bt__tb .vl.new { font-weight: var(--font-semibold, 600); color: var(--text-strong); }
    .vnr-bt__tb .ar { inline-size: 26px; text-align: center; color: var(--text-soft); }
    /* Không đổi ⇒ mờ để mắt tập trung vào phần THỰC SỰ thay đổi */
    .vnr-bt__tb tr.is-same { opacity: .55; }

    .vnr-bt__cards { display: none; flex-direction: column; gap: 6px; padding: 8px; }
    .vnr-bt__card { display: flex; flex-direction: column; gap: 2px; padding: 8px 10px;
      border: 1px solid var(--border-sub); border-radius: var(--radius-sm, 6px); background: var(--bg-surface); }
    .vnr-bt__card.is-same { opacity: .55; }
    .vnr-bt__card .lb { font-size: var(--fs-11, 11px); color: var(--text-soft); }
    .vnr-bt__card .pair { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px; }
    .vnr-bt__card .vl { font-size: var(--fs-13, 13px); color: var(--text-body); font-variant-numeric: tabular-nums; }
    .vnr-bt__card .vl.new { font-weight: var(--font-semibold, 600); color: var(--text-strong); }
    .vnr-bt__card .ar { color: var(--text-soft); }
    .vnr-bt__card .sm { font-size: var(--fs-11, 11px); color: var(--text-soft); }

    .vnr-bt__empty { text-align: center; color: var(--text-soft); font-size: var(--fs-12, 12px); padding: 14px; }

    .vnr-bt__rs { border: 1px solid transparent; border-radius: var(--radius-sm, 6px); padding: 9px 12px;
      font-size: var(--fs-12, 12px); }
    /* Thành công MỘT PHẦN là trạng thái bình thường của thao tác hàng loạt ⇒ tô cảnh báo, không phải lỗi */
    .vnr-bt__rs[data-tone='ok'] { background: var(--success-bg); border-color: var(--success-base); }
    .vnr-bt__rs[data-tone='partial'] { background: var(--warning-bg); border-color: var(--warning-border); }
    .vnr-bt__rs .line { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px; }
    .vnr-bt__rs .k { color: var(--text-sub); }
    .vnr-bt__rs .dot { color: var(--text-soft); }
    .vnr-bt__rs .v { font-weight: var(--font-bold, 700); font-variant-numeric: tabular-nums; }
    .vnr-bt__rs .v.ok { color: var(--success-base); }
    .vnr-bt__rs .v.fa { color: var(--error-base); }
    .vnr-bt__rs .nt { margin-block-start: 4px; font-size: var(--fs-11, 11px); font-weight: var(--font-semibold, 600); color: var(--text-body); }

    /* Đổi vai theo BỀ RỘNG CONTAINER (không phải viewport) */
    @container vnrform (max-width: 559px) {
      .vnr-bt__tb { display: none; }
      .vnr-bt__cards { display: flex; }
      .vnr-bt__ft .vnr-bt__b { flex: 1 1 100%; }
      .vnr-bt__ft .sp { display: none; }
    }
  