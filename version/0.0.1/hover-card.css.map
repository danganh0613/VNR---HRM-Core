
    .hv-line { font-size: var(--fs-14); color: var(--text-body); }
    .hv-name { color: var(--primary-base); cursor: pointer; font-weight: 500; }
    .hv-name:hover { text-decoration: underline; }
    .hv-card { display: flex; flex-direction: column; gap: 10px; width: 240px; }
    .hv-top { display: flex; align-items: center; gap: 10px; }
    .hv-t1 { font-size: var(--fs-14); font-weight: 600; color: var(--text-strong); }
    .hv-t2 { font-size: var(--fs-12); color: var(--text-sub); }
    .hv-meta { font-size: var(--fs-12); color: var(--text-sub); }
  