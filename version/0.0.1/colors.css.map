
    .swatch { height: 64px; border-bottom: 1px solid var(--border-sub); }
    .grp-note { margin: -4px 0 16px; color: var(--text-sub); font-size: var(--fs-13); max-width: 74ch; line-height: 1.5; }
    .grp-note b { color: var(--text-body); font-weight: 600; }

    /* Tier divider */
    .tier { display: flex; align-items: center; gap: 14px; margin: 40px 0 20px; padding-bottom: 14px; border-bottom: 2px solid var(--border-strong); }
    .tier:first-of-type { margin-top: 8px; }
    .tier-n { font-size: var(--fs-13); font-weight: 700; letter-spacing: 0.08em; color: var(--text-on-primary); background: var(--primary-base); border-radius: var(--radius-full); width: 34px; height: 34px; display: grid; place-items: center; flex: none; }
    .tier-h { font-size: var(--fs-18); font-weight: 600; color: var(--text-strong); }
    .tier-d { font-size: var(--fs-13); color: var(--text-sub); margin-top: 2px; max-width: 76ch; }

    /* Ramp strip */
    .ramp { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; }
    .ramp-name { width: 92px; flex: none; font-size: var(--fs-13); font-weight: 600; color: var(--text-body); padding-top: 6px; }
    .ramp-name small { display: block; font-weight: 400; color: var(--text-soft); font-size: var(--fs-11); }
    .ramp-steps { display: flex; flex: 1; min-width: 280px; border-radius: var(--radius-md); overflow: hidden; box-shadow: inset 0 0 0 1px var(--border-sub); }
    .ramp-steps.seq { max-width: 420px; }
    .ramp-step { flex: 1; }
    .ramp-chip { height: 44px; }
    .ramp-l { font-size: var(--fs-10); text-align: center; color: var(--text-soft); padding: 3px 0; font-variant-numeric: tabular-nums; }

    /* Role cluster row */
    .role-row { display: flex; align-items: center; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--border-soft); flex-wrap: wrap; }
    .role-name { width: 168px; flex: none; font-size: var(--fs-13); font-weight: 600; color: var(--text-strong); text-transform: capitalize; }
    .role-sws { display: flex; gap: 10px; flex-wrap: wrap; }
    .role-sw { width: 76px; text-align: center; }
    .role-chip { height: 40px; border-radius: var(--radius-sm); box-shadow: inset 0 0 0 1px var(--border-sub); }
    .role-tag { font-size: var(--fs-11); color: var(--text-sub); margin-top: 4px; }

    /* Contrast badge */
    .cr {
      display: inline-block; margin-top: 3px; padding: 1px 6px; border-radius: var(--radius-full);
      font-size: var(--fs-10); font-weight: 700; font-variant-numeric: tabular-nums;
      background: var(--bg-surface-subtle); color: var(--text-sub);
    }
    .cr[data-g='AAA'], .cr[data-g='AA']  { background: var(--success-muted-light); color: var(--success-dark); }
    .cr[data-g='AA-L'] { background: var(--warning-muted-light); color: var(--warning-dark); }
    .cr[data-g='FAIL'] { background: var(--error-muted-light);   color: var(--error-dark); }
  