
    .ph-frame {
      width: 100%;
      border: 1px solid var(--border-sub);
      border-radius: var(--radius-xl);
      background: var(--bg-surface);
      padding: 4px 16px;
    }
    /* Nút hành động (nz-page-header-extra): nút phụ cách nút chính 6px. */
    .ph-frame ::ng-deep .ant-page-header-heading-extra { display: flex; align-items: center; gap: 6px; }
    .ph-tabs { display: flex; gap: 4px; }
    .ph-tab {
      padding: 8px 14px;
      font-size: var(--fs-14);
      color: var(--text-sub);
      border-bottom: 2px solid transparent;
      cursor: pointer;
    }
    .ph-tab.on { color: var(--primary-base); border-bottom-color: var(--primary-base); font-weight: 500; }
  