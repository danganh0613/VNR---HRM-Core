
.hrm-input-pre { color: var(--icon-secondary, var(--text-sub)); display: inline-flex; }
.hrm-input-clear {
  display: inline-flex; align-items: center; justify-content: center;
  border: 0; padding: 0; background: transparent; cursor: pointer;
  color: var(--icon-secondary, var(--text-sub)); border-radius: var(--radius-sm);
}
.hrm-input-clear:hover { color: var(--text-strong); }
  