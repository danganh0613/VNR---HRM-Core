
    /* Nền khối tiêu đề = surface token → TRẮNG ở light, nền tối dịu ở dark (tự đổi theo mode). */
    :host ::ng-deep .ant-page-header { background: var(--bg-surface); }

    /* Phụ đề nằm DƯỚI tiêu đề (nz mặc định để cạnh phải) — stack dọc, THẲNG HÀNG mép trái tiêu đề. */
    :host ::ng-deep .ant-page-header-heading-left { flex-wrap: wrap; align-items: baseline; row-gap: 2px; }
    :host ::ng-deep .ant-page-header-heading-sub-title {
      flex: 0 0 100%; margin: 0; padding: 0; white-space: normal; line-height: 1.4;
    }
    /* Nút back rỗng (nzBackIcon='') không chiếm chỗ → tiêu đề & phụ đề cùng mép trái. */
    :host ::ng-deep .ant-page-header-back { margin-right: 0; }
  