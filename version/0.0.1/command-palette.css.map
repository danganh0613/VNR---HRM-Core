
    .kbd-hint { display: inline-flex; align-items: center; gap: 4px; font-size: var(--fs-13); color: var(--text-sub); }
    kbd {
      font-family: var(--font-sans); font-size: var(--fs-12); color: var(--text-body);
      background: var(--bg-surface-subtle); border: 1px solid var(--border-sub);
      border-bottom-width: 2px; border-radius: var(--radius-sm); padding: 1px 6px;
    }
  