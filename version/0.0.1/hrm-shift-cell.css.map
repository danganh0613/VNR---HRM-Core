
    :host { display: block; height: 100%; }
    .sc { position: relative; display: flex; align-items: center; gap: var(--space-2, 8px);
      height: 100%; min-height: 48px; box-sizing: border-box;
      padding: var(--space-2, 8px) var(--space-3, 10px); border-radius: var(--radius-md); }

    .sc-body { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; }
    .sc-title { font-size: var(--fs-13, 13px); font-weight: var(--font-semibold, 600); color: var(--text-strong);
      line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sc-time { font-size: var(--fs-12, 12px); color: var(--text-sub); line-height: 1.2; font-variant-numeric: tabular-nums; }

    .sc-badge { flex: none; align-self: flex-start; min-width: 22px; height: 22px; padding: 0 5px;
      display: grid; place-items: center; border-radius: var(--radius-sm);
      background: color-mix(in srgb, var(--sh) 16%, transparent); color: var(--sh);
      font-size: var(--fs-12, 12px); font-weight: var(--font-bold, 700); line-height: 1; }
    .sc-ai { position: absolute; top: 5px; right: 6px; color: var(--sh); opacity: .9; }

    /* variant: shift — white card + left accent */
    .v-shift { background: var(--bg-surface); border: 1px solid var(--border-sub);
      border-left: 3px solid var(--sh); box-shadow: var(--shadow-regular-xs, none); }
    /* variant: coverage — dashed demand cell */
    .v-coverage { background: color-mix(in srgb, var(--sh) 5%, var(--bg-surface));
      border: 1.5px dashed color-mix(in srgb, var(--sh) 50%, var(--border-sub)); }
    .v-coverage.is-muted { opacity: .45; }
    .v-coverage .sc-time { color: var(--text-soft); }
    /* variant: block + rest — ngày đặc biệt (Nghỉ lễ / Vắng mặt / Ngày nghỉ):
       ĐỒNG BỘ nền PASTEL + chữ tông, KHÔNG viền (chỉ background + text color). */
    .v-block, .v-rest { justify-content: center; text-align: center; border: 0;
      background: color-mix(in srgb, var(--sh) 22%, var(--bg-surface)); }
    .v-block .sc-body, .v-rest .sc-body { flex: none; align-items: center; }
    .v-block .sc-title, .v-rest .sc-title { font-weight: var(--font-medium, 500);
      color: color-mix(in srgb, var(--sh) 72%, var(--text-strong)); }

    /* tone → --sh (categorical --data-* tokens + semantic warning for absence) */
    .t-opening { --sh: var(--data-7); } .t-afternoon { --sh: var(--data-1); }
    .t-night { --sh: var(--data-3); } .t-admin { --sh: var(--data-4); }
    .t-rest { --sh: var(--data-5); } .t-holiday { --sh: var(--data-8); }
    .t-absence { --sh: var(--warning-base); } .t-neutral { --sh: var(--data-neutral); }
  