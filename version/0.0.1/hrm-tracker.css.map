
:host { display: inline-flex; align-items: center; gap: var(--_gap, 3px); max-width: 100%; flex-wrap: wrap; }
.tk-cell {
  flex: none; width: var(--_w, 10px); height: var(--_h, 24px);
  border-radius: var(--radius-xs, 2px);
  transition: opacity var(--duration-fast, .15s) var(--ease-out, ease);
}
.tk-cell:hover { opacity: .75; }
.tk-cell[data-tone='success'] { background: var(--success-base); }
.tk-cell[data-tone='warning'] { background: var(--warning-base); }
.tk-cell[data-tone='error']   { background: var(--error-base); }
.tk-cell[data-tone='info']    { background: var(--info-base); }
.tk-cell[data-tone='neutral'] { background: var(--neutral-300, var(--border-sub)); }
  