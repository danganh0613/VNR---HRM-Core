
    .bars { display: flex; flex-direction: column; gap: 6px; }
    .bar-row { display: flex; align-items: center; gap: 16px; }
    .bar-name { width: 90px; font-size: var(--fs-13); color: var(--text-body); font-variant-numeric: tabular-nums; }
    .bar { height: 16px; background: var(--primary-base); border-radius: var(--radius-xs); flex-shrink: 0; }
    .bar-val { font-size: var(--fs-12); color: var(--text-sub); font-variant-numeric: tabular-nums; }

    .chips { display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-end; }
    .chip { display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 72px; }
    .dot { background: var(--primary-bg-soft); border: 1px solid var(--primary-border); border-radius: var(--radius-full); }
    .rbox { width: 56px; height: 56px; background: var(--primary-bg-soft); border: 1px solid var(--primary-border); }
    .chip-name { font-size: var(--fs-12); font-weight: 500; color: var(--text-body); }
    .chip-val { font-size: var(--fs-12); color: var(--text-sub); font-variant-numeric: tabular-nums; }
  