
    .search-bar {
      position: sticky; top: -32px; z-index: 1;
      display: flex; align-items: center; gap: 10px;
      background: var(--bg-app); padding: 8px 0 16px;
    }
    .s-ico { color: var(--text-sub); }
    .search {
      flex: 1; max-width: 420px; height: 40px; padding: 0 14px;
      border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
      background: var(--bg-surface); color: var(--text-strong);
      font-family: var(--font-sans); font-size: var(--fs-14); outline: none;
    }
    .search:focus { border-color: var(--border-focus); box-shadow: var(--shadow-focus-primary); }
    .count { font-size: var(--fs-12); color: var(--text-sub); font-variant-numeric: tabular-nums; }
    .ico-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 8px; }
    .ico-cell {
      display: flex; flex-direction: column; align-items: center; gap: 8px;
      padding: 14px 6px; border: 1px solid var(--border-sub); border-radius: var(--radius-lg);
      background: var(--bg-surface); color: var(--text-body); cursor: default;
      transition: border-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
    }
    .ico-cell:hover { border-color: var(--primary-base); color: var(--primary-base); }
    .ico-name { font-size: var(--fs-11); color: var(--text-sub); text-align: center; word-break: break-all; line-height: 1.3; }
    .ico-cell:hover .ico-name { color: var(--text-strong); }
    .more { margin-top: 16px; font-size: var(--fs-13); color: var(--text-sub); }
  