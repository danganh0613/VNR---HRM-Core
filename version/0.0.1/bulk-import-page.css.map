
    .lp-desktop { position: relative; height: 760px; border: 1px solid var(--border-sub); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-regular-sm); }
    .lp-desktop--full { position: relative; height: 100vh; border: 0; border-radius: 0; box-shadow: none; }
    .lp-desktop ::ng-deep .shell-content { padding: 0; }
    .lp-full { display: flex; justify-content: center; margin-top: 12px; }

    /* Trang FULL chiều rộng: không có cột chi tiết, chỉ một vùng cuộn duy nhất */
    .bi-wrap { height: 100%; min-height: 0; overflow: auto; padding: 20px 24px 32px; }
    .bi-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4, 16px); flex-wrap: wrap; margin-bottom: 14px; }
    .bi-h1 { font-size: var(--fs-20, 20px); font-weight: var(--font-bold, 700); letter-spacing: -.01em; color: var(--text-strong); }
    .bi-sub { font-size: var(--fs-13, 13px); color: var(--text-sub); margin-top: 3px; max-width: 720px; line-height: 1.55; }

    /* Tab tự dựng bằng button — chỉ đổi vùng nội dung, chrome giữ nguyên */
    .bi-tabs { display: flex; align-items: flex-end; gap: var(--space-1, 4px);
      border-bottom: 1px solid var(--border-sub); }
    .bi-tab { display: inline-flex; align-items: center; gap: 6px; margin-bottom: -1px;
      border: 0; border-bottom: 2px solid transparent; background: transparent; cursor: pointer;
      font: inherit; font-size: var(--fs-13, 13px); font-weight: var(--font-medium, 500); color: var(--text-sub);
      padding: var(--space-2, 8px) var(--space-3, 12px);
      border-start-start-radius: var(--radius-sm, 6px); border-start-end-radius: var(--radius-sm, 6px); }
    .bi-tab:hover { color: var(--text-strong); background: var(--bg-surface-subtle); }
    .bi-tab.is-on { color: var(--primary-base); border-bottom-color: var(--primary-base); font-weight: var(--font-semibold, 600); }
    .bi-tab .cnt { font-size: var(--fs-11, 11px); font-weight: var(--font-semibold, 600); padding: 1px 6px; border-radius: var(--radius-sm, 6px);
      background: var(--faded-bg); color: var(--text-soft); font-variant-numeric: tabular-nums; }
    .bi-tab.is-on .cnt { background: var(--primary-bg-subtle); color: var(--primary-base); }

    .bi-hint { margin-top: var(--space-2, 8px); font-size: var(--fs-11, 11px); color: var(--text-soft); line-height: 1.5; }
    .bi-hint b { color: var(--text-body); font-weight: var(--font-semibold, 600); }

    .bi-note { margin-top: var(--space-2-5, 10px); padding: var(--space-2, 8px) var(--space-3, 12px);
      border: 1px solid var(--border-sub); border-inline-start: 3px solid var(--primary-base);
      border-radius: var(--radius-sm, 6px); background: var(--primary-bg-subtle);
      font-size: var(--fs-12, 12px); color: var(--text-body); line-height: 1.5; }
  