
:host { display: inline-flex; align-items: center; gap: 6px; }
.rc-stars { display: inline-flex; align-items: center; gap: 1px; color: var(--text-disabled); }
.rc-star.rc-on { color: var(--yellow-500); }
.rc-val { font-size: var(--fs-13); font-weight: 500; color: var(--text-strong); font-variant-numeric: tabular-nums; }
.rc-count { font-size: var(--fs-12); color: var(--text-sub); }
  