
    :host { display: block; }
    .sg-card { background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-xl, 16px); overflow: hidden; }

    /* HEADER — trái main / phải (progress + chevron), canh giữa dọc → chevron giữa chiều cao header. */
    .sg-head { width: 100%; display: flex; align-items: center; gap: var(--space-4, 16px);
      padding: var(--space-4, 16px) var(--space-5, 20px); border: 0; background: transparent; cursor: pointer; text-align: left; font: inherit;
      transition: background var(--duration-fast, .15s) var(--ease-out, ease); }
    .sg-head:hover { background: var(--bg-surface-subtle); }
    .sg-head-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .sg-title { font-size: var(--fs-16, 16px); font-weight: var(--font-semibold, 600); color: var(--text-strong); }
    .sg-sub { font-size: var(--fs-13, 13px); color: var(--text-sub); margin-top: 2px; }
    .sg-head-right { flex: none; display: flex; align-items: center; gap: var(--space-3, 12px); }
    .sg-progress { display: flex; align-items: center; gap: var(--space-2, 8px); }
    .sg-count { font-size: var(--fs-13, 13px); color: var(--text-sub); white-space: nowrap; }
    .sg-bar { display: block; width: 132px; }
    .sg-chev { flex: none; color: var(--text-soft); }

    /* SECTION (accordion) */
    .sg-sec { border-top: 1px solid var(--border-soft, var(--border-sub)); }
    .sg-sec-head { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: var(--space-2, 8px);
      padding: var(--space-3-5, 14px) var(--space-5, 20px); border: 0; background: transparent; cursor: pointer; text-align: left; font: inherit; color: var(--text-strong);
      transition: background var(--duration-fast, .15s) var(--ease-out, ease); }
    .sg-sec-head:hover { background: var(--bg-surface-subtle); }
    .sg-sec-l { display: flex; align-items: center; gap: var(--space-2-5, 10px); min-width: 0; }
    .sg-sec-title { font-size: var(--fs-14, 14px); font-weight: var(--font-semibold, 600); }
    .sg-sec-title.is-done { color: var(--text-sub); }
    .sg-sec-head > tabler-icon { color: var(--text-soft); }
    /* Vòng tròn check: viền đứt (chưa) / ✓ xanh (xong) — TÍCH TẠI CHỖ, không đổi thứ tự. */
    .sg-circle { flex: none; width: 20px; height: 20px; border-radius: 50%; border: 2px dashed var(--border-strong, var(--border-sub)); display: grid; place-items: center; color: var(--success-base); }
    .sg-circle.is-done { border: 0; color: var(--success-base); }
    .sg-circle--btn { cursor: pointer; transition: border-color var(--duration-fast, .15s) var(--ease-out, ease); }
    .sg-circle--btn:not(.is-done):hover { border-color: var(--success-base); }
    .sg-circle-hover { opacity: 0; transition: opacity var(--duration-fast, .15s) var(--ease-out, ease); }
    .sg-circle--btn:hover .sg-circle-hover { opacity: .4; }

    /* FORM trong nhóm đang mở — lưới 2 cột (field half) cho form nhiều thông tin gọn gàng. */
    .sg-form { padding: 0 var(--space-5, 20px) var(--space-4, 16px) calc(var(--space-5, 20px) + 30px); }
    .sg-form-desc { margin: 0 0 var(--space-3, 12px); font-size: var(--fs-13, 13px); color: var(--text-sub); line-height: 1.5; }
    .sg-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3-5, 14px); }
    .sgf-full { grid-column: 1 / -1; }
    .sgf-field { display: flex; flex-direction: column; gap: var(--space-1-5, 6px); min-width: 0; }
    .sgf-lbl { font-size: var(--fs-13, 13px); font-weight: var(--font-medium, 500); color: var(--text-strong); }
    .sgf-hint { font-size: var(--fs-12, 12px); color: var(--text-soft); }
    .sgf-toggle { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3, 12px);
      padding: var(--space-2-5, 10px) var(--space-3, 12px); border: 1px solid var(--border-sub); border-radius: var(--radius-md); }
    .sgf-toggle-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  