
    .lp-desktop { height: 760px; border: 1px solid var(--border-sub); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-regular-sm); }
    .lp-desktop--full { height: 100vh; border: 0; border-radius: 0; box-shadow: none; }
    .lp-full { margin-top: 14px; } .lp-full-link { text-decoration: none; }
    .lp-desktop ::ng-deep .shell-content { padding: 0; display: flex; flex-direction: column; min-height: 0; }
    .lp-desktop ::ng-deep .shell-content hrm-list-page { flex: 1 1 auto; min-height: 0; }
    .lp-desktop ::ng-deep hrm-data-view .dv-bar { display: none; }
    .lp-desktop ::ng-deep .ant-table-tbody > tr > td, .lp-desktop ::ng-deep .ant-table-thead > tr > th { white-space: nowrap; }
    :host ::ng-deep .ant-tag { margin: 0; }

    .lp-hdr { display: flex; align-items: center; justify-content: flex-end; gap: var(--space-2); }
    .lp-tabsrow { display: flex; }
    .tbx { display: flex; align-items: center; gap: var(--space-2); min-width: 0; }
    .bx-clear { display: grid; place-items: center; width: 28px; height: 28px; border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub); }
    .bx-clear:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
    .bx-count { font-size: var(--fs-13); color: var(--text-body); background: var(--primary-bg-subtle); padding: 4px 10px; border-radius: var(--radius-full); white-space: nowrap; }
    .bx-count b { color: var(--primary-base); }

    /* Cột hành động — nút icon SOLID theo TONE (đồng bộ treatment với footer detail: duyệt=primary,
       từ chối=error). Rule: tone quyết định màu (như status-cell); mọi surface dùng CÙNG solid. */
    .aq { display: inline-flex; gap: var(--space-2, 8px); }
    .aq-btn { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub); transition: filter .12s, background-color .12s, border-color .12s, color .12s; }
    .aq-ok { background: var(--primary-base); border-color: var(--primary-base); color: var(--static-white, #fff); }
    .aq-no { background: var(--error-base); border-color: var(--error-base); color: var(--static-white, #fff); }
    .aq-ok:hover, .aq-no:hover { filter: brightness(0.95); }
    .aq-view:hover { border-color: var(--primary-base); color: var(--primary-base); }

    .c-code { font-family: var(--font-mono, ui-monospace, monospace); font-size: var(--fs-13); color: var(--text-strong); font-weight: var(--font-medium, 500); }
    .c-mut { font-size: var(--fs-13); color: var(--text-sub); }

    .rc { display: flex; flex-direction: column; gap: var(--space-2, 8px); }
    .rc-top { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2); }
    .rc-line { display: flex; align-items: center; gap: var(--space-2, 8px); }
    .rc-row { display: flex; align-items: center; gap: 6px; min-width: 0; font-size: var(--fs-12); color: var(--text-sub); }
    .rc-row tabler-icon { flex: none; color: var(--text-soft); }
    .rc-foot { display: flex; gap: var(--space-2, 8px); padding-top: var(--space-2, 8px); border-top: 1px solid var(--border-soft); }

    .as-ico { display: grid; place-items: center; width: 34px; height: 34px; border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub); }
    .sn-acct { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px; border: 1px solid var(--border-sub); border-radius: var(--radius-lg); background: var(--bg-surface); cursor: pointer; text-align: left; }
    .sn-acct--mini { width: auto; padding: 4px; border-color: transparent; background: transparent; }
    .sn-acct-ic { display: grid; place-items: center; width: 32px; height: 32px; border-radius: var(--radius-md); background: var(--primary-bg-subtle); color: var(--primary-base); flex: none; }
    .sn-acct-info { flex: 1; min-width: 0; }
    .sn-acct-name { display: block; font-size: var(--fs-14); font-weight: var(--font-semibold, 600); color: var(--text-strong); }
    .sn-acct-sub { display: block; font-size: var(--fs-12); color: var(--text-sub); }
  