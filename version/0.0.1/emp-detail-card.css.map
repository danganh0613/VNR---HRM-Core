
    :host { display: block; }
    /* padding-top bù cho phần surface đã bỏ padding-top (để action bar ghim flush) → nhịp trên đều. */
    .pk { display: flex; flex-direction: column; gap: var(--space-3-5); padding-top: var(--space-4); }
    .pk-head2 { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2); }
    /* Action bar: full-width, KHÔNG rớt hàng (nowrap) — dư thu vào ⋮; STICKY ghim FLUSH sát header
       (surface đã bỏ padding-top → top:0 = sát header, không hở khe padding). padding trên = dưới
       (đều); margin-bottom âm triệt tiêu flex-gap → nền bar phủ kín, content cuộn không "xuyên" qua
       khe dưới; border-bottom = DUY NHẤT 1 đường (section kề bỏ border-top). */
    .pk-actions {
      display: flex; align-items: center; gap: var(--space-2); flex-wrap: nowrap; width: 100%; min-width: 0;
      position: sticky; top: 0; z-index: 5;
      padding: var(--space-2) 0; margin-bottom: calc(-1 * var(--space-3-5));
      background: var(--bg-surface); border-bottom: 1px solid var(--border-soft);
    }
    /* Section kề ngay dưới bar: bỏ đường kẻ trên (tránh double divider) + bỏ padding-top thừa. */
    .pk-actions + .pk-sec { border-top: 0; padding-top: 0; }

    /* PAGE MODE: action bar nội bộ ẩn (trang tự dựng topnav). Card của trang đã padding đều
       → bỏ padding-top bù của .pk (chỉ cần cho surface drawer) → nhịp trên = trái/phải/dưới. */
    :host([data-page-mode]) .pk { padding-top: 0; }
    .pk-actions hrm-button[hidden] { display: none; }
    /* Nút gọn: gap icon↔text nhỏ + padding ngang thu lại (token). */
    .pk-actions hrm-button tabler-icon { margin-right: var(--space-0-5); }
    .pk-actions hrm-button ::ng-deep .ant-btn { padding-inline: var(--space-2); gap: var(--space-0-5); }
    /* Tông màu nút hành động (nền đặc theo ngữ nghĩa) — đồng bộ hrm-workflow-actions. */
    .pk-actions hrm-button[data-tone='error'] ::ng-deep .ant-btn { background: var(--error-base); border-color: var(--error-base); color: var(--static-white, #fff); }
    .pk-actions hrm-button[data-tone='error'] ::ng-deep .ant-btn:hover { filter: brightness(0.95); }
    .pk-actions hrm-button[data-tone='warning'] ::ng-deep .ant-btn { background: var(--warning-base); border-color: var(--warning-base); color: var(--static-white, #fff); }
    .pk-actions hrm-button[data-tone='warning'] ::ng-deep .ant-btn:hover { filter: brightness(0.95); }
    .pk-actions hrm-button[data-tone='violet'] ::ng-deep .ant-btn { background: var(--purple-500); border-color: var(--purple-500); color: var(--static-white, #fff); }
    .pk-actions hrm-button[data-tone='violet'] ::ng-deep .ant-btn:hover { filter: brightness(0.95); }
    .pk-more { flex: none; margin-left: auto; }
    /* Nút ⋮ cao ĐÚNG bằng ant-btn size md (32px) → hàng nút đồng đều. */
    .pk-more { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md); cursor: pointer; color: var(--text-sub); }
    .pk-mi-danger { color: var(--error-base); }
    .pk-more:hover { border-color: var(--primary-base); color: var(--text-strong); }
    .pk-h { margin: 0 0 8px; font-size: var(--fs-12); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--text-sub); }
    .pk-sec { border-top: 1px solid var(--border-soft); padding-top: 12px; }
    .pk-list { display: grid; grid-template-columns: 118px 1fr; gap: 8px 12px; margin: 0; align-items: center; }
    .pk-list dt { font-size: var(--fs-13); color: var(--text-sub); }
    .pk-list dd { margin: 0; font-size: var(--fs-13); color: var(--text-body); min-width: 0; }
    .pk-file { display: flex; align-items: center; justify-content: space-between; gap: 8px; border: 1px solid var(--border-soft); border-radius: var(--radius-md); padding: 8px 10px; }
    .pk-dl { display: grid; place-items: center; width: 30px; height: 30px; flex: none; border: 0; background: transparent; border-radius: var(--radius-md); cursor: pointer; color: var(--icon-secondary); }
    .pk-dl:hover { background: var(--bg-surface-subtle); color: var(--icon-primary); }
    .pk-tl { display: flex; flex-direction: column; }
    .pk-tl-i { position: relative; padding: 0 0 12px 18px; }
    .pk-tl-i:last-child { padding-bottom: 0; }
    .pk-tl-i::before { content: ''; position: absolute; left: 3px; top: 4px; width: 8px; height: 8px; border-radius: 50%; background: var(--neutral-300); }
    .pk-tl-i.is-on::before { background: var(--primary-base); }
    .pk-tl-i::after { content: ''; position: absolute; left: 6.5px; top: 14px; bottom: 2px; width: 1px; background: var(--border-soft); }
    .pk-tl-i:last-child::after { display: none; }
    .pk-tl-t { font-size: var(--fs-12); color: var(--text-soft); }
    .pk-tl-x { font-size: var(--fs-13); color: var(--text-body); }
  