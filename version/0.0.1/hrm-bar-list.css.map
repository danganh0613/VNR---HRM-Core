
:host { display: flex; flex-direction: column; gap: 8px; width: 100%; }
.bl-row { display: flex; align-items: center; gap: 12px; }
.bl-bar-wrap { position: relative; flex: 1; min-width: 0; height: 30px; border-radius: var(--radius-sm); overflow: hidden; }
.bl-bar { position: absolute; inset: 0 auto 0 0; border-radius: var(--radius-sm);
  transition: width var(--duration-normal, .25s) var(--ease-out, ease); }
.bl-label { position: relative; display: inline-flex; align-items: center; height: 100%;
  padding: 0 10px; font-size: var(--fs-13); color: var(--text-body);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
.bl-value { flex: none; min-width: 40px; text-align: right; font-size: var(--fs-13);
  color: var(--text-strong); font-variant-numeric: tabular-nums; }
  