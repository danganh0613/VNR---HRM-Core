
    .lp-desktop { position: relative; height: 760px; border: 1px solid var(--border-sub); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-regular-sm); }
    .lp-desktop--full { position: relative; height: 100vh; border: 0; border-radius: 0; box-shadow: none; }
    .lp-desktop ::ng-deep .shell-content { padding: 0; }
    .lp-full { display: flex; justify-content: center; margin-top: 12px; }

    /* Vùng chứa: danh sách + peek nằm cạnh nhau (surface 'master') */
    .fe-wrap { display: flex; align-items: stretch; height: 100%; min-height: 0; }
    .fe-main { flex: 1; min-width: 0; overflow: auto; padding: 20px 24px 32px; }
    .fe-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; }
    .fe-h1 { font-size: var(--fs-20, 20px); font-weight: var(--font-bold, 700); letter-spacing: -.01em; }
    .fe-sub { font-size: var(--fs-13, 13px); color: var(--text-sub); margin-top: 3px; max-width: 620px; }

    .fe-grid { background: var(--bg-surface); border: 1px solid var(--border-sub); border-radius: var(--radius-lg, 10px);
      overflow-x: auto; overflow-y: hidden; scrollbar-gutter: stable;
      /* gợi ý còn cột bên phải: bóng mờ ở mép khi cuộn được */
      background-image: linear-gradient(to left, rgb(0 0 0 / .06), transparent 24px);
      background-attachment: local, scroll; }
    .fe-tb { width: 100%; border-collapse: collapse; }
    .fe-tb th { background: var(--bg-surface-subtle); font-size: var(--fs-11, 11px); text-transform: uppercase; letter-spacing: .3px;
      color: var(--text-soft); font-weight: var(--font-semibold, 600); text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--border-soft); white-space: nowrap; }
    .fe-tb td { padding: 9px 12px; border-bottom: 1px solid var(--border-soft); font-size: var(--fs-13, 13px); }
    .fe-tb tbody tr:last-child td { border-bottom: none; }
    .fe-tb tbody tr:hover { background: var(--bg-surface-subtle); }
    .fe-tb tbody tr.is-active { background: var(--primary-bg-subtle); }
    .fe-tb .n { text-align: right; }
    .fe-tb .a { width: 130px; text-align: right; }
    .fe-tb .mono { font-variant-numeric: tabular-nums; }
    /* Nút "Chỉnh sửa" trên dòng dùng hrm-button — chỉ chỉnh khoảng cách icon/chữ.
       hrm-button KHÔNG tự khai display cho host: ở nơi khác nó thành block chỉ vì tình cờ là
       flex item. Trong ô bảng thì không, host sập còn chiều cao dòng chữ (đo: 15px) trong khi
       nút con cao 24px ⇒ nút tràn khỏi hộp host, lệch baseline. Khai display ở đây cho chắc. */
    .fe-tb .a hrm-button { display: inline-flex; vertical-align: middle; }
    .fe-tb .a hrm-button tabler-icon { margin-right: var(--space-1, 4px); vertical-align: -2px; }
  