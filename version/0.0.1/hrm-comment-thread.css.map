
    :host { display: block; }
    .ct { display: flex; flex-direction: column; gap: 12px; }
    .ct-item { display: flex; flex-direction: column; gap: 6px; }
    .ct-head { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .ct-spacer { flex: 1; }
    .ct-time { flex: none; font-size: var(--fs-12); color: var(--text-soft); font-variant-numeric: tabular-nums; }
    /* Bong bóng nội dung — thẳng cột với tên (avatar 28 + gap 8). */
    .ct-bubble {
      margin-left: 36px; padding: 8px 12px; border-radius: var(--radius-md);
      background: var(--bg-surface-subtle); font-size: var(--fs-13); line-height: 1.55; color: var(--text-body);
      white-space: pre-line; overflow-wrap: anywhere;
    }

    /* Hàng nhập: ô nhập · đính kèm · gửi — cao ĐỀU 32px. */
    .ct-input { display: flex; align-items: center; gap: 8px; margin-top: 2px; }
    .ct-field {
      flex: 1; min-width: 0; height: 32px; padding: 0 10px;
      border: 1px solid var(--border-sub); border-radius: var(--radius-md);
      background: var(--bg-surface); color: var(--text-body); font: inherit; font-size: var(--fs-13); outline: none;
      transition: border-color var(--duration-fast, .15s) var(--ease-out, ease);
    }
    .ct-field::placeholder { color: var(--text-soft); }
    .ct-field:focus { border-color: var(--primary-base); }
    .ct-attach {
      display: grid; place-items: center; width: 32px; height: 32px; flex: none;
      border: 1px solid var(--border-sub); background: var(--bg-surface); border-radius: var(--radius-md);
      cursor: pointer; color: var(--icon-secondary);
    }
    .ct-attach:hover { border-color: var(--primary-base); color: var(--icon-primary); }
  