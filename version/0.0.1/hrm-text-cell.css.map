
/* display:flex (block-level) — không tham gia baseline của td, gióng ngang với Ô người dùng trong cùng dòng. */
:host { display: flex; align-items: center; gap: 8px; min-width: 0; max-width: 100%; }
:host([data-align='right']) { justify-content: flex-end; text-align: right; }
.tc-ic { display: inline-flex; color: var(--icon-secondary); flex: none; }
.tc-body { display: flex; flex-direction: column; min-width: 0; }
.tc-primary { font-size: var(--fs-14); color: var(--text-strong); line-height: 1.35;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tc-secondary { font-size: var(--fs-12); color: var(--text-sub); line-height: 1.3;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  