
:host { display: inline-block; }

/* Trigger — cùng ngôn ngữ quick-filter: bo góc theo config theme, viền brand khi có lọc. */
.fp {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 5px 12px; border-radius: var(--radius-lg); cursor: pointer;
  background: var(--bg-surface); border: 1px solid var(--border-sub);
  font-family: var(--font-sans); font-size: var(--fs-13); color: var(--text-body);
  transition: border-color var(--duration-fast, .15s) var(--ease-out, ease),
              background var(--duration-fast, .15s) var(--ease-out, ease);
}
.fp:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
.fp--active { border-color: var(--primary-base); }
.fp-ic { flex: none; color: var(--text-sub); }
.fp-label { white-space: nowrap; }
.fp-sep { width: 1px; align-self: stretch; margin: 1px 2px; background: var(--border-sub); }
.fp-count { white-space: nowrap; font-weight: 600; color: var(--text-strong); }
.fp:focus-visible { outline: 2px solid var(--primary-focus-ring, var(--primary-base)); outline-offset: 1px; }

/* Panel builder — flex cột + max-height: header/footer GHIM, body cuộn → thêm bao nhiêu điều kiện
   nút Áp dụng vẫn luôn bấm được (fix bug panel nở vượt màn). */
.fp-panel {
  width: min(640px, 94vw); max-height: min(72vh, 620px);
  display: flex; flex-direction: column;
  padding: 14px 16px 12px;
  background: var(--bg-surface); border: 1px solid var(--border-sub);
  border-radius: var(--radius-xl); box-shadow: var(--shadow-regular-md);
  font-family: var(--font-sans);
}
.fp-head { flex: none; display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 4px; }
.fp-head-t { font-size: var(--fs-16); font-weight: 700; color: var(--text-strong); }
.fp-head-s { margin-top: 2px; font-size: var(--fs-12); color: var(--text-sub); }
.fp-reset-link {
  flex: none; display: inline-flex; align-items: center; gap: 4px;
  border: 0; background: transparent; padding: 2px 0; cursor: pointer;
  font-family: inherit; font-size: var(--fs-13); color: var(--primary-base); font-weight: 500;
}
.fp-reset-link:hover { text-decoration: underline; }

.fp-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
.fp-row {
  display: grid; grid-template-columns: 185px 148px 1fr; gap: 10px; align-items: center;
  padding: 12px 0; border-bottom: 1px solid var(--border-soft);
}
.fp-row:first-child { border-top: 1px solid var(--border-soft); margin-top: 8px; }
.fp-row-label {
  display: flex; align-items: center; gap: 8px; min-width: 0;
  font-size: var(--fs-13); font-weight: 500; color: var(--text-strong);
}
.fp-row-ic { flex: none; color: var(--text-sub); }
/* Nhãn dài (VD "Có hợp đồng chính thức") — cho xuống dòng, KHÔNG cắt cụt để user luôn đọc đủ. */
.fp-row-label span { white-space: normal; line-height: 1.35; }
.fp-row-op { min-width: 0; }
.fp-row-value { min-width: 0; }
.fp-row-value--full { grid-column: 2 / -1; }
.fp-row-novalue { display: block; padding: 4px 2px; font-size: var(--fs-13); color: var(--text-disabled); font-style: italic; }
.fp-num-range { display: flex; align-items: center; gap: 6px; min-width: 0; }
.fp-num-range hrm-input-number { flex: 1; min-width: 0; }
.fp-num-sep { flex: none; color: var(--text-soft); }

/* "+ Thêm điều kiện" — dashed, full-width. */
.fp-add {
  display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%;
  margin-top: 12px; padding: 9px 12px; cursor: pointer;
  border: 1px dashed var(--border-sub); border-radius: var(--radius-md);
  background: transparent; font-family: inherit; font-size: var(--fs-13); color: var(--primary-base); font-weight: 500;
}
.fp-add:hover { border-color: var(--primary-base); background: var(--primary-bg-subtle); }

.fp-foot { flex: none; display: flex; justify-content: flex-end; gap: 8px; padding-top: 12px; }
.fp-btn {
  padding: 6px 16px; cursor: pointer; text-align: center;
  border: 1px solid var(--border-sub); border-radius: var(--radius-md);
  background: var(--bg-surface); font-family: inherit; font-size: var(--fs-13); color: var(--text-body);
}
.fp-btn:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
.fp-btn--primary {
  background: var(--primary-base); border-color: var(--primary-base); color: var(--primary-foreground);
  font-weight: 500;
}
.fp-btn--primary:hover { background: var(--primary-hover); border-color: var(--primary-hover); color: var(--primary-foreground); }

/* Picker "Thêm điều kiện" */
.fp-picker {
  min-width: 240px; max-width: 300px; max-height: 380px; overflow-y: auto; padding: 6px;
  background: var(--bg-surface); border: 1px solid var(--border-sub);
  border-radius: var(--radius-xl); box-shadow: var(--shadow-regular-md);
  font-family: var(--font-sans);
}
.fp-picker-search { display: flex; align-items: center; gap: 8px; padding: 4px 10px 8px; border-bottom: 1px solid var(--border-soft); color: var(--text-soft); }
.fp-picker-search input.ant-input.ant-input {
  flex: 1; min-width: 0; padding: 4px 0; border: 0; background: transparent; box-shadow: none;
  font-size: var(--fs-13); color: var(--text-body);
}
.fp-picker-group {
  font-size: var(--fs-11); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;
  color: var(--text-soft); padding: 10px 10px 4px;
}
.fp-picker-row {
  display: flex; align-items: center; gap: 10px; width: 100%;
  padding: 7px 10px; border: 0; background: transparent; cursor: pointer;
  border-radius: var(--radius-md); text-align: left;
  font-family: inherit; font-size: var(--fs-13); color: var(--text-body);
}
.fp-picker-row:hover { background: var(--bg-surface-subtle); color: var(--text-strong); }
.fp-picker-cb { flex: none; pointer-events: none; }
.fp-picker-label { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  